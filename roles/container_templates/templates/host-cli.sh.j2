#!/usr/bin/env bash
# {{ ansible_managed }}
#
# Per-template host-side CLI for container template `{{ cfg.name }}` (build /
# run / stop / shell-in / ssh-in / rma). All subcommands are HOST-side podman
# operations - this script is invoked ON the host, not inside the container.
#
# ===========================================================================
# Two-role layout (the key to not getting lost between container_apps and
# container_templates):
#
#   roles/container_apps/       thin launchers at `~/.local/bin/c-<tpl>-<rt>`
#                               + zsh/bash completions. Each launcher sets
#                               RUNTIME / PROJECT_NAME / PROJECT_PATH env
#                               vars then `exec`s into the script below.
#                               (This is the name the user types.)
#                                                |
#                                                v
#   roles/container_templates/  per-template assets under
#                               `~/.local/share/ansible-managed/container-templates/<tpl>/`,
#                               including Dockerfile{,.krun,.systemd}, the
#                               rendered dotfiles, and host-cli.sh. <-- YOU ARE HERE
#                               (Per-template means: one host-cli.sh per
#                               template name; one launcher per
#                               (template, runtime) pair.)
#
# Concrete example for `c-claude-crun init`:
#   1. shell runs `~/.local/bin/c-claude-crun`                                          (launcher; container_apps)
#   2. launcher `exec`s `~/.local/share/ansible-managed/container-templates/claude/host-cli.sh init`   (this file; container_templates)
# ===========================================================================

set -euo pipefail

# ---------- Initial values (env wins over default; flag parser below wins over env) ----------
# RUNTIME is deliberately NOT exposed as a flag - it's effectively pinned by
# which launcher you ran (`c-<tpl>-crun` vs `c-<tpl>-krun`), and changing it
# mid-invocation would only confuse the manifest / container naming. Keep it
# as an env var for power users who invoke host-cli.sh directly.
PROJECT_NAME="${PROJECT_NAME:-}"
PROJECT_PATH="${PROJECT_PATH:-}"
RUNTIME="${RUNTIME:-}"
HIDE_GIT_DIR="${HIDE_GIT_DIR:-true}"
HIDE_VSCODE_DIR="${HIDE_VSCODE_DIR:-true}"

# ---------- CLI flag parsing ----------
# Flags must come BEFORE the subcommand:
#   c-claude-crun --project-name foo --hide-git-dir false init
# Precedence: CLI flag > env var > default. Use `--` to terminate flag
# parsing explicitly (e.g. when a subcommand arg starts with `-`).
# `--hide-*` flags take an explicit `true`/`false` value (symmetric with the
# `HIDE_*` env vars). Any other value is rejected outright - downstream code
# only checks for the literal string "true", so a typo like `yes` or `1`
# would silently behave as `false`, which is a worse footgun than just
# erroring out here.
_require_bool() {
    [[ "$2" == "true" || "$2" == "false" ]] || {
        echo "$1 requires 'true' or 'false', got: $2" >&2; exit 1
    }
}

# Mount accumulator. Each entry pairs `MOUNT_HOSTS[i]` -> `MOUNT_NAMES[i]`,
# resulting in a `--volume <host>:/workspaces/<name>` at run time. Parallel
# arrays (not "host:name" strings) so paths containing `:` don't break parsing.
MOUNT_HOSTS=()
MOUNT_NAMES=()
_n_mounts=0    # scalar parallel to array length; avoids bash's array-length
               # syntax `$ {  # ARR[@]}` (spaces inserted in this comment so
               # Jinja2 doesn't read it as the start of a {# ... #} comment
               # at render time and choke).
_used_p=0      # 1 once -p / --project-path is seen (legacy single-mount alias)
_used_mount=0  # 1 once --mount is seen
_add_mount() {
    # Parse `<host>[:<name>]`, resolve realpath, validate, dedupe-by-name.
    local arg="$1" host_part name_part host_abs existing
    if [[ "$arg" == *:* ]]; then
        host_part="${arg%%:*}"
        name_part="${arg#*:}"
    else
        host_part="$arg"
        name_part=""
    fi
    host_abs="$(realpath -- "$host_part" 2>/dev/null)" \
        || { echo "Mount source not found: $host_part" >&2; exit 1; }
    [[ -d "$host_abs" ]] \
        || { echo "Mount source is not a directory: $host_part" >&2; exit 1; }
    if [[ -z "$name_part" ]]; then
        name_part="$(basename "$host_abs")"
        # Leading `.` -> `_` so dotdirs (`~/.config/foo`, `~/projects/.bar`)
        # pass the regex below. We only rewrite the auto-derived basename;
        # an explicit `--mount X:name` still has to be regex-clean as given.
        name_part="${name_part/#./_}"
    fi
    # Single-segment name only - no slashes, no leading dash, no leading dot.
    [[ "$name_part" =~ ^[A-Za-z0-9_][A-Za-z0-9._-]*$ ]] \
        || { echo "Mount name must match [A-Za-z0-9_][A-Za-z0-9._-]*, got: '$name_part'" >&2; exit 1; }
    for existing in "${MOUNT_NAMES[@]:-}"; do
        [[ "$existing" == "$name_part" ]] \
            && { echo "Mount name '$name_part' already used by an earlier --mount / -p" >&2; exit 1; }
    done
    MOUNT_HOSTS+=("$host_abs")
    MOUNT_NAMES+=("$name_part")
    _n_mounts=$((_n_mounts + 1))
}

while [[ $# -gt 0 ]]; do
    case "$1" in
        -n|--project-name)   PROJECT_NAME="$2"; shift 2 ;;
        -p|--project-path)
            [[ "$_used_mount" == 1 ]] && { echo "-p / --project-path cannot be combined with --mount; use one style." >&2; exit 1; }
            _used_p=1; _add_mount "$2"; shift 2 ;;
        --mount)
            [[ "$_used_p" == 1 ]] && { echo "--mount cannot be combined with -p / --project-path; use one style." >&2; exit 1; }
            _used_mount=1; _add_mount "$2"; shift 2 ;;
        --hide-git-dir)      _require_bool "$1" "${2:-}"; HIDE_GIT_DIR="$2";    shift 2 ;;
        --hide-vscode-dir)   _require_bool "$1" "${2:-}"; HIDE_VSCODE_DIR="$2"; shift 2 ;;
        --) shift; break ;;
        -*) echo "Unknown flag: $1 (try 'help')" >&2; exit 1 ;;
        *)  break ;;
    esac
done

# Required check. `help` doesn't need a project context (it just prints text);
# every other subcommand does. Skip when the user is asking for help (or when
# no subcommand was given, in which case dispatch below defaults to help too).
if [[ "${1:-help}" != "help" ]]; then
    [[ -n "$PROJECT_NAME" ]] || { echo "PROJECT_NAME must be set (--project-name or env)" >&2; exit 1; }
    # No mount given on the CLI -> single mount of cwd (or legacy PROJECT_PATH env).
    if [[ $_n_mounts -eq 0 ]]; then
        _add_mount "${PROJECT_PATH:-$PWD}"
    fi
fi

# Container-side workdir: single mount -> that workspace dir; multi-mount ->
# the /workspaces parent (the shell rc inside the container auto-cds for
# interactive sessions; for `exec`-style entry the user lands at this WORKDIR).
if [[ $_n_mounts -eq 1 ]]; then
    WORKSPACE_WORKDIR="/workspaces/${MOUNT_NAMES[0]}"
else
    WORKSPACE_WORKDIR="/workspaces"
fi

RUNTIME_OPT=()
RUNTIME_SUFFIX=""
if [[ -n "$RUNTIME" ]]; then
    RUNTIME_OPT=(--runtime "$RUNTIME")
    RUNTIME_SUFFIX="_$RUNTIME"
fi

IMAGE_NAME="{{ cfg.naming_prefix }}_image__${PROJECT_NAME}${RUNTIME_SUFFIX}"
CONTAINER_NAME="{{ cfg.naming_prefix }}_container__${PROJECT_NAME}${RUNTIME_SUFFIX}"
# Silent fail: `help` doesn't need this; the build / run subcommands that DO
# need it will error naturally when they try to use an empty ASSETS_DIR.
# The `|| ASSETS_DIR=""` is required because `set -e` + a failing `&&` chain
# inside `$(...)` propagates failure to the whole assignment.
ASSETS_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/assets" 2>/dev/null && pwd)" || ASSETS_DIR=""

# SSH key + Dockerfile selection for krun (sshd-based exec replacement).
# libkrun keeps `init.krun` as PID 1, so systemd refuses to start - we use
# the sshd-only `Dockerfile.krun` instead. `--systemd=always` is intentionally
# NOT set here because there is no systemd inside the krun image; the flag's
# job (mount /sys/fs/cgroup etc.) is irrelevant to a non-systemd workload.
SSH_KEY="$HOME/.local/share/ansible-managed/container-templates/host_ssh_key"
# `--publish 127.0.0.1::22` decoded:
#   - `127.0.0.1`    bind host side to loopback only (not 0.0.0.0)
#   - empty middle   (between the two `:`) -> let podman pick a random ephemeral
#                    host port; avoids fixed-port collisions across containers
#   - `22`           the container's listening port (sshd)
# DO NOT use `--publish 0:22` thinking 0 means "any port" - podman parses the
# first segment as an explicit host port and rejects 0 (`port numbers must be
# between 1 and 65535`). The double-colon form is the documented way to ask
# for a random port.
case "$RUNTIME" in
    krun) DOCKERFILE="Dockerfile.krun"; USE_SSH=1; SYSTEMD_FLAG=(); SSH_PUBLISH=(--publish 127.0.0.1::22) ;;
    *)    DOCKERFILE="Dockerfile";      USE_SSH=0; SYSTEMD_FLAG=(); SSH_PUBLISH=() ;;
esac

_ensure_ssh_key() {
    [[ -f "$SSH_KEY" ]] && return 0
    mkdir -p "$(dirname "$SSH_KEY")"
    # -C comment is what shows up at the end of $SSH_KEY.pub and in `authorized_keys`,
    # so any future "wait, what's this key for?" inspection is self-answering.
    ssh-keygen -t ed25519 -N "" -f "$SSH_KEY" \
        -C "ansible-managed: SSH client key for c-<template>-krun (host -> container, local-only) on $(hostname)" \
        >/dev/null
    echo "Generated SSH key at $SSH_KEY (pub key gets baked into image at build time)" >&2
}

_ssh_host_port() {
    # podman port output is like `0.0.0.0:43217` or `127.0.0.1:43217`. Take the trailing port.
    "$ENGINE" port "$CONTAINER_NAME" 22 2>/dev/null | head -1 | awk -F: '{print $NF}'
}

# Hide-dir mask via empty bind volume. One mask per mount, but ONLY when the
# corresponding `.git/` or `.vscode/` actually exists as a directory on the
# host. If it doesn't, podman would auto-create the bind target on the host
# side with whatever subuid the container process is running as (often a
# weird 5-digit UID once you map back through userns) -> mysterious leftover
# dirs in $HOME after the container exits.
HIDE_DIRS_ARGS=()
FAKE_MASK_DIR="/tmp/podman-mask-dir/$CONTAINER_NAME"
if [[ $_n_mounts -gt 0 ]]; then
    mkdir -p "$FAKE_MASK_DIR"
    for _i in "${!MOUNT_HOSTS[@]}"; do
        _host="${MOUNT_HOSTS[_i]}"
        _name="${MOUNT_NAMES[_i]}"
        if [[ "$HIDE_GIT_DIR" == "true" && -d "$_host/.git" ]]; then
            HIDE_DIRS_ARGS+=(--volume "$FAKE_MASK_DIR:/workspaces/$_name/.git:ro,Z")
        fi
        if [[ "$HIDE_VSCODE_DIR" == "true" && -d "$_host/.vscode" ]]; then
            HIDE_DIRS_ARGS+=(--volume "$FAKE_MASK_DIR:/workspaces/$_name/.vscode:ro,Z")
        fi
    done
    unset _i _host _name
fi

# Engine detection (prefer podman)
if command -v podman >/dev/null 2>&1; then
    ENGINE=podman
    USERNS_ARGS=(--userns=keep-id)
else
    ENGINE=docker
    USERNS_ARGS=()
fi

# ---------- Subcommands ----------

cmd_help() {
    cat <<'EOF'
Usage: <launcher> [flags] <subcommand> [args]
       (or `host-cli.sh [flags] <subcommand> [args]` for direct invocation)

Flags (override env vars; both override the launcher's cwd-based defaults):
  -n, --project-name <name>              Container/image disambiguator on the host
                                         (default: PWD with $HOME stripped and `/` -> `_`)
      --mount <host>[:<name>]            Bind-mount <host> dir at /workspaces/<name>.
                                         <name> defaults to basename(<host>). Repeat
                                         for multiple workspaces. If no --mount /
                                         --project-path given, defaults to $PWD.
  -p, --project-path <path>              Single-mount alias for --mount; can't be
                                         combined with --mount.
      --hide-git-dir true|false          Mask host's .git/ inside container, per mount
                                         (default: true; skipped per-mount if that
                                         workspace doesn't have a .git/ to mask).
      --hide-vscode-dir true|false       Same, for .vscode/ (default: true).
  --                                     End of flag parsing (use before a subcommand
                                         arg that itself starts with `-`)

Subcommands:
  help              Show this message
  env               Print resolved environment for debug
  init              build + run (idempotent build, fails if container exists)
  build             Build image from Dockerfile in ./assets/
  run               Create and start the container from the built image
  rma               rm all: rmc + rmi (container then image)
  rmc               Remove container (stops first)
  rmi               Remove image (stops + removes container first)
  start             Start an existing stopped container
  stop              Stop running container
  bash-user         exec /bin/bash as user `user`
  bash-root         exec /bin/bash as user `root`
  zsh-user          exec /bin/zsh as user `user`
  zsh-root          exec /bin/zsh as user `root`
EOF
{% if cfg.agent %}
    printf '  %-18sLaunch %s inside the container\n' '{{ cfg.agent.target_suffix }}' '{{ cfg.agent.display_name }}'
{% endif %}
    cat <<'EOF'

Environment variable equivalents (alternative to flags; flags win when both set):
  PROJECT_NAME      same as `--project-name`
  PROJECT_PATH      same as `--project-path` (single-mount). Ignored if --mount used.
  HIDE_GIT_DIR      `true` / `false`; same as `--hide-git-dir`
  HIDE_VSCODE_DIR   `true` / `false`; same as `--hide-vscode-dir`
  RUNTIME           OCI runtime (`crun`, `krun`, ...). Empty = podman default.
                    Has no `--flag` form: it's effectively pinned by which
                    launcher you ran (`c-<tpl>-crun` vs `c-<tpl>-krun`).
EOF
}

cmd_env() {
    cat <<EOF
========================================
Container Engine:  $ENGINE
========================================
SCRIPT:            ${BASH_SOURCE[0]}
ASSETS_DIR:        $ASSETS_DIR
UID:               $(id -u)
GID:               $(id -g)
========================================
PROJECT_NAME:      $PROJECT_NAME
RUNTIME:           $RUNTIME
HIDE_GIT_DIR:      $HIDE_GIT_DIR
HIDE_VSCODE_DIR:   $HIDE_VSCODE_DIR
WORKSPACE_WORKDIR: $WORKSPACE_WORKDIR
Mounts:
EOF
    for _i in "${!MOUNT_HOSTS[@]}"; do
        printf '  %s  ->  /workspaces/%s\n' "${MOUNT_HOSTS[_i]}" "${MOUNT_NAMES[_i]}"
    done
    unset _i
    cat <<EOF
========================================
IMAGE_NAME:        $IMAGE_NAME
CONTAINER_NAME:    $CONTAINER_NAME
========================================
EOF
}

cmd_build() {
    echo "=============================================================="
    echo "Build Image from $DOCKERFILE"
    echo "=============================================================="
    local build_args=()
    if [[ "$USE_SSH" == 1 ]]; then
        _ensure_ssh_key
        build_args+=(--build-arg "SSH_AUTHORIZED_KEY=$(cat "$SSH_KEY.pub")")
    fi
    BUILDAH_LAYERS=true "$ENGINE" build \
        --tag "localhost/$IMAGE_NAME" \
        --file "$ASSETS_DIR/$DOCKERFILE" \
        "${build_args[@]}" \
        "$ASSETS_DIR"
}

cmd_run() {
    echo "=============================================================="
    echo "Initialize the built Image into a running Container"
    echo "=============================================================="
    local _mount_args=()
    for _i in "${!MOUNT_HOSTS[@]}"; do
        _mount_args+=(--volume "${MOUNT_HOSTS[_i]}:/workspaces/${MOUNT_NAMES[_i]}")
    done
    "$ENGINE" run --name "$CONTAINER_NAME" --detach --tty \
        "${USERNS_ARGS[@]}" \
        "${RUNTIME_OPT[@]}" \
        "${SYSTEMD_FLAG[@]}" \
        "${SSH_PUBLISH[@]}" \
        --hostname "$CONTAINER_NAME" \
        --workdir "$WORKSPACE_WORKDIR" \
{% for port in cfg.publish_ports %}
        --publish "{{ port }}" \
{% endfor %}
        "${_mount_args[@]}" \
        "${HIDE_DIRS_ARGS[@]}" \
        "localhost/$IMAGE_NAME"
}

cmd_init() { cmd_build; cmd_run; }

cmd_start() { "$ENGINE" start "$CONTAINER_NAME"; }
cmd_stop()  { "$ENGINE" stop "$CONTAINER_NAME" || true; }
cmd_rmc()   { cmd_stop; "$ENGINE" container rm "$CONTAINER_NAME" || true; }
cmd_rmi()   { cmd_rmc; "$ENGINE" image rm "localhost/$IMAGE_NAME" || true; }
cmd_rma()   { cmd_rmc; cmd_rmi; }

_exec_user() {
    cmd_start
    if [[ "$USE_SSH" == 1 ]]; then
        local port; port=$(_ssh_host_port)
        [[ -n "$port" ]] || { echo "Could not find ssh host port for $CONTAINER_NAME" >&2; exit 1; }
        ssh -t -p "$port" -i "$SSH_KEY" \
            -o StrictHostKeyChecking=no \
            -o UserKnownHostsFile=/dev/null \
            -o LogLevel=ERROR \
            "user@127.0.0.1" "$@"
    else
        "$ENGINE" exec --interactive --tty --user user --workdir "$WORKSPACE_WORKDIR" "$CONTAINER_NAME" "$@"
    fi
}
_exec_root() {
    cmd_start
    if [[ "$USE_SSH" == 1 ]]; then
        local port; port=$(_ssh_host_port)
        [[ -n "$port" ]] || { echo "Could not find ssh host port for $CONTAINER_NAME" >&2; exit 1; }
        ssh -t -p "$port" -i "$SSH_KEY" \
            -o StrictHostKeyChecking=no \
            -o UserKnownHostsFile=/dev/null \
            -o LogLevel=ERROR \
            "root@127.0.0.1" "$@"
    else
        "$ENGINE" exec --interactive --tty --user root "$CONTAINER_NAME" "$@"
    fi
}

cmd_bash_user() { _exec_user /bin/bash; }
cmd_bash_root() { _exec_root /bin/bash; }
cmd_zsh_user()  { _exec_user /bin/zsh; }
cmd_zsh_root()  { _exec_root /bin/zsh; }

{% if cfg.agent %}
cmd_{{ cfg.agent.target_suffix | replace('-', '_') }}() { _exec_user {{ cfg.agent.command }}; }
{% endif %}

# ---------- Dispatch ----------
sub="${1:-help}"; shift || true
case "$sub" in
    help|env|init|build|run|rma|rmi|rmc|start|stop|bash-user|bash-root|zsh-user|zsh-root{% if cfg.agent %}|{{ cfg.agent.target_suffix }}{% endif %})
        # User-facing names keep hyphens; bash function names use underscores.
        "cmd_${sub//-/_}" "$@"
        ;;
    *)
        echo "Unknown subcommand: $sub" >&2
        cmd_help >&2
        exit 1
        ;;
esac
