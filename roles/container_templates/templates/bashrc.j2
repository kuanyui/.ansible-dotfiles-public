# {{ ansible_managed }}

{% if who == 'user' %}
# - This is the ~/.bashrc inside the container
# - bash is reserved for compatibility. Please use zsh instead.
# - Comments are mostly in ~/.zshrc.
{% else %}
# This is the ~/.bashrc inside the container
{% endif %}

{{ shared_bash_ps1_line }}

# Auto-cd into the workspace on interactive login. Single-mount containers
# land in the workspace dir directly; multi-mount stays at /workspaces/ so the
# user can `ls` and pick. Counter loop (not bash array-length) avoids the
# Jinja2-comment collision that bash array-length syntax would trigger.
if [ -n "$PS1" ] && [ -d /workspaces ]; then
    _count=0
    _first=""
    for _d in /workspaces/*/; do
        [ -d "$_d" ] || continue
        _count=$((_count + 1))
        [ -z "$_first" ] && _first="$_d"
    done
    if [ "$_count" = 1 ]; then
        cd "$_first"
    elif [ "$_count" -gt 1 ]; then
        cd /workspaces
    fi
    unset _count _first _d
fi

# Prevent Emacs TRAMP from failed to match the shell prompt.
if [ "$TERM" = "dumb" ]; then
    PS1='$ '
    unset PROMPT_COMMAND
    [ -n "$ZSH_VERSION" ] && unsetopt zle 2>/dev/null
fi

{% if who == 'user' %}

PATH={% if cfg.nodejs is defined and cfg.nodejs.install_via == 'distro' %}${HOME}/.local/npm_global/bin:{% endif %}${HOME}/.local/bin:${PATH}

{% endif %}
alias sz="source ~/.bashrc"
{{ shared_shell_aliases_ls }}
alias sc="sudo systemctl"
alias jc="sudo journalctl"
alias jc-clear="sudo journalctl --vacuum-time=5d"   #  Delete journal logs which are older than 5 days

{% if who == 'user' %}
alias nvv='nvm ls'
alias nv='nvm version'

{% endif %}
{{ shared_shell_aliases_cd_shortcuts }}

export HISTCONTROL=ignorespace
{% if who == 'user' %}

export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"  # This loads nvm
[ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"  # This loads nvm bash_completion
{% endif %}
