def colorize_vm_name(vm_name: str, *, stream: Any = sys.stderr) -> str:
    """Bold-cyan the VM name on TTYs (NO_COLOR honored), plain otherwise."""
    if os.environ.get("NO_COLOR") or not stream.isatty():
        return vm_name
    return f"{VM_NAME_COLOR}{vm_name}{COLOR_RESET}"


def die(message: str) -> NoReturn:
    print(f"qvm: error: {message}", file=sys.stderr)
    raise SystemExit(1)


def run(command_argv: list[str], *, dry_run: bool, cwd: Path | None = None) -> None:
    """Run a mutating command, printing the exact argv FIRST (transparency rule)."""
    print("+ " + shlex.join(command_argv), file=sys.stderr)
    if dry_run:
        return
    subprocess.run(command_argv, check=True, cwd=cwd)


def run_capture(command_argv: list[str], *, cwd: Path | None = None) -> tuple[int, str, str]:
    """Run read-only, capture (returncode, stdout, stderr); missing binary -> rc 127."""
    try:
        completed = subprocess.run(command_argv, capture_output=True, text=True, check=False, cwd=cwd)
    except FileNotFoundError:
        return 127, "", f"{command_argv[0]}: not found"
    return completed.returncode, completed.stdout, completed.stderr


def confirm_or_die(prompt_text: str, *, assume_yes: bool) -> None:
    """y/N gate before anything heavy (download / build / delete). Non-TTY aborts
    unless --yes, so scripts can never stumble into a half-made VM."""
    if assume_yes:
        return
    if not sys.stdin.isatty():
        die("not a TTY and --yes not given - refusing to proceed unconfirmed")
    reply: str = input(f"{prompt_text} [y/N] ").strip().lower()
    if reply not in ("y", "yes"):
        die("aborted by user")


# ---------- conf / ports / meta parsing (pure helpers; unit-tested) ----------


def parse_conf_text(conf_text: str) -> dict[str, str]:
    """Parse a quickemu `.conf` (shell `key="value"` lines; quickget writes the
    same shape). Comments / non-assignment lines are skipped. Good enough for
    the keys qvm reads back (guest_os, disk_img, fixed_iso); NOT a shell parser."""
    parsed_conf: dict[str, str] = {}
    for conf_line in conf_text.splitlines():
        assignment = re.match(r'^([A-Za-z_][A-Za-z0-9_]*)=["\']?(.*?)["\']?\s*$', conf_line.strip())
        if assignment and not conf_line.lstrip().startswith("#"):
            parsed_conf[assignment.group(1)] = assignment.group(2)
    return parsed_conf


def render_conf_text(guest_os: str, disk_img_path: Path, *, fixed_iso_path: Path | None,
                     disk_size: str, ram: str, cpu_cores: str) -> str:
    """The quickemu conf qvm writes for a prebuilt image: ABSOLUTE disk_img (so
    `VMDIR = dirname(disk_img)` is stable no matter where quickemu runs), no
    `iso=` (the disk is already installed - quickemu boots it directly)."""
    conf_lines: list[str] = [
        "#!/usr/bin/env quickemu --vm",
        "# Managed by qvm (roles/quickemu_vm) - prebuilt image, no installer ISO.",
        f'guest_os="{guest_os}"',
        f'disk_img="{disk_img_path}"',
    ]
    if fixed_iso_path is not None:
        conf_lines.append(f'fixed_iso="{fixed_iso_path}"')
    conf_lines.append(f'disk_size="{disk_size}"')
    if ram:
        conf_lines.append(f'ram="{ram}"')
    if cpu_cores:
        conf_lines.append(f'cpu_cores="{cpu_cores}"')
    return "\n".join(conf_lines) + "\n"


def parse_ssh_port(ports_file_text: str) -> int | None:
    """The `ssh,<port>` line quickemu writes to `<vm>.ports` at boot."""
    for ports_line in ports_file_text.splitlines():
        port_fields: list[str] = ports_line.strip().split(",")
        if len(port_fields) == 2 and port_fields[0] == "ssh" and port_fields[1].isdigit():
            return int(port_fields[1])
    return None


def parse_sha256_line(sha256_file_text: str, image_filename: str) -> str | None:
    """The `<hex>  <filename>` line matching `image_filename` from a `.sha256` file."""
    for sha256_line in sha256_file_text.splitlines():
        checksum_fields: list[str] = sha256_line.split()
        if len(checksum_fields) >= 2 and Path(checksum_fields[-1].lstrip("*")).name == image_filename:
            return checksum_fields[0].lower()
    return None


class VmRecord(NamedTuple):
    """One qvm-managed VM: its conf + VMDIR + recorded metadata."""
    vm_name: str
    conf_path: Path
    vm_dir: Path
    meta: dict[str, Any]


def choose_vm_for_cwd(vm_records: list[VmRecord], cwd: Path) -> VmRecord | None:
    """The VM whose recorded `init_at_dir` is `cwd`, else the NEAREST ancestor
    binding (deepest wins). >1 match at the same depth -> ValueError (caller
    dies with a `--name` hint). Pure; unit-tested."""
    bindings_by_dir: dict[Path, list[VmRecord]] = {}
    for vm_record in vm_records:
        recorded_init_dir: str = str(vm_record.meta.get("init_at_dir") or "")
        if recorded_init_dir:
            bindings_by_dir.setdefault(Path(recorded_init_dir), []).append(vm_record)
    for candidate_dir in (cwd, *cwd.parents):
        candidates_at_dir: list[VmRecord] = bindings_by_dir.get(candidate_dir, [])
        if len(candidates_at_dir) > 1:
            raise ValueError(
                f"multiple VMs bound to {candidate_dir}: "
                + ", ".join(candidate.vm_name for candidate in candidates_at_dir))
        if candidates_at_dir:
            return candidates_at_dir[0]
    return None


# ---------- VM registry (scan vms/) ----------


def list_vm_records() -> list[VmRecord]:
    """Every `vms/<name>.conf` + its VMDIR + qvm-meta.json (missing meta -> {},
    e.g. a conf quickget wrote that qvm has not adopted)."""
    vm_records: list[VmRecord] = []
    if not VMS_DIR.is_dir():
        return vm_records
    for conf_path in sorted(VMS_DIR.glob("*.conf")):
        vm_name: str = conf_path.stem
        vm_dir: Path = VMS_DIR / vm_name
        meta: dict[str, Any] = {}
        try:
            parsed_meta: Any = json.loads((vm_dir / QVM_META_FILENAME).read_text())
            if isinstance(parsed_meta, dict):
                meta = parsed_meta
        except (OSError, ValueError):
            pass
        vm_records.append(VmRecord(vm_name, conf_path, vm_dir, meta))
    return vm_records


def resolve_target_vm(name_flag: str | None) -> VmRecord:
    """The VM a subcommand acts on: `--name` wins; else the cwd binding."""
    vm_records: list[VmRecord] = list_vm_records()
    if name_flag:
        for vm_record in vm_records:
            if vm_record.vm_name == name_flag:
                return vm_record
        die(f"no VM named `{name_flag}` (known: "
            f"{', '.join(record.vm_name for record in vm_records) or '(none)'})")
    try:
        cwd_bound_vm: VmRecord | None = choose_vm_for_cwd(vm_records, Path.cwd())
    except ValueError as ambiguous:
        die(f"{ambiguous} - pick one with `--name <vm>`")
    if cwd_bound_vm is None:
        die("no VM bound to this directory (or its ancestors) - "
            "`qvm init <os>` here, or target one with `--name <vm>`")
    return cwd_bound_vm


def vm_pid_if_running(vm_record: VmRecord) -> int | None:
    """quickemu writes `<vm>.pid` (qemu `-pidfile`); stale files are filtered
    with a 0-signal probe."""
    try:
        qemu_pid: int = int((vm_record.vm_dir / f"{vm_record.vm_name}.pid").read_text().strip())
    except (OSError, ValueError):
        return None
    try:
        os.kill(qemu_pid, 0)
    except (ProcessLookupError, PermissionError):
        return None
    return qemu_pid


# ---------- provision resolver (reads the SHARED asset cache) ----------
# These helpers are duplicated verbatim from `ivm` BY DESIGN: each launcher is a
# standalone single-file tool that reads the SAME shared JSON (the DATA is the one
# source of truth; the resolver CODE is copied so qvm needs no ivm import). Keep
# them in sync with roles/vm_incus/files/ivm.


def load_package_groups(shared_root: Path) -> dict[str, Any]:
    """Load distro-package-groups.json (rendered at apply time from the
    provision_distro_packages registry; see roles/_shared_prebuilt_provision_assets)."""
    path: Path = shared_root / "distro-package-groups.json"
    if not path.is_file():
        die(f"distro-package-groups.json not found: {path}; re-run `make quickemu-install`")
    loaded: Any = json.loads(path.read_text())
    if not isinstance(loaded, dict):
        die(f"distro-package-groups.json is not a mapping: {path}")
    return loaded


def load_thirdparty_software(shared_root: Path) -> dict[str, Any]:
    """Load thirdparty-software.json (rendered at apply time from the
    provision_thirdparty_software registry; see roles/_shared_prebuilt_provision_assets)."""
    path: Path = shared_root / "thirdparty-software.json"
    if not path.is_file():
        die(f"thirdparty-software.json not found: {path}; re-run `make quickemu-install`")
    loaded: Any = json.loads(path.read_text())
    if not isinstance(loaded, dict):
        die(f"thirdparty-software.json is not a mapping: {path}")
    return loaded


def overlay_install_packages(overlay: Any) -> list[str]:
    """A family overlay (the `common` / `debian` / `suse` / `redhat` value of a
    distro_packages bundle) is EITHER a bare package list, OR - when that family also
    carries setup - a dict `{install: [...], post_install: <shell>}`. Return its package
    list either way."""
    if isinstance(overlay, dict):
        return list(overlay.get("install", []))
    return list(overlay or [])


def overlay_post_install(overlay: Any) -> str:
    """The optional `post_install` shell snippet of a family overlay (only its dict form
    has one). Returns "" for the bare-list form or when absent."""
    if isinstance(overlay, dict):
        return str(overlay.get("post_install", "") or "")
    return ""


def resolve_group(registry: dict[str, Any], group: str, ansible_os_family: str) -> list[str]:
    """A bundle resolves to `__common__ + <ansible_os_family overlay>` packages (same rule as
    roles/provision_distro_packages/tasks/main.yml, but for one family at a time). Each overlay is a
    bare list or a `{install, post_install}` dict - see overlay_install_packages."""
    entry: Any = registry.get(group)
    if entry is None:
        die(f"unknown distro_package_group '{group}' "
            f"(not in distro-package-groups.json; defined ones: {', '.join(sorted(registry))})")
    return overlay_install_packages(entry.get("__common__")) + overlay_install_packages(entry.get(ansible_os_family))


def group_post_install_snippet(group_entry: dict[str, Any], ansible_os_family: str) -> str:
    """Resolve a bundle's `post_install` for one family: the `__common__` overlay's snippet +
    this family overlay's snippet, ADDITIVE (__common__ runs first, the family-specific extra
    appends - so a distro needing one extra step adds it without repeating the shared part).
    `post_install` lives INSIDE each family overlay's dict form (sibling to its `install`),
    so the bundle's top level stays purely families. Returns "" when none define one."""
    parts: list[str] = [overlay_post_install(group_entry.get("__common__")),
                        overlay_post_install(group_entry.get(ansible_os_family))]
    return "\n".join(part for part in parts if part.strip())


def groups_post_install_script(groups: list[str], registry: dict[str, Any], ansible_os_family: str) -> str:
    """A distro_packages bundle MAY carry an optional `post_install` shell snippet
    (sibling to its per-family package overlays) - setup that belongs WITH its packages,
    e.g. enabling a display manager after installing it. Concatenate the resolved
    snippets of the given bundles, in order, each prefixed with an echo marker; skip
    bundles without one. Run as ROOT in the guest AFTER the packages install. Idempotent."""
    script: str = ""
    for group in groups:
        snippet: str = group_post_install_snippet(registry.get(group) or {}, ansible_os_family)
        if snippet.strip():
            script += f"echo '==> {group}: post_install' >&2\n"
            script += snippet if snippet.endswith("\n") else snippet + "\n"
    return script


# zypper is the most failure-prone of the three package managers (mirror/metadata
# hiccups); run it non-interactively (same policy as ivm).
ZYPPER: str = "zypper --non-interactive"


def install_packages_script(ansible_os_family: str, packages: list[str]) -> str:
    """Per-family install with weak-deps/recommends OFF (the apt-min/zypper-min/
    dnf-min policy, applied to provisioning)."""
    pkgs: str = " ".join(packages)
    if ansible_os_family == "Debian":
        return ("export DEBIAN_FRONTEND=noninteractive\n"
                "apt-get update -qq\n"
                f"apt-get install --yes --no-install-recommends {pkgs}\n")
    if ansible_os_family == "Suse":
        return (f"{ZYPPER} refresh\n"
                f"{ZYPPER} install --no-recommends {pkgs}\n")
    if ansible_os_family == "RedHat":
        return f"dnf install --assumeyes --setopt=install_weak_deps=False {pkgs}\n"
    die(f"no package-manager mapping for ansible_os_family '{ansible_os_family}'")


def resolve_thirdparty_software(
    names: list[str], registry: dict[str, Any], ansible_os_family: str
) -> list[dict[str, Any]]:
    """Resolve `thirdparty_software` recipe names against the registry into
    `{name, already_installed?, install_script}` recipes for THIS VM's family.
    OVERRIDE (not additive like distro groups): the family's entry if defined, else
    `__common__`."""
    recipes: list[dict[str, Any]] = []
    for name in names:
        entry: Any = registry.get(name)
        if entry is None:
            die(f"unknown thirdparty_software '{name}' (not in thirdparty-software.json; "
                f"defined: {', '.join(sorted(registry))})")
        family_recipe: Any = entry.get(ansible_os_family) or entry.get("__common__")
        if family_recipe is None:
            die(f"thirdparty_software '{name}' has no recipe for {ansible_os_family} "
                f"(needs a '{ansible_os_family}' or '__common__' entry)")
        install_script: str = family_recipe.get("install_script", "")
        if not install_script:
            die(f"thirdparty_software '{name}' ({ansible_os_family}) has no install_script")
        recipes.append({
            "name": name,
            "already_installed": family_recipe.get("already_installed"),
            "install_script": install_script,
        })
    return recipes


def thirdparty_install_script(recipes: list[dict[str, Any]]) -> str:
    """Shell (run as root in the guest) that installs each resolved recipe, guarded
    by its `already_installed` probe when present (rc 0 -> skip), so a re-run is
    idempotent. Each recipe's `install_script` is the author's verbatim shell."""
    script: str = ""
    for recipe in recipes:
        name: str = recipe["name"]
        install: str = recipe["install_script"]
        if not install.endswith("\n"):
            install += "\n"
        probe: str | None = recipe.get("already_installed")
        script += f"echo '==> thirdparty_software: {name}' >&2\n"
        if probe:
            script += (
                f"if {{ {probe}; }} >/dev/null 2>&1; then\n"
                f"  echo '    already present, skipping' >&2\n"
                "else\n"
                f"{install}"
                "fi\n"
            )
        else:
            script += install
    return script


def vm_ansible_os_family(vm_record: VmRecord) -> str:
    """The target VM's ansible_os_family, from its recorded `guest_os_label`
    (qvm-meta.json). `die`s clearly when the VM's OS has no provisioning mapping -
    e.g. a quickget passthrough OS (windows/macos) qvm cannot provision."""
    guest_os_label: str = str(vm_record.meta.get("guest_os_label") or "")
    if not guest_os_label:
        die(f"VM `{vm_record.vm_name}` has no recorded guest_os_label "
            f"(qvm-meta.json) - cannot determine how to provision it")
    family: str | None = GUEST_OS_LABEL_TO_ANSIBLE_OS_FAMILY.get(guest_os_label)
    if family is None:
        die(f"VM `{vm_record.vm_name}` runs `{guest_os_label}`, which qvm cannot provision "
            f"(no package-manager mapping; provisionable families: "
            f"{', '.join(sorted(set(GUEST_OS_LABEL_TO_ANSIBLE_OS_FAMILY.values())))}). "
            f"qvm provision targets the prebuilt Linux OSes "
            f"({', '.join(PREBUILT_OSES)}) + known quickget Linux distros, not "
            f"Windows/macOS or unrecognized passthrough OSes.")
    return family


# ---------- QEMU Guest Agent client (exec / push / pull) ----------
# Protocol: newline-delimited JSON on `<vmdir>/<vm>-agent.sock` (the chardev
# quickemu wires for --display none|spice|spice-app). guest-exec output is only
# available AFTER the process exits (no PTY/streaming - upstream-documented), so
# `exec` is batch-only; interactive work goes through `qvm shell` (SSH).


class GuestAgentError(Exception):
    pass


def guest_agent_socket_path(vm_record: VmRecord) -> Path:
    return vm_record.vm_dir / f"{vm_record.vm_name}-agent.sock"


def qga_call(agent_socket_path: Path, execute: str, arguments: dict[str, Any] | None = None,
             *, timeout_seconds: float = 10.0) -> Any:
    """One QGA command -> its `return` value. Each call opens a fresh connection
    and `guest-sync`s first (flushes any stale half-line the agent buffered), so
    responses can't get crossed between calls."""
    sync_id: int = (os.getpid() << 16) | (time.monotonic_ns() & 0xFFFF)
    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as agent_connection:
        agent_connection.settimeout(timeout_seconds)
        try:
            agent_connection.connect(str(agent_socket_path))
        except OSError as connect_error:
            raise GuestAgentError(f"cannot connect to {agent_socket_path}: {connect_error}") from None

        def send_request(request_execute: str, request_arguments: dict[str, Any] | None) -> None:
            request_document: dict[str, Any] = {"execute": request_execute}
            if request_arguments is not None:
                request_document["arguments"] = request_arguments
            agent_connection.sendall(json.dumps(request_document).encode() + b"\n")

        received_buffer: bytes = b""

        def read_response() -> Any:
            nonlocal received_buffer
            deadline: float = time.monotonic() + timeout_seconds
            while True:
                newline_position: int = received_buffer.find(b"\n")
                if newline_position >= 0:
                    response_line: bytes = received_buffer[:newline_position]
                    received_buffer = received_buffer[newline_position + 1:]
                    if not response_line.strip():
                        continue
                    response_document: Any = json.loads(response_line)
                    if isinstance(response_document, dict) and "error" in response_document:
                        error_description: str = str(
                            (response_document["error"] or {}).get("desc", response_document["error"]))
                        raise GuestAgentError(f"{execute}: {error_description}")
                    if isinstance(response_document, dict) and "return" in response_document:
                        return response_document["return"]
                    continue  # events etc. - not ours, keep reading
                if time.monotonic() > deadline:
                    raise GuestAgentError(f"{execute}: timed out after {timeout_seconds}s")
                try:
                    received_chunk: bytes = agent_connection.recv(65536)
                except TimeoutError:
                    raise GuestAgentError(f"{execute}: timed out after {timeout_seconds}s") from None
                if not received_chunk:
                    raise GuestAgentError(f"{execute}: agent closed the connection")
                received_buffer += received_chunk

        # guest-sync: skip everything until the echoed id comes back.
        send_request("guest-sync", {"id": sync_id})
        while True:
            sync_reply: Any = read_response()
            if sync_reply == sync_id:
                break
        send_request(execute, arguments)
        return read_response()


def qga_call_or_die(vm_record: VmRecord, execute: str, arguments: dict[str, Any] | None = None,
                    *, timeout_seconds: float = 10.0) -> Any:
    """`qga_call` with the human diagnosis attached (VM down? agent not installed
    yet? cloud-init still installing it on first boot?)."""
    if vm_pid_if_running(vm_record) is None:
        die(f"VM `{vm_record.vm_name}` is not running - `qvm start` first")
    try:
        return qga_call(guest_agent_socket_path(vm_record), execute, arguments,
                        timeout_seconds=timeout_seconds)
    except GuestAgentError as agent_error:
        die(f"guest agent unreachable ({agent_error}).\n"
            "  Likely causes: the guest is still booting; `qemu-guest-agent` is not\n"
            "  installed/running in the guest (tumbleweed installs it via cloud-init on\n"
            "  FIRST boot - give it a minute); or the VM was started without\n"
            "  --display none/spice. Interactive fallback: `qvm shell` (SSH).")


def qga_guest_exec_wait(vm_record: VmRecord, guest_argv: list[str]) -> dict[str, Any]:
    """guest-exec `guest_argv` (root) then poll guest-exec-status until it exits;
    return the final status dict (carries exitcode + base64 out/err-data). Batch
    semantics - output arrives only after exit (QGA has no PTY/streaming). Shared
    by `cmd_exec` (CLI passthrough) and `qga_run_script` (provisioning)."""
    started: Any = qga_call_or_die(vm_record, "guest-exec", {
        "path": guest_argv[0], "arg": guest_argv[1:], "capture-output": "separated"})
    guest_pid: int = int(started["pid"])
    while True:
        execution_status: Any = qga_call_or_die(vm_record, "guest-exec-status", {"pid": guest_pid})
        if execution_status.get("exited"):
            return execution_status
        time.sleep(0.3)


def write_guest_exec_output(execution_status: dict[str, Any]) -> None:
    """Stream a finished guest-exec's captured stdout/stderr to ours + warn on the
    agent's size-cap truncation."""
    sys.stdout.write(base64.b64decode(execution_status.get("out-data", "")).decode(errors="replace"))
    sys.stderr.write(base64.b64decode(execution_status.get("err-data", "")).decode(errors="replace"))
    for truncated_stream_key in ("out-truncated", "err-truncated"):
        if execution_status.get(truncated_stream_key):
            print(f"qvm: warning: {truncated_stream_key} - output hit the agent's size cap; "
                  "write to a guest file and `qvm pull` it instead", file=sys.stderr)


def cmd_exec(vm_record: VmRecord, guest_argv: list[str]) -> NoReturn:
    """Run a command in the guest via QGA guest-exec (root, no SSH, no
    credentials). Batch semantics: stdout/stderr arrive only after exit."""
    if not guest_argv:
        die("exec needs a command, e.g. `qvm exec -- uname -a`")
    print(f"+ (guest-exec) {shlex.join(guest_argv)}", file=sys.stderr)
    execution_status: dict[str, Any] = qga_guest_exec_wait(vm_record, guest_argv)
    write_guest_exec_output(execution_status)
    raise SystemExit(int(execution_status.get("exitcode", 1)))


def qga_run_script(vm_record: VmRecord, script_text: str, *, dry_run: bool) -> None:
    """Run `bash -ec <script_text>` in the guest as ROOT via QGA (the provisioning
    equivalent of ivm's `incus exec <vm> -- bash -ec <script>`). Streams the script's
    stdout/stderr and `die`s on a non-zero exit. Reusable - does NOT raise SystemExit
    on success. Honors dry_run (prints the bash invocation it would run)."""
    bash_argv: list[str] = ["bash", "-ec", script_text]
    print(f"+ (guest-exec) {shlex.join(bash_argv)}", file=sys.stderr)
    if dry_run:
        return
    execution_status: dict[str, Any] = qga_guest_exec_wait(vm_record, bash_argv)
    write_guest_exec_output(execution_status)
    exit_code: int = int(execution_status.get("exitcode", 1))
    if exit_code != 0:
        die(f"provisioning script failed in `{vm_record.vm_name}` (exit {exit_code})")


QGA_FILE_CHUNK_BYTES: int = 1024 * 1024


def cmd_push(vm_record: VmRecord, local_path_argument: str, guest_path: str) -> None:
    """Copy ONE local file into the guest via QGA guest-file-write (as root)."""
    local_file_path: Path = Path(local_path_argument)
    if not local_file_path.is_file():
        die(f"`{local_file_path}` is not a regular file (qvm push handles single files)")
    print(f"+ (guest-file) push {local_file_path} -> {guest_path}", file=sys.stderr)
    guest_file_handle: Any = qga_call_or_die(vm_record, "guest-file-open",
                                             {"path": guest_path, "mode": "wb"})
    try:
        with open(local_file_path, "rb") as local_file:
            while True:
                file_chunk: bytes = local_file.read(QGA_FILE_CHUNK_BYTES)
                if not file_chunk:
                    break
                qga_call_or_die(vm_record, "guest-file-write", {
                    "handle": guest_file_handle,
                    "buf-b64": base64.b64encode(file_chunk).decode()})
    finally:
        qga_call_or_die(vm_record, "guest-file-close", {"handle": guest_file_handle})
    print(f"==> pushed to {colorize_vm_name(vm_record.vm_name)}:{guest_path}", file=sys.stderr)


def cmd_pull(vm_record: VmRecord, guest_path: str, local_path_argument: str) -> None:
    """Copy ONE guest file out via QGA guest-file-read."""
    local_file_path: Path = Path(local_path_argument)
    print(f"+ (guest-file) pull {guest_path} -> {local_file_path}", file=sys.stderr)
    guest_file_handle: Any = qga_call_or_die(vm_record, "guest-file-open",
                                             {"path": guest_path, "mode": "rb"})
    try:
        with open(local_file_path, "wb") as local_file:
            while True:
                read_reply: Any = qga_call_or_die(vm_record, "guest-file-read", {
                    "handle": guest_file_handle, "count": QGA_FILE_CHUNK_BYTES})
                local_file.write(base64.b64decode(read_reply.get("buf-b64", "")))
                if read_reply.get("eof"):
                    break
    finally:
        qga_call_or_die(vm_record, "guest-file-close", {"handle": guest_file_handle})
    print(f"==> pulled from {colorize_vm_name(vm_record.vm_name)}:{guest_path}", file=sys.stderr)


def qga_push_file_bytes(vm_record: VmRecord, file_bytes: bytes, guest_path: str) -> None:
    """Write `file_bytes` to `guest_path` in the guest via guest-file-open/write/close
    (as root). Like `cmd_push` but from an in-memory blob (the parent dir must already
    exist - qga_push_tree mkdir -p's it first)."""
    guest_file_handle: Any = qga_call_or_die(vm_record, "guest-file-open",
                                             {"path": guest_path, "mode": "wb"})
    try:
        for chunk_start in range(0, len(file_bytes) or 1, QGA_FILE_CHUNK_BYTES):
            file_chunk: bytes = file_bytes[chunk_start:chunk_start + QGA_FILE_CHUNK_BYTES]
            qga_call_or_die(vm_record, "guest-file-write", {
                "handle": guest_file_handle,
                "buf-b64": base64.b64encode(file_chunk).decode()})
    finally:
        qga_call_or_die(vm_record, "guest-file-close", {"handle": guest_file_handle})


def qga_push_tree(vm_record: VmRecord, local_dir: Path, guest_dest_dir: str,
                  *, uid: int, gid: int, dry_run: bool) -> None:
    """Recursively push `local_dir`'s contents into `guest_dest_dir` over QGA (qvm
    has no `incus file push --recursive`, so this builds it). For each file: mkdir -p
    its guest parent dir (guest-exec), then guest-file-write the bytes. Ownership is
    fixed ONCE at the end with `chown -R uid:gid <guest_dest_dir>` (simplest correct
    approach - every written file/dir lands root-owned otherwise). The contents of
    `local_dir` land DIRECTLY under `guest_dest_dir` (i.e. `<local_dir>/a/b` ->
    `<guest_dest_dir>/a/b`)."""
    local_files: list[Path] = sorted(p for p in local_dir.rglob("*") if p.is_file())
    if not local_files:
        return
    for local_file in local_files:
        relative_path: str = local_file.relative_to(local_dir).as_posix()
        guest_file_path: str = f"{guest_dest_dir.rstrip('/')}/{relative_path}"
        guest_parent_dir: str = str(Path(guest_file_path).parent)
        print(f"+ (guest-file) push tree {local_file} -> {guest_file_path}", file=sys.stderr)
        if dry_run:
            continue
        mkdir_status: dict[str, Any] = qga_guest_exec_wait(
            vm_record, ["mkdir", "-p", guest_parent_dir])
        if int(mkdir_status.get("exitcode", 1)) != 0:
            die(f"mkdir -p {guest_parent_dir} failed in `{vm_record.vm_name}`")
        qga_push_file_bytes(vm_record, local_file.read_bytes(), guest_file_path)
    chown_argv: list[str] = ["chown", "-R", f"{uid}:{gid}", guest_dest_dir]
    print(f"+ (guest-exec) {shlex.join(chown_argv)}", file=sys.stderr)
    if dry_run:
        return
    chown_status: dict[str, Any] = qga_guest_exec_wait(vm_record, chown_argv)
    if int(chown_status.get("exitcode", 1)) != 0:
        die(f"chown -R {uid}:{gid} {guest_dest_dir} failed in `{vm_record.vm_name}`")


def push_feature_dotfiles_qga(feature: str, ansible_os_family: str, vm_record: VmRecord,
                              shared_root: Path, *, dry_run: bool) -> None:
    """Push one feature's staged dotfiles into the guest over QGA: the `__common__`
    bucket then the VM's `<ansible_os_family>` bucket (distro overlays common), each
    with its `home/user` (uid/gid 1000) + `root` (uid/gid 0) side. Buckets/sides a
    feature does not populate are skipped. Source:
    `<shared_root>/dotfiles/<feature>/<bucket>/<who>/`. The `home/user` side lands at
    /home/user/...; the `root` side at /root/... (mirror of ivm's
    push_feature_dotfiles_commands, but file-by-file via the guest agent)."""
    feature_dir: Path = shared_root / "dotfiles" / feature
    for bucket in ("__common__", ansible_os_family):
        user_side: Path = feature_dir / bucket / "home" / "user"
        root_side: Path = feature_dir / bucket / "root"
        if user_side.is_dir():
            qga_push_tree(vm_record, user_side, "/home/user", uid=1000, gid=1000, dry_run=dry_run)
        if root_side.is_dir():
            qga_push_tree(vm_record, root_side, "/root", uid=0, gid=0, dry_run=dry_run)


# ---------- provision (install bundles / recipes / dotfiles onto a VM) ----------


def cmd_list_provision_units(shared_root: Path) -> None:
    """List the installable units (name + `description`), grouped by kind - shown when
    `qvm provision` runs with NO unit arg (the bash-friendly alternative to <TAB>). No VM
    needed - this is just the registry. Prints to stdout (readable / pipeable)."""
    distro: dict[str, Any] = load_package_groups(shared_root)
    thirdparty: dict[str, Any] = load_thirdparty_software(shared_root)
    dotfiles_root: Path = shared_root / "dotfiles"
    dotfiles: list[str] = sorted(p.name for p in dotfiles_root.iterdir()) if dotfiles_root.is_dir() else []

    def described_rows(registry: dict[str, Any]) -> list[str]:
        names: list[str] = sorted(registry)
        width: int = max((len(n) for n in names), default=0)
        rows: list[str] = []
        for n in names:
            desc: str = registry[n].get("description", "") if isinstance(registry[n], dict) else ""
            rows.append(f"    {n:<{width}}  {desc}" if desc else f"    {n}")
        return rows

    print("Provisionable units - run `qvm provision <unit>...` (a name may match more than one):\n")
    print("  distro package bundles:")
    print("\n".join(described_rows(distro)))
    print("\n  thirdparty software:")
    print("\n".join(described_rows(thirdparty)))
    print("\n  dotfiles features:")
    print(("    " + ", ".join(dotfiles)) if dotfiles else "    (none)")


# Marker every launcher (ivm/qvm/pvm) drops into its guest so the shared shell dotfiles
# can badge the prompt. Its CONTENTS are this launcher's id; the shared PS1 snippet
# (`roles/_shared_j2_snippets/templates/{zsh,bash}_ps1_*.j2`) reads it and prefixes the
# prompt with one box glyph per isolation level (full VM = 3, container = 1). The host
# runs the SAME dotfiles but has no marker, so its prompt is unchanged.
MANAGED_GUEST_TYPE_MARKER_PATH: str = "/etc/ansible-managed-guest-type"
GUEST_TYPE: str = "qvm"


def guest_type_marker_script() -> str:
    """Shell (run as root in the guest) writing this launcher's id (the `GUEST_TYPE`
    constant) to `MANAGED_GUEST_TYPE_MARKER_PATH`, the marker the shared PS1 snippet keys
    its box-glyph prompt prefix off. Idempotent (truncating write)."""
    return (
        f"echo '==> managed-guest marker: {MANAGED_GUEST_TYPE_MARKER_PATH} ({GUEST_TYPE})' >&2\n"
        f"printf '%s\\n' {GUEST_TYPE} > {MANAGED_GUEST_TYPE_MARKER_PATH}\n"
    )


def cmd_provision(vm_record: VmRecord, unit_names: list[str], shared_root: Path,
                  *, dry_run: bool) -> None:
    """Install named units onto an EXISTING VM via the QEMU Guest Agent - the post-`init`
    "add more software" path (the qvm twin of `ivm provision`). A name can be a
    `distro_package_groups` bundle, a `thirdparty_software` recipe, AND/OR a dotfiles
    feature - all that match are applied. Distro bundles install via the VM's package
    manager, thirdparty recipes run their (probe-guarded) script as root, dotfiles
    features are pushed into /home/user (+ /root). Idempotent. With NO unit args the
    caller lists the registry instead (handled before VM resolution)."""
    distro_registry: dict[str, Any] = load_package_groups(shared_root)
    thirdparty_registry: dict[str, Any] = load_thirdparty_software(shared_root)
    dotfiles_root: Path = shared_root / "dotfiles"
    distro_bundles: list[str] = []
    thirdparty_names: list[str] = []
    dotfiles_features: list[str] = []
    for unit in unit_names:
        matched: bool = False
        if unit in distro_registry:
            distro_bundles.append(unit)
            matched = True
        if unit in thirdparty_registry:
            thirdparty_names.append(unit)
            matched = True
        if (dotfiles_root / unit).is_dir():
            dotfiles_features.append(unit)
            matched = True
        if not matched:
            available_features: list[str] = (
                sorted(p.name for p in dotfiles_root.iterdir()) if dotfiles_root.is_dir() else [])
            die(f"unknown unit '{unit}' - not a distro_package_groups bundle, a "
                f"thirdparty_software recipe, nor a dotfiles feature.\n"
                f"  distro bundles:      {', '.join(sorted(distro_registry))}\n"
                f"  thirdparty software: {', '.join(sorted(thirdparty_registry))}\n"
                f"  dotfiles features:   {', '.join(available_features)}")
    ansible_os_family: str = vm_ansible_os_family(vm_record)
    # Always (re)write the managed-guest marker so the shared PS1 snippet can badge the
    # prompt; `script` is therefore never empty, so the qga_run_script below always runs.
    script: str = guest_type_marker_script()
    if distro_bundles:
        packages: list[str] = []
        for bundle in distro_bundles:
            packages += resolve_group(distro_registry, bundle, ansible_os_family)
        packages = list(dict.fromkeys(packages))
        if packages:
            script += install_packages_script(ansible_os_family, packages)
        script += groups_post_install_script(distro_bundles, distro_registry, ansible_os_family)
    if thirdparty_names:
        script += thirdparty_install_script(
            resolve_thirdparty_software(thirdparty_names, thirdparty_registry, ansible_os_family))
    if script:
        qga_run_script(vm_record, script, dry_run=dry_run)
    for feature in dotfiles_features:
        push_feature_dotfiles_qga(feature, ansible_os_family, vm_record, shared_root, dry_run=dry_run)
    print(f"==> provisioned {', '.join(unit_names)} into {colorize_vm_name(vm_record.vm_name)}.",
          file=sys.stderr)


# ---------- init: prebuilt images (the no-interactive-install paths) ----------


def fetch_url_to_file(image_url: str, destination_path: Path) -> None:
    """Fetch a SMALL file (a checksum / signature) to disk, with a read timeout."""
    with urllib.request.urlopen(image_url, timeout=DOWNLOAD_TIMEOUT_SECONDS) as url_response:
        destination_path.write_bytes(url_response.read())


def gpg_verify_image_checksum(image_url: str, signing_keyring: Path, *, into_dir: Path) -> str:
    """Download `<image_url>.sha256` + `.sha256.asc`, GPG-verify the detached
    signature against `signing_keyring`, and return the (now authenticated)
    checksum file's text. HARD error - not a silent downgrade - if the keyring or
    `gpg` is missing, or the signature does not verify; `--no-gpg-verify` is the
    only opt-out (fail-loud rule)."""
    if not signing_keyring.exists():
        die(f"GPG keyring {signing_keyring} not found - run the trusted_pubkeys role to\n"
            f"  pin the openSUSE signing key, or pass `--no-gpg-verify` for sha256-only.")
    if shutil.which("gpg") is None:
        die("gpg not found - install gnupg (e.g. `sudo zypper install gpg2` /\n"
            "  `sudo apt install gnupg`), or pass `--no-gpg-verify` for sha256-only.")
    image_filename: str = Path(image_url).name
    checksum_path: Path = into_dir / f"{image_filename}.sha256"
    signature_path: Path = into_dir / f"{image_filename}.sha256.asc"
    fetch_url_to_file(f"{image_url}.sha256", checksum_path)
    fetch_url_to_file(f"{image_url}.sha256.asc", signature_path)
    gpg_verify_argv: list[str] = [
        "gpg", "--no-default-keyring", "--keyring", str(signing_keyring),
        "--verify", str(signature_path), str(checksum_path),
    ]
    print("+ " + shlex.join(gpg_verify_argv), file=sys.stderr)
    returncode, _, gpg_stderr = run_capture(gpg_verify_argv)
    if returncode != 0:
        die(f"GPG verification of {image_url}.sha256 FAILED - the checksum is NOT signed by\n"
            f"  the pinned openSUSE key. Refusing the download.\n{gpg_stderr.strip()}")
    print(f"==> GPG-verified {image_filename}.sha256 against {signing_keyring.name}", file=sys.stderr)
    return checksum_path.read_text()


def warn_if_cached_image_stale(cached_image_path: Path) -> None:
    """Tumbleweed is rolling, so a long-cached base image may be far behind. Warn
    (never auto-delete) and print the exact `rm` to refresh it."""
    age_days: float = (time.time() - cached_image_path.stat().st_mtime) / 86400
    if age_days < IMAGE_CACHE_STALE_DAYS:
        return
    print(f"qvm: warning: cached image is ~{int(age_days)} days old "
          f"(> {IMAGE_CACHE_STALE_DAYS}d) and may be stale. To refresh, delete it then re-init:",
          file=sys.stderr)
    print(f"  rm {shlex.quote(str(cached_image_path))}", file=sys.stderr)


def download_with_cache(image_url: str, *, signing_keyring: Path | None, dry_run: bool) -> Path:
    """Download `image_url` into the cache (printed first - transparency for
    outside-repo fetches). When `signing_keyring` is given, GPG-verify the
    publisher's `.sha256.asc` against it BEFORE trusting the checksum (then verify
    the image's sha256); when None, fall back to sha256-only. A cached copy is
    reused as-is: Tumbleweed is rolling, so the REMOTE checksum changes over time
    and would false-fail a re-verify; delete the cache file to re-download."""
    cached_image_path: Path = IMAGE_CACHE_DIR / Path(image_url).name
    if cached_image_path.exists():
        warn_if_cached_image_stale(cached_image_path)
        print(f"==> using cached {cached_image_path} (delete it to re-download)", file=sys.stderr)
        return cached_image_path
    IMAGE_CACHE_DIR.mkdir(parents=True, exist_ok=True)
    print(f"+ GET {image_url}", file=sys.stderr)
    print(f"+ GET {image_url}.sha256", file=sys.stderr)
    if signing_keyring is not None:
        print(f"+ GET {image_url}.sha256.asc", file=sys.stderr)
    if dry_run:
        return cached_image_path
    if signing_keyring is not None:
        checksum_text: str = gpg_verify_image_checksum(
            image_url, signing_keyring, into_dir=IMAGE_CACHE_DIR)
    else:
        with urllib.request.urlopen(f"{image_url}.sha256",
                                    timeout=DOWNLOAD_TIMEOUT_SECONDS) as sha256_response:
            checksum_text = sha256_response.read().decode()
    published_sha256: str | None = parse_sha256_line(checksum_text, cached_image_path.name)
    if not published_sha256:
        die(f"no checksum for {cached_image_path.name} in {image_url}.sha256")
    download_in_progress_path: Path = cached_image_path.with_suffix(".partial")
    image_digest = hashlib.sha256()
    try:
        with urllib.request.urlopen(image_url, timeout=DOWNLOAD_TIMEOUT_SECONDS) as image_response, \
                open(download_in_progress_path, "wb") as partial_file:
            while True:
                downloaded_chunk: bytes = image_response.read(QGA_FILE_CHUNK_BYTES)
                if not downloaded_chunk:
                    break
                image_digest.update(downloaded_chunk)
                partial_file.write(downloaded_chunk)
    except (urllib.error.URLError, TimeoutError) as download_error:
        download_in_progress_path.unlink(missing_ok=True)
        die(f"download of {image_url} failed or stalled "
            f"(>{DOWNLOAD_TIMEOUT_SECONDS}s per read): {download_error}")
    if image_digest.hexdigest().lower() != published_sha256:
        download_in_progress_path.unlink()
        die(f"sha256 MISMATCH for {image_url}\n"
            f"  expected {published_sha256}\n  got      {image_digest.hexdigest()}")
    download_in_progress_path.rename(cached_image_path)
    verification_method: str = "gpg + sha256" if signing_keyring is not None else "sha256"
    print(f"==> downloaded + {verification_method}-verified {cached_image_path}", file=sys.stderr)
    return cached_image_path


def generate_vm_ssh_keypair(vm_dir: Path, *, dry_run: bool) -> Path:
    """Per-VM ed25519 keypair (no passphrase) - `shell` uses it; nothing from the
    host's own ~/.ssh is reused. Returns the PUBLIC key path."""
    ssh_key_path: Path = vm_dir / "ssh" / "id_ed25519"
    if not dry_run:
        ssh_key_path.parent.mkdir(parents=True, exist_ok=True)
    run(["ssh-keygen", "-t", "ed25519", "-N", "", "-C", f"qvm-{vm_dir.name}",
         "-f", str(ssh_key_path)], dry_run=dry_run)
    return ssh_key_path.with_suffix(".pub")


def render_cloud_init_user_data(vm_name: str, ssh_public_key_line: str) -> str:
    """NoCloud user-data for the Tumbleweed cloud image: create the login user
    (key-only, passwordless sudo) and install+enable qemu-guest-agent on first
    boot - that closes the chicken-and-egg for `qvm exec`."""
    return "\n".join([
        "#cloud-config",
        f"hostname: {vm_name}",
        "users:",
        f"  - name: {TUMBLEWEED_SSH_USER}",
        '    sudo: "ALL=(ALL) NOPASSWD:ALL"',
        "    shell: /bin/bash",
        "    lock_passwd: true",
        "    ssh_authorized_keys:",
        f"      - {ssh_public_key_line}",
        "packages:",
        "  - qemu-guest-agent",
        "runcmd:",
        "  - [systemctl, enable, --now, qemu-guest-agent]",
        "",
    ])


def find_seed_iso_tool() -> list[str]:
    """The ISO-9660 writer to build the cidata seed with, as the argv PREFIX
    (xorriso needs its mkisofs emulation flag)."""
    if shutil.which("xorriso"):
        return ["xorriso", "-as", "mkisofs"]
    for mkisofs_compatible_tool in ("genisoimage", "mkisofs"):
        if shutil.which(mkisofs_compatible_tool):
            return [mkisofs_compatible_tool]
    die("need xorriso / genisoimage / mkisofs to build the cloud-init seed ISO "
        "(the role installs xorriso; or install one manually)")


def build_seed_iso(vm_dir: Path, vm_name: str, ssh_public_key_path: Path, *, dry_run: bool) -> Path:
    """The NoCloud seed: a tiny ISO labeled `cidata` holding user-data +
    meta-data; attached via the conf's `fixed_iso` (a plain CD-ROM to quickemu)."""
    seed_content_dir: Path = vm_dir / "seed"
    seed_iso_path: Path = vm_dir / "seed.iso"
    if not dry_run:
        seed_content_dir.mkdir(parents=True, exist_ok=True)
        ssh_public_key_line: str = ssh_public_key_path.read_text().strip()
        (seed_content_dir / "user-data").write_text(
            render_cloud_init_user_data(vm_name, ssh_public_key_line))
        (seed_content_dir / "meta-data").write_text(
            f"instance-id: qvm-{vm_name}\nlocal-hostname: {vm_name}\n")
    run([*find_seed_iso_tool(), "-volid", "cidata", "-joliet", "-rock",
         "-o", str(seed_iso_path), str(seed_content_dir)], dry_run=dry_run)
    return seed_iso_path


def init_tumbleweed_disk(vm_dir: Path, vm_name: str, disk_size: str, *,
                         signing_keyring: Path | None, dry_run: bool) -> Path | None:
    """Tumbleweed: official Minimal-VM Cloud qcow2 -> disk.qcow2 (+resize) + the
    cloud-init seed ISO. Returns the seed ISO path (becomes `fixed_iso`)."""
    cached_image_path: Path = download_with_cache(
        TUMBLEWEED_CLOUD_QCOW2_URL, signing_keyring=signing_keyring, dry_run=dry_run)
    disk_image_path: Path = vm_dir / "disk.qcow2"
    print(f"+ cp {cached_image_path} {disk_image_path}", file=sys.stderr)
    if not dry_run:
        shutil.copyfile(cached_image_path, disk_image_path)
    run(["qemu-img", "resize", str(disk_image_path), disk_size], dry_run=dry_run)
    ssh_public_key_path: Path = generate_vm_ssh_keypair(vm_dir, dry_run=dry_run)
    return build_seed_iso(vm_dir, vm_name, ssh_public_key_path, dry_run=dry_run)


def init_virt_builder_disk(vm_dir: Path, vm_name: str, guest_os_label: str, disk_size: str, *,
                           dry_run: bool) -> Path | None:
    """Debian/Fedora: `virt-builder` (GPG-verified prebuilt image). qemu-guest-agent
    + sshd installed INTO the image; the per-VM key goes on root. virt-builder's
    default random root password is printed on ITS stdout (console fallback)."""
    ssh_public_key_path: Path = generate_vm_ssh_keypair(vm_dir, dry_run=dry_run)
    virt_builder_argv: list[str] = [
        "virt-builder", VIRT_BUILDER_IMAGE_BY_OS[guest_os_label],
        "--output", str(vm_dir / "disk.qcow2"), "--format", "qcow2",
        "--size", disk_size, "--hostname", vm_name,
        "--install", "qemu-guest-agent,openssh-server",
        "--firstboot-command", "systemctl enable --now qemu-guest-agent sshd",
        "--ssh-inject", f"{VIRT_BUILDER_SSH_USER}:file:{ssh_public_key_path}",
    ]
    if guest_os_label == "fedora":
        virt_builder_argv.append("--selinux-relabel")  # key/agent files need correct labels
    run(virt_builder_argv, dry_run=dry_run)
    return None  # no seed ISO on this path


def cmd_init(os_arguments: list[str], *, disk_size: str, ram: str,
             cpu_cores: str, assume_yes: bool, provision_units: list[str] | None,
             gpg_verify: bool, shared_assets_root: Path, dry_run: bool) -> None:
    """Create a VM: prebuilt path for tumbleweed/debian/fedora (zero interactive
    install; optional 2nd positional = VM name), `quickget` passthrough for
    everything else (Windows is unattended; most Linux ISOs are interactive
    ONCE - keep the installed disk around). `--provision <unit>...` (prebuilt OS
    only): after the VM boots and its agent is reachable, install those units."""
    if not os_arguments:
        die(f"init needs an OS: one of {', '.join(PREBUILT_OSES)} (prebuilt, no installer), "
            "or any `quickget` OS (e.g. `qvm init windows 11`)")
    guest_os_label: str = os_arguments[0]
    if guest_os_label not in PREBUILT_OSES:
        if provision_units is not None:
            die("`--provision` is only supported for the prebuilt OSes "
                f"({', '.join(PREBUILT_OSES)}); a quickget VM needs an interactive "
                "install first, then `qvm provision` once it is up")
        init_via_quickget(os_arguments, assume_yes=assume_yes, dry_run=dry_run)
        return
    if len(os_arguments) > 2:
        die(f"`qvm init {guest_os_label}` takes at most a VM name after the OS "
            f"(got: {os_arguments[1:]})")
    vm_name: str = os_arguments[1] if len(os_arguments) == 2 else guest_os_label
    if not VM_NAME_RE.match(vm_name):
        die(f"bad VM name `{vm_name}` (want: alnum start, then [a-zA-Z0-9_-], <=63 chars)")
    conf_path: Path = VMS_DIR / f"{vm_name}.conf"
    vm_dir: Path = VMS_DIR / vm_name
    if conf_path.exists() or vm_dir.exists():
        die(f"VM `{vm_name}` already exists ({conf_path}) - pick another --name or `qvm delete` it")
    ssh_user: str = TUMBLEWEED_SSH_USER if guest_os_label == "tumbleweed" else VIRT_BUILDER_SSH_USER
    image_source_description: str = (
        f"{TUMBLEWEED_CLOUD_QCOW2_URL} ({'GPG+sha256' if gpg_verify else 'sha256-ONLY'} verified)"
        if guest_os_label == "tumbleweed"
        else f"virt-builder {VIRT_BUILDER_IMAGE_BY_OS[guest_os_label]} (GPG-verified)")
    print("\n".join([
        "qvm init preview:",
        f"  name        {vm_name}",
        f"  os          {guest_os_label} (prebuilt - NO interactive install)",
        f"  image from  {image_source_description}",
        f"  disk        {vm_dir}/disk.qcow2  (size {disk_size})",
        f"  conf        {conf_path}" + (f"  (ram {ram})" if ram else ""),
        f"  ssh user    {ssh_user} (per-VM key in {vm_dir}/ssh/)",
        f"  bound to    {Path.cwd()}  (subcommands here resolve to this VM)",
    ]), file=sys.stderr)
    confirm_or_die("proceed?", assume_yes=assume_yes)
    if not dry_run:
        vm_dir.mkdir(parents=True, exist_ok=True)
    if guest_os_label == "tumbleweed":
        signing_keyring: Path | None = OPENSUSE_SIGNING_KEYRING if gpg_verify else None
        seed_iso_path: Path | None = init_tumbleweed_disk(
            vm_dir, vm_name, disk_size, signing_keyring=signing_keyring, dry_run=dry_run)
    else:
        seed_iso_path = init_virt_builder_disk(vm_dir, vm_name, guest_os_label, disk_size,
                                               dry_run=dry_run)
    conf_text: str = render_conf_text("linux", vm_dir / "disk.qcow2",
                                      fixed_iso_path=seed_iso_path, disk_size=disk_size,
                                      ram=ram, cpu_cores=cpu_cores)
    print(f"+ write {conf_path}", file=sys.stderr)
    if not dry_run:
        conf_path.write_text(conf_text)
        write_vm_meta(vm_dir, vm_name, guest_os_label, ssh_user)
    if provision_units is not None:
        init_provision_after_boot(vm_name, provision_units, shared_assets_root, dry_run=dry_run)
        return
    print("\n".join([
        f"==> {colorize_vm_name(vm_name)} created. Next:",
        "",
        "    qvm start",
        "",
        "  then `qvm exec -- uname -a` (guest agent; tumbleweed installs the agent on",
        "  FIRST boot via cloud-init - allow a minute) or `qvm shell` (SSH).",
    ]), file=sys.stderr)


# How long to wait for the guest agent after `init --provision` starts the VM.
# Tumbleweed installs qemu-guest-agent via cloud-init on FIRST boot (download +
# install + enable), so the wait is generous.
INIT_PROVISION_AGENT_TIMEOUT_SECONDS: float = 300.0


def wait_for_guest_agent(vm_record: VmRecord, *, timeout_seconds: float) -> None:
    """Block until the guest agent answers a `guest-ping`, or `die` on timeout. Used
    by `init --provision` (the agent needs the VM running AND - on tumbleweed's first
    boot - cloud-init to have installed+started qemu-guest-agent)."""
    deadline: float = time.monotonic() + timeout_seconds
    agent_socket_path: Path = guest_agent_socket_path(vm_record)
    while time.monotonic() < deadline:
        if vm_pid_if_running(vm_record) is None:
            die(f"VM `{vm_record.vm_name}` is no longer running while waiting for its agent")
        try:
            qga_call(agent_socket_path, "guest-ping", timeout_seconds=5.0)
            return
        except GuestAgentError:
            time.sleep(3.0)
    die(f"guest agent on `{vm_record.vm_name}` not reachable within "
        f"{int(timeout_seconds)}s (tumbleweed installs it via cloud-init on first "
        f"boot - try `qvm provision ...` again in a minute)")


def init_provision_after_boot(vm_name: str, provision_units: list[str], shared_assets_root: Path,
                              *, dry_run: bool) -> None:
    """`init --provision`: start the freshly-created VM headless, wait for its guest
    agent, then run the provisioning. Best-effort + clearly reported (provisioning
    failures `die` loudly; the VM itself is already created)."""
    vm_record: VmRecord | None = next(
        (record for record in list_vm_records() if record.vm_name == vm_name), None)
    if vm_record is None:
        if dry_run:
            print(f"==> (dry-run) would start {colorize_vm_name(vm_name)}, wait for its agent, "
                  f"then provision {provision_units or '(list)'}", file=sys.stderr)
            return
        die(f"could not find the just-created VM `{vm_name}` to provision it")
    print(f"==> {colorize_vm_name(vm_name)} created; starting it to provision "
          f"{provision_units or '(none - will list)'}", file=sys.stderr)
    cmd_start(vm_record, gui=False, public_dir=None, dry_run=dry_run)
    if not provision_units:
        cmd_list_provision_units(shared_assets_root)
        return
    if not dry_run:
        print("==> waiting for the guest agent (first boot can take a few minutes "
              "while cloud-init installs it)...", file=sys.stderr)
        wait_for_guest_agent(vm_record, timeout_seconds=INIT_PROVISION_AGENT_TIMEOUT_SECONDS)
    cmd_provision(vm_record, provision_units, shared_assets_root, dry_run=dry_run)


def write_vm_meta(vm_dir: Path, vm_name: str, guest_os_label: str, ssh_user: str) -> None:
    (vm_dir / QVM_META_FILENAME).write_text(json.dumps({
        "vm_name": vm_name,
        "guest_os_label": guest_os_label,
        "ssh_user": ssh_user,
        "init_at_dir": str(Path.cwd()),
    }, indent=2) + "\n")


def init_via_quickget(quickget_arguments: list[str], *, assume_yes: bool, dry_run: bool) -> None:
    """Anything qvm has no prebuilt path for: hand to `quickget` verbatim (it
    downloads installer media + writes the conf; Windows install is unattended,
    most others are interactive ONCE). The new conf is then adopted: meta written
    so cwd binding + `qvm start/...` work on it."""
    if shutil.which("quickget") is None:
        die("`quickget` not found - install quickemu (Debian 13+/Fedora 41+: official "
            "repo; openSUSE: not packaged, install manually)")
    confirm_or_die(f"run `quickget {shlex.join(quickget_arguments)}` under {VMS_DIR}?",
                   assume_yes=assume_yes)
    if not dry_run:
        VMS_DIR.mkdir(parents=True, exist_ok=True)
    conf_paths_before: set[Path] = set(VMS_DIR.glob("*.conf"))
    run(["quickget", *quickget_arguments], dry_run=dry_run, cwd=VMS_DIR)
    if dry_run:
        return
    newly_written_confs: list[Path] = sorted(set(VMS_DIR.glob("*.conf")) - conf_paths_before)
    if not newly_written_confs:
        die("quickget wrote no new .conf - see its output above")
    for new_conf_path in newly_written_confs:
        quickget_vm_name: str = new_conf_path.stem
        quickget_vm_dir: Path = VMS_DIR / quickget_vm_name
        quickget_vm_dir.mkdir(exist_ok=True)
        write_vm_meta(quickget_vm_dir, quickget_vm_name,
                      guest_os_label=quickget_arguments[0], ssh_user="")
        print(f"==> adopted {colorize_vm_name(quickget_vm_name)} "
              f"(bound to {Path.cwd()}); `qvm start` boots the installer", file=sys.stderr)


# ---------- lifecycle ----------


def quickemu_argv(vm_record: VmRecord, *extra_quickemu_arguments: str) -> list[str]:
    return ["quickemu", "--vm", str(vm_record.conf_path), *extra_quickemu_arguments]


def cmd_start(vm_record: VmRecord, *, gui: bool, public_dir: str | None, dry_run: bool) -> None:
    """Boot via quickemu (qemu goes to the background; state lands in the VMDIR).
    Headless `--display none` by default - the guest-agent socket needs
    none/spice/spice-app, and that keeps `exec`/`push` working. `public_dir`
    overrides quickemu's shared folder (default ~/Public); shared clipboard +
    that folder need the guest_spice bundle in the guest, and clipboard needs
    --gui (a connected SPICE display)."""
    if vm_pid_if_running(vm_record) is not None:
        print(f"==> {colorize_vm_name(vm_record.vm_name)} is already running", file=sys.stderr)
        return
    display_mode: str = "spice" if gui else "none"
    quickemu_extra_arguments: list[str] = ["--display", display_mode]
    if public_dir is not None:
        quickemu_extra_arguments += ["--public-dir", public_dir]
    # cwd=VMS_DIR: quickget-written confs use paths relative to where quickget ran.
    run(quickemu_argv(vm_record, *quickemu_extra_arguments), dry_run=dry_run, cwd=VMS_DIR)
    ssh_port: int | None = read_ssh_port(vm_record)
    if ssh_port is not None:
        print(f"==> ssh forwarded on localhost:{ssh_port} (`qvm shell`)", file=sys.stderr)


def read_ssh_port(vm_record: VmRecord) -> int | None:
    try:
        return parse_ssh_port((vm_record.vm_dir / f"{vm_record.vm_name}.ports").read_text())
    except OSError:
        return None


def cmd_stop(vm_record: VmRecord, *, dry_run: bool) -> None:
    """Clean ACPI shutdown via quickemu's HMP monitor socket (no agent needed,
    works for Windows too). Hard fallback: `qvm kill`."""
    if vm_pid_if_running(vm_record) is None:
        print(f"==> {colorize_vm_name(vm_record.vm_name)} is not running", file=sys.stderr)
        return
    monitor_socket_path: Path = vm_record.vm_dir / f"{vm_record.vm_name}-monitor.socket"
    print(f"+ (monitor) system_powerdown -> {monitor_socket_path}", file=sys.stderr)
    if dry_run:
        return
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as monitor_connection:
            monitor_connection.settimeout(5.0)
            monitor_connection.connect(str(monitor_socket_path))
            monitor_connection.sendall(b"system_powerdown\n")
    except OSError as monitor_error:
        die(f"monitor socket failed ({monitor_error}) - `qvm kill` to force-stop")
    print(f"==> ACPI powerdown sent to {colorize_vm_name(vm_record.vm_name)}", file=sys.stderr)


def cmd_kill(vm_record: VmRecord, *, dry_run: bool) -> None:
    run(quickemu_argv(vm_record, "--kill"), dry_run=dry_run, cwd=VMS_DIR)


def cmd_delete(vm_record: VmRecord, *, assume_yes: bool, dry_run: bool) -> None:
    """Remove the conf + the whole VMDIR (disk, snapshots inside the qcow2, ssh
    keypair, state). Refuses while running."""
    if vm_pid_if_running(vm_record) is not None:
        die(f"`{vm_record.vm_name}` is running - `qvm stop` (or `qvm kill`) first")
    print(f"DELETE preview: {vm_record.conf_path} + {vm_record.vm_dir}/ "
          "(disk + all its internal snapshots + keys)", file=sys.stderr)
    confirm_or_die(f"delete VM `{vm_record.vm_name}`?", assume_yes=assume_yes)
    print(f"+ rm -rf {vm_record.vm_dir} {vm_record.conf_path}", file=sys.stderr)
    if dry_run:
        return
    shutil.rmtree(vm_record.vm_dir, ignore_errors=True)
    vm_record.conf_path.unlink(missing_ok=True)
    print(f"==> deleted {colorize_vm_name(vm_record.vm_name)}", file=sys.stderr)


def cmd_shell(vm_record: VmRecord, *, dry_run: bool) -> NoReturn | None:
    """Interactive SSH through quickemu's auto-forwarded port, with the per-VM
    key + per-VM known_hosts (host keys never touch ~/.ssh/known_hosts)."""
    ssh_port: int | None = read_ssh_port(vm_record)
    if ssh_port is None:
        die("no ssh port recorded - is the VM running? (`qvm start`)")
    ssh_user: str = str(vm_record.meta.get("ssh_user") or "") or "root"
    ssh_argv: list[str] = [
        "ssh", "-p", str(ssh_port),
        "-i", str(vm_record.vm_dir / "ssh" / "id_ed25519"),
        "-o", f"UserKnownHostsFile={vm_record.vm_dir / 'known_hosts'}",
        "-o", "StrictHostKeyChecking=accept-new",
        f"{ssh_user}@localhost",
    ]
    print("+ " + shlex.join(ssh_argv), file=sys.stderr)
    if dry_run:
        return None
    os.execvp("ssh", ssh_argv)


def cmd_snapshot(vm_record: VmRecord, snapshot_arguments: list[str], *, dry_run: bool) -> None:
    """Passthrough to quickemu's qcow2-internal snapshots
    (`--snapshot apply|create|delete <tag>` / `--snapshot info`). apply/create on
    a RUNNING disk risks corruption -> refused (only `info` is safe live)."""
    if not snapshot_arguments:
        die("snapshot needs an action: apply/create/delete <tag>, or info")
    if snapshot_arguments[0] != "info" and vm_pid_if_running(vm_record) is not None:
        die(f"`{vm_record.vm_name}` is running - qcow2-internal snapshots need the VM "
            "stopped (`qvm stop`); only `qvm snapshot info` is safe live")
    run(quickemu_argv(vm_record, "--snapshot", *snapshot_arguments), dry_run=dry_run, cwd=VMS_DIR)


def cmd_list() -> None:
    vm_records: list[VmRecord] = list_vm_records()
    if not vm_records:
        print(f"(no VMs under {VMS_DIR} - `qvm init <os>` creates one)")
        return
    for vm_record in vm_records:
        running_marker: str = "RUNNING" if vm_pid_if_running(vm_record) is not None else "stopped"
        bound_dir: str = str(vm_record.meta.get("init_at_dir") or "(no cwd binding)")
        print(f"{vm_record.vm_name:<24} {running_marker:<8} {bound_dir}")


def cmd_info(vm_record: VmRecord) -> None:
    parsed_conf: dict[str, str] = parse_conf_text(vm_record.conf_path.read_text())
    qemu_pid: int | None = vm_pid_if_running(vm_record)
    info_lines: list[str] = [
        f"name        {colorize_vm_name(vm_record.vm_name, stream=sys.stdout)}",
        f"state       {f'RUNNING (pid {qemu_pid})' if qemu_pid else 'stopped'}",
        f"conf        {vm_record.conf_path}",
        f"guest_os    {parsed_conf.get('guest_os', '?')}",
        f"disk_img    {parsed_conf.get('disk_img', '?')}",
        f"bound dir   {vm_record.meta.get('init_at_dir', '(none)')}",
        f"ssh user    {vm_record.meta.get('ssh_user') or '(unknown - quickget VM?)'}",
        f"agent sock  {guest_agent_socket_path(vm_record)}",
    ]
    ssh_port: int | None = read_ssh_port(vm_record)
    if ssh_port is not None:
        info_lines.append(f"ssh port    localhost:{ssh_port}")
    disk_info_rc, disk_info_stdout, _ = run_capture(
        ["qemu-img", "info", parsed_conf.get("disk_img", "")])
    if disk_info_rc == 0:
        for disk_info_line in disk_info_stdout.splitlines():
            if disk_info_line.startswith(("virtual size", "disk size")):
                info_lines.append(f"disk        {disk_info_line.strip()}")
    print("\n".join(info_lines))


# ---------- CLI ----------


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="qvm",
        description="quickemu VM launcher: prebuilt tumbleweed/debian/fedora images "
                    "(no interactive install), quickget passthrough for the rest, "
                    "QGA exec/push/pull, SSH shell.",
        epilog="VM-acting subcommands resolve the target by the directory `init` ran in, "
               "or take the global `--name <vm>`.")
    parser.add_argument("--name", metavar="<vm>", default=None,
                        help="target VM by name (overrides the cwd binding)")
    parser.add_argument("--dry-run", action="store_true",
                        help="print every mutating command instead of running it")
    parser.add_argument("--shared-assets-root", type=Path, default=DEFAULT_SHARED_ASSETS_ROOT,
                        help=f"shared provision-asset cache (package-group + thirdparty JSON, "
                             f"feature-first dotfiles/); rarely overridden. "
                             f"Default: {DEFAULT_SHARED_ASSETS_ROOT}")
    subparsers = parser.add_subparsers(dest="subcommand", required=True)

    init_parser = subparsers.add_parser(
        "init", help=f"create a VM: {'/'.join(PREBUILT_OSES)} [name] (prebuilt, "
                     "zero-interaction) or any quickget OS (e.g. `init windows 11`)")
    init_parser.add_argument("os_arguments", nargs="+", metavar="<os> [name | quickget args...]")
    init_parser.add_argument("--disk-size", default=DEFAULT_DISK_SIZE,
                             help=f"disk size for prebuilt images (default {DEFAULT_DISK_SIZE})")
    init_parser.add_argument("--ram", default="", help="e.g. 8G (default: quickemu auto)")
    init_parser.add_argument("--cpus", default="", help="cpu cores (default: quickemu auto)")
    init_parser.add_argument("--yes", action="store_true", help="skip the y/N confirmation")
    init_parser.add_argument("--provision", nargs="*", metavar="<unit>", default=None,
                             help="after the VM boots, provision these unit(s) "
                                  "(distro bundle / thirdparty recipe / dotfiles feature); "
                                  "prebuilt-OS init only")
    init_parser.add_argument("--no-gpg-verify", action="store_true",
                             help="tumbleweed only: skip GPG-verifying the image checksum "
                                  "(sha256-only). Default verifies the `.sha256.asc` against the "
                                  "pinned openSUSE key in ~/.gnupg/ansible-trusted-opensuse.gpg")

    for vm_acting_subcommand, subcommand_help in (
            ("start", "boot the VM headless (--gui for a SPICE desktop window)"),
            ("stop", "clean ACPI shutdown (monitor socket; no agent needed)"),
            ("kill", "force-stop the qemu process (quickemu --kill)"),
            ("delete", "delete the VM: conf + disk + snapshots (confirms; --yes skips)"),
            ("shell", "interactive SSH (quickemu's auto-forwarded port, per-VM key)"),
            ("exec", "run a command in the guest via the QEMU Guest Agent (batch; root)"),
            ("push", "copy one local file into the guest (guest agent)"),
            ("pull", "copy one guest file out (guest agent)"),
            ("snapshot", "qcow2-internal snapshots: apply/create/delete <tag>, info"),
            ("provision", "install distro bundle(s) / thirdparty recipe(s) / dotfiles "
                          "onto the VM via the guest agent (no args = list them)"),
            ("info", "show the VM's state (conf, disk, ssh port, agent socket)")):
        vm_acting_parser = subparsers.add_parser(vm_acting_subcommand, help=subcommand_help)
        if vm_acting_subcommand == "start":
            vm_acting_parser.add_argument("--gui", action="store_true",
                                          help="SPICE display instead of headless")
            vm_acting_parser.add_argument("--public-dir", default=None, metavar="<dir>|none",
                                          help="host folder shared into the guest (quickemu "
                                               "9p/webdav; default ~/Public, 'none' disables). "
                                               "Needs the guest_spice bundle in the guest; "
                                               "clipboard also needs --gui")
        elif vm_acting_subcommand == "delete":
            vm_acting_parser.add_argument("--yes", action="store_true",
                                          help="skip the y/N confirmation")
        elif vm_acting_subcommand == "exec":
            vm_acting_parser.add_argument("guest_argv", nargs=argparse.REMAINDER,
                                          metavar="-- <command> [args...]")
        elif vm_acting_subcommand == "push":
            vm_acting_parser.add_argument("local_path")
            vm_acting_parser.add_argument("guest_path")
        elif vm_acting_subcommand == "pull":
            vm_acting_parser.add_argument("guest_path")
            vm_acting_parser.add_argument("local_path")
        elif vm_acting_subcommand == "snapshot":
            vm_acting_parser.add_argument("snapshot_arguments", nargs="+",
                                          metavar="apply|create|delete <tag> | info")
        elif vm_acting_subcommand == "provision":
            vm_acting_parser.add_argument("names", nargs="*", metavar="<unit>",
                                          help="unit(s) to install; omit to LIST all "
                                               "installable units + descriptions")

    subparsers.add_parser("list", help="list qvm-managed VMs (name, state, bound dir)")
    return parser


def main() -> None:
    parsed_arguments: argparse.Namespace = build_parser().parse_args()
    subcommand: str = parsed_arguments.subcommand
    shared_assets_root: Path = parsed_arguments.shared_assets_root
    if subcommand == "init":
        if parsed_arguments.name:
            die("`--name` targets an EXISTING VM; for init give the name as a "
                "positional: `qvm init <os> <name>`")
        cmd_init(parsed_arguments.os_arguments,
                 disk_size=parsed_arguments.disk_size, ram=parsed_arguments.ram,
                 cpu_cores=parsed_arguments.cpus, assume_yes=parsed_arguments.yes,
                 provision_units=parsed_arguments.provision,
                 gpg_verify=not parsed_arguments.no_gpg_verify,
                 shared_assets_root=shared_assets_root, dry_run=parsed_arguments.dry_run)
        return
    if subcommand == "list":
        cmd_list()
        return
    # `provision` with no units just lists what is installable - no VM needed, so
    # handle it BEFORE resolving a target VM (mirror ivm).
    if subcommand == "provision" and not parsed_arguments.names:
        cmd_list_provision_units(shared_assets_root)
        return
    target_vm: VmRecord = resolve_target_vm(parsed_arguments.name)
    if subcommand == "start":
        cmd_start(target_vm, gui=parsed_arguments.gui,
                  public_dir=parsed_arguments.public_dir, dry_run=parsed_arguments.dry_run)
    elif subcommand == "stop":
        cmd_stop(target_vm, dry_run=parsed_arguments.dry_run)
    elif subcommand == "kill":
        cmd_kill(target_vm, dry_run=parsed_arguments.dry_run)
    elif subcommand == "delete":
        cmd_delete(target_vm, assume_yes=parsed_arguments.yes, dry_run=parsed_arguments.dry_run)
    elif subcommand == "shell":
        cmd_shell(target_vm, dry_run=parsed_arguments.dry_run)
    elif subcommand == "exec":
        guest_argv: list[str] = list(parsed_arguments.guest_argv)
        if guest_argv and guest_argv[0] == "--":
            guest_argv = guest_argv[1:]
        cmd_exec(target_vm, guest_argv)
    elif subcommand == "push":
        cmd_push(target_vm, parsed_arguments.local_path, parsed_arguments.guest_path)
    elif subcommand == "pull":
        cmd_pull(target_vm, parsed_arguments.guest_path, parsed_arguments.local_path)
    elif subcommand == "snapshot":
        cmd_snapshot(target_vm, parsed_arguments.snapshot_arguments,
                     dry_run=parsed_arguments.dry_run)
    elif subcommand == "provision":
        cmd_provision(target_vm, parsed_arguments.names, shared_assets_root,
                      dry_run=parsed_arguments.dry_run)
    elif subcommand == "info":
        cmd_info(target_vm)


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        print("\nqvm: interrupted", file=sys.stderr)
        sys.exit(130)
    except subprocess.CalledProcessError as command_failure:
        failed_command: str = (shlex.join(command_failure.cmd)
                               if isinstance(command_failure.cmd, list) else str(command_failure.cmd))
        print(f"qvm: command failed (exit {command_failure.returncode}): {failed_command}",
              file=sys.stderr)
        sys.exit(command_failure.returncode or 1)
