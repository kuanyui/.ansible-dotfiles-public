#compdef qvm
# qvm zsh completion (ansible-managed by roles/vm_quickemu). zsh autoloads this
# via fpath - see the `ansible-managed/*/zsh-completions` glob in
# roles/zsh/.zshrc.j2. Two levels: subcommands, then their args - prebuilt OS
# names for `init`, snapshot actions, VM names for `--name`.

local -a _qvm_subcommands
_qvm_subcommands=(
  'init:create a VM (tumbleweed/debian/fedora = prebuilt image; any other OS via quickget)'
  'start:boot the VM headless (--gui = SPICE desktop window)'
  'stop:clean ACPI shutdown (monitor socket; no agent needed)'
  'kill:force-stop the qemu process (quickemu --kill)'
  'delete:delete the VM - conf + disk + snapshots (confirms)'
  'shell:interactive SSH (quickemu auto-forwarded port, per-VM key)'
  'exec:run a command in the guest via the QEMU Guest Agent (batch; root)'
  'push:copy one local file into the guest (guest agent)'
  'pull:copy one guest file out (guest agent)'
  'snapshot:qcow2-internal snapshots - apply/create/delete <tag>, info'
  'provision:install distro bundle(s) / thirdparty recipe(s) / dotfiles onto the VM (guest agent)'
  'info:show the VM state (conf, disk, ssh port, agent socket)'
  'list:list qvm-managed VMs (name, state, bound dir)'
)

# qvm VM names = vms/<name>.conf stems under QVM_HOME (no daemon to ask - fast).
_qvm_vm_names() {
  local _qvm_vms_dir="${QVM_HOME:-$HOME/.local/share/qvm}/vms"
  local _qvm_conf_path
  for _qvm_conf_path in ${_qvm_vms_dir}/*.conf(N); do
    print -r -- "${_qvm_conf_path:t:r}"
  done
}

# All installable unit names for `provision`: keys of the materialized distro-bundle
# + thirdparty-recipe registries + dotfiles feature dirs, from the SHARED provision-asset
# cache (python3 is a qvm dependency, so always present). Same dynamic pattern as ivm's
# `_ivm_unit_names` - reads the JSON, so it auto-tracks the registry.
_qvm_unit_names() {
  local _qvm_shared_assets_root="${SHARED_PREBUILT_PROVISION_ASSETS_ROOT:-$HOME/.local/share/ansible-managed/shared-prebuilt-provision-assets}"
  python3 - "$_qvm_shared_assets_root" 2>/dev/null <<'PY'
import json, os, sys
shared_root = sys.argv[1]
LAUNCHER = "qvm"
def offered(entry):
    # Same `available_on` rule as the launcher's registry loader: the entry's list of
    # consumers; absent = every consumer.
    if not isinstance(entry, dict):
        return True
    available_on = entry.get("available_on")
    return available_on is None or LAUNCHER in available_on
seen, out = set(), []
def add(name, desc=""):
    if name in seen:
        return
    seen.add(name)
    # zsh _describe splits on the FIRST colon -> "name:description"; bare name = no desc.
    out.append(f"{name}:{desc}" if desc else name)
for f in ("distro-package-groups.json", "thirdparty-software.json"):
    p = os.path.join(shared_root, f)
    if os.path.exists(p):
        try:
            for key, val in json.load(open(p)).items():
                if not offered(val):
                    continue
                add(key, val.get("description", "") if isinstance(val, dict) else "")
        except Exception:
            pass
dotfiles = os.path.join(shared_root, "dotfiles")
if os.path.isdir(dotfiles):
    for d in sorted(os.listdir(dotfiles)):
        add(d)
# A name can live in two registries (first occurrence wins, so the `description` shown
# is the distro one - it already notes any pairing).
print("\n".join(out))
PY
}

local state

_arguments -C \
  '--name[target an existing VM by name, ignoring the cwd binding]:vm:->vmname' \
  '--dry-run[print every mutating command instead of running it]' \
  '--shared-assets-root[shared provision-asset cache dir (rarely overridden)]:dir:_files -/' \
  '1:subcommand:->subcmd' \
  '*::args:->args'

case "$state" in
  subcmd) _describe 'qvm subcommand' _qvm_subcommands ;;
  vmname) compadd -- ${(f)"$(_qvm_vm_names)"} ;;
  args)
    case "$words[1]" in
      init) compadd -- tumbleweed debian fedora --disk-size --ram --cpus --yes --provision ;;
      start) compadd -- --gui ;;
      delete) compadd -- --yes ;;
      snapshot) compadd -- apply create delete info ;;
      provision)
        # `_describe` renders each "name:description" line as `name  -- description`.
        local -a _qvm_provision_units
        _qvm_provision_units=(${(f)"$(_qvm_unit_names)"})
        _describe -t units 'provision unit' _qvm_provision_units ;;
      push|pull) _files ;;
    esac
    ;;
esac
