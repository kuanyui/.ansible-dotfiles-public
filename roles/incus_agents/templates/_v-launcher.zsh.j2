#compdef {{ launcher_name }}
# {{ ansible_managed }}
#
# zsh completion for `{{ launcher_name }}`. Subcommands parsed from the
# dispatch case statement in the launcher itself, so any new subcommand
# picks up automatically.

local script="{{ incus_bin_dir }}/{{ launcher_name }}"
local -a subs
subs=(${(s.|.)"$(perl -ne 'if (/^\s*([a-zA-Z_][\w-]*(\|[a-zA-Z_][\w-]*)+)\)/) { print $1; exit }' "$script" 2>/dev/null)"})

_arguments -C \
    '(-n --project-name)'{-n,--project-name}'[project name (default: cwd-derived)]:name:->projects' \
    '(-p --project-path)'{-p,--project-path}'[single-mount alias for --mount]:path:_files -/' \
    '(-y --yes)'{-y,--yes}'[skip the pre-create confirmation prompt]' \
    '*--mount[bind-mount <host>\[:<name>\] into /workspaces/<name>; repeatable]:mount:_files -/' \
    '1:subcommand:->subcmd' \
    '*::arg:->args'

case "$state" in
    subcmd) _describe 'subcommand' subs ;;
    projects)
        # Complete `-n` with the suffixes of EXISTING `{{ launcher_name }}-*` VMs
        # (running or stopped), so you can attach to an already-created VM by
        # name without `cd`-ing into its project dir.
        local -a projs
        projs=(${(f)"$(incus list '^{{ launcher_name }}-' --format csv --columns n 2>/dev/null)"})
        projs=(${projs#{{ launcher_name }}-})
        _describe 'existing project (VM)' projs ;;
esac
