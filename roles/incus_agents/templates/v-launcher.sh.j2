#!/usr/bin/env bash
# {{ ansible_managed }}
#
# Per-agent VM launcher for `{{ incus_app.name }}` ({{ incus_app.agent.display_name }}).
# Provisions one Incus KVM VM per (agent, project), virtio-fs shares the
# host project dir into /workspaces/<name>, and execs the agent inside.
#
# ===========================================================================
# Architecture: one VM per (agent, project), vs `roles/container_apps`'s one
# podman container per (agent, project).
#
#   roles/container_apps/      ~/.local/bin/c-<agent>-<runtime>
#                              -> rootless podman container; shared host kernel
#                                 (crun) or libkrun microVM (krun).
#
#   roles/incus_agents/  (this file)  ~/.local/bin/v-<agent>
#                              -> full KVM VM via Incus; full hardware isolation,
#                                 separate guest kernel, virtio-fs share by
#                                 QEMU's standalone virtiofsd (pivot_root +
#                                 seccomp).
#
# Tradeoff: c-* boots in seconds, v-* takes ~10-15s to boot but has a stronger
# isolation boundary suitable for less-trusted workloads.
# ===========================================================================

set -euo pipefail

AGENT_NAME="{{ incus_app.name }}"
AGENT_DISPLAY="{{ incus_app.agent.display_name }}"
AGENT_COMMAND="{{ incus_app.agent.command }}"
{% if incus_app.agent.install_script_url is defined %}
AGENT_INSTALL_KIND="curl"
AGENT_INSTALL_URL="{{ incus_app.agent.install_script_url }}"
{% else %}
AGENT_INSTALL_KIND="npm"
AGENT_INSTALL_NPM_PKG="{{ incus_app.agent.install_via_npm }}"
{% endif %}

VM_BASE_IMAGE="{{ vm_cfg.base_image }}"
VM_CPU="{{ vm_cfg.cpu }}"
VM_MEMORY="{{ vm_cfg.memory }}"
VM_DISK="{{ vm_cfg.disk }}"

# Default project name from cwd (same logic as c-claude-crun launcher: strip
# $HOME/ prefix or leading /, then replace / with _). For Incus VM names we
# additionally need to swap underscore to hyphen because Incus rejects
# underscores in names (must match `[a-zA-Z][a-zA-Z0-9-]*`, max 63 chars).
_proj="${PWD#"$HOME"/}"
_proj="${_proj#/}"
# Sanitize `.` at the start of any path segment to `_`, BEFORE the `/`->`_`
# pass. Two downstream consumers reject `.`-prefixed segments:
#   - Docker image references in image tags (regex forbids `_.` and leading `.`)
#   - Incus VM names below (regex `[a-zA-Z][a-zA-Z0-9-]*`)
# Without this, any dotdir on the path explodes. We preserve position with `_`
# instead of stripping, so `~/foo` and `~/.foo` map to distinct VM names.
_proj="${_proj//\/./\/_}"
_proj="${_proj/#./_}"
PROJECT_NAME="${PROJECT_NAME:-${_proj//\//_}}"
unset _proj

# Sanitize for Incus name requirements.
VM_NAME_SUFFIX="${PROJECT_NAME//_/-}"
VM_NAME="v-${AGENT_NAME}-${VM_NAME_SUFFIX}"

# Mount accumulator (same shape as host-cli.sh in container_apps). Default
# to $PWD when neither --mount nor -p is given.
MOUNT_HOSTS=()
MOUNT_NAMES=()
_n_mounts=0     # scalar; avoids the bash array-length form that collides
                # with Jinja2's {# ... #} comment delimiter at render time.
_used_p=0
_used_mount=0

_add_mount() {
    local arg="$1" host_part name_part host_abs existing
    if [[ "$arg" == *:* ]]; then
        host_part="${arg%%:*}"
        name_part="${arg#*:}"
    else
        host_part="$arg"
        name_part=""
    fi
    host_abs="$(realpath -- "$host_part" 2>/dev/null)" \
        || { echo "Mount source not found: $host_part" >&2; exit 1; }
    [[ -d "$host_abs" ]] \
        || { echo "Mount source is not a directory: $host_part" >&2; exit 1; }
    if [[ -z "$name_part" ]]; then
        name_part="$(basename "$host_abs")"
        # Leading `.` -> `_` so dotdirs (`~/.config/foo`, `~/projects/.bar`)
        # pass the regex below. We only rewrite the auto-derived basename;
        # an explicit `--mount X:name` still has to be regex-clean as given.
        name_part="${name_part/#./_}"
    fi
    [[ "$name_part" =~ ^[A-Za-z0-9_][A-Za-z0-9._-]*$ ]] \
        || { echo "Mount name must match [A-Za-z0-9_][A-Za-z0-9._-]*, got: '$name_part'" >&2; exit 1; }
    # MOUNT_NAMES is declared `=()` at top level, so under `set -u` the plain
    # `"${MOUNT_NAMES[@]}"` form is safe and expands to nothing when empty.
    # The previous `:-` default would have expanded to a single empty string,
    # spinning the loop once with `existing=""` - harmless here but misleading.
    for existing in "${MOUNT_NAMES[@]}"; do
        [[ "$existing" == "$name_part" ]] \
            && { echo "Mount name '$name_part' already used" >&2; exit 1; }
    done
    MOUNT_HOSTS+=("$host_abs")
    MOUNT_NAMES+=("$name_part")
    _n_mounts=$((_n_mounts + 1))
}

# ---------- Flag parsing ----------
while [[ $# -gt 0 ]]; do
    case "$1" in
        -n|--project-name)
            PROJECT_NAME="$2"
            VM_NAME_SUFFIX="${PROJECT_NAME//_/-}"
            VM_NAME="v-${AGENT_NAME}-${VM_NAME_SUFFIX}"
            shift 2 ;;
        -p|--project-path)
            [[ "$_used_mount" == 1 ]] && { echo "-p cannot be combined with --mount" >&2; exit 1; }
            _used_p=1; _add_mount "$2"; shift 2 ;;
        --mount)
            [[ "$_used_p" == 1 ]] && { echo "--mount cannot be combined with -p" >&2; exit 1; }
            _used_mount=1; _add_mount "$2"; shift 2 ;;
        --) shift; break ;;
        -*) echo "Unknown flag: $1 (try 'help')" >&2; exit 1 ;;
        *)  break ;;
    esac
done

# Default to $PWD if no mount given AND we're not just asking for help.
if [[ "${1:-help}" != "help" ]] && [[ $_n_mounts -eq 0 ]]; then
    _add_mount "$PWD"
fi

# Workspace cwd inside VM (same convention as host-cli.sh).
if [[ $_n_mounts -eq 1 ]]; then
    WORKSPACE_WORKDIR="/workspaces/${MOUNT_NAMES[0]}"
else
    WORKSPACE_WORKDIR="/workspaces"
fi

# ---------- Subcommands ----------

cmd_help() {
    cat <<EOF
$VM_NAME — Incus KVM VM launcher for $AGENT_DISPLAY (agent: $AGENT_NAME)

Usage: v-$AGENT_NAME [flags] <subcommand> [args]

Flags (override env vars; both override the launcher's cwd-based defaults):
  -n, --project-name <name>              Project name; baked into the VM name
                                         as `v-<agent>-<name>`. (default: \$PWD
                                         with \$HOME stripped, slashes -> hyphens)
      --mount <host>[:<name>]            virtio-fs share <host> dir into the VM
                                         at /workspaces/<name>. <name> defaults
                                         to basename(<host>). Repeatable.
                                         If omitted, defaults to \$PWD.
  -p, --project-path <path>              Single-mount alias for --mount.

Subcommands:
  help              Show this message
  env               Print resolved configuration
  init              Create VM if missing, share workspace, provision the agent.
                    Idempotent: re-running on an existing VM is a no-op start.
  start             Start an existing stopped VM
  stop              Stop the VM
  shell             Open a shell in the VM as 'user' (alias: shell-user),
                    cwd = $WORKSPACE_WORKDIR
  shell-user        Same as 'shell': unprivileged 'user' zsh
  shell-root        Root maintenance shell (bash, uid 0), cwd = $WORKSPACE_WORKDIR
  set-root-password Set the VM root password and enable 'user' sudo, gated by
                    that password. Default (without this): 'user' CANNOT sudo;
                    root is reachable only via shell-root / incus exec.
  $AGENT_NAME           Run $AGENT_DISPLAY ('$AGENT_COMMAND') inside the VM,
                    cwd = $WORKSPACE_WORKDIR
  rma               rm all: stop + delete the VM entirely (config + disk).
                    Spelled rma not rm to stay far from the system 'rm'.

VM lifecycle is managed per-project. Different projects get different VMs
(named by cwd). To force a specific VM (e.g. share one across projects),
override with --project-name.

Resource config (compiled in by this launcher at render time):
  base image: $VM_BASE_IMAGE
  cpu:        $VM_CPU
  memory:     $VM_MEMORY
  disk:       $VM_DISK

Prereq: incus must be installed and initialized on the host:
  sudo apt install incus && sudo incus admin init
  sudo usermod -aG incus-admin \$USER  # then re-login
EOF
}

cmd_env() {
    cat <<EOF
========================================
Agent:             $AGENT_NAME ($AGENT_DISPLAY)
Agent command:     $AGENT_COMMAND
Agent install:     $AGENT_INSTALL_KIND
========================================
PROJECT_NAME:      $PROJECT_NAME
VM_NAME:           $VM_NAME
WORKSPACE_WORKDIR: $WORKSPACE_WORKDIR
Mounts:
EOF
    for _i in "${!MOUNT_HOSTS[@]}"; do
        printf '  %s  ->  /workspaces/%s\n' "${MOUNT_HOSTS[_i]}" "${MOUNT_NAMES[_i]}"
    done
    unset _i
    cat <<EOF
========================================
VM config:
  base image: $VM_BASE_IMAGE
  cpu:        $VM_CPU
  memory:     $VM_MEMORY
  disk:       $VM_DISK
========================================
EOF
}

_vm_exists() { incus info "$VM_NAME" >/dev/null 2>&1; }
# `incus list <pattern>` is regex, not exact. Anchor with ^...$ so e.g.
# `v-claude-foo` doesn't accidentally also match `v-claude-foo-bar` (which
# would yield a multi-row CSV and a guaranteed-false `== "RUNNING"`).
_vm_running() { [[ "$(incus list "^${VM_NAME}$" --format csv --columns s 2>/dev/null)" == "RUNNING" ]]; }

_wait_vm_ready() {
    # Block until `incus exec` succeeds (i.e. lxd-agent is up inside the VM).
    # Cold boot is usually 10-15s; give a generous timeout.
    local deadline=$((SECONDS + 90))
    while (( SECONDS < deadline )); do
        if incus exec "$VM_NAME" -- true 2>/dev/null; then return 0; fi
        sleep 1
    done
    echo "VM '$VM_NAME' did not become ready within 90s" >&2
    exit 1
}

_provision_vm() {
    # `force` (passed by `cmd_init`) re-runs the whole pass even on an
    # already-provisioned VM - the repair path for a half-provisioned VM (apt
    # failure on first run, network blip during curl-install, etc.); every step
    # below is idempotent. WITHOUT `force` (the `shell` / agent path) we SKIP
    # entirely once the VM is marked provisioned, so day-to-day
    # `v-<agent> shell` / `v-<agent> <agent>` don't re-run apt-get update + the
    # dotfile push on every single launch. The marker is written LAST, so a
    # failure mid-provision (set -e aborts) leaves the VM unmarked and the next
    # run retries the whole thing.
    local force="${1:-}"
    local provisioned_marker=/var/lib/v-launcher-provisioned
    if [[ "$force" != "force" ]] \
        && incus exec "$VM_NAME" -- test -f "$provisioned_marker" 2>/dev/null; then
        return 0
    fi
    echo "==> Provisioning $VM_NAME (apt: agent + sshd + zsh + tmux; chsh; dotfiles)..."
    incus exec "$VM_NAME" -- bash -ec '
        export DEBIAN_FRONTEND=noninteractive
        apt-get update -qq
        apt-get install --yes --no-install-recommends \
            openssh-server curl git ca-certificates sudo \
            zsh zsh-syntax-highlighting zsh-autosuggestions \
            tmux
        # Create unprivileged `user` if not present. UID 1000 matches host shift.
        # NO sudoers entry by default: a process running as `user` inside the
        # guest MUST NOT be able to escalate to root - that is the whole point
        # of running the agent unprivileged. `incus exec` gives the HOST
        # operator root with no in-guest password (auth is the host`s
        # incus-admin group + socket, unreachable from inside the guest), so
        # that path is unaffected. To opt into IN-GUEST escalation, run
        # `v-<agent> set-root-password`: it sets root`s password AND enables
        # `user` sudo gated by that same password (Defaults:user rootpw).
        if ! id user >/dev/null 2>&1; then
            useradd --create-home --shell /bin/zsh --uid 1000 user
        fi
        # `chsh` is idempotent and self-heals VMs created by earlier launcher
        # versions where the user was created with /bin/bash.
        chsh --shell /bin/zsh user
    '

    # Push the host-side rendered dotfiles (rendered once at `roles/incus_agents`
    # apply time; see install.yml) into the VM. `--uid 1000 --gid 1000`
    # sets ownership to `user` inside the VM, overriding whatever uid/gid
    # the staging files carry on the host. `--create-dirs` is mandatory here:
    # incus refuses `--recursive` + uid/gid override without it ("Can't
    # override UID/GID in recursive mode without -p"), since it must own any
    # directories it creates along the way.
    #
    # Path semantics: push the source dir `.../home/user` INTO the target's
    # parent `/home/`, NOT `.../home/user/.` into `/home/user/`. incus does
    # `filepath.Clean` on the source (stripping a trailing `/.`) and appends
    # its basename to the target - so the rsync-style `src/. -> dest/` "copy
    # contents" idiom does NOT work here: it produced `/home/user/user/`.
    # Pushing the `user` dir into `/home/` resolves to `/home/user/` (which
    # already exists from useradd above) and merges the dotfiles in.
    echo "==> Pushing dotfiles into $VM_NAME (~/.bashrc, ~/.zshrc, ~/.tmux.conf)..."
    incus file push --recursive --create-dirs --uid 1000 --gid 1000 \
        "{{ incus_root }}/vm-rootfs/home/user" \
        "$VM_NAME/home/"
{% if incus_app.agent.install_script_url is defined %}
    # Curl-based install (e.g. claude). Runs as `user` so the binary lands in
    # ~/.local/bin/ inside the VM. The install URL is passed as a positional
    # argument ($1) rather than interpolated into the script body, so any
    # shell metachars in the YAML value don't get evaluated by bash.
    # `--env HOME/USER`: `incus exec --user/--group` sets the uid/gid but NOT
    # $HOME, so the installer's `mkdir "$HOME/.claude"` would expand to
    # `mkdir /.claude` and fail with EACCES. Set them explicitly here and at
    # every other run-as-`user` exec below (npm install, shell, agent).
    incus exec --user 1000 --group 1000 --env HOME=/home/user --env USER=user --cwd /home/user "$VM_NAME" -- \
        bash -c 'curl -fsSL "$1" | bash' _ "$AGENT_INSTALL_URL"
{% else %}
    # npm-based install (e.g. codex). Install nodejs/npm at the system level,
    # then npm-install the package as `user` into ~/.local/npm_global. Same
    # positional-arg quoting pattern as the curl branch above.
    incus exec "$VM_NAME" -- bash -ec '
        export DEBIAN_FRONTEND=noninteractive
        apt-get install --yes --no-install-recommends nodejs npm
    '
    incus exec --user 1000 --group 1000 --env HOME=/home/user --env USER=user --cwd /home/user "$VM_NAME" -- \
        bash -ec '
            mkdir -p ~/.local/npm_global
            npm config set prefix ~/.local/npm_global
            npm install -g "$1"
        ' _ "$AGENT_INSTALL_NPM_PKG"
{% endif %}
    # Mark provisioned (see the skip-check at the top of this function). Root-
    # owned path; `incus exec` without --user runs as root, which can write it.
    incus exec "$VM_NAME" -- touch "$provisioned_marker"
}

# Ensure the VM exists and is running: launch + attach virtio-fs mounts on
# first creation, otherwise just start it if stopped. Does NOT provision -
# callers decide whether to provision and whether to force it.
_ensure_vm_up() {
    if _vm_exists; then
        echo "==> VM $VM_NAME already exists; starting if stopped..."
        _vm_running || incus start "$VM_NAME"
        _wait_vm_ready
    else
        echo "==> Launching $VM_NAME from $VM_BASE_IMAGE..."
        incus launch "$VM_BASE_IMAGE" "$VM_NAME" \
            --vm \
            --config "limits.cpu=$VM_CPU" \
            --config "limits.memory=$VM_MEMORY" \
            --device "root,size=$VM_DISK"
        _wait_vm_ready

        echo "==> Attaching virtio-fs shares..."
        for _i in "${!MOUNT_HOSTS[@]}"; do
            local host="${MOUNT_HOSTS[_i]}"
            local name="${MOUNT_NAMES[_i]}"
            # shift=true uses idmap shifting so host UID ↔ VM UID is auto-mapped;
            # without it, bind-mounted files appear as nobody:nogroup in the VM.
            incus config device add "$VM_NAME" "workspace_${name//-/_}" disk \
                "source=$host" \
                "path=/workspaces/$name" \
                shift=true
        done
        unset _i
    fi
}

cmd_init() {
    _ensure_vm_up
    # `force`: `init` is the explicit (re)provision / repair entry point, so it
    # always runs the full pass regardless of the provisioned marker.
    _provision_vm force
    echo "==> $VM_NAME ready. Try: v-$AGENT_NAME $AGENT_NAME"
}

cmd_start() { _vm_exists || { echo "VM $VM_NAME does not exist; run 'init' first" >&2; exit 1; }; incus start "$VM_NAME"; _wait_vm_ready; }
cmd_stop()  { _vm_exists && incus stop "$VM_NAME" 2>/dev/null || true; }
cmd_rma()   { _vm_exists && incus delete -f "$VM_NAME" 2>/dev/null || true; }

cmd_shell_user() {
    _ensure_vm_up
    _provision_vm   # marker-gated: provisions the first time, then skips
    # `zsh` not `bash`: user's default shell was chsh'd to zsh at provision
    # time, and the dotfiles pushed in include `~/.zshrc`. TTY is attached via
    # `incus exec`, so zsh auto-detects interactive and sources `~/.zshrc`.
    incus exec --user 1000 --group 1000 --env HOME=/home/user --env USER=user --cwd "$WORKSPACE_WORKDIR" "$VM_NAME" -- zsh
}

# `shell` is the everyday entry point and a deliberate alias for `shell-user`.
cmd_shell() { cmd_shell_user "$@"; }

cmd_shell_root() {
    _ensure_vm_up
    _provision_vm   # marker-gated: provisions the first time, then skips
    # Root maintenance shell. No --user/--group/--env: `incus exec` defaults to
    # uid 0. `bash` not `zsh` - root has no staged ~/.zshrc, so plain bash is
    # the predictable maintenance shell (zsh would drop into the new-user
    # wizard against root's empty home).
    incus exec --cwd "$WORKSPACE_WORKDIR" "$VM_NAME" -- bash
}

cmd_set_root_password() {
    # Opt into IN-GUEST privilege escalation. Default provisioning gives `user`
    # NO sudo at all; this sets root's password and enables `user` sudo gated by
    # THAT password (`Defaults:user rootpw` -> sudo prompts for root's password,
    # not user's). A process running as `user` that doesn't know the password
    # still cannot escalate. The operator's `shell-root` / `incus exec` path is
    # orthogonal (host-socket auth) and works with or without this.
    _ensure_vm_up
    _provision_vm   # ensure `user` exists before referencing it in sudoers
    local root_password root_password_confirm
    read -rsp "New root password for $VM_NAME: " root_password; echo
    read -rsp "Confirm: " root_password_confirm; echo
    [[ -n "$root_password" ]] || { echo "Empty password rejected." >&2; exit 1; }
    [[ "$root_password" == "$root_password_confirm" ]] \
        || { echo "Passwords do not match." >&2; exit 1; }
    # Password travels via stdin (the pipe), never argv - so it is not visible
    # in the VM's process list. `chpasswd` reads `user:password` lines.
    printf 'root:%s\n' "$root_password" | incus exec "$VM_NAME" -- chpasswd
    incus exec "$VM_NAME" -- bash -ec '
        cat > /etc/sudoers.d/user <<EOF
Defaults:user rootpw
user ALL=(ALL) ALL
EOF
        chmod 0440 /etc/sudoers.d/user
        visudo --check --file=/etc/sudoers.d/user
    '
    echo "==> root password set; \`user\` may now sudo (prompts for the root password)."
}

cmd_agent() {
    _ensure_vm_up
    _provision_vm   # marker-gated: provisions the first time, then skips
    # Need a login shell so ~/.local/bin (where curl installer drops the binary)
    # is on PATH. `bash -lc` sources the user's bash login files.
    incus exec --user 1000 --group 1000 --env HOME=/home/user --env USER=user --cwd "$WORKSPACE_WORKDIR" "$VM_NAME" -- \
        bash -lc "$AGENT_COMMAND"
}

# ---------- Dispatch ----------
sub="${1:-help}"; shift || true
case "$sub" in
    help|env|init|start|stop|shell|shell-user|shell-root|set-root-password|rma|{{ incus_app.name }})
        # User-facing names keep hyphens; bash function names use underscores.
        # The agent subcommand is renamed to a fixed `cmd_agent` (vs per-agent
        # function name) so the dispatch line above doesn't have to be edited
        # when the agent name changes.
        if [[ "$sub" == "{{ incus_app.name }}" ]]; then
            cmd_agent "$@"
        else
            "cmd_${sub//-/_}" "$@"
        fi
        ;;
    *)
        echo "Unknown subcommand: $sub" >&2
        cmd_help >&2
        exit 1
        ;;
esac
