# LLM coding-agent CLIs. `claude` defaults to skip-permissions + max effort (claude
# warns on launch; full path avoids alias recursion). `SHELL=/bin/bash` because Claude Code's
# Bash tool runs commands under $SHELL: under zsh an unmatched glob aborts the whole command
# (`no matches found`), which hangs/garbles Claude's output; bash keeps the literal and carries on.
# `codex` mirrors it: `--ask-for-approval never` (never pause for approval) + `--sandbox
# danger-full-access` (no filesystem/network sandbox) - OpenAI Codex CLI's equivalent of claude's
# skip-permissions (`--dangerously-bypass-approvals-and-sandbox` / `--yolo` is the one-flag
# shortcut for the pair). No `SHELL=` prefix for codex: it reads its shell from /etc/passwd via
# `getpwuid()`, not $SHELL, so setting it would be a no-op (openai/codex `codex-rs` shell_detect).
alias claude="SHELL=/bin/bash ~/.local/bin/claude --dangerously-skip-permissions --effort max"
alias codex="~/.centralized-lang-pkgs/npm/bin/codex --ask-for-approval never --sandbox danger-full-access"
