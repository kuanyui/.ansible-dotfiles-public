#!/usr/bin/env python3
"""pvm - podman container launcher (rootless; optional libkrun microVM).

Sibling of `ivm` (incus VMs) and `qvm` (quickemu VMs), for the container axis.
Drives podman from the HOST off declarative YAML templates: build a per-template
image once (provision a base container via `podman exec` + `podman cp`, then
`podman commit` it - NO Dockerfile), then run a per-project container bound to the
cwd. Provisioning (packages + thirdparty recipes + dotfiles) reads the SAME shared
provision-asset cache `ivm`/`qvm` use, so all three engines share one source of
truth.

Isolation honesty: the default runtime (`crun`) shares the HOST kernel - the
boundary `ivm` exists to avoid. For real kernel isolation use `ivm`; pvm warns and
gates accordingly (sub-phase 3.3). `libkrun` (a microVM runtime) is a later
addition; `--runtime libkrun` is accepted now but the drive lands later.

Layout (program data under `PVM_HOME`; uninstalling the role's managed subdir
`~/.local/share/ansible-managed/vm-podman/` removes it):
  ~/.local/share/ansible-managed/vm-podman/pvm/templates/           shipped + user templates
  ~/.local/share/ansible-managed/vm-podman/pvm/template.schema.json validation schema
  ~/.local/share/ansible-managed/vm-podman/pvm/mask/                empty dir masked over hide_dirs

Sub-phase status: 3.1 - templates/schema + the pure host-cli logic ported to
Python (`env`, `list`, `help`, and `run --dry-run` show the real podman argv with
NO podman calls). `init`/`build` + the live drive land in 3.2/3.3.
"""

from __future__ import annotations

import argparse
import hashlib
import json
import os
import re
import shlex
import subprocess
import sys
from pathlib import Path
from typing import Any, NamedTuple, NoReturn

PVM_DATA_HOME: Path = Path(os.environ.get("PVM_HOME", str(Path.home() / ".local/share/ansible-managed/vm-podman/pvm")))
TEMPLATES_DIR: Path = PVM_DATA_HOME / "templates"
SCHEMA_PATH: Path = PVM_DATA_HOME / "template.schema.json"
# A single empty dir masked (read-only) over each hide_dir, hiding the host's real
# .git / .vscode from the container. Shared across containers (always empty).
MASK_DIR: Path = PVM_DATA_HOME / "mask"

# The SHARED, regenerable provision-asset cache (produced by
# roles/_shared_prebuilt_provision_assets, also included by pvm_install): the SAME
# dir ivm/qvm read - distro-package-groups.json + thirdparty-software.json + the
# feature-first dotfiles/ tree. `pvm` only READS it (at build time). Rarely
# overridden (env SHARED_PREBUILT_PROVISION_ASSETS_ROOT or --shared-assets-root).
DEFAULT_SHARED_ASSETS_ROOT: Path = Path(
    os.environ.get("SHARED_PREBUILT_PROVISION_ASSETS_ROOT",
                   str(Path.home() / ".local/share/ansible-managed/shared-prebuilt-provision-assets")))

# `crun` shares the host kernel (lightweight, default); `libkrun` is a microVM
# (stronger isolation, deferred). The user-facing flag value `libkrun` maps to
# podman's `krun` OCI-runtime handler (the runtime binary podman invokes).
DEFAULT_RUNTIME: str = "crun"
RUNTIME_CHOICES: tuple[str, ...] = ("crun", "libkrun")
RUNTIME_FLAG_TO_PODMAN: dict[str, str] = {"crun": "crun", "libkrun": "krun"}

# pvm-managed containers are named `pvm-<template>-<project>`; the prefix scopes
# `list` and never collides with hand-run podman containers. The cwd binding is
# stored in the `pvm.project_dir` LABEL (authoritative), not parsed from the name.
CONTAINER_NAME_PREFIX: str = "pvm-"
LABEL_MANAGED: str = "pvm.managed"
LABEL_TEMPLATE: str = "pvm.template"
LABEL_PROJECT_DIR: str = "pvm.project_dir"

# Default subpaths masked inside the cwd mount (hidden from the agent) when a
# template does not set `hide_dirs`. .git history + .vscode autorun are the classic
# risks - same default as the old container_apps HIDE_GIT_DIR / HIDE_VSCODE_DIR.
DEFAULT_HIDE_DIRS: tuple[str, ...] = (".git", ".vscode")

# image name string -> ansible_os_family (the shared cache's overlay key). Port of
# roles/container_templates/filter_plugins/distro.py mapped onto Debian/Suse/RedHat
# (the families the shared cache carries; alpine etc. -> None = unprovisionable).
CONTAINER_NAME_COLOR: str = "\033[1;36m"  # bold cyan, same convention as ivm/qvm
COLOR_RESET: str = "\033[0m"


class Mount(NamedTuple):
    host: Path
    name: str  # workspace name -> /workspaces/<name>


def colorize_container_name(container_name: str, *, stream: Any = sys.stderr) -> str:
    """Bold-cyan the container name on TTYs (NO_COLOR honored), plain otherwise."""
    if os.environ.get("NO_COLOR") or not stream.isatty():
        return container_name
    return f"{CONTAINER_NAME_COLOR}{container_name}{COLOR_RESET}"


def die(message: str) -> NoReturn:
    print(f"pvm: error: {message}", file=sys.stderr)
    raise SystemExit(1)


def run(command_argv: list[str], *, dry_run: bool, cwd: Path | None = None) -> None:
    """Run a mutating command, printing the exact argv FIRST (transparency rule)."""
    print("+ " + shlex.join(command_argv), file=sys.stderr)
    if dry_run:
        return
    subprocess.run(command_argv, check=True, cwd=cwd)


def run_capture(command_argv: list[str], *, cwd: Path | None = None) -> tuple[int, str, str]:
    """Run read-only, capture (returncode, stdout, stderr); missing binary -> rc 127."""
    try:
        completed = subprocess.run(command_argv, capture_output=True, text=True, check=False, cwd=cwd)
    except FileNotFoundError:
        return 127, "", f"{command_argv[0]}: not found"
    return completed.returncode, completed.stdout, completed.stderr


def confirm_or_die(prompt_text: str, *, assume_yes: bool) -> None:
    """y/N gate before anything heavy (build / delete) or the shared-kernel `init`
    gate. Non-TTY aborts unless --yes, so scripts can never stumble through it."""
    if assume_yes:
        return
    if not sys.stdin.isatty():
        die("not a TTY and --yes not given - refusing to proceed unconfirmed")
    reply: str = input(f"{prompt_text} [y/N] ").strip().lower()
    if reply not in ("y", "yes"):
        die("aborted by user")


# ---------- pure helpers (ported from host-cli.sh.j2 / distro.py; unit-tested) ----------


def distro_family_of_image(image_name: str) -> str | None:
    """Map a container image tag to its `ansible_os_family` (the shared cache's
    overlay key: Debian/Suse/RedHat). Port of filter_plugins/distro.py, mapped to
    the families the shared cache carries. Returns None for an unknown/unsupported
    base (e.g. alpine) so provisioning can fail clearly."""
    low: str = image_name.lower()
    if "debian" in low or "ubuntu" in low:
        return "Debian"
    if "suse" in low:  # opensuse/leap, opensuse/tumbleweed
        return "Suse"
    if any(token in low for token in ("fedora", "rocky", "centos", "almalinux")):
        return "RedHat"
    return None


def project_name_from_cwd(cwd: Path, home: Path) -> str:
    """Derive a stable, container-name-safe project slug from the cwd (port of the
    old launcher's `$PWD` minus `$HOME`, `/`->`_`). Uses the cwd's path RELATIVE to
    $HOME so two same-basename dirs differ; non-alphanumerics collapse to `-`."""
    resolved_cwd: Path = cwd.resolve()
    try:
        relative: str = str(resolved_cwd.relative_to(home.resolve()))
    except ValueError:
        relative = str(resolved_cwd).lstrip("/")
    if not relative or relative == ".":
        relative = resolved_cwd.name or "root"
    slug: str = re.sub(r"[^A-Za-z0-9_.-]+", "-", relative).strip("-._").lower()
    return slug or "proj"


def cwd_mount(cwd: Path) -> Mount:
    """The cwd mounted at /workspaces/<name>. <name> = cwd basename with a leading
    dot rewritten to `_` (so dotdirs stay name-safe) and other odd chars -> `_`."""
    raw_name: str = cwd.resolve().name or "workspace"
    workspace_name: str = ("_" + raw_name[1:]) if raw_name.startswith(".") else raw_name
    workspace_name = re.sub(r"[^A-Za-z0-9._-]", "_", workspace_name)
    if not re.match(r"^[A-Za-z0-9_]", workspace_name):
        workspace_name = "_" + workspace_name
    return Mount(host=cwd.resolve(), name=workspace_name)


def workspace_workdir(mounts: list[Mount]) -> str:
    """Container workdir: a single mount -> that workspace dir; multi -> /workspaces."""
    if len(mounts) == 1:
        return f"/workspaces/{mounts[0].name}"
    return "/workspaces"


def container_name_for(template_name: str, project_name: str) -> str:
    return f"{CONTAINER_NAME_PREFIX}{template_name}-{project_name}"


def image_ref_for(template_name: str, tag: str) -> str:
    """The per-template image ref, tagged by a content hash. `localhost/` keeps podman
    from treating it as a remote; the name is lowercased because OCI image references
    must be lowercase (the schema's template_name pattern still allows uppercase,
    which is fine for container names but not image refs)."""
    return f"localhost/pvm/{template_name.lower()}:{tag}"


def hide_dir_volume_args(mounts: list[Mount], hide_dirs: list[str]) -> list[str]:
    """`--volume` args masking each hide_dir under each mount with the empty MASK_DIR
    (read-only), so the container sees an empty .git/.vscode instead of the host's."""
    volume_args: list[str] = []
    for mount in mounts:
        for sub_path in hide_dirs:
            volume_args += ["--volume", f"{MASK_DIR}:/workspaces/{mount.name}/{sub_path}:ro"]
    return volume_args


def build_podman_run_argv(*, image_ref: str, container_name: str, template_name: str,
                          mounts: list[Mount], hide_dirs: list[str], publish_ports: list[str],
                          runtime: str, network: str | None) -> list[str]:
    """The exact `podman run` argv for a per-project container. Pure (no podman
    call) - what `run --dry-run` prints. Port of host-cli.sh.j2 `cmd_run`."""
    argv: list[str] = [
        "podman", "run", "--detach", "--tty",
        "--name", container_name,
        "--userns=keep-id",
        "--runtime", RUNTIME_FLAG_TO_PODMAN[runtime],
        "--hostname", container_name,
        "--workdir", workspace_workdir(mounts),
        "--label", f"{LABEL_MANAGED}=true",
        "--label", f"{LABEL_TEMPLATE}={template_name}",
        "--label", f"{LABEL_PROJECT_DIR}={mounts[0].host}",
    ]
    if network:
        argv += ["--network", network]
    for mount in mounts:
        argv += ["--volume", f"{mount.host}:/workspaces/{mount.name}"]
    argv += hide_dir_volume_args(mounts, hide_dirs)
    for port in publish_ports:
        argv += ["--publish", port]
    argv.append(image_ref)
    return argv


def load_template(template_name: str) -> dict[str, Any]:
    """Load + validate a template YAML from TEMPLATES_DIR against the JSON schema."""
    import yaml  # ships with ansible-core / python3-yaml (a pvm host dep)
    template_path: Path = TEMPLATES_DIR / f"{template_name}.yaml"
    if not template_path.is_file():
        available: list[str] = sorted(p.stem for p in TEMPLATES_DIR.glob("*.yaml")) if TEMPLATES_DIR.is_dir() else []
        die(f"no template '{template_name}' in {TEMPLATES_DIR}"
            + (f" (have: {', '.join(available)})" if available else "; re-run `make vm-podman-install`"))
    loaded: Any = yaml.safe_load(template_path.read_text())
    if not isinstance(loaded, dict):
        die(f"template {template_path} is not a mapping")
    validate_template(loaded, template_name)
    return loaded


def load_template_quiet(template_name: str) -> dict[str, Any] | None:
    """Best-effort template load for READ-ONLY display (`info`): returns None instead of
    dying when the file is missing or unparseable, so `info` never aborts over a template
    issue (the agent line just shows a placeholder)."""
    import yaml
    template_path: Path = TEMPLATES_DIR / f"{template_name}.yaml"
    if not template_path.is_file():
        return None
    try:
        loaded: Any = yaml.safe_load(template_path.read_text())
    except (yaml.YAMLError, OSError):
        return None
    return loaded if isinstance(loaded, dict) else None


def validate_template(doc: dict[str, Any], template_name: str) -> None:
    """Validate against template.schema.json with jsonschema when available; else a
    minimal manual check of the required fields (jsonschema is a pvm host dep, but
    keep working if it is missing - mirror ivm's tolerance)."""
    import json
    required_fields: tuple[str, ...] = ("template_name", "image_name")
    missing: list[str] = [field for field in required_fields if field not in doc]
    if missing:
        die(f"template '{template_name}' missing required field(s): {', '.join(missing)}")
    try:
        import jsonschema
    except ImportError:
        return
    if not SCHEMA_PATH.is_file():
        return
    schema: dict[str, Any] = json.loads(SCHEMA_PATH.read_text())
    errors = sorted(jsonschema.Draft202012Validator(schema).iter_errors(doc), key=lambda e: list(e.path))
    if errors:
        location: str = "/".join(str(part) for part in errors[0].path) or "(root)"
        die(f"template '{template_name}' invalid at {location}: {errors[0].message}")


def resolve_runtime(template: dict[str, Any], requested_runtime: str) -> str:
    """The runtime to use: the one requested on the CLI, asserted to be one this
    template declares in `runtimes` (default [crun])."""
    supported: list[str] = template.get("runtimes", ["crun"])
    if requested_runtime not in supported:
        die(f"template '{template['template_name']}' does not support runtime "
            f"'{requested_runtime}' (declares: {', '.join(supported)})")
    return requested_runtime


# ---------- provision resolver (reads the SHARED asset cache) ----------
# Duplicated verbatim from `ivm`/`qvm` BY DESIGN: each launcher is a standalone
# single-file tool reading the SAME shared JSON (the DATA is the one source of
# truth; the resolver CODE is copied so pvm needs no ivm/qvm import). Keep in sync
# with roles/vm_incus/files/ivm + roles/vm_quickemu/files/qvm.


def load_package_groups(shared_root: Path) -> dict[str, Any]:
    """Load distro-package-groups.json (rendered from the provision_distro_packages registry)."""
    path: Path = shared_root / "distro-package-groups.json"
    if not path.is_file():
        die(f"distro-package-groups.json not found: {path}; re-run `make vm-podman-install`")
    loaded: Any = json.loads(path.read_text())
    if not isinstance(loaded, dict):
        die(f"distro-package-groups.json is not a mapping: {path}")
    return loaded


def load_thirdparty_software(shared_root: Path) -> dict[str, Any]:
    """Load thirdparty-software.json (rendered from the provision_thirdparty_software registry)."""
    path: Path = shared_root / "thirdparty-software.json"
    if not path.is_file():
        die(f"thirdparty-software.json not found: {path}; re-run `make vm-podman-install`")
    loaded: Any = json.loads(path.read_text())
    if not isinstance(loaded, dict):
        die(f"thirdparty-software.json is not a mapping: {path}")
    return loaded


def overlay_install_packages(overlay: Any) -> list[str]:
    """A family overlay is EITHER a bare package list OR `{install: [...], post_install: <shell>}`.
    Return its package list either way."""
    if isinstance(overlay, dict):
        return list(overlay.get("install", []))
    return list(overlay or [])


def overlay_post_install(overlay: Any) -> str:
    """The optional `post_install` shell snippet of a family overlay (dict form only)."""
    if isinstance(overlay, dict):
        return str(overlay.get("post_install", "") or "")
    return ""


def resolve_group(registry: dict[str, Any], group: str, ansible_os_family: str) -> list[str]:
    """A bundle resolves to `__common__ + <ansible_os_family overlay>` packages."""
    entry: Any = registry.get(group)
    if entry is None:
        die(f"unknown distro_package_group '{group}' "
            f"(not in distro-package-groups.json; defined: {', '.join(sorted(registry))})")
    return overlay_install_packages(entry.get("__common__")) + overlay_install_packages(entry.get(ansible_os_family))


def group_post_install_snippet(group_entry: dict[str, Any], ansible_os_family: str) -> str:
    """A bundle's `post_install` for one family: __common__ snippet + family snippet (additive)."""
    parts: list[str] = [overlay_post_install(group_entry.get("__common__")),
                        overlay_post_install(group_entry.get(ansible_os_family))]
    return "\n".join(part for part in parts if part.strip())


def groups_post_install_script(groups: list[str], registry: dict[str, Any], ansible_os_family: str) -> str:
    """Concatenate the resolved `post_install` snippets of the given bundles. Run as ROOT
    after the packages install. Idempotent."""
    script: str = ""
    for group in groups:
        snippet: str = group_post_install_snippet(registry.get(group) or {}, ansible_os_family)
        if snippet.strip():
            script += f"echo '==> {group}: post_install' >&2\n"
            script += snippet if snippet.endswith("\n") else snippet + "\n"
    return script


# zypper is the most failure-prone of the three; run it non-interactively (ivm/qvm policy).
ZYPPER: str = "zypper --non-interactive"


def install_packages_script(ansible_os_family: str, packages: list[str]) -> str:
    """Per-family package install with recommends/weak-deps OFF."""
    pkgs: str = " ".join(packages)
    if ansible_os_family == "Debian":
        return ("export DEBIAN_FRONTEND=noninteractive\n"
                "apt-get update -qq\n"
                f"apt-get install --yes --no-install-recommends {pkgs}\n")
    if ansible_os_family == "Suse":
        return f"{ZYPPER} refresh\n{ZYPPER} install --no-recommends {pkgs}\n"
    if ansible_os_family == "RedHat":
        return f"dnf install --assumeyes --setopt=install_weak_deps=False {pkgs}\n"
    die(f"no package-manager mapping for ansible_os_family '{ansible_os_family}'")


def resolve_thirdparty_software(names: list[str], registry: dict[str, Any],
                                ansible_os_family: str) -> list[dict[str, Any]]:
    """Resolve `thirdparty_software` names into `{name, already_installed?, install_script}`
    recipes for this family (OVERRIDE: family entry if defined, else __common__)."""
    recipes: list[dict[str, Any]] = []
    for name in names:
        entry: Any = registry.get(name)
        if entry is None:
            die(f"unknown thirdparty_software '{name}' (not in thirdparty-software.json; "
                f"defined: {', '.join(sorted(registry))})")
        family_recipe: Any = entry.get(ansible_os_family) or entry.get("__common__")
        if family_recipe is None:
            die(f"thirdparty_software '{name}' has no recipe for {ansible_os_family}")
        install_script: str = family_recipe.get("install_script", "")
        if not install_script:
            die(f"thirdparty_software '{name}' ({ansible_os_family}) has no install_script")
        recipes.append({"name": name, "already_installed": family_recipe.get("already_installed"),
                        "install_script": install_script})
    return recipes


def thirdparty_install_script(recipes: list[dict[str, Any]]) -> str:
    """Shell (run as root) installing each recipe, guarded by its `already_installed`
    probe when present (rc 0 -> skip). Each recipe's install_script is verbatim."""
    script: str = ""
    for recipe in recipes:
        install: str = recipe["install_script"]
        if not install.endswith("\n"):
            install += "\n"
        probe: str | None = recipe.get("already_installed")
        script += f"echo '==> thirdparty_software: {recipe['name']}' >&2\n"
        if probe:
            script += (f"if {{ {probe}; }} >/dev/null 2>&1; then\n"
                       f"  echo '    already present, skipping' >&2\nelse\n{install}fi\n")
        else:
            script += install
    return script


# ---------- image build pipeline (provision-via-exec + podman commit; no Dockerfile) ----------

# The ONLY container-specific dotfile bit (the rest comes from the shared cache,
# same as ivm/qvm). Auto-cd into the workspace on interactive login. Ported from
# roles/container_templates/templates/zshrc.j2.
WORKSPACE_AUTOCD_ZSH: str = (
    'if [[ -o interactive && -d /workspaces ]]; then\n'
    '  _pvm_count=0; _pvm_first=""\n'
    '  for _pvm_d in /workspaces/*(N/); do\n'
    '    _pvm_count=$((_pvm_count + 1)); [[ -z "$_pvm_first" ]] && _pvm_first="$_pvm_d"\n'
    '  done\n'
    '  (( _pvm_count == 1 )) && cd "$_pvm_first"\n'
    '  (( _pvm_count > 1 )) && cd /workspaces\n'
    '  unset _pvm_count _pvm_first _pvm_d\n'
    'fi\n'
)
WORKSPACE_AUTOCD_BASH: str = (
    'if [[ $- == *i* && -d /workspaces ]]; then\n'
    '  shopt -s nullglob; _pvm_dirs=(/workspaces/*/); shopt -u nullglob\n'
    '  if (( ${#_pvm_dirs[@]} == 1 )); then cd "${_pvm_dirs[0]}"\n'
    '  elif (( ${#_pvm_dirs[@]} > 1 )); then cd /workspaces; fi\n'
    '  unset _pvm_dirs\n'
    'fi\n'
)

# Create the unprivileged `user` (uid/gid 1000) so --userns=keep-id maps the host
# user in, and the thirdparty recipes' `su - user -c` land in /home/user. Run as
# root AFTER packages (so zsh exists for the login shell).
CREATE_USER_SCRIPT: str = (
    'if ! id user >/dev/null 2>&1; then\n'
    '  groupadd -g 1000 user 2>/dev/null || true\n'
    '  useradd --create-home --uid 1000 --gid 1000 --shell "$(command -v zsh || echo /bin/bash)" user\n'
    'fi\n'
    'usermod --shell "$(command -v zsh || echo /bin/bash)" user >/dev/null 2>&1 || true\n'
    'chown user:user /home/user\n'
)

DOTFILE_BUCKET_SIDES: tuple[tuple[str, str], ...] = (("home/user", "/home/user/"), ("root", "/root/"))

# Baked into the committed image's ENV so `podman exec` (which sources NO rc files)
# finds user-scoped binaries - claude in ~/.local/bin, codex in ~/.local/npm_global/bin.
# The shared dotfiles add these for interactive/login shells; this covers `pvm agent`/
# `exec`. Mirrors the old container Dockerfile's `ENV PATH=/home/user/.local/bin:...`.
IMAGE_ENV_PATH: str = ("/home/user/.local/bin:/home/user/.local/npm_global/bin:"
                       "/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin")


def resolve_packages(template: dict[str, Any], registry: dict[str, Any], family: str) -> list[str]:
    """The template's groups (resolved per family) + its flat distro_packages, deduped."""
    packages: list[str] = []
    for group in template.get("distro_package_groups", []):
        packages += resolve_group(registry, group, family)
    packages += template.get("distro_packages", [])
    return list(dict.fromkeys(packages))


# Marker every launcher (ivm/qvm/pvm) drops into its guest so the shared shell dotfiles
# can badge the prompt. Its CONTENTS are this launcher's id; the shared PS1 snippet
# (`roles/_shared_j2_snippets/templates/{zsh,bash}_ps1_*.j2`) reads it and prefixes the
# prompt with one box glyph per isolation level (full VM = 3, container = 1). The host
# runs the SAME dotfiles but has no marker, so its prompt is unchanged. pvm is a podman
# container (shared-kernel, weaker isolation) -> one glyph.
MANAGED_GUEST_TYPE_MARKER_PATH: str = "/etc/ansible-managed-guest-type"
GUEST_TYPE: str = "pvm"


def guest_type_marker_script() -> str:
    """Shell (run as root in the build container) writing this launcher's id (the
    `GUEST_TYPE` constant) to `MANAGED_GUEST_TYPE_MARKER_PATH`, baked into the committed
    image so every container off it badges the prompt via the shared PS1 snippet."""
    return (
        f"echo '==> managed-guest marker: {MANAGED_GUEST_TYPE_MARKER_PATH} ({GUEST_TYPE})' >&2\n"
        f"printf '%s\\n' {GUEST_TYPE} > {MANAGED_GUEST_TYPE_MARKER_PATH}\n"
    )


def build_provision_script(template: dict[str, Any], distro_registry: dict[str, Any],
                           tp_registry: dict[str, Any], family: str) -> str:
    """The shell run as ROOT in the build container: packages -> create user ->
    bundle post_installs -> thirdparty recipes -> the template's post_install_script."""
    packages: list[str] = resolve_packages(template, distro_registry, family)
    parts: list[str] = ["set -e"]
    # Bake the managed-guest marker into the image so every container off it badges the
    # prompt; the shared PS1 snippet reads it (pvm = one box glyph, container isolation).
    parts.append(guest_type_marker_script())
    if packages:
        parts.append(install_packages_script(family, packages))
    parts.append(CREATE_USER_SCRIPT)
    parts.append(groups_post_install_script(template.get("distro_package_groups", []), distro_registry, family))
    parts.append(thirdparty_install_script(
        resolve_thirdparty_software(template.get("thirdparty_software", []), tp_registry, family)))
    if template.get("post_install_script"):
        parts.append(str(template["post_install_script"]))
    return "\n".join(part for part in parts if part.strip()) + "\n"


def dotfiles_copy_argv(container: str, template: dict[str, Any], family: str,
                       shared_root: Path) -> list[list[str]]:
    """`podman cp` argv to stage each requested dotfiles feature's `{__common__,<family>}`
    home/user + root buckets into the container (common first, family overlays)."""
    copy_commands: list[list[str]] = []
    dotfiles_root: Path = shared_root / "dotfiles"
    for feature in template.get("dotfiles", []):
        for bucket in ("__common__", family):
            for side_subpath, container_dest in DOTFILE_BUCKET_SIDES:
                source_dir: Path = dotfiles_root / feature / bucket / side_subpath
                if source_dir.is_dir():
                    copy_commands.append(["podman", "cp", f"{source_dir}/.", f"{container}:{container_dest}"])
    return copy_commands


def overlay_append_script() -> str:
    """Append the /workspaces auto-cd overlay to the staged user+root rc files
    (idempotent via the `pvm-workspace-autocd` marker)."""
    return (
        '_pvm_append() {\n'
        '  [ -f "$1" ] || return 0\n'
        '  grep -q "pvm-workspace-autocd" "$1" && return 0\n'
        '  printf "\\n# pvm-workspace-autocd\\n%s\\n" "$2" >> "$1"\n'
        '}\n'
        f'_pvm_append /home/user/.zshrc {shlex.quote(WORKSPACE_AUTOCD_ZSH)}\n'
        f'_pvm_append /root/.zshrc {shlex.quote(WORKSPACE_AUTOCD_ZSH)}\n'
        f'_pvm_append /home/user/.bashrc {shlex.quote(WORKSPACE_AUTOCD_BASH)}\n'
        f'_pvm_append /root/.bashrc {shlex.quote(WORKSPACE_AUTOCD_BASH)}\n'
        'chown user:user /home/user/.zshrc /home/user/.bashrc 2>/dev/null || true\n'
    )


def content_hash(template: dict[str, Any], family: str, shared_root: Path, provision_script: str) -> str:
    """A stable 12-hex digest over everything that defines the image: the template,
    the resolved provision script, the overlay, and the staged dotfiles bytes. An
    edit to any of them changes the tag, so `init` rebuilds instead of reusing a
    stale image."""
    hasher = hashlib.sha256()
    hasher.update(json.dumps(template, sort_keys=True).encode())
    hasher.update(family.encode())
    hasher.update(provision_script.encode())
    hasher.update(WORKSPACE_AUTOCD_ZSH.encode())
    hasher.update(WORKSPACE_AUTOCD_BASH.encode())
    hasher.update(IMAGE_ENV_PATH.encode())
    dotfiles_root: Path = shared_root / "dotfiles"
    for feature in sorted(template.get("dotfiles", [])):
        for bucket in ("__common__", family):
            for side_subpath, _ in DOTFILE_BUCKET_SIDES:
                source_dir: Path = dotfiles_root / feature / bucket / side_subpath
                if source_dir.is_dir():
                    for file_path in sorted(source_dir.rglob("*")):
                        if file_path.is_file():
                            hasher.update(str(file_path.relative_to(dotfiles_root)).encode())
                            hasher.update(file_path.read_bytes())
    return hasher.hexdigest()[:12]


def image_exists(image_ref: str) -> bool:
    return run_capture(["podman", "image", "exists", image_ref])[0] == 0


def build_image(template: dict[str, Any], *, shared_root: Path, network: str | None,
                rebuild: bool, dry_run: bool) -> str:
    """Build (provision + commit) the per-template image, keyed by a content hash.
    Reuses an existing image with the same hash unless --rebuild. Returns the image ref."""
    template_name: str = template["template_name"]
    family: str | None = distro_family_of_image(template["image_name"])
    if family is None:
        die(f"template '{template_name}' image '{template['image_name']}' has no supported "
            f"distro family (Debian/Suse/RedHat) - cannot provision it")
    distro_registry: dict[str, Any] = load_package_groups(shared_root)
    tp_registry: dict[str, Any] = load_thirdparty_software(shared_root)
    provision_script: str = build_provision_script(template, distro_registry, tp_registry, family)
    image_ref: str = image_ref_for(template_name, content_hash(template, family, shared_root, provision_script))

    if not rebuild and not dry_run and image_exists(image_ref):
        print(f"==> image {image_ref} already built (use --rebuild to force)", file=sys.stderr)
        return image_ref

    build_container: str = f"pvm-build-{template_name}"
    network_args: list[str] = ["--network", network] if network else []
    if dry_run:
        print(f"==> would build {image_ref} (family={family})", file=sys.stderr)
        print(f"--- provision.sh (run as root in the build container) ---\n{provision_script}", file=sys.stderr)
    run(["podman", "rm", "--force", build_container], dry_run=dry_run)
    run(["podman", "run", "--detach", *network_args, "--name", build_container,
         template["image_name"], "sleep", "infinity"], dry_run=dry_run)
    try:
        run(["podman", "exec", build_container, "bash", "-ec", provision_script], dry_run=dry_run)
        for copy_argv in dotfiles_copy_argv(build_container, template, family, shared_root):
            run(copy_argv, dry_run=dry_run)
        run(["podman", "exec", build_container, "chown", "-R", "1000:1000", "/home/user"], dry_run=dry_run)
        run(["podman", "exec", build_container, "bash", "-ec", overlay_append_script()], dry_run=dry_run)
        run(["podman", "commit", "--change", 'CMD ["sleep", "infinity"]',
             "--change", "WORKDIR /workspaces", "--change", f"ENV PATH={IMAGE_ENV_PATH}",
             build_container, image_ref], dry_run=dry_run)
    finally:
        run(["podman", "rm", "--force", build_container], dry_run=dry_run)
    print(f"==> built {colorize_container_name(image_ref)}", file=sys.stderr)
    return image_ref


