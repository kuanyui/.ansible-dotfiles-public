def cmd_reboot(container_name: str, *, assume_yes: bool, dry_run: bool) -> None:
    """Restart the cwd container (`podman restart`). Confirms first (ivm `reboot` parity)."""
    confirm_or_die(f"restart container {container_name}?", assume_yes=assume_yes)
    run(["podman", "restart", container_name], dry_run=dry_run)
    print(f"==> {colorize_container_name(container_name)} restarted.", file=sys.stderr)


def cmd_delete(container_name: str, *, assume_yes: bool, dry_run: bool) -> None:
    """Remove the cwd container, KEEPING the shared per-template image (ivm `delete`
    parity). The image is reused by other projects' containers, so removing it is the
    explicit `rmi`/`rma`, never `delete`."""
    confirm_or_die(f"delete container {container_name} (keeps the per-template image)?",
                   assume_yes=assume_yes)
    run(["podman", "rm", "--force", container_name], dry_run=dry_run)
    print(f"==> deleted container {colorize_container_name(container_name)}.", file=sys.stderr)


def cmd_agent(container_name: str, *, runtime: str, dry_run: bool) -> None:
    """Run the template's configured agent command in the container, as `user`. The
    template is read from the container's pvm.template label (read-only, so this also
    works under --dry-run)."""
    template_name: str = container_template_name(container_name)
    agent: dict[str, Any] = load_template(template_name).get("agent") or {}
    if not agent.get("command"):
        die(f"template '{template_name}' has no `agent` command to run")
    exec_into(container_name, shlex.split(str(agent["command"])), as_root=False,
              runtime=runtime, dry_run=dry_run)


def cmd_push(container_name: str, local_path: str, guest_path: str, *,
             as_root: bool, dry_run: bool) -> None:
    """Copy a host file/dir into the container at <guest_path> (`podman cp`). It lands owned
    by the container `user` (--userns=keep-id maps the host user in); --as-root then re-owns
    the pushed path to root (chown -R). ivm `push` parity. The optional chown starts the
    container (`podman exec` needs it running); plain copy works stopped too."""
    if not dry_run and not Path(local_path).exists():
        die(f"local path does not exist: {local_path}")
    run(["podman", "cp", local_path, f"{container_name}:{guest_path}"], dry_run=dry_run)
    if as_root:
        ensure_started(container_name, dry_run=dry_run)
        run(["podman", "exec", "--user", "root", container_name,
             "chown", "-R", "root:root", guest_path], dry_run=dry_run)
    ownership: str = " (root-owned)" if as_root else ""
    print(f"==> pushed {local_path} -> {colorize_container_name(container_name)}:{guest_path}{ownership}",
          file=sys.stderr)


# In-place upgrade run as ROOT inside the container. Detects the package manager itself, so
# it needs neither the template nor the image->family mapping (the container may have drifted).
CONTAINER_UPDATE_SCRIPT: str = (
    "set -e\n"
    "if command -v apt-get >/dev/null 2>&1; then\n"
    "  export DEBIAN_FRONTEND=noninteractive\n"
    "  apt-get update -qq && apt-get upgrade --yes\n"
    "elif command -v zypper >/dev/null 2>&1; then\n"
    "  zypper --non-interactive refresh && zypper --non-interactive update\n"
    "elif command -v dnf >/dev/null 2>&1; then\n"
    "  dnf upgrade --assumeyes\n"
    "else\n"
    "  echo 'pvm update: no supported package manager (apt-get/zypper/dnf) in the container' >&2\n"
    "  exit 1\n"
    "fi\n"
)


def cmd_update(container_name: str, *, dry_run: bool) -> None:
    """Refresh + upgrade all distro packages inside the container, as root (detects
    apt-get / zypper / dnf). ivm `update` parity. Starts the container if it is stopped."""
    ensure_started(container_name, dry_run=dry_run)
    run(["podman", "exec", "--user", "root", container_name, "bash", "-ec", CONTAINER_UPDATE_SCRIPT],
        dry_run=dry_run)
    print(f"==> {colorize_container_name(container_name)} packages updated.", file=sys.stderr)


def cmd_resize(container_name: str, *, cpu: str | None, memory: str | None, dry_run: bool) -> None:
    """Change the container's vCPU and/or memory limit IN PLACE (`podman update`). ivm
    `resize` parity, cpu/memory only: a rootless container's overlay rootfs is not resizable,
    so there is NO --disk. At least one of --cpu/--memory is required. The ivm-aligned flag
    names (--cpu/--memory) map onto podman's --cpus/--memory."""
    update_argv: list[str] = ["podman", "update"]
    if cpu is not None:
        update_argv += ["--cpus", cpu]
    if memory is not None:
        update_argv += ["--memory", memory]
    if len(update_argv) == 2:
        die("resize: specify --cpu and/or --memory (no --disk: a rootless container's rootfs "
            "is not resizable)")
    update_argv.append(container_name)
    run(update_argv, dry_run=dry_run)
    print(f"==> {colorize_container_name(container_name)} resized.", file=sys.stderr)


def container_family(container_name: str) -> str:
    """The container's ansible_os_family (Debian/Suse/RedHat) for provisioning, from its
    pvm.template label -> the template's image_name. Dies if it cannot be resolved."""
    template_name: str = container_template_name(container_name)
    template: dict[str, Any] | None = load_template_quiet(template_name) if template_name else None
    family: str | None = distro_family_of_image(str(template.get("image_name", ""))) if template else None
    if family is None:
        die(f"cannot resolve the distro family of {container_name} (pvm.template label "
            f"'{template_name or '(unset)'}' missing or unmapped)")
    return family


def cmd_list_provision_units(shared_root: Path) -> None:
    """List every provisionable unit - distro package groups + thirdparty software + dotfiles
    features - with descriptions. Bare `pvm provision` (ivm parity). Lists for bash users too
    (CLAUDE.md), the same data the completions read."""
    distro_registry: dict[str, Any] = load_package_groups(shared_root)
    tp_registry: dict[str, Any] = load_thirdparty_software(shared_root)
    dotfiles_root: Path = shared_root / "dotfiles"
    print("distro package groups:")
    for group_name in sorted(distro_registry):
        entry: Any = distro_registry[group_name]
        description: str = entry.get("description", "") if isinstance(entry, dict) else ""
