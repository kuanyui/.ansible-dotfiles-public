        print("  (none)")


def cmd_provision(container_name: str, units: list[str], *, shared_root: Path, dry_run: bool) -> None:
    """Install distro package groups / thirdparty software / dotfiles features into the RUNNING
    container's writable layer (persists across stop/start like a VM's disk; lost on delete).
    ivm `provision <unit>` parity. A unit present in more than one registry applies ALL of them
    (e.g. `emacs` = the package group AND its dotfiles; `dev_android` = the bundle AND the
    recipe). Order: distro packages + their post_install, then thirdparty recipes, then dotfiles.
    The container's family comes from its pvm.template label."""
    distro_registry: dict[str, Any] = load_package_groups(shared_root)
    tp_registry: dict[str, Any] = load_thirdparty_software(shared_root)
    dotfiles_root: Path = shared_root / "dotfiles"

    # Classify each unit FIRST (no podman needed) so a typo fails fast before we touch the
    # container. A unit can land in more than one bucket (applies all - ivm parity).
    groups: list[str] = []
    thirdparty_names: list[str] = []
    dotfiles_features: list[str] = []
    unknown: list[str] = []
    for unit in units:
        matched: bool = False
        if unit in distro_registry:
            groups.append(unit); matched = True
        if unit in tp_registry:
            thirdparty_names.append(unit); matched = True
        if (dotfiles_root / unit).is_dir():
            dotfiles_features.append(unit); matched = True
        if not matched:
            unknown.append(unit)
    if unknown:
        die(f"unknown provision unit(s): {', '.join(unknown)} (run `pvm provision` with no "
            f"args to list every available unit)")

    family: str = container_family(container_name)
    ensure_started(container_name, dry_run=dry_run)

    packages: list[str] = []
    for group in groups:
        packages += resolve_group(distro_registry, group, family)
    script_parts: list[str] = ["set -e"]
    if packages:
        script_parts.append(install_packages_script(family, list(dict.fromkeys(packages))))
    if groups:
        script_parts.append(groups_post_install_script(groups, distro_registry, family))
    if thirdparty_names:
        script_parts.append(thirdparty_install_script(
            resolve_thirdparty_software(thirdparty_names, tp_registry, family)))
    provision_script: str = "\n".join(part for part in script_parts if part.strip()) + "\n"
    if provision_script.strip() != "set -e":
        run(["podman", "exec", "--user", "root", container_name, "bash", "-ec", provision_script],
            dry_run=dry_run)

    if dotfiles_features:
        for copy_argv in dotfiles_copy_argv(container_name, {"dotfiles": dotfiles_features}, family, shared_root):
            run(copy_argv, dry_run=dry_run)
        run(["podman", "exec", container_name, "chown", "-R", "1000:1000", "/home/user"], dry_run=dry_run)
        run(["podman", "exec", "--user", "root", container_name, "bash", "-ec", overlay_append_script()],
            dry_run=dry_run)

    print(f"==> provisioned {', '.join(units)} into {colorize_container_name(container_name)}.",
          file=sys.stderr)


def cmd_overwrite_dotfiles(container_name: str, *, shared_root: Path, dry_run: bool) -> None:
    """Re-push the template's dotfiles slice into the container (NO reprovision) - refresh the
    staged dotfiles after editing them on the host. ivm `overwrite-dotfiles` parity. The template
    (-> its dotfiles list + family) comes from the container's pvm.template label."""
    template_name: str = container_template_name(container_name)
    template: dict[str, Any] | None = load_template_quiet(template_name) if template_name else None
    if template is None:
        die(f"cannot resolve the template of {container_name} (pvm.template label "
            f"'{template_name or '(unset)'}' missing); recreate it via `pvm init`")
    family: str | None = distro_family_of_image(str(template.get("image_name", "")))
    if family is None:
        die(f"template '{template_name}' image has no supported distro family")
    if not template.get("dotfiles"):
        die(f"template '{template_name}' declares no dotfiles to overwrite")
    ensure_started(container_name, dry_run=dry_run)
    for copy_argv in dotfiles_copy_argv(container_name, template, family, shared_root):
        run(copy_argv, dry_run=dry_run)
    run(["podman", "exec", container_name, "chown", "-R", "1000:1000", "/home/user"], dry_run=dry_run)
    run(["podman", "exec", "--user", "root", container_name, "bash", "-ec", overlay_append_script()],
        dry_run=dry_run)
    print(f"==> re-pushed dotfiles into {colorize_container_name(container_name)}.", file=sys.stderr)


def cmd_build(template_name: str, *, shared_root: Path, network: str | None,
              rebuild: bool, dry_run: bool) -> None:
    """Build (provision + commit) the per-template image only - no container run.
    `pvm init` (3.3) calls the same build_image() then runs a container from it."""
    template: dict[str, Any] = load_template(template_name)
    build_image(template, shared_root=shared_root, network=network, rebuild=rebuild, dry_run=dry_run)


def cmd_list() -> None:
    """List pvm-managed containers (name, status, image). Read-only `podman ps`;
    degrades to a hint when podman is absent."""
    return_code, stdout, stderr = run_capture(
        ["podman", "ps", "--all", "--filter", f"label={LABEL_MANAGED}=true",
         "--format", "{{.Names}}\t{{.Status}}\t{{.Image}}"])
    if return_code == 127:
        print("pvm: podman not found - run `make vm-podman-install` first", file=sys.stderr)
        return
    if return_code != 0:
        die(f"podman ps failed: {stderr.strip()}")
    container_rows: list[str] = [row for row in stdout.splitlines() if row.strip()]
    if not container_rows:
        print("no pvm-managed containers", file=sys.stderr)
        return
    print("\n".join(container_rows))


def cmd_top(stats_args: list[str], *, dry_run: bool) -> None:
    """Live resource stats (CPU / memory / net / block IO) - passthrough to `podman stats`,
    replacing the pvm process so streaming + Ctrl-C are clean. ivm `top` parity. No args = all
    running containers; pass container names / `podman stats` flags (e.g. --no-stream) to scope."""
    stats_argv: list[str] = ["podman", "stats", *stats_args]
    print("+ " + shlex.join(stats_argv), file=sys.stderr)
    if dry_run:
        return
    os.execvp("podman", stats_argv)


def _container_cpu_limit(host_config: dict[str, Any]) -> str:
    """vCPU limit from inspect HostConfig.NanoCpus; `(host default)` when unset (0)."""
    nano_cpus: int = int(host_config.get("NanoCpus") or 0)
    if nano_cpus <= 0:
        return "(host default)"
    return f"{nano_cpus / 1_000_000_000:g}"


def _container_memory_limit(host_config: dict[str, Any]) -> str:
    """Memory limit from inspect HostConfig.Memory (bytes); `(host default)` when unset (0)."""
    memory_bytes: int = int(host_config.get("Memory") or 0)
    if memory_bytes <= 0:
        return "(host default)"
    size: float = float(memory_bytes)
    for unit in ("B", "K", "M", "G", "T"):
        if size < 1024 or unit == "T":
            return f"{size:.0f}{unit}"
        size /= 1024
    return f"{memory_bytes}B"


def _container_published_ports(host_config: dict[str, Any]) -> str:
    """Published ports from inspect HostConfig.PortBindings as `host->guest/proto`;
    `(none)` when the container publishes nothing."""
    port_bindings: dict[str, Any] = host_config.get("PortBindings") or {}
    entries: list[str] = []
    for guest_port_proto, bindings in sorted(port_bindings.items()):
        for binding in (bindings or []):
            host_ip: str = binding.get("HostIp") or ""
            host_port: str = binding.get("HostPort") or "?"
            entries.append(f"{(host_ip + ':') if host_ip else ''}{host_port}->{guest_port_proto}")
    return ", ".join(entries) if entries else "(none)"


def _container_mount_lines(info: dict[str, Any]) -> list[str]:
    """One line per mount: `<source> -> <dest> [ro]`; the empty MASK_DIR masked over a
    hide_dir is flagged `(mask)`. `(none)` when the container has no mounts."""
    mounts: list[dict[str, Any]] = info.get("Mounts") or []
    lines: list[str] = []
    for mount in mounts:
        source: str = mount.get("Source") or "?"
        destination: str = mount.get("Destination") or "?"
        read_only: str = "" if mount.get("RW", True) else " [ro]"
        mask: str = " (mask)" if source == str(MASK_DIR) else ""
        lines.append(f"{source} -> {destination}{read_only}{mask}")
    return lines or ["(none)"]


def cmd_info(container_name: str) -> None:
    """Show the cwd container's state: status/image/template/hw/network/ports/mounts/
    agent. Read-only `podman inspect`; EVERY field prints with a placeholder when empty
    (never hide a row - CLAUDE.md launcher-info rule). ivm `info` parity. Works stopped
    or running."""
    return_code, stdout, _ = run_capture(["podman", "inspect", container_name])
    if return_code == 127:
        die("podman not found - run `make vm-podman-install` first")
    if return_code != 0:
        die(f"no such container: {container_name} (run `pvm init <template>` here? "
            f"or pass --name <container>)")
    inspected: Any = json.loads(stdout or "[]")
    if not inspected:
        die(f"podman inspect returned nothing for {container_name}")
    info: dict[str, Any] = inspected[0]
    config: dict[str, Any] = info.get("Config") or {}
    labels: dict[str, Any] = config.get("Labels") or {}
    host_config: dict[str, Any] = info.get("HostConfig") or {}
    state: dict[str, Any] = info.get("State") or {}

    template_name: str = labels.get(LABEL_TEMPLATE) or ""
    agent_line: str = "(none)"
    if template_name:
        agent: dict[str, Any] = (load_template_quiet(template_name) or {}).get("agent") or {}
        if agent.get("command"):
            display_name: str = agent.get("display_name") or ""
            agent_line = str(agent["command"]) + (f" ({display_name})" if display_name else "")

    print(f"container: {colorize_container_name(container_name, stream=sys.stdout)}")
    print(f"  status:       {state.get('Status') or '(unknown)'}")
    print(f"  image:        {info.get('ImageName') or config.get('Image') or '(unknown)'}")
    print(f"  template:     {template_name or '(unset)'}")
    print(f"  project dir:  {labels.get(LABEL_PROJECT_DIR) or '(unset)'}")
    print(f"  runtime:      {host_config.get('Runtime') or '(unknown)'}")
    print(f"  hw:           cpu={_container_cpu_limit(host_config)} "
          f"memory={_container_memory_limit(host_config)}")
    print(f"  network:      {host_config.get('NetworkMode') or '(default)'}")
    print(f"  published:    {_container_published_ports(host_config)}")
    print("  mounts:")
    for mount_line in _container_mount_lines(info):
        print(f"    {mount_line}")
    print(f"  agent:        {agent_line}")


def cmd_mount_ls(container_name: str) -> None:
    """List the container's bind mounts - the cwd `--volume` + the hide-dir masks - read-only
    `podman inspect`. ivm `mount ls` parity. pvm has ONLY `ls`: podman cannot hot-attach/detach
    a volume on a running container (mounts are fixed at `pvm init` from the template), so there
    is no attach/detach/shadow."""
    return_code, stdout, _ = run_capture(["podman", "inspect", container_name])
    if return_code == 127:
        die("podman not found - run `make vm-podman-install` first")
    if return_code != 0:
        die(f"no such container: {container_name} (run `pvm init <template>` here? or pass --name)")
    inspected: Any = json.loads(stdout or "[]")
    if not inspected:
        die(f"podman inspect returned nothing for {container_name}")
    print(f"mounts for {colorize_container_name(container_name, stream=sys.stdout)}:")
    for mount_line in _container_mount_lines(inspected[0]):
        print(f"  {mount_line}")


def cmd_help(parser: argparse.ArgumentParser) -> None:
    parser.print_help()


# ---------- CLI ----------

# Shell-entry subcommands -> (shell binary, run as root?). ivm-aligned names: shell / sh /
# shell-user / sh-user = zsh as the unprivileged user; shell-root / sh-root = zsh as root.
# pvm keeps its explicit zsh-/bash- variants too. main() dispatches any of these via this table.
SHELL_SUBCOMMANDS: dict[str, tuple[str, bool]] = {
    "shell": ("zsh", False), "sh": ("zsh", False),
    "shell-user": ("zsh", False), "sh-user": ("zsh", False),
    "shell-root": ("zsh", True), "sh-root": ("zsh", True),
    "zsh-user": ("zsh", False), "zsh-root": ("zsh", True),
    "bash-user": ("bash", False), "bash-root": ("bash", True),
}


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="pvm",
        description="podman container launcher: declarative templates, per-template "
                    "image built via podman exec+commit (no Dockerfile), per-project "
                    "container bound to the cwd. Shares ivm/qvm's provision cache.",
        epilog="Container-acting subcommands resolve the target by the directory "
               "`init` ran in, or take the global `--name <container>`.")
    parser.add_argument("--name", metavar="<container>", default=None,
                        help="target container by name (overrides the cwd binding)")
    parser.add_argument("--dry-run", action="store_true",
                        help="print every mutating command instead of running it")
    parser.add_argument("--runtime", choices=RUNTIME_CHOICES, default=DEFAULT_RUNTIME,
                        help=f"OCI runtime: crun (shared host kernel, default) or libkrun "
                             f"(microVM; later). Default: {DEFAULT_RUNTIME}")
    parser.add_argument("--network", metavar="<mode>", default=None,
                        help="podman `--network` mode passthrough (e.g. host); default = podman's default")
    parser.add_argument("--shared-assets-root", type=Path, default=DEFAULT_SHARED_ASSETS_ROOT,
                        help=f"shared provision-asset cache (package-group + thirdparty JSON, "
                             f"feature-first dotfiles/); rarely overridden. "
                             f"Default: {DEFAULT_SHARED_ASSETS_ROOT}")
    subparsers = parser.add_subparsers(dest="subcommand", required=True)

    for template_subcommand, subcommand_help in (
            ("init", "build the image if needed, then run a container bound to the cwd"),
            ("build", "build + commit the per-template image only (no container)"),
            ("run", "run a container from the per-template image (cwd-bound)"),
            ("env", "show resolved paths + runtime (optionally for a template)")):
        template_parser = subparsers.add_parser(template_subcommand, help=subcommand_help)
        template_parser.add_argument(
            "template", nargs="?" if template_subcommand == "env" else None,
            metavar="<template>", help="template name (a *.yaml stem under the templates dir)")
        if template_subcommand in ("init", "build"):
            template_parser.add_argument("--rebuild", action="store_true",
                                         help="force a rebuild even if the image exists")
        if template_subcommand == "init":
            template_parser.add_argument("--yes", action="store_true",
                                         help="skip the shared-kernel confirmation gate")

    for container_subcommand, subcommand_help in (
            ("start", "start the cwd-bound container (no-op if running)"),
            ("stop", "stop the cwd-bound container"),
            ("rmc", "remove the container (keeps the image)"),
            ("rmi", "remove the per-template image (keeps containers)"),
            ("rma", "remove the container AND its image"),
            ("info", "show the cwd container's status/image/hw/network/ports/mounts/agent"),
            ("update", "refresh + upgrade all distro packages in the container (apt/zypper/dnf)"),
            ("overwrite-dotfiles", "re-push the template's dotfiles into the container (no reprovision)"),
            ("shell", "interactive shell (zsh, user); ivm-aligned alias: sh"),
            ("sh", "alias of shell (zsh, user)"),
            ("shell-user", "zsh as the unprivileged user (ivm-aligned; alias sh-user)"),
            ("sh-user", "alias of shell-user"),
            ("shell-root", "zsh as root (ivm-aligned; alias sh-root)"),
            ("sh-root", "alias of shell-root"),
            ("zsh-user", "zsh in the container as the unprivileged user"),
            ("zsh-root", "zsh in the container as root"),
            ("bash-user", "bash in the container as the unprivileged user"),
            ("bash-root", "bash in the container as root"),
            ("agent", "run the template's configured agent (e.g. claude) in the container")):
        subparsers.add_parser(container_subcommand, help=subcommand_help)

    # Container lifecycle verbs that confirm first (ivm-aligned reboot/delete).
    for confirming_subcommand, subcommand_help in (
            ("reboot", "restart the cwd container (podman restart); confirms, --yes skips"),
            ("delete", "remove the cwd container, keeping the per-template image; confirms")):
        confirming_parser = subparsers.add_parser(confirming_subcommand, help=subcommand_help)
        confirming_parser.add_argument("--yes", action="store_true",
                                       help="skip the confirmation prompt")

    push_parser = subparsers.add_parser(
        "push", help="copy a host file/dir into the container (podman cp)")
    push_parser.add_argument("local", metavar="<local>", help="host file or directory to copy in")
    push_parser.add_argument("guest", metavar="<guest>", help="destination path inside the container")
    push_parser.add_argument("--as-root", action="store_true",
                             help="re-own the pushed path to root inside the container (chown -R)")

    resize_parser = subparsers.add_parser(
        "resize", help="change the container's vCPU/memory limit in place (podman update)")
    resize_parser.add_argument("--cpu", metavar="<n>", default=None,
                               help="vCPU limit (maps to podman --cpus), e.g. 2")
    resize_parser.add_argument("--memory", metavar="<size>", default=None,
                               help="memory limit (maps to podman --memory), e.g. 4g")

    provision_parser = subparsers.add_parser(
        "provision",
        help="install distro groups / thirdparty / dotfiles into the container (bare = list units)")
    provision_parser.add_argument("units", nargs="*", metavar="[unit]",
                                  help="units to install; none = list every available unit")

    mount_parser = subparsers.add_parser("mount", help="inspect the container's bind mounts")
    mount_subparsers = mount_parser.add_subparsers(dest="mount_action", required=True)
    mount_subparsers.add_parser("ls", help="list the container's mounts (cwd volume + hide-dir masks)")

    top_parser = subparsers.add_parser(
        "top", help="live resource stats (passthrough to podman stats)")
    top_parser.add_argument("stats_args", nargs="*", metavar="[args]",
                            help="container names to scope; for podman stats flags use the "
                                 "`--` form, e.g. `pvm top -- --no-stream`")

    subparsers.add_parser("list", help="list pvm-managed containers (name, status, image)")
    subparsers.add_parser("help", help="show this help")
    return parser


def main() -> None:
    parser: argparse.ArgumentParser = build_parser()
    parsed_arguments: argparse.Namespace = parser.parse_args()
    subcommand: str = parsed_arguments.subcommand
    runtime: str = parsed_arguments.runtime
    network: str | None = parsed_arguments.network
    shared_root: Path = parsed_arguments.shared_assets_root
    dry_run: bool = parsed_arguments.dry_run

    if subcommand == "env":
        cmd_env(parsed_arguments.template, runtime=runtime, network=network)
        return
    if subcommand == "list":
        cmd_list()
        return
    if subcommand == "help":
        cmd_help(parser)
        return
    if subcommand == "init":
        cmd_init(parsed_arguments.template, shared_root=shared_root, runtime=runtime,
                 network=network, rebuild=parsed_arguments.rebuild,
                 assume_yes=parsed_arguments.yes, dry_run=dry_run)
        return
    if subcommand == "build":
        cmd_build(parsed_arguments.template, shared_root=shared_root, network=network,
                  rebuild=parsed_arguments.rebuild, dry_run=dry_run)
        return
    if subcommand == "run":
        cmd_run(parsed_arguments.template, shared_root=shared_root, runtime=runtime,
                network=network, dry_run=dry_run)
        return
    if subcommand == "top":
        cmd_top(parsed_arguments.stats_args, dry_run=dry_run)
        return
    if subcommand == "provision" and not parsed_arguments.units:
        cmd_list_provision_units(shared_root)
        return

    # Container-acting subcommands: resolve the target by cwd binding or --name.
    container_name: str = resolve_container_for_cwd(parsed_arguments.name)
    shell_spec: tuple[str, bool] | None = SHELL_SUBCOMMANDS.get(subcommand)
    if shell_spec is not None:
        shell_binary, shell_as_root = shell_spec
        exec_into(container_name, [shell_binary], as_root=shell_as_root, runtime=runtime, dry_run=dry_run)
        return
    if subcommand == "start":
        cmd_start(container_name, dry_run=dry_run)
    elif subcommand == "stop":
        cmd_stop(container_name, dry_run=dry_run)
    elif subcommand == "rmc":
        cmd_rmc(container_name, dry_run=dry_run)
    elif subcommand == "rmi":
        cmd_rmi(container_name, dry_run=dry_run)
    elif subcommand == "rma":
        cmd_rma(container_name, dry_run=dry_run)
    elif subcommand == "reboot":
        cmd_reboot(container_name, assume_yes=parsed_arguments.yes, dry_run=dry_run)
    elif subcommand == "delete":
        cmd_delete(container_name, assume_yes=parsed_arguments.yes, dry_run=dry_run)
    elif subcommand == "info":
        cmd_info(container_name)
    elif subcommand == "update":
        cmd_update(container_name, dry_run=dry_run)
    elif subcommand == "push":
        cmd_push(container_name, parsed_arguments.local, parsed_arguments.guest,
                 as_root=parsed_arguments.as_root, dry_run=dry_run)
    elif subcommand == "resize":
        cmd_resize(container_name, cpu=parsed_arguments.cpu, memory=parsed_arguments.memory,
                   dry_run=dry_run)
    elif subcommand == "provision":
        cmd_provision(container_name, parsed_arguments.units, shared_root=shared_root, dry_run=dry_run)
    elif subcommand == "overwrite-dotfiles":
        cmd_overwrite_dotfiles(container_name, shared_root=shared_root, dry_run=dry_run)
    elif subcommand == "mount":
        if parsed_arguments.mount_action == "ls":
            cmd_mount_ls(container_name)
    elif subcommand == "agent":
        cmd_agent(container_name, runtime=runtime, dry_run=dry_run)


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        print("\npvm: interrupted", file=sys.stderr)
        sys.exit(130)
    except subprocess.CalledProcessError as command_failure:
        failed_command: str = (shlex.join(command_failure.cmd)
                               if isinstance(command_failure.cmd, list) else str(command_failure.cmd))
        print(f"pvm: command failed (exit {command_failure.returncode}): {failed_command}",
              file=sys.stderr)
        sys.exit(command_failure.returncode or 1)
