# ---------- isolation guardrails (shared-kernel honesty; REFACTOR.md) ----------


def is_macos_or_windows() -> bool:
    """On macOS/Windows podman runs inside a `podman machine` VM, so a crun container
    shares only that VM's kernel - the shared-HOST-kernel warning softens there."""
    return sys.platform in ("darwin", "win32")


def warn_shared_kernel(runtime: str) -> None:
    """Non-blocking notice: a crun container shares the HOST kernel (weaker than a
    real VM). libkrun (a microVM) does not; for full isolation use `ivm`."""
    if runtime == "libkrun" or is_macos_or_windows():
        return
    print("pvm: note: crun shares the HOST kernel - weaker isolation than a real VM. "
          "For kernel-level isolation use `ivm`.", file=sys.stderr)


def gate_non_libkrun_init(runtime: str, *, assume_yes: bool) -> None:
    """At `init` on Linux with a shared-kernel runtime, require an explicit y/N
    (default No; --yes bypasses; non-TTY aborts) - the container must EARN the run."""
    if runtime == "libkrun" or is_macos_or_windows():
        return
    confirm_or_die("pvm: this container shares the HOST kernel (crun), NOT a real VM "
                   "boundary - for kernel isolation use `ivm`. Continue with crun?",
                   assume_yes=assume_yes)


# ---------- container resolution + drive ----------


def container_exists(container_name: str) -> bool:
    return run_capture(["podman", "container", "exists", container_name])[0] == 0


def resolve_container_for_cwd(name_override: str | None) -> str:
    """The container a container-acting subcommand targets: `--name` wins; else the
    pvm container labelled with this cwd (pvm.project_dir). 0 -> die with an init
    hint; >1 (different templates in one dir) -> die listing them, require --name."""
    if name_override:
        return name_override
    cwd: str = str(Path.cwd().resolve())
    return_code, stdout, _ = run_capture(
        ["podman", "ps", "--all", "--filter", f"label={LABEL_PROJECT_DIR}={cwd}",
         "--format", "{{.Names}}"])
    if return_code == 127:
        die("podman not found - run `make vm-podman-install` first")
    names: list[str] = [name for name in stdout.splitlines() if name.strip()]
    if not names:
        die(f"no pvm container bound to {cwd}; run `pvm init <template>` here first "
            f"(or pass --name <container>)")
    if len(names) > 1:
        die(f"{len(names)} pvm containers bound to {cwd}: {', '.join(names)}; "
            f"pass --name <container> to pick one")
    return names[0]


def container_template_name(container_name: str) -> str:
    """The template label baked into a pvm container (for `agent`)."""
    label_format: str = '{{ index .Config.Labels "' + LABEL_TEMPLATE + '" }}'
    return run_capture(["podman", "inspect", "--format", label_format, container_name])[1].strip()


def container_image(container_name: str) -> str:
    """The image ref a container was created from (for rmi/rma)."""
    return run_capture(["podman", "inspect", "--format", "{{.ImageName}}", container_name])[1].strip()


def ensure_mask_dir(*, dry_run: bool) -> None:
    """The empty dir masked (read-only) over each hide_dir must exist before `podman run`."""
    if dry_run or MASK_DIR.is_dir():
        return
    MASK_DIR.mkdir(parents=True, exist_ok=True)


def run_container(template: dict[str, Any], image_ref: str, *, runtime: str,
                  network: str | None, dry_run: bool) -> str:
    """`podman run` a per-project container from image_ref, bound to the cwd; returns
    its name. Errors if a container for this cwd+template already exists."""
    cwd: Path = Path.cwd()
    container_name: str = container_name_for(template["template_name"],
                                             project_name_from_cwd(cwd, Path.home()))
    if not dry_run and container_exists(container_name):
        die(f"container {container_name} already exists; `pvm rma` (or `pvm rmc`) first, "
            f"or `pvm shell` / `pvm start` to use it")
    ensure_mask_dir(dry_run=dry_run)
    run(build_podman_run_argv(
        image_ref=image_ref, container_name=container_name,
        template_name=template["template_name"], mounts=[cwd_mount(cwd)],
        hide_dirs=template.get("hide_dirs", list(DEFAULT_HIDE_DIRS)),
        publish_ports=template.get("publish_ports", []), runtime=runtime, network=network),
        dry_run=dry_run)
    return container_name


def ensure_started(container_name: str, *, dry_run: bool) -> None:
    """Start the container if it exists but is not running (exec/shell need it up)."""
    if dry_run:
        return
    return_code, stdout, _ = run_capture(["podman", "inspect", "--format", "{{.State.Running}}", container_name])
    if return_code != 0:
        die(f"no such container: {container_name} (run `pvm init <template>` here?)")
    if stdout.strip() != "true":
        run(["podman", "start", container_name], dry_run=dry_run)


def exec_into(container_name: str, command_argv: list[str], *, as_root: bool,
              runtime: str, dry_run: bool) -> None:
    """`podman exec -it` into the container (user by default), replacing the pvm
    process so the child IS the foreground program (no Python wrapper / traceback)."""
    ensure_started(container_name, dry_run=dry_run)
    warn_shared_kernel(runtime)
    user_args: list[str] = ["--user", "root"] if as_root else ["--user", "user"]
    exec_argv: list[str] = ["podman", "exec", "--interactive", "--tty", *user_args,
                            container_name, *command_argv]
    if dry_run:
        run(exec_argv, dry_run=True)
        return
    print("+ " + shlex.join(exec_argv), file=sys.stderr)
    os.execvp("podman", exec_argv)


def cmd_init(template_name: str, *, shared_root: Path, runtime: str, network: str | None,
             rebuild: bool, assume_yes: bool, dry_run: bool) -> None:
    """Build the per-template image if needed, then run a container bound to the cwd."""
    template: dict[str, Any] = load_template(template_name)
    effective_runtime: str = resolve_runtime(template, runtime)
    gate_non_libkrun_init(effective_runtime, assume_yes=assume_yes)
    image_ref: str = build_image(template, shared_root=shared_root, network=network,
                                 rebuild=rebuild, dry_run=dry_run)
    container_name: str = run_container(template, image_ref, runtime=effective_runtime,
                                        network=network, dry_run=dry_run)
    warn_shared_kernel(effective_runtime)
    enter_hint: str = "pvm shell" + ("; run the agent: pvm agent" if template.get("agent") else "")
    print(f"==> {colorize_container_name(container_name)} ready. Enter: {enter_hint}", file=sys.stderr)
    auth_note: str = (template.get("agent") or {}).get("auth_note", "")
    if auth_note:
        print(f"    {auth_note}", file=sys.stderr)


def cmd_run(template_name: str, *, shared_root: Path, runtime: str, network: str | None,
            dry_run: bool) -> None:
    """Run a container from the per-template image (building it if missing). Like
    `init` without the shared-kernel gate (init already earned it)."""
    template: dict[str, Any] = load_template(template_name)
    effective_runtime: str = resolve_runtime(template, runtime)
    image_ref: str = build_image(template, shared_root=shared_root, network=network,
                                 rebuild=False, dry_run=dry_run)
    container_name: str = run_container(template, image_ref, runtime=effective_runtime,
                                        network=network, dry_run=dry_run)
    warn_shared_kernel(effective_runtime)
    print(f"==> {colorize_container_name(container_name)} running.", file=sys.stderr)


def cmd_start(container_name: str, *, dry_run: bool) -> None:
    run(["podman", "start", container_name], dry_run=dry_run)
    print(f"==> {colorize_container_name(container_name)} started.", file=sys.stderr)


def cmd_stop(container_name: str, *, dry_run: bool) -> None:
