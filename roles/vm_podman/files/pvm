    print(f"==> {colorize_container_name(container_name)} stopped.", file=sys.stderr)


def cmd_rmc(container_name: str, *, dry_run: bool) -> None:
    run(["podman", "rm", "--force", container_name], dry_run=dry_run)
    print(f"==> removed container {colorize_container_name(container_name)}.", file=sys.stderr)


def cmd_rmi(container_name: str, *, dry_run: bool) -> None:
    image_ref: str = "<image>" if dry_run else container_image(container_name)
    run(["podman", "rm", "--force", container_name], dry_run=dry_run)
    run(["podman", "rmi", image_ref], dry_run=dry_run)
    print(f"==> removed container + image ({image_ref}).", file=sys.stderr)


def cmd_rma(container_name: str, *, dry_run: bool) -> None:
