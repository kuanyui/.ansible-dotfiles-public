#compdef ivm
# ivm zsh completion (ansible-managed by roles/vm_incus). zsh autoloads this via
# fpath - see the `ansible-managed/*/zsh-completions` glob in roles/zsh/.zshrc.j2.
# Two levels: subcommands, then their args - template names for `init`/`env`, unit
# names for `provision`, `snapshot` actions + existing snapshot names, script names for
# `script`, and the two-level `set`/`unset <aspect>` args (aspect, then `user`/`root`,
# `--pubkey`, a guest dir, etc.).

local -a _ivm_subcommands
_ivm_subcommands=(
  'init:create a VM from a template'
  'shell:open a zsh shell as user (cwd-resolved)'
  'sh:alias of shell'
  'shell-user:open a zsh shell as user'
  'sh-user:alias of shell-user'
  'shell-root:open a zsh shell as root'
  'sh-root:alias of shell-root'
  'start:start the target VM'
  'reboot:restart the target VM (incus restart; --force = SIGKILL qemu)'
  'stop:stop the target VM (--force = SIGKILL qemu)'
  'delete:delete the target VM (confirms)'
  'rename:rename the target VM (incus rename; stopped only; confirms)'
  'env:load + print a template'\''s resolved config'
  'list:table of managed VMs - state/name/MEM guest+host/disk/created/up-last-on/host-bound dir/IPv4 (extra args -> raw incus list)'
  'ls:alias of list'
  'top:live per-instance CPU/memory/disk usage (incus top passthrough)'
  'cd:cd the shell into a VM'\''s host-bound dir (completes VM -> its dir)'
  'info:target VM info - status, image, hw, network, mounts, storage (cwd or --name)'
  'adopt:bring an unmanaged Incus VM (hand-made or old-ivm) under ivm management (requires --name)'
  'storage-status:show host incus storage pool status (driver/loop/mount/fstab/verdict)'
  'overwrite-dotfiles:re-push staged dotfiles into the VM'
  'update:upgrade all packages in the VM'
  'provision:install distro bundle(s) / thirdparty recipe(s) onto the VM'
  'set:configure a VM setting - password/ssh-server/guest-shell-dir/host-bound-dir/user-sudo/git-ssh-key/static-ip (no aspect lists them)'
  'unset:clear a VM setting - password/ssh-server/guest-shell-dir/host-bound-dir/user-sudo/git-ssh-key/static-ip'
  'snapshot:incus snapshot (create/list/restore/delete/rename/show)'
  'gui:open a SPICE graphical console'
  'resize:change vCPU/RAM/root-disk of an existing VM (--cpu/--memory/--disk)'
  'mount:inspect/change virtio-fs shares post-init (ls/attach/detach; hotplug)'
  'push:copy a host file/dir into the VM (incus file push; --as-root)'
  'expose:forward a host TCP port to the VM for LAN access (no arg lists forwards)'
  'unexpose:remove a port forward - <host-port> or --all (no arg lists forwards)'
  'script:run a host-side helper script (backup / restore / ...) against the VM (--name <vm>; no arg lists scripts)'
)

# All installable unit names for `provision`: keys of the materialized distro-bundle
# + thirdparty-recipe registries + dotfiles feature dirs, from the SHARED provision-asset
# cache (python3 is an ivm dependency, so always present).
_ivm_unit_names() {
  local _ivm_shared_assets_root="${SHARED_PREBUILT_PROVISION_ASSETS_ROOT:-$HOME/.local/share/ansible-managed/shared-prebuilt-provision-assets}"
  python3 - "$_ivm_shared_assets_root" 2>/dev/null <<'PY'
import json, os, sys
shared_root = sys.argv[1]
LAUNCHER = "ivm"
def offered(entry):
    # Same `available_on` rule as the launcher's registry loader: the entry's list of
    # consumers; absent = every consumer. Entries not offered to this launcher must not
    # complete (e.g. the host-only dev_android BUNDLE, which would otherwise shadow the
    # dev_android RECIPE's description).
    if not isinstance(entry, dict):
        return True
    available_on = entry.get("available_on")
    return available_on is None or LAUNCHER in available_on
seen, out = set(), []
def add(name, desc=""):
    if name in seen:
        return
    seen.add(name)
    # zsh _describe splits on the FIRST colon -> "name:description"; bare name = no desc.
    out.append(f"{name}:{desc}" if desc else name)
for f in ("distro-package-groups.json", "thirdparty-software.json"):
    p = os.path.join(shared_root, f)
    if os.path.exists(p):
        try:
            for key, val in json.load(open(p)).items():
                if not offered(val):
                    continue
                add(key, val.get("description", "") if isinstance(val, dict) else "")
        except Exception:
            pass
dotfiles = os.path.join(shared_root, "dotfiles")
if os.path.isdir(dotfiles):
    for d in sorted(os.listdir(dotfiles)):
        add(d)
# A name can live in two registries (e.g. emacs = package bundle AND dotfiles feature) -
# first occurrence wins, so the `description` shown is the distro one (it already notes
# the pairing).
print("\n".join(out))
PY
}

# Template names + their `description` (template.schema.json field) for `ivm init` /
# `ivm env` completion. zsh _describe renders `name  -- description`; bash can't show
# inline descriptions, so ivm.bash lists template names only.
_ivm_template_names() {
  local _ivm_templates_root="${IVM_ROOT:-$HOME/.local/share/ansible-managed/vm-incus/ivm}/templates"
  python3 - "$_ivm_templates_root" 2>/dev/null <<'PY'
import os, sys, glob
root = sys.argv[1]
for tf in sorted(glob.glob(os.path.join(root, "*.yaml"))):
    name = os.path.basename(tf)[:-5]  # strip .yaml
    desc = ""
    try:  # cheap line-scan for `description:` (no yaml dep in the completion)
        for line in open(tf):
            if line.startswith("description:"):
                desc = line.split(":", 1)[1].strip().strip('"').strip("'")
                break
    except Exception:
        pass
    print(f"{name}:{desc}" if desc else name)
PY
}

# The VM a cwd-resolved subcommand targets, for completion: `--name <vm>` if given, else the
# VM bound to the current directory (`user.ivm_host_bound_dir`). Empty if neither. REUSABLE.
_ivm_target_vm() {
  print -r -- "${opt_args[--name]:-$(incus list --format csv --columns n "user.ivm_host_bound_dir=$PWD" 2>/dev/null)}"
}

# A VM's `expose` forwards as `_describe` lines - `<host-port>:host <listen-address>:<host-port>
# -> guest :<guest-port>`, the rendering bare `ivm unexpose` prints. Same filter as ivm's
# `expose_proxy_forwards` (`expose-tcp-*` proxy devices), but a line-scan of `incus config
# device show` - no yaml dep in the completion. $1 = VM name; empty -> nothing.
_ivm_expose_forwards() {
  [[ -n "$1" ]] || return 1
  python3 - "$(incus config device show "$1" 2>/dev/null)" 2>/dev/null <<'PY'
import sys
EXPOSE_DEVICE_PREFIX = "expose-tcp-"
device_fields_by_name = {}
device_name = ""
# An unindented `<device>:` line opens a device; the indented `key: value` lines below are its fields.
for line in sys.argv[1].splitlines():
    if line and not line[0].isspace():
        device_name = line.rstrip().rstrip(":")
        device_fields_by_name[device_name] = {}
    elif device_name and ":" in line:
        field_key, _, field_value = line.strip().partition(":")
        device_fields_by_name[device_name][field_key] = field_value.strip().strip("\"'")
for device_name, device_fields in device_fields_by_name.items():
    if not device_name.startswith(EXPOSE_DEVICE_PREFIX) or device_fields.get("type") != "proxy":
        continue
    # `listen` is `tcp:<host-address>:<port>`; split at the LAST colon (keeps `[::1]` whole).
    listen_address, _, host_port = device_fields.get("listen", "").partition(":")[2].rpartition(":")
    guest_port = device_fields.get("connect", "").rsplit(":", 1)[-1] or "?"
    print(f"{host_port or '?'}:host {listen_address or '?'}:{host_port or '?'} -> guest :{guest_port}")
PY
}

# Script names + their `# description:` header for `ivm script` completion: the executable,
# non-`_`-prefixed files in `<root>/scripts/` (the same filter as ivm's `available_scripts`;
# `_`-prefixed = the scripts' shared libs).
_ivm_script_names() {
  local _ivm_scripts_root="${IVM_ROOT:-$HOME/.local/share/ansible-managed/vm-incus/ivm}/scripts"
  python3 - "$_ivm_scripts_root" 2>/dev/null <<'PY'
import os, sys
scripts_root = sys.argv[1]
if os.path.isdir(scripts_root):
    for script_name in sorted(os.listdir(scripts_root)):
        script_path = os.path.join(scripts_root, script_name)
        if script_name.startswith("_") or not os.path.isfile(script_path) or not os.access(script_path, os.X_OK):
            continue
        description = ""
        try:  # cheap line-scan for the `# description:` header (first 10 lines)
            with open(script_path, errors="replace") as script_file:
                for _ in range(10):
                    line = script_file.readline()
                    if line.startswith("# description:"):
                        description = line[len("# description:"):].strip()
                        break
        except Exception:
            pass
        print(f"{script_name}:{description}" if description else script_name)
PY
}

# REUSABLE: EVERY incus VM as a `_describe` line, for any VM-name completion that should
# show where each VM lives (`--name`, and the trailing `<vm>` on the no-positional
# subcommands `stop`/`info`/`sh`/...). Description precedence: the host-bound dir
# (`user.ivm_host_bound_dir`); a managed VM WITHOUT one (unbound appliance / legacy
# pre-tag VM) still gets a description - `(unbound; init dir <user.ivm_init_at_dir>)` -
# so the dir column never silently vanishes for a managed VM; a hand-made instance (no
# ivm tags) stays a bare name. python3 (an ivm dependency) parses the CSV because with
# TWO dir columns the usual split-on-first-comma trick cannot survive a comma in a path.
_ivm_vms_with_dir() {
  incus list --format csv --columns n,config:user.ivm_host_bound_dir,config:user.ivm_init_at_dir 2>/dev/null \
    | python3 -c '
import csv, sys
for row in csv.reader(sys.stdin):
    if len(row) < 3:
        continue
    vm_name, host_bound_dir, init_at_dir = row[0], row[1], row[2]
    if host_bound_dir:
        print(f"{vm_name}:{host_bound_dir}")
    elif init_at_dir:
        print(f"{vm_name}:(unbound; init dir {init_at_dir})")
    else:
        print(vm_name)
'
}

# Add VM-name completions from `name[:description]` lines, one match PER LINE. NOT
# `_describe` on purpose: with the `list-grouped` style true (the default) it stacks
# matches sharing one description onto a single line (`vm-a vm-b vm-c -- (unbound; init
# dir ...)`) - confusing for VM names. `compadd -l -d` keeps a strict 1:1 name ->
# display-line mapping (names padded so the `--` descriptions still align).
# $1 = the completion-listing header, rest = the lines.
_ivm_add_vms_ungrouped() {
  local _ivm_listing_header="$1" _ivm_line _ivm_vm_name
  shift
  local -a _ivm_match_names _ivm_display_lines _ivm_expl
  local _ivm_name_pad_width=0
  for _ivm_line in "$@"; do
    [[ -n "$_ivm_line" ]] || continue
    _ivm_vm_name="${_ivm_line%%:*}"
    (( ${#_ivm_vm_name} > _ivm_name_pad_width )) && _ivm_name_pad_width=${#_ivm_vm_name}
  done
  for _ivm_line in "$@"; do
    [[ -n "$_ivm_line" ]] || continue
    _ivm_vm_name="${_ivm_line%%:*}"
    _ivm_match_names+=("$_ivm_vm_name")
    if [[ "$_ivm_line" == *:* ]]; then
      _ivm_display_lines+=("$(printf "%-${_ivm_name_pad_width}s  -- %s" "$_ivm_vm_name" "${_ivm_line#*:}")")
    else
      _ivm_display_lines+=("$_ivm_vm_name")
    fi
  done
  (( $#_ivm_match_names )) || return 1
  _wanted vms _ivm_expl "$_ivm_listing_header" compadd -l -d _ivm_display_lines -a _ivm_match_names
}

# REUSABLE: only the VMs `ivm cd` can jump to - those with a REAL `user.ivm_host_bound_dir`
# - as `name:host_bound_dir` pairs. Deliberately NOT built on `_ivm_vms_with_dir`: its
# `(unbound; ...)` fallback descriptions would sneak unbound VMs (which `ivm cd` refuses)
# into the candidates. Single dir column, so `IFS=, read` (split on the FIRST comma only)
# keeps a comma-containing path whole.
_ivm_managed_vms() {
  incus list --format csv --columns n,config:user.ivm_host_bound_dir 2>/dev/null \
    | while IFS=, read -r _ivm_vm_name _ivm_vm_dir; do
        [[ -n "$_ivm_vm_dir" ]] && print -r -- "${_ivm_vm_name}:${_ivm_vm_dir}"
      done
}

# REUSABLE guest-path completion: complete an existing DIRECTORY inside the target RUNNING
# guest VM - for any arg that takes a guest path (`mount shadow <guest_path>`,
# `set guest-shell-dir <path>`, ...). Asks the guest over `incus exec find` (silent + empty if the
# VM is stopped/absent). Descends one path component per TAB (dirs only; guest paths are
# absolute, so it starts at /). $1 = VM name; omit to resolve it from --name / cwd.
_ivm_guest_dirs() {
  local _ivm_gd_vm="${1:-$(_ivm_target_vm)}"
  [[ -z "$_ivm_gd_vm" ]] && return 1
  # The guest dir already typed (everything up to the last slash); default to / .
  local _ivm_gd_base="/"
  [[ "$PREFIX" == */* ]] && _ivm_gd_base="${PREFIX%/*}/"
  # Immediate child directories of that dir in the guest (full paths); zsh filters by PREFIX.
  local -a _ivm_gd_children
  _ivm_gd_children=(${(f)"$(incus exec "$_ivm_gd_vm" -- find "$_ivm_gd_base" -mindepth 1 -maxdepth 1 -type d 2>/dev/null)"})
  compadd -S / -- $_ivm_gd_children
}

local state

_arguments -C \
  '--root[install root holding the template.schema.json + templates]:dir:_files -/' \
  '--dry-run[print the incus commands without running them]' \
  '--name[target an existing VM by name, ignoring cwd]:vm:->vmname' \
  '(-y --yes)'{-y,--yes}'[skip confirmation / name prompts]' \
  '1:subcommand:->subcmd' \
  '*::args:->args'

case "$state" in
  subcmd) _describe 'ivm subcommand' _ivm_subcommands ;;
  vmname)
    # `--name <vm>`: any incus VM, with its working dir shown on the right for managed ones.
    _ivm_add_vms_ungrouped 'VM' ${(f)"$(_ivm_vms_with_dir)"} ;;
  args)
    case "$words[1]" in
      init|env)
        # _describe shows each `name:description` as `name  -- description`.
        local -a _ivm_templates
        _ivm_templates=(${(f)"$(_ivm_template_names)"})
        _describe -t templates 'template' _ivm_templates ;;
      cd)
        # An ivm-managed VM by name; the description column is its working dir
        # (`<name>  -- <working dir>` - left name, right path).
        _ivm_add_vms_ungrouped 'ivm-managed VM' ${(f)"$(_ivm_managed_vms)"} ;;
      # The no-positional subcommands take an optional trailing `<vm>` (shortcut for --name);
      # complete any incus VM with its working dir shown (managed ones). `resize` adds its
      # flags; `stop`/`reboot` add the hard-kill `--force`.
      shell|sh|shell-user|sh-user|shell-root|sh-root|start|stop|reboot|delete|overwrite-dotfiles|update|gui|info|resize)
        if [[ "$words[1]" == resize ]]; then
          local -a _ivm_resize_flags
          _ivm_resize_flags=(
            '--cpu:new vCPU count (live hotplug)'
            '--memory:new RAM, number+unit - 16G / 1.2GB / 512MiB (bare G/M = IEC, 16G = 16GiB)'
            '--disk:new root-disk size, same units (50G / 1.5TB) - GROWS only, never shrinks'
          )
          _describe -t flags 'flag' _ivm_resize_flags
        fi
        if [[ "$words[1]" == (stop|reboot) ]]; then
          local -a _ivm_force_flag
          _ivm_force_flag=(
            '--force:no clean guest shutdown - SIGKILL qemu (clears incus Error status; unflushed guest writes lost)'
          )
          _describe -t flags 'flag' _ivm_force_flag
        fi
        _ivm_add_vms_ungrouped 'VM' ${(f)"$(_ivm_vms_with_dir)"} ;;
      storage-status) compadd -- --json ;;
      mount)
        # 1=mount, then the action (ls/attach/shadow/detach); flags may sit between -> skip them.
        local _ivm_mount_action="" _ivm_mount_word_index
        for (( _ivm_mount_word_index = 2; _ivm_mount_word_index < CURRENT; _ivm_mount_word_index++ )); do
          [[ "$words[_ivm_mount_word_index]" == -* ]] && continue
          _ivm_mount_action="$words[_ivm_mount_word_index]"; break
        done
        # The VM this mount command targets (shadow/detach completions need its devices).
        local _ivm_mount_vm="${opt_args[--name]:-$(incus list --format csv --columns n "user.ivm_host_bound_dir=$PWD" 2>/dev/null)}"
        if [[ -z "$_ivm_mount_action" ]]; then
          compadd -- ls attach shadow detach
        elif [[ "$_ivm_mount_action" == attach ]]; then
          # attach <host> <guest> [--ro] [--shadow ...]: 1st positional = host path (on the HOST),
          # 2nd = guest mountpoint (in the GUEST). Count non-flag positionals after the action.
          local _ivm_attach_positional=0 _ivm_attach_word_index
          for (( _ivm_attach_word_index = _ivm_mount_word_index + 1; _ivm_attach_word_index < CURRENT; _ivm_attach_word_index++ )); do
            [[ "$words[_ivm_attach_word_index]" == -* ]] && continue
            (( _ivm_attach_positional++ ))
          done
          compadd -- --ro --shadow
          if (( _ivm_attach_positional == 0 )); then
            _files                            # <host>: a path on the host
          elif (( _ivm_attach_positional == 1 )); then
            _ivm_guest_dirs "$_ivm_mount_vm"  # <guest>: the mountpoint inside the guest
          fi
        elif [[ "$_ivm_mount_action" == shadow ]]; then
          # <guest_path>: an existing directory inside the guest to mask -> complete real guest dirs.
          _ivm_guest_dirs "$_ivm_mount_vm"
        elif [[ "$_ivm_mount_action" == detach ]]; then
          # detach target: the VM's own mount/shadow device names (ivm_mount_* / ivm_shadow_*).
          [[ -n "$_ivm_mount_vm" ]] && compadd -- ${(f)"$(incus config device list ${_ivm_mount_vm} 2>/dev/null | grep '^ivm_')"}
        fi
        ;;
      push)
        # push <local> <guest> [--as-root]: 1st positional = local host path, 2nd = guest path.
        local _ivm_push_positional=0 _ivm_push_word_index
        for (( _ivm_push_word_index = 2; _ivm_push_word_index < CURRENT; _ivm_push_word_index++ )); do
          [[ "$words[_ivm_push_word_index]" == -* ]] && continue
          (( _ivm_push_positional++ ))
        done
        compadd -- --as-root
        if (( _ivm_push_positional == 0 )); then
          _files            # <local>: a path on the host
        elif (( _ivm_push_positional == 1 )); then
          _ivm_guest_dirs   # <guest>: the destination path in the guest
        fi
        ;;
      rename)
        # `incus rename` order: 1st positional = the OLD VM (optional - omitted, cwd or
        # --name resolves it), 2nd/last = the NEW name. BOTH complete VM names: a rename
        # usually tweaks a few trailing chars, so completing the old name as an editable
        # starting point for the NEW name saves retyping it.
        _ivm_add_vms_ungrouped 'VM name (old to rename, or as a starting point to edit into the new name)' \
          ${(f)"$(_ivm_vms_with_dir)"}
        ;;
      expose) _message 'host port, or host-port:guest-port (e.g. 8000 or 9000:8000)' ;;
      script)
        # script <name> [args...]: 1st positional = a script in <root>/scripts/ (shown with its
        # `# description:` header); everything after it belongs to the script -> host files.
        local _ivm_script_positional=0 _ivm_script_word_index
        for (( _ivm_script_word_index = 2; _ivm_script_word_index < CURRENT; _ivm_script_word_index++ )); do
          [[ "$words[_ivm_script_word_index]" == -* ]] && continue
          (( _ivm_script_positional++ ))
        done
        if (( _ivm_script_positional == 0 )); then
          local -a _ivm_scripts
          _ivm_scripts=(${(f)"$(_ivm_script_names)"})
          _describe -t scripts 'script' _ivm_scripts
        else
          _files
        fi
        ;;
      provision)
        # `_describe` renders each "name:description" line as `name  -- description`.
        local -a _ivm_provision_units
        _ivm_provision_units=(${(f)"$(_ivm_unit_names)"})
        _describe -t units 'provision unit' _ivm_provision_units ;;
      set|unset)
        # Two levels (like `mount`): 1=set/unset, then the aspect, then the aspect's args.
        # Flags may sit between, so skip them while locating the aspect.
        local _ivm_aspect="" _ivm_aspect_word_index
        for (( _ivm_aspect_word_index = 2; _ivm_aspect_word_index < CURRENT; _ivm_aspect_word_index++ )); do
          [[ "$words[_ivm_aspect_word_index]" == -* ]] && continue
          _ivm_aspect="$words[_ivm_aspect_word_index]"; break
        done
        if [[ -z "$_ivm_aspect" ]]; then
          local -a _ivm_aspects
          _ivm_aspects=(
            'password:a guest account'\''s login password'
            'ssh-server:key-based SSH login for a guest account'
            'guest-shell-dir:GUEST dir (inside the VM) that `ivm sh` starts in'
            'host-bound-dir:HOST dir that resolves this VM by cwd (unset = target it by name)'
            'user-sudo:whether `user` may sudo (root-password gated)'
            'git-ssh-key:copy a host private ssh key in + wire git SSH for private repos'
            'static-ip:whether the IPv4 is pinned to its current DHCP lease (stable across host/VM reboots)'
          )
          _describe 'ivm aspect' _ivm_aspects
        else
          case "$_ivm_aspect" in
            password) compadd -- user root ;;
            ssh-server) compadd -- user root --pubkey; _files ;;
            # `set guest-shell-dir <path>` takes an existing GUEST directory -> complete real
            # guest dirs; `set host-bound-dir [<path>]` takes a HOST directory -> `_files -/`
            # (`unset` of either and `(un)set user-sudo` / `(un)set static-ip` take no further args).
            guest-shell-dir) [[ "$words[1]" == set ]] && _ivm_guest_dirs ;;
            host-bound-dir) [[ "$words[1]" == set ]] && _files -/ ;;
            # `set git-ssh-key <keyfile>` takes a HOST key file (-> _files); both verbs take --host.
            git-ssh-key) compadd -- --host; [[ "$words[1]" == set ]] && _files ;;
          esac
        fi
        ;;
      snapshot)
        # `$words` here: 1=snapshot, then the action, then a snapshot name. Flags may
        # sit between (e.g. `create --reuse`), so skip them while locating the action
        # and counting how many positional args already follow it.
        local _ivm_snapshot_action="" _ivm_snapshot_positional=0 _ivm_word_index
        for (( _ivm_word_index = 2; _ivm_word_index < CURRENT; _ivm_word_index++ )); do
          [[ "$words[_ivm_word_index]" == -* ]] && continue
          if [[ -z "$_ivm_snapshot_action" ]]; then
            _ivm_snapshot_action="$words[_ivm_word_index]"
          else
            (( _ivm_snapshot_positional++ ))
          fi
        done
        if [[ -z "$_ivm_snapshot_action" ]]; then
          local -a _ivm_snapshot_actions
          _ivm_snapshot_actions=(
            'create:create a snapshot (optional name)'
            'list:list snapshots'
            'restore:restore a snapshot'
            'delete:delete a snapshot'
            'rename:rename a snapshot (old -> new)'
            'show:show a snapshot'\''s config'
          )
          _describe 'ivm snapshot action' _ivm_snapshot_actions
        elif (( _ivm_snapshot_positional == 0 )); then
          # The first arg after these actions is an EXISTING snapshot name.
          case "$_ivm_snapshot_action" in
            restore|delete|rename|show)
              # Target VM: the global `--name` (captured by `_arguments` into
              # `opt_args`) wins, else the VM bound to $PWD via the
              # `user.ivm_host_bound_dir` tag (exact-cwd match only - no ancestor walk).
              local _ivm_snapshot_vm="${opt_args[--name]:-$(incus list --format csv --columns n "user.ivm_host_bound_dir=$PWD" 2>/dev/null)}"
              [[ -n "$_ivm_snapshot_vm" ]] && compadd -- ${(f)"$(incus snapshot list ${_ivm_snapshot_vm} --format csv --columns n 2>/dev/null)"}
              ;;
          esac
        fi
        ;;
    esac
    ;;
esac
