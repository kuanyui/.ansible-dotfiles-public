# ---------- expose / unexpose: LAN-reachable port forwards (incus proxy device) ----------

# Device-name prefix for the proxy devices `expose` adds; the host port is the key, so
# `unexpose <host-port>` and `info` can find them again. TCP only for now (the common
# case - a dev HTTP server); a UDP flag can hang off this later without touching callers.
EXPOSE_DEVICE_PREFIX: str = "expose-tcp-"


def parse_host_guest_ports(port_spec: str) -> tuple[int, int]:
    """`<port>` (host == guest) or `<host-port>:<guest-port>` -> (host_port, guest_port),
    the docker/podman `-p` convention. `die`s on a non-numeric or out-of-range port."""
    host_port_text, _, guest_port_text = port_spec.partition(":")
    guest_port_text = guest_port_text or host_port_text
    if not (host_port_text.isdigit() and guest_port_text.isdigit()):
        die(f"invalid port '{port_spec}' - use <port> or <host-port>:<guest-port> (e.g. 8000 or 9000:8000)")
    host_port, guest_port = int(host_port_text), int(guest_port_text)
    for port in (host_port, guest_port):
        if not 1 <= port <= 65535:
            die(f"port {port} out of range (1-65535)")
    return host_port, guest_port


def instance_level_devices(name: str) -> dict[str, Any]:
    """The VM's INSTANCE-level devices only (not profile-inherited), parsed from
    `incus config device show <name>`. Read-only; {} on any failure."""
    import yaml  # lazy, same as cmd_info (ships with ansible-core / python3-yaml)
    parsed: Any = yaml.safe_load(capture(["incus", "config", "device", "show", name]) or "")
    return parsed if isinstance(parsed, dict) else {}


def expose_proxy_forwards(name: str) -> list[tuple[str, str, str]]:
    """This VM's `expose`-added proxy devices as (device_name, host_port, guest_port),
    from its instance-level devices. Read-only - used by `info` and bare `expose`."""
    forwards: list[tuple[str, str, str]] = []
    for device_name, device in instance_level_devices(name).items():
        if not device_name.startswith(EXPOSE_DEVICE_PREFIX) or device.get("type") != "proxy":
            continue
        host_port: str = str(device.get("listen", "")).rsplit(":", 1)[-1] or "?"
        guest_port: str = str(device.get("connect", "")).rsplit(":", 1)[-1] or "?"
        forwards.append((device_name, host_port, guest_port))
    return forwards


def vm_primary_ipv4(name: str) -> str:
    """The VM's current IPv4 (its incusbr0 DHCP lease), parsed from `incus list`. Empty
    string if it has none yet (not running, or no lease)."""
    raw_ipv4_column: str = capture(["incus", "list", name, "--format", "csv", "--columns", "4"])
    for token in raw_ipv4_column.replace(",", " ").split():
        if token.count(".") == 3 and all(octet.isdigit() for octet in token.split(".")):
            return token
    return ""


def host_tcp_port_in_use(host_port: int) -> bool:
    """Best-effort: is something already LISTENing on this TCP port on the host? Uses
    `ss`; if `ss` is absent (empty output) returns False and lets incus catch a genuine
    conflict when the proxy device is added."""
    return bool(capture(["ss", "-Hltn", f"sport = :{host_port}"]).strip())


def pin_vm_ipv4(name: str, *, dry_run: bool) -> tuple[str, list[str] | None]:
    """Ensure eth0 has a STATIC IPv4 (incus proxy `nat=true` needs a fixed target IP).
    Returns (ipv4, rollback_command): if it was already pinned, (the IP, None); if we pin
    it now - to the CURRENT lease, same address so no reboot - (the IP, the argv that
    undoes the pin) so a later failure can leave no half-state. Under --dry-run with no
    lease yet, ("<vm-ipv4>", None)."""
    import yaml  # lazy
    expanded: Any = yaml.safe_load(capture(["incus", "config", "show", "--expanded", name]) or "")
    eth0_device: dict[str, Any] = ((expanded or {}).get("devices", {}) or {}).get("eth0", {}) or {}
    already_pinned_ipv4: str = eth0_device.get("ipv4.address", "")
    if already_pinned_ipv4:
        return already_pinned_ipv4, None
    current_ipv4: str = vm_primary_ipv4(name)
    if not current_ipv4:
        if dry_run:
            return "<vm-ipv4>", None
        die(f"{name} has no IPv4 yet (running and on incusbr0?); cannot set up the forward")
    # `override` lifts the profile's eth0 onto the instance so we can edit it; `set` edits
    # an eth0 that is already instance-level (e.g. a bridged/macvlan VM, or a re-run).
    override_or_set: str = "set" if "eth0" in instance_level_devices(name) else "override"
    run(["incus", "config", "device", override_or_set, name, "eth0", f"ipv4.address={current_ipv4}"],
        dry_run=dry_run)
    # The undo matches what we did: `override` created an instance-level eth0 -> remove it
    # (falls back to the profile's); `set` edited an existing one -> just unset the address.
    rollback_command: list[str] = (
        ["incus", "config", "device", "remove", name, "eth0"] if override_or_set == "override"
        else ["incus", "config", "device", "unset", name, "eth0", "ipv4.address"])
    return current_ipv4, rollback_command


def cmd_expose(name: str, *, port_spec: str | None, dry_run: bool) -> None:
    """`ivm expose [<port>|<host-port>:<guest-port>]`: forward a host TCP port to this VM
    so the LAN can reach a service inside it. host<->VM already works over incusbr0 NAT;
    this only ADDS the LAN path, via an incus proxy device (`nat=true`). With no port it
    lists the VM's current forwards. The VM's incusbr0 IPv4 is pinned first (proxy
    `nat=true` needs a static target) - pinned to the current lease, so no reboot."""
    if not port_spec:
        forwards: list[tuple[str, str, str]] = expose_proxy_forwards(name)
        if not forwards:
            print(f"==> {colorize_vm_name(name)} has no forwards.", file=sys.stderr)
            return
        for _device_name, host_port_text, guest_port_text in forwards:
            print(f"host :{host_port_text} -> guest :{guest_port_text}")
        return
    host_port, guest_port = parse_host_guest_ports(port_spec)
    device_name: str = f"{EXPOSE_DEVICE_PREFIX}{host_port}"
    if device_name in instance_level_devices(name):
        die(f"host port {host_port} is already exposed on {name} - `ivm unexpose {host_port}` first")
    if host_tcp_port_in_use(host_port):
        die(f"host TCP port {host_port} is already in use on this machine - pick another "
            f"host port, e.g. `ivm expose {host_port + 1}:{guest_port}`")
    ensure_up(name, dry_run=dry_run)
    target_ipv4, pin_rollback_command = pin_vm_ipv4(name, dry_run=dry_run)
    try:
        run(["incus", "config", "device", "add", name, device_name, "proxy",
             f"listen=tcp:0.0.0.0:{host_port}", f"connect=tcp:{target_ipv4}:{guest_port}", "nat=true"],
            dry_run=dry_run)
    except subprocess.CalledProcessError:
        # Undo the IP pin we just made, so a failed expose leaves no half-configured VM.
        if pin_rollback_command is not None:
            run(pin_rollback_command, dry_run=dry_run)
        die('could not add the proxy device (see the incus error above).\n'
            '  If it says "Proxy devices are forbidden": ivm\'s VMs live in a RESTRICTED incus\n'
            '  project (user-<uid>) that blocks proxy devices by default. Re-run\n'
            '  `make vm-incus-install` (it allows them for your user project unless you set\n'
            '  `vm_incus_allow_proxy_devices: false`), or do it manually as admin:\n'
            '      sudo incus project set user-$(id -u) restricted.devices.proxy=allow\n'
            '  then re-run `ivm expose`.')
    print(f"==> {colorize_vm_name(name)}: host :{host_port} -> guest :{guest_port}. "
          f"LAN reaches it at <this-host-ip>:{host_port} (host<->VM unchanged).", file=sys.stderr)


def cmd_unexpose(name: str, *, port_spec: str | None, assume_yes: bool, dry_run: bool) -> None:
    """`ivm unexpose [<host-port>]`: remove a forward added by `expose`. With no port it
    removes ALL of this VM's forwards (confirms; --yes skips). The pinned IPv4 is left in
    place - harmless, and a later `expose` reuses it."""
    forwards: list[tuple[str, str, str]] = expose_proxy_forwards(name)
    if not forwards:
        print(f"==> {colorize_vm_name(name)} has no forwards to remove.", file=sys.stderr)
        return
    if port_spec:
        host_port, _guest_port = parse_host_guest_ports(port_spec)
        device_name: str = f"{EXPOSE_DEVICE_PREFIX}{host_port}"
        if device_name not in {forward[0] for forward in forwards}:
            open_host_ports: str = ", ".join(forward[1] for forward in forwards)
            die(f"no forward on host port {host_port} (open: {open_host_ports})")
        device_names_to_remove: list[str] = [device_name]
    else:
        confirm_action(name, "remove ALL forwards from", assume_yes=assume_yes, dry_run=dry_run)
        device_names_to_remove = [forward[0] for forward in forwards]
    for device_name in device_names_to_remove:
        run(["incus", "config", "device", "remove", name, device_name], dry_run=dry_run)
    print(f"==> {colorize_vm_name(name)}: removed {len(device_names_to_remove)} forward(s).",
          file=sys.stderr)


def cmd_info(name: str, root: Path) -> None:
    """`ivm info`: the TARGET VM's live state - status, image, hw, network, mounts
    (from `incus config show --expanded`) + the storage pool its disk lives in.
    Target resolved by cwd or `--name`, like the other VM subcommands. Read-only."""
    import yaml  # lazy, same as load_yaml (ships with ansible-core / python3-yaml)
    parsed: Any = yaml.safe_load(capture(["incus", "config", "show", "--expanded", name]) or "")
    cfg: dict[str, Any] = parsed if isinstance(parsed, dict) else {}
    config: dict[str, Any] = cfg.get("config", {}) or {}
    devices: dict[str, Any] = cfg.get("devices", {}) or {}
    status: str = capture(["incus", "list", name, "--format", "csv", "--columns", "s"]).strip() or "?"
    image: str = (config.get("image.description")
                  or f"{config.get('image.os', '')} {config.get('image.release', '')}".strip()
                  or "?")
    root_device: dict[str, Any] = devices.get("root", {}) or {}
    eth0_device: dict[str, Any] = devices.get("eth0", {}) or {}
    network: str = (eth0_device.get("network")
                    or f"{eth0_device.get('nictype', '')} {eth0_device.get('parent', '')}".strip()
                    or "?")
    print(f"VM: {colorize_vm_name(name, stream=sys.stdout)}")
    print(f"  status:        {status}")
    print(f"  image:         {image}")
    print(f"  hw:            cpu={config.get('limits.cpu', '?')} "
          f"memory={config.get('limits.memory', '?')} disk={root_device.get('size', '?')}")
    print(f"  network:       {network}")
    expose_forwards: list[tuple[str, str, str]] = expose_proxy_forwards(name)
    if expose_forwards:
        print("  forwards:")
        for _expose_device_name, expose_host_port, expose_guest_port in expose_forwards:
            print(f"    host :{expose_host_port} -> guest :{expose_guest_port}")
    else:
        print("  forwards:      (none; `ivm expose <port>` to add)")
    # Host->guest mounts are the non-root disk devices ivm attaches; skip the
    # `_shadow_` masking devices (internal, not user-meaningful).
    mount_lines: list[str] = [
        f"    {device.get('source')} -> {device.get('path', '?')}"
        for device_name, device in devices.items()
        if device.get("type") == "disk" and device_name != "root"
        and "shadow" not in device_name and device.get("source")
    ]
    if mount_lines:
        print("  mounts:")
        for mount_line in mount_lines:
            print(mount_line)
    for line in preview_storage_pool(root, dry_run=False):
        print(line)


def _parse_gib(size: str) -> int | None:
    """'50GiB' / '50G' / '50GB' -> 50. Anything else (empty, or MiB/TiB/other units)
    -> None, so a caller comparing two sizes skips the check rather than guess wrong."""
    match: re.Match[str] | None = re.fullmatch(r"([0-9]+)\s*(?:G|GB|GiB)", (size or "").strip())
    return int(match.group(1)) if match else None


def _resize_root_disk(name: str, new_size: str, *, dry_run: bool) -> bool:
    """Grow the VM's `root` device to `new_size` (incus form, e.g. '50GiB'). Returns
    True if a resize was issued, False if the disk was already that size. REFUSES to
    shrink. Picks the verb by whether `root` is instance-local: ivm VMs created with
    `hw.disk` carry a `--device root,size=` override (-> `set`); one created without it
    inherits `root` from the profile (-> `override`, since `set` rejects an inherited
    device)."""
    import yaml  # lazy, same as cmd_info / load_yaml
    requested_gib: int | None = _parse_gib(new_size)
    expanded_raw: Any = yaml.safe_load(capture(["incus", "config", "show", "--expanded", name]) or "")
    expanded: dict[str, Any] = expanded_raw if isinstance(expanded_raw, dict) else {}
    expanded_devices: dict[str, Any] = expanded.get("devices", {}) or {}
    current_size: str = (expanded_devices.get("root", {}) or {}).get("size", "")
    current_gib: int | None = _parse_gib(current_size)
    if requested_gib is not None and current_gib is not None:
        if requested_gib < current_gib:
            die(f"refusing to SHRINK the root disk ({current_size} -> {new_size}): incus has no "
                f"safe VM-disk shrink (it truncates under the guest filesystem). To go smaller, "
                f"recreate the VM - `ivm delete` then `ivm init`.")
        if requested_gib == current_gib:
            print(f"    disk already {current_size}; left as-is.", file=sys.stderr)
            return False
    # `incus config device set` only edits an INSTANCE-LOCAL device; the non-expanded
    # view lists exactly those (inherited devices are omitted). If `root` isn't there,
    # it's profile-inherited - promote it to an instance override before sizing.
    local_raw: Any = yaml.safe_load(capture(["incus", "config", "show", name]) or "")
    local_config: dict[str, Any] = local_raw if isinstance(local_raw, dict) else {}
    root_is_instance_local: bool = "root" in (local_config.get("devices", {}) or {})
    device_verb: str = "set" if root_is_instance_local else "override"
    run(["incus", "config", "device", device_verb, name, "root", f"size={new_size}"], dry_run=dry_run)
    return True


def cmd_resize(name: str, *, cpu: int | None, memory: str | None, disk: str | None, dry_run: bool) -> None:
    """`ivm resize`: change an EXISTING VM's vCPU / RAM / root-disk allocation. The
    template `hw.*` only applies at `init`, and editing the template never touches a
    live VM - this is how you change one afterward. Pass any subset of
    `--cpu N` / `--memory NG` / `--disk NG` (at least one):

      cpu    -> `incus config set <vm> limits.cpu=N`        (live hotplug; the guest
                may need to bring the new vCPUs online, or just `ivm reboot`)
      memory -> `incus config set <vm> limits.memory=NGiB`  (live: grow via hotplug,
                shrink via balloon (slow); a reboot applies it cleanly)
      disk   -> `incus config device set|override <vm> root size=NGiB`  (GROW ONLY)

    Disk is grow-only and resizes only the HOST block device; the GUEST filesystem is
    NOT auto-grown (see the printed follow-up). Shrinking is refused (no safe VM-disk
    shrink). `--memory`/`--disk` take the template's whole-GiB `NG` form (e.g. `16G`)."""
    if cpu is None and memory is None and disk is None:
        die("resize needs at least one of --cpu / --memory / --disk")
    if cpu is not None and cpu < 1:
        die(f"--cpu must be >= 1 (got {cpu})")
    for flag_name, flag_value in (("--memory", memory), ("--disk", disk)):
        if flag_value is not None and not re.fullmatch(r"[0-9]+G", flag_value):
            die(f"{flag_name} must be a whole number of GiB with a 'G' suffix, e.g. 16G (got '{flag_value}')")
    if not dry_run and not instance_exists(name):
        die(f"no such incus VM: '{name}' (see `incus list`)")

    if cpu is not None:
        run(["incus", "config", "set", name, f"limits.cpu={cpu}"], dry_run=dry_run)
    if memory is not None:
        run(["incus", "config", "set", name, f"limits.memory={g_to_gib(memory)}"], dry_run=dry_run)
    disk_changed: bool = _resize_root_disk(name, g_to_gib(disk), dry_run=dry_run) if disk is not None else False

    print(f"==> {colorize_vm_name(name)} resized.", file=sys.stderr)
    if cpu is not None or memory is not None:
        print("    cpu/memory apply live; if the guest doesn't reflect the change, `ivm reboot`.",
              file=sys.stderr)
    if disk_changed:
        print("    disk: the HOST block device grew, but the GUEST filesystem did NOT. Either", file=sys.stderr)
        print("    `ivm reboot` (most images grow the root fs on boot), or live inside the guest:", file=sys.stderr)
        print("        growpart /dev/sda 2 && resize2fs /dev/sda2     # ext4 root", file=sys.stderr)
        print("        btrfs filesystem resize max /                  # btrfs root", file=sys.stderr)


def _vm_disk_devices(name: str) -> dict[str, dict[str, Any]]:
    """The VM's INSTANCE-LOCAL disk devices (mounts + their shadow masks), keyed by
    device name. Non-expanded `incus config show`, so profile-inherited devices
    (`root`/`eth0`) are excluded - what's left is exactly the shares attached to THIS
    VM. Empty if the VM is unreachable."""
    import yaml  # lazy, same as cmd_info
    raw: Any = yaml.safe_load(capture(["incus", "config", "show", name]) or "")
    config: dict[str, Any] = raw if isinstance(raw, dict) else {}
    devices: dict[str, Any] = config.get("devices", {}) or {}
    return {device_name: device for device_name, device in devices.items()
            if isinstance(device, dict) and device.get("type") == "disk" and device_name != "root"}


def _next_ivm_mount_index(disk_devices: dict[str, dict[str, Any]]) -> int:
    """Next free N for an `ivm_mount_<N>` device, so a hotplugged mount keeps ivm's
    naming and never collides. Base mount names only (not the `_shadow_` children)."""
    indices: list[int] = []
    for device_name in disk_devices:
        match: re.Match[str] | None = re.fullmatch(r"ivm_mount_([0-9]+)", device_name)
        if match:
            indices.append(int(match.group(1)))
    return max(indices) + 1 if indices else 0


def _next_ivm_standalone_shadow_index(disk_devices: dict[str, dict[str, Any]]) -> int:
    """Next free N for an `ivm_shadow_<N>` standalone mask (the kind `ivm mount
    shadow` adds), so it never collides with an existing one. Ignores the
    mount-tied `ivm_mount_<i>_shadow_<j>` masks, which have their own numbering."""
    indices: list[int] = []
    for device_name in disk_devices:
        match: re.Match[str] | None = re.fullmatch(r"ivm_shadow_([0-9]+)", device_name)
        if match:
            indices.append(int(match.group(1)))
    return max(indices) + 1 if indices else 0


def cmd_mount_ls(name: str) -> None:
    """List the VM's virtio-fs shares + any shadow masks layered on them. Read-only."""
    if not instance_exists(name):
        die(f"no such incus VM: '{name}' (see `incus list`)")
    disk_devices: dict[str, dict[str, Any]] = _vm_disk_devices(name)
    base_mounts: dict[str, dict[str, Any]] = {n: d for n, d in disk_devices.items() if "_shadow_" not in n}
    # Standalone masks added via `ivm mount shadow` (`ivm_shadow_<N>`), not tied to
    # any base mount; listed in their own section so they are not silently hidden.
    standalone_shadows: dict[str, dict[str, Any]] = {
        n: d for n, d in disk_devices.items() if re.fullmatch(r"ivm_shadow_[0-9]+", n)}
    if not base_mounts and not standalone_shadows:
        print(f"{colorize_vm_name(name, stream=sys.stdout)}: no virtio-fs mounts.")
        return
    print(f"mounts on {colorize_vm_name(name, stream=sys.stdout)}:")
    for mount_name, mount_device in sorted(base_mounts.items()):
        ro_tag: str = "  [ro]" if str(mount_device.get("readonly", "")).lower() == "true" else ""
        print(f"  {mount_name:20} {mount_device.get('source', '?')} -> {mount_device.get('path', '?')}{ro_tag}")
        for shadow_name in sorted(disk_devices):
            if shadow_name.startswith(f"{mount_name}_shadow_"):
                print(f"      masked: {disk_devices[shadow_name].get('path') or '?'}  ({shadow_name})")
    for shadow_name in sorted(standalone_shadows):
        print(f"  {shadow_name:20} masked (empty ro): {standalone_shadows[shadow_name].get('path') or '?'}")


def cmd_mount_attach(name: str, host: str, guest: str, *, ro: bool, shadow: list[str],
                     root: Path, dry_run: bool) -> None:
    """Hotplug a virtio-fs share (host dir -> absolute guest path), plus an empty
    read-only mask over each `--shadow` subpath. Uses the next free `ivm_mount_<N>`
    name; works on a running (hotplug) or stopped VM."""
    host_abs: str = os.path.abspath(os.path.expanduser(host))
    if not guest.startswith("/"):
        die(f"guest path must be absolute (got '{guest}')")
    if not dry_run:
        if not instance_exists(name):
            die(f"no such incus VM: '{name}' (see `incus list`)")
        if not os.path.exists(host_abs):
            die(f"host path does not exist: {host_abs}")
    disk_devices: dict[str, dict[str, Any]] = {} if dry_run else _vm_disk_devices(name)
    mount_index: int = _next_ivm_mount_index(disk_devices)
    device_name: str = mount_device_name(mount_index)
    # The same AF_UNIX sun_path guard `init` applies, for the new device(s).
    if not dry_run:
        incus_project_prefix: str = current_incus_project_prefix()
        new_device_names: list[str] = [device_name] + [
            shadow_device_name(mount_index, shadow_index) for shadow_index in range(len(shadow))]
        for new_device_name in new_device_names:
            socket_path: str = virtiofs_socket_path(incus_project_prefix, name, new_device_name)
            if len(socket_path) > SUN_PATH_MAX - 1:
                die(f"virtiofs socket path too long ({len(socket_path)} > {SUN_PATH_MAX - 1}): "
                    f"{socket_path}. The VM name is the long part - recreate it with a shorter name.")
    add_cmd: list[str] = ["incus", "config", "device", "add", name, device_name, "disk",
                          f"source={host_abs}", f"path={guest}"]
    if ro:
        add_cmd.append("readonly=true")
    run(add_cmd, dry_run=dry_run)
    if shadow:
        ensure_shadow_mask(root, dry_run=dry_run)
        mask_source: str = str(shadow_mask_dir(root))
        for shadow_index, subpath in enumerate(shadow):
            masked_guest_path: str = f"{guest.rstrip('/')}/{subpath.lstrip('/')}"
            run(["incus", "config", "device", "add", name,
                 shadow_device_name(mount_index, shadow_index), "disk",
                 f"source={mask_source}", f"path={masked_guest_path}", "readonly=true"], dry_run=dry_run)
    print(f"==> attached {device_name} to {colorize_vm_name(name)}: {host_abs} -> {guest}"
          f"{' [ro]' if ro else ''}.", file=sys.stderr)
    if shadow:
        print(f"    masked subpaths: {', '.join(shadow)}", file=sys.stderr)


def cmd_mount_shadow(name: str, guest_path: str, *, root: Path, dry_run: bool) -> None:
    """Mask an existing guest DIRECTORY with an empty read-only dir, so the guest
    can no longer see whatever was there (its own files, or a subpath of a mount).
    Adds a standalone `ivm_shadow_<N>` disk device at `guest_path`. Unlike `attach
    --shadow` (a subpath relative to a mount added at attach time), this targets an
    absolute guest path and works on an already-running, already-mounted tree.

    Directories only: a VM disk device cannot mount a single file (incus:
    'Mounting single files is not supported' for VMs), and Linux cannot mount a
    filesystem over a regular-file path. `ivm mount detach <guest_path>` un-masks."""
    if not guest_path.startswith("/"):
        die(f"guest path must be absolute (got '{guest_path}')")
    disk_devices: dict[str, dict[str, Any]] = {} if dry_run else _vm_disk_devices(name)
    if not dry_run:
        if not instance_exists(name):
            die(f"no such incus VM: '{name}' (see `incus list`)")
        # A mask only lands on a directory mountpoint. Probe the guest (running VMs
        # only) so a file / missing path fails HERE with a clear reason, not as a
        # cryptic mount error at hotplug or silently at next boot.
        if vm_is_running(name):
            guest_path_kind: str = capture([
                "incus", "exec", name, "--", "sh", "-c",
                f"if [ -d {shlex.quote(guest_path)} ]; then echo DIR; "
                f"elif [ -e {shlex.quote(guest_path)} ]; then echo FILE; else echo MISSING; fi"]).strip()
            if guest_path_kind == "FILE":
                die(f"guest path is a file, not a directory: {guest_path}. A VM disk device "
                    f"cannot mask a single file - mask its parent directory instead.")
            if guest_path_kind == "MISSING":
                die(f"guest path does not exist in {name}: {guest_path}. `shadow` masks an "
                    f"existing guest directory (see `ivm mount ls`).")
    shadow_index: int = _next_ivm_standalone_shadow_index(disk_devices)
    device_name: str = standalone_shadow_device_name(shadow_index)
    # Same AF_UNIX sun_path guard `init`/`attach` apply, for the new mask device.
    if not dry_run:
        socket_path: str = virtiofs_socket_path(current_incus_project_prefix(), name, device_name)
        if len(socket_path) > SUN_PATH_MAX - 1:
            die(f"virtiofs socket path too long ({len(socket_path)} > {SUN_PATH_MAX - 1}): "
                f"{socket_path}. The VM name is the long part - recreate it with a shorter name.")
    ensure_shadow_mask(root, dry_run=dry_run)
    run(["incus", "config", "device", "add", name, device_name, "disk",
         f"source={shadow_mask_dir(root)}", f"path={guest_path}", "readonly=true"], dry_run=dry_run)
    print(f"==> masked {guest_path} on {colorize_vm_name(name)} with an empty read-only dir "
          f"({device_name}). `ivm mount detach {guest_path}` un-masks it.", file=sys.stderr)


def cmd_mount_detach(name: str, target: str, *, dry_run: bool) -> None:
    """Detach a mount OR a single shadow mask, addressed by device name or by path:
      - a mount (`ivm_mount_1`, or its guest path) -> detached WITH its shadow masks
      - one shadow mask (its `..._shadow_N` name, or the masked subpath like the
        project's `.git`) -> just that mask is detached, un-masking the subpath
    Only the virtio-fs binding goes away (`incus config device remove`); the host
    directory + its data are left intact. `ivm mount ls` shows paths + device names."""
    disk_devices: dict[str, dict[str, Any]] = _vm_disk_devices(name)
    if not disk_devices:
        if dry_run:  # no daemon to introspect under --dry-run: take target as the device name
            run(["incus", "config", "device", "remove", name, target], dry_run=dry_run)
            return
        die(f"{name} has no virtio-fs mounts to detach (or is unreachable).")
    # Resolve target -> a device name: exact device name (mount or shadow), else the
    # device whose guest path matches (a mount's path, or a shadow's masked subpath).
    device_name: str | None = None
    if target in disk_devices:
        device_name = target
    else:
        for candidate_name, candidate_device in disk_devices.items():
            if candidate_device.get("path") == target:
                device_name = candidate_name
                break
    if device_name is None:
        die(f"no mount or shadow mask matching '{target}' on {name} (see `ivm mount ls`); "
            f"pass a device name (e.g. ivm_mount_1) or the exact (masked) guest path.")
    # A base mount drags its shadow masks with it; a shadow mask is detached alone.
    is_shadow: bool = "_shadow_" in device_name
    shadow_names: list[str] = [] if is_shadow else sorted(
        n for n in disk_devices if n.startswith(f"{device_name}_shadow_"))
    for device_to_remove in [device_name, *shadow_names]:
        run(["incus", "config", "device", "remove", name, device_to_remove], dry_run=dry_run)
    if is_shadow:
        print(f"==> detached shadow mask {device_name} from {colorize_vm_name(name)} "
              f"(subpath un-masked; host data untouched).", file=sys.stderr)
    else:
        shadow_note: str = (f" (+{len(shadow_names)} shadow mask{'s' if len(shadow_names) != 1 else ''})"
                            if shadow_names else "")
        print(f"==> detached {device_name}{shadow_note} from {colorize_vm_name(name)} "
              f"(share unbound; host directory untouched).", file=sys.stderr)


def cmd_mount(name: str, action: str, *, host: str | None, guest: str | None, ro: bool,
              shadow: list[str], target: str | None, root: Path, dry_run: bool) -> None:
    """`ivm mount`: inspect or change a VM's virtio-fs shares AFTER creation. Template
    `mounts` apply only at `init`, but incus disk devices hotplug for VMs, so this
    works on a live (or stopped) VM. Actions:

      ls                                    list this VM's mounts + their shadow masks
      attach <host> <guest> [--ro]          add a share; repeat --shadow <subpath>
                 [--shadow SUB ...]         to mask subpaths (e.g. --shadow .git)
      shadow <guest_path>                   mask one existing guest DIRECTORY with an
                                            empty ro dir (no host; e.g. a mounted .git)
      detach <device | path>                unbind a mount (+its masks), or one mask
                                            (un-mask a subpath, e.g. `.git`)

    `detach` only unbinds the share (host data is never deleted). Mounts keep ivm's
    `ivm_mount_<N>` naming so `ls`/`detach` stay consistent."""
    if action == "ls":
        cmd_mount_ls(name)
    elif action == "attach":
        cmd_mount_attach(name, host or "", guest or "", ro=ro, shadow=shadow, root=root, dry_run=dry_run)
    elif action == "shadow":
        cmd_mount_shadow(name, guest or "", root=root, dry_run=dry_run)
    elif action == "detach":
        cmd_mount_detach(name, target or "", dry_run=dry_run)
    else:
        die(f"unknown `ivm mount` action: {action!r} (want ls / attach / shadow / detach)")


def cmd_push(name: str, local: str, guest: str, *, as_root: bool, dry_run: bool) -> None:
    """`ivm push <local> <guest>`: copy a host file/dir into the VM via
    `incus file push` (a one-shot snapshot; for a live two-way share use
    `ivm mount attach`). Ownership defaults to `user` (uid/gid 1000); `--as-root`
    pushes as root (0/0). A directory source goes recursively, missing guest dirs are
    created, and the guest path must be absolute. VM file ops run through the
    incus-agent, so the VM is started + waited-for if stopped."""
    local_abs: str = os.path.abspath(os.path.expanduser(local))
    if not guest.startswith("/"):
        die(f"guest path must be absolute (got '{guest}')")
    if not dry_run and not os.path.exists(local_abs):
        die(f"local path does not exist: {local_abs}")
    ensure_up(name, dry_run=dry_run)
    owner_id: str = "0" if as_root else "1000"
    push_cmd: list[str] = ["incus", "file", "push", "--create-dirs"]
    if os.path.isdir(local_abs):
        push_cmd.append("--recursive")
    push_cmd += ["--uid", owner_id, "--gid", owner_id, local_abs, f"{name}{guest}"]
    run(push_cmd, dry_run=dry_run)
    print(f"==> pushed {local_abs} -> {colorize_vm_name(name)}:{guest} "
          f"(owner {'root' if as_root else 'user'}).", file=sys.stderr)


# The legacy `user.*` tags older ivm versions wrote, superseded by the canonical
# set below; `adopt` unsets any that linger so a re-tagged VM has no stale keys.
LEGACY_TAGS: tuple[str, ...] = ("user.ansible-managed", "user.ansible-guest-os")


def cmd_adopt(name: str, root: Path, *, dry_run: bool) -> None:
    """`ivm --name <vm> adopt`: bring an EXISTING incus VM (an older-ivm VM created
    before the `user.ivm_*` tags, or any hand-made instance) under ivm management
    by interactively setting the canonical `user.*` tags. REQUIRES `--name` and
    never resolves by cwd - the VM has no `user.ivm_init_at_dir` yet, and supplying
    one is the whole point. Each prompt pre-fills the tag's current value (or a
    sane default) as an editable line; an empty answer skips that tag. Every write
    prints its `incus config set` before running (legacy hyphenated tags unset)."""
    if not dry_run and not instance_exists(name):
        die(f"no such incus VM: '{name}' (see `incus list`)")
    print(f"Adopting {colorize_vm_name(name)}.", file=sys.stderr)
    print("ivm uses custom `user.*` tags to tell whether an Incus VM is ivm-managed. "
          "ivm can't probe some of these automatically, so please fill them in below "
          "(Enter keeps the shown value, blank skips a tag):", file=sys.stderr)
    available_templates: list[str] = sorted(
        template_file.stem for template_file in (root / "templates").glob("*.yaml"))
    template_hint: str = f" (have: {', '.join(available_templates)})" if available_templates else ""
    # (tag, human label, default-when-unset, allowed values | None). Asked in order.
    tag_specs: list[tuple[str, str, str, tuple[str, ...] | None]] = [
        ("user.ansible_managed", "host-wide 'this VM is ours' flag", "true", None),
        ("user.ivm_guest_os", "guest OS kind", "linux", ("linux", "windows")),
        ("user.ivm_ansible_os_family", "dotfiles os_family (blank for non-Linux)", "", ("Debian", "Suse", "RedHat")),
        ("user.ivm_template", f"source template{template_hint}", "?", None),
        ("user.ivm_init_at_dir", "dir that resolves this VM by cwd", str(Path.cwd()), None),
    ]
    bound_dir: str = ""
    for tag_key, label, fallback_default, allowed_values in tag_specs:
        current_value: str = "" if dry_run else capture(["incus", "config", "get", name, tag_key]).strip()
        choices_suffix: str = f" [{'/'.join(allowed_values)}]" if allowed_values else ""
        while True:
            entered_value: str = prompt_with_prefill(
                f"  {tag_key} - {label}{choices_suffix}: ", current_value or fallback_default).strip()
            if entered_value and allowed_values and entered_value not in allowed_values:
                print(f"    must be one of: {', '.join(allowed_values)} (or blank to skip)", file=sys.stderr)
                continue
            break
        if not entered_value:
            continue
        if tag_key == "user.ivm_init_at_dir":
            entered_value = os.path.abspath(os.path.expanduser(entered_value))
            bound_dir = entered_value
        run(["incus", "config", "set", name, tag_key, entered_value], dry_run=dry_run)
    for legacy_tag in LEGACY_TAGS:
        if dry_run or capture(["incus", "config", "get", name, legacy_tag]).strip():
            run(["incus", "config", "unset", name, legacy_tag], dry_run=dry_run)
    print(f"\nAdopted {colorize_vm_name(name)}. Verify with:\n", file=sys.stderr)
    print("ivm info", file=sys.stderr)
    where: str = f"from {bound_dir}" if bound_dir else "from the dir you bound"
    print(f"\n(run it {where}, or anywhere with `--name {name}`)", file=sys.stderr)


def cmd_storage_status(root: Path, *, as_json: bool, dry_run: bool) -> None:
    """Show the whole host incus storage picture in ONE command: the `default`
    pool's live driver/source, the role-built btrfs loop file + its sparse
    footprint, the loop mount + the file it is ACTUALLY backed by, the matching
    /etc/fstab line, the recorded request (storage-info.json), and a consistency
    verdict. Delegates to the shared `incus_storage_pool.py` inspector (the same one
    the `make incus-install` post-step runs), so host setup and `ivm` report storage
    identically. Read-only - unreadable admin-only fields fall back to the record."""
    inspector: Path = root / "incus_storage_pool.py"
    if not inspector.exists():
        die(f"storage inspector not found at {inspector} - run `make incus-install` first")
    inspector_cmd: list[str] = [sys.executable, str(inspector), "--root", str(root), "status"]
    if as_json:
        inspector_cmd.append("--json")
    run(inspector_cmd, dry_run=dry_run)


def cmd_stub(subcommand: str) -> NoReturn:
    die(f"`{subcommand}` is not implemented yet (see IMPLEMENTATION_PLAN.md phases).")


# ---------- CLI ----------

# Each cwd-resolved subcommand's handler; build_parser() uses its docstring as the
# `ivm <cmd> --help` description - one source: the code doc IS the CLI long help.
# Keys MUST match CWD_RESOLVED.
CWD_RESOLVED_HANDLER: dict[str, Callable[..., None]] = {
    "shell": cmd_shell, "shell-user": cmd_shell, "shell-root": cmd_shell,
    "start": cmd_start, "reboot": cmd_reboot, "stop": cmd_stop, "delete": cmd_delete,
    "overwrite-dotfiles": cmd_overwrite_dotfiles, "update": cmd_update, "provision": cmd_provision,
    "set-password": cmd_set_password, "unset-password": cmd_unset_password,
    "enable-user-sudo": cmd_enable_user_sudo, "disable-user-sudo": cmd_disable_user_sudo,
    "set-ssh-server": cmd_set_ssh_server, "unset-ssh-server": cmd_unset_ssh_server,
    "snapshot": cmd_snapshot, "gui": cmd_gui, "info": cmd_info, "resize": cmd_resize,
    "mount": cmd_mount, "push": cmd_push,
    "expose": cmd_expose, "unexpose": cmd_unexpose,
}


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="ivm", description="incus VM launcher",
        epilog="Most subcommands act on ONE VM, resolved by the current directory "
               "(`user.ivm_init_at_dir`) or `--name <vm>`; `init`/`env`/`list` do not.")
    parser.add_argument("--root", type=Path, default=DEFAULT_ROOT,
                        help=f"ivm install root (schema + templates + fcitx5 script). Default: {DEFAULT_ROOT}")
    parser.add_argument("--shared-assets-root", type=Path, default=DEFAULT_SHARED_ASSETS_ROOT,
                        help=f"shared provision-asset cache (package-group + thirdparty JSON, "
                             f"feature-first dotfiles/); rarely overridden. Default: {DEFAULT_SHARED_ASSETS_ROOT}")
    parser.add_argument("--dry-run", action="store_true",
                        help="print the incus commands that would run, without executing")
    parser.add_argument("-y", "--yes", action="store_true",
                        help="skip confirmation prompts / name prompt (use the default name)")
    parser.add_argument("--name", default=None,
                        help="target this existing VM by name, ignoring the cwd binding "
                             "(applies to the VM-acting subcommands; not init/env/list)")
    sub = parser.add_subparsers(dest="subcommand", required=True)

    p_init: argparse.ArgumentParser = sub.add_parser(
        "init", help="create a VM from a template", description=cmd_init.__doc__)
    p_init.add_argument("template", nargs="?",
                        help="template id (file in templates/); omit to list all templates + descriptions")
    p_init.add_argument("name", nargs="?",
                        help="incus VM instance name (as shown in `incus list`); skips the prompt")

    p_env: argparse.ArgumentParser = sub.add_parser(
        "env", help="print a template's resolved config", description=cmd_env.__doc__)
    p_env.add_argument("template", help="template id")

    # No args here: `list` is a raw passthrough, so we collect everything after it
    # via parse_known_args in main() (REMAINDER mishandles leading `--flags`).
    sub.add_parser("list", help="`incus list` passthrough (e.g. `ivm list --format csv`)",
                   description=cmd_list.__doc__)

    sub.add_parser("top", help="`incus top` passthrough: live per-instance CPU/memory/disk usage",
                   description=cmd_top.__doc__)

    sub.add_parser("adopt",
                   help="bring an unmanaged Incus VM (hand-made or old-ivm) under ivm management (requires `--name`)",
                   description=cmd_adopt.__doc__)

    storage_status_parser: argparse.ArgumentParser = sub.add_parser(
        "storage-status",
        help="show the host incus storage pool status (driver, loop file, mount, fstab, verdict)",
        description=cmd_storage_status.__doc__)
    storage_status_parser.add_argument("--json", action="store_true", help="machine-readable output")

    for name in CWD_RESOLVED:
        sp: argparse.ArgumentParser = sub.add_parser(
            name, aliases=list(CWD_RESOLVED_ALIASES.get(name, ())),
            help=CWD_RESOLVED_HELP[name], description=CWD_RESOLVED_HANDLER[name].__doc__)
        if name == "snapshot":
            sp.add_argument("snapshot_args", nargs=argparse.REMAINDER)
        if name in PASSWORD_SUBCOMMANDS:
            sp.add_argument("username", help="guest account to set/lock the password for (e.g. `user`, `root`)")
        if name in SSH_SERVER_SUBCOMMANDS:
            sp.add_argument("username", help="guest account to grant/revoke key-based SSH for (e.g. `user`, `root`)")
            sp.add_argument("--pubkey", action="append", metavar="FILE",
                            help="host public-key file to authorize/remove (repeatable; default ~/.ssh/id_ed25519.pub)")
        if name == "provision":
            sp.add_argument("names", nargs="*",
                            help="unit(s) to install: a distro_package_groups bundle, a thirdparty_software recipe, or a dotfiles feature; omit to list all units + descriptions")
        if name == "resize":
            sp.add_argument("--cpu", type=int, metavar="N", help="new vCPU count")
            sp.add_argument("--memory", metavar="NG", help="new RAM, whole GiB with a G suffix (e.g. 16G)")
            sp.add_argument("--disk", metavar="NG",
                            help="new root-disk size, whole GiB with a G suffix (e.g. 50G); GROW only")
        if name == "mount":
            mount_sub = sp.add_subparsers(dest="mount_action", required=True)
            mount_sub.add_parser("ls", help="list this VM's mounts + shadow masks")
            p_mount_attach: argparse.ArgumentParser = mount_sub.add_parser("attach", help="add a virtio-fs share")
            p_mount_attach.add_argument("host", help="host path to share")
            p_mount_attach.add_argument("guest", help="absolute path inside the guest")
            p_mount_attach.add_argument("--ro", action="store_true", help="mount read-only")
            p_mount_attach.add_argument("--shadow", action="append", default=[], metavar="SUBPATH",
                                        help="mask a subpath under <guest> with an empty ro dir (repeatable)")
            p_mount_shadow: argparse.ArgumentParser = mount_sub.add_parser(
                "shadow", help="mask an existing guest directory with an empty read-only dir")
            # dest=`guest` (reuses cmd_mount's plumbing); shown as `guest_path` for clarity.
            p_mount_shadow.add_argument("guest", metavar="guest_path",
                                        help="absolute guest DIRECTORY to mask (e.g. a mounted project's "
                                        ".git); single files are not maskable on a VM")
            p_mount_detach: argparse.ArgumentParser = mount_sub.add_parser(
                "detach", help="unbind a mount (+ its shadow masks); host data is never deleted")
            p_mount_detach.add_argument("target", help="a mount (ivm_mount_N / its guest path; unbinds its "
                                        "masks too), or one shadow mask (its name / the masked subpath)")
        if name == "push":
            sp.add_argument("local", help="host file or directory to copy in")
            sp.add_argument("guest", help="absolute destination path in the guest")
            sp.add_argument("--as-root", action="store_true",
                            help="own the pushed files as root (uid/gid 0); default is user (1000)")
        if name == "expose":
            sp.add_argument("port", nargs="?",
                            help="<port> (host==guest) or <host-port>:<guest-port> (e.g. 8000 or 9000:8000); "
                                 "omit to list this VM's current forwards")
        if name == "unexpose":
            sp.add_argument("port", nargs="?",
                            help="host port to stop forwarding; omit to remove ALL forwards (confirms; --yes skips)")
    return parser


def main() -> None:
    parser: argparse.ArgumentParser = build_parser()
    # Bare `ivm` (no args at all) prints full help and exits 0, instead of the
    # argparse `required=True` subcommand error (short usage + stderr, exit 2).
    if len(sys.argv) == 1:
        parser.print_help()
        return
    args: argparse.Namespace
    extras: list[str]
    args, extras = parser.parse_known_args()
    # A subparser alias (e.g. `sh`) is stored verbatim in args.subcommand; fold it back
    # to the canonical subcommand (`shell`) so the dispatch below needs no alias cases.
    args.subcommand = SUBCOMMAND_ALIAS_TO_CANONICAL.get(args.subcommand, args.subcommand)
    root: Path = args.root
    shared_prebuilt_provision_assets_root: Path = args.shared_assets_root
    # init / env / list don't act on an existing VM, so they don't resolve a target.
    if args.subcommand == "list":
        cmd_list(extras, dry_run=args.dry_run)  # raw passthrough to `incus list`
        return
    if args.subcommand == "top":
        cmd_top(extras, dry_run=args.dry_run)  # raw passthrough to `incus top`
        return
    if extras:  # every other subcommand is strict about unknown args
        parser.error("unrecognized arguments: " + " ".join(extras))
    if args.subcommand == "init":
        if args.template:
            cmd_init(args.template, args.name, root, shared_prebuilt_provision_assets_root, assume_yes=args.yes, dry_run=args.dry_run)
        else:
            cmd_list_templates(root)  # no template arg -> list what's available
        return
    if args.subcommand == "env":
        cmd_env(args.template, root, shared_prebuilt_provision_assets_root)
        return
    # adopt acts on an existing VM but must NOT resolve by cwd (the VM has no
    # binding yet - adopt is what creates it), so it forces an explicit --name.
    if args.subcommand == "adopt":
        if not args.name:
            parser.error("adopt requires `--name <vm>` (it never resolves a VM by cwd)")
        cmd_adopt(args.name, root, dry_run=args.dry_run)
        return
    # storage-status is host-level (the whole `default` pool), not per-VM, so it
    # resolves no VM by cwd - handle it before the cwd binding below.
    if args.subcommand == "storage-status":
        cmd_storage_status(root, as_json=args.json, dry_run=args.dry_run)
        return
    # `provision` with no units just lists what is installable - no VM needed, so handle
    # it before the cwd VM binding below.
    if args.subcommand == "provision" and not args.names:
        cmd_list_provision_units(shared_prebuilt_provision_assets_root)
        return
    # Everything else acts on a VM: the global --name overrides the cwd binding.
    name: str = args.name if args.name else resolve_vm_by_cwd(Path.cwd(), dry_run=args.dry_run)
    if args.subcommand in ("shell", "shell-user"):
        cmd_shell(name, root, as_root=False, dry_run=args.dry_run)
    elif args.subcommand == "shell-root":
        cmd_shell(name, root, as_root=True, dry_run=args.dry_run)
    elif args.subcommand == "start":
        cmd_start(name, dry_run=args.dry_run)
    elif args.subcommand == "reboot":
        cmd_reboot(name, assume_yes=args.yes, dry_run=args.dry_run)
    elif args.subcommand == "stop":
        cmd_stop(name, assume_yes=args.yes, dry_run=args.dry_run)
    elif args.subcommand == "delete":
        cmd_delete(name, root, assume_yes=args.yes, dry_run=args.dry_run)
    elif args.subcommand == "overwrite-dotfiles":
        cmd_overwrite_dotfiles(name, shared_prebuilt_provision_assets_root, dry_run=args.dry_run)
    elif args.subcommand == "set-password":
        cmd_set_password(name, args.username, dry_run=args.dry_run)
    elif args.subcommand == "unset-password":
        cmd_unset_password(name, args.username, dry_run=args.dry_run)
    elif args.subcommand == "set-ssh-server":
        cmd_set_ssh_server(name, args.username, pubkey_files=args.pubkey, dry_run=args.dry_run)
    elif args.subcommand == "unset-ssh-server":
        cmd_unset_ssh_server(name, args.username, pubkey_files=args.pubkey, dry_run=args.dry_run)
    elif args.subcommand == "enable-user-sudo":
        cmd_enable_user_sudo(name, dry_run=args.dry_run)
    elif args.subcommand == "disable-user-sudo":
        cmd_disable_user_sudo(name, dry_run=args.dry_run)
    elif args.subcommand == "update":
        cmd_update(name, dry_run=args.dry_run)
    elif args.subcommand == "provision":
        cmd_provision(name, args.names, shared_prebuilt_provision_assets_root, dry_run=args.dry_run)
    elif args.subcommand == "snapshot":
        cmd_snapshot(name, args.snapshot_args, dry_run=args.dry_run)
    elif args.subcommand == "gui":
        cmd_gui(name, dry_run=args.dry_run)
    elif args.subcommand == "info":
        cmd_info(name, root)
    elif args.subcommand == "resize":
        cmd_resize(name, cpu=args.cpu, memory=args.memory, disk=args.disk, dry_run=args.dry_run)
    elif args.subcommand == "mount":
        cmd_mount(name, args.mount_action,
                  host=getattr(args, "host", None), guest=getattr(args, "guest", None),
                  ro=getattr(args, "ro", False), shadow=getattr(args, "shadow", []),
                  target=getattr(args, "target", None), root=root, dry_run=args.dry_run)
    elif args.subcommand == "push":
        cmd_push(name, args.local, args.guest, as_root=args.as_root, dry_run=args.dry_run)
    elif args.subcommand == "expose":
        cmd_expose(name, port_spec=args.port, dry_run=args.dry_run)
    elif args.subcommand == "unexpose":
        cmd_unexpose(name, port_spec=args.port, assume_yes=args.yes, dry_run=args.dry_run)
    else:
        cmd_stub(args.subcommand)


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        # Ctrl+C is a normal way to abort a long `init` / `provision`; exit the way
        # a shell would (130 = 128 + SIGINT) with a one-line notice, not a Python
        # traceback. Mutating subprocesses run via run() get the same SIGINT from
        # the terminal and stop on their own; exec_into() (os.execvp) is unaffected.
        print("\nivm: aborted", file=sys.stderr)
        sys.exit(130)
