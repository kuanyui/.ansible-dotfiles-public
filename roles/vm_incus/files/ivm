def cmd_list_provision_units(shared_prebuilt_provision_assets_root: Path) -> None:
    """List the installable units (name + `description`), grouped by kind - shown when
    `ivm provision` runs with NO unit arg (the bash-friendly alternative to <TAB>). No VM
    needed - this is just the registry. Prints to stdout (readable / pipeable)."""
    distro: dict[str, Any] = load_package_groups(shared_prebuilt_provision_assets_root)
    thirdparty: dict[str, Any] = load_thirdparty_software(shared_prebuilt_provision_assets_root)
    dotfiles_root: Path = shared_prebuilt_provision_assets_root / "dotfiles"
    dotfiles: list[str] = sorted(p.name for p in dotfiles_root.iterdir()) if dotfiles_root.is_dir() else []

    def described_rows(registry: dict[str, Any]) -> list[str]:
        names: list[str] = sorted(registry)
        width: int = max((len(n) for n in names), default=0)
        rows: list[str] = []
        for n in names:
            desc: str = registry[n].get("description", "") if isinstance(registry[n], dict) else ""
            rows.append(f"    {n:<{width}}  {desc}" if desc else f"    {n}")
        return rows

    print("Provisionable units - run `ivm provision <unit>...` (a name may match more than one):\n")
    print("  distro package bundles:")
    print("\n".join(described_rows(distro)))
    print("\n  thirdparty software:")
    print("\n".join(described_rows(thirdparty)))
    print("\n  dotfiles features:")
    print(("    " + ", ".join(dotfiles)) if dotfiles else "    (none)")


def cmd_provision(name: str, unit_names: list[str], shared_prebuilt_provision_assets_root: Path, *, dry_run: bool) -> None:
    """Install named units onto an EXISTING VM - the post-`init` "add more software"
    path. A name can be a `distro_package_groups` bundle, a `thirdparty_software`
    recipe, AND/OR a dotfiles feature - all that match are applied (e.g. `emacs` is
    BOTH the `emacs` package bundle AND the `dotfiles/emacs` config, so both happen).
    Distro bundles install via the VM's package manager; thirdparty recipes run their
    (probe-guarded) script as root, AFTER their declared `distro_packages` deps are
    installed in the same package transaction as the bundles; dotfiles features are
    pushed into /home/user (+ /root). Idempotent. Target is the cwd-bound VM or
    `--name`, like the other VM subcommands."""
    ensure_up(name, dry_run=dry_run)
    distro_registry: dict[str, Any] = load_package_groups(shared_prebuilt_provision_assets_root)
    thirdparty_registry: dict[str, Any] = load_thirdparty_software(shared_prebuilt_provision_assets_root)
    dotfiles_root: Path = shared_prebuilt_provision_assets_root / "dotfiles"
    distro_bundles: list[str] = []
    thirdparty_names: list[str] = []
    dotfiles_features: list[str] = []
    for unit in unit_names:
        matched: bool = False
        if unit in distro_registry:
            distro_bundles.append(unit)
            matched = True
        if unit in thirdparty_registry:
            thirdparty_names.append(unit)
            matched = True
        if (dotfiles_root / unit).is_dir():
            dotfiles_features.append(unit)
            matched = True
        if not matched:
            available_features: list[str] = sorted(p.name for p in dotfiles_root.iterdir()) if dotfiles_root.is_dir() else []
            die(f"unknown unit '{unit}' - not a distro_package_groups bundle, a "
                f"thirdparty_software recipe, nor a dotfiles feature.\n"
                f"  distro bundles:      {', '.join(sorted(distro_registry))}\n"
                f"  thirdparty software: {', '.join(sorted(thirdparty_registry))}\n"
                f"  dotfiles features:   {', '.join(available_features)}")
    if dry_run:
        print(f"+ (incus exec {name} -- install distro bundles {distro_bundles or '[]'} + "
              f"thirdparty {thirdparty_names or '[]'}; push dotfiles {dotfiles_features or '[]'})",
              file=sys.stderr)
        return
    ansible_os_family: str = vm_ansible_os_family(name, dry_run=dry_run)
    if thirdparty_names:
        # Thirdparty recipes source `~/.centralized-lang-pkgs/centralized-lang-pkgs.env.sh`
        # (the npm/pip/pipx/cargo/go install redirect) - (re-)push its feature first, so a
        # VM initialized before this feature existed can still `provision` recipes.
        for push_cmd in push_feature_dotfiles_commands(CENTRALIZE_LANG_PKGS_DIR_FEATURE, ansible_os_family,
                                                       name, shared_prebuilt_provision_assets_root):
            run(push_cmd, dry_run=dry_run)
    script: str = ""
    thirdparty_recipes: list[dict[str, Any]] = resolve_thirdparty_software(
        thirdparty_names, thirdparty_registry, ansible_os_family
    ) if thirdparty_names else []
    # ONE package-manager transaction for the bundles' packages AND the recipes'
    # `distro_packages` deps - so deps are in place before any recipe script runs.
    packages: list[str] = []
    for bundle in distro_bundles:
        packages += resolve_group(distro_registry, bundle, ansible_os_family)
    for thirdparty_recipe in thirdparty_recipes:
        packages += thirdparty_recipe["distro_packages"]
    packages = list(dict.fromkeys(packages))
    if packages:
        script += install_packages_script(ansible_os_family, packages)
    if distro_bundles:
        # `user` already exists on a provisioned VM, so a bundle's post_install can
        # `su - user -c` straight away (unlike init, no ordering concern).
        script += groups_post_install_script(distro_bundles, distro_registry, ansible_os_family)
    if thirdparty_recipes:
        script += thirdparty_install_script(thirdparty_recipes)
    if script:
        run(["incus", "exec", name, "--", "bash", "-ec", script], dry_run=dry_run)
    for feature in dotfiles_features:
        for push_cmd in push_feature_dotfiles_commands(feature, ansible_os_family, name, shared_prebuilt_provision_assets_root):
            run(push_cmd, dry_run=dry_run)
    print(f"==> provisioned {', '.join(unit_names)} into {colorize_vm_name(name)}.", file=sys.stderr)


def cmd_snapshot(name: str, snapshot_args: list[str], *, dry_run: bool) -> None:
    """Thin wrapper over `incus snapshot`, injecting the target VM as the instance
    arg: `ivm snapshot [create|list|restore|delete|...] [snapname]` ->
    `incus snapshot <action> <vm> [snapname]`. No args defaults to `list`."""
    action: str = snapshot_args[0] if snapshot_args else "list"
    rest: list[str] = snapshot_args[1:]
    run(["incus", "snapshot", action, name, *rest], dry_run=dry_run)


def cmd_gui(name: str, *, dry_run: bool) -> None:
    """Open the VM's SPICE graphical console (`incus console --type=vga`) DETACHED
    from the calling shell: spawn it in its own session with stdin/stdout/stderr
    silenced, so ivm returns at once and you can close the terminal without
    killing the GUI. (incus console itself stays alive managing the SPICE socket
    until the viewer closes - cmd/incus/console.go vga() - so it must be detached,
    not merely backgrounded.)"""
    ensure_up(name, dry_run=dry_run)
    cmd: list[str] = ["incus", "console", "--type=vga", name]
    print("+ " + shlex.join(cmd) + "  (detached: own session, output silenced)", file=sys.stderr)
    if dry_run:
        return
    # `incus console --type=vga` auto-launches remote-viewer, else spicy. If
    # NEITHER is installed it does NOT fail - it prints a socket path and hangs
    # waiting for a connection (console.go vga(), "neither could be found").
    # Detached + silenced, that would be an invisible stuck process with no
    # window, so refuse loudly here instead (mirrors incus's own viewer probe).
    if shutil.which("remote-viewer") is None and shutil.which("spicy") is None:
        die("no SPICE viewer found - install remote-viewer (virt-viewer) or spicy "
            "(spice-gtk), then retry `ivm gui`. To debug without one, run yourself: "
            f"incus console --type=vga {name}")
    # Detach: start_new_session=True puts it in its own session (no controlling
    # terminal), so closing this shell does NOT SIGHUP it; stdin/stdout/stderr to
    # /dev/null keeps console noise off the shell. The vga path needs no TTY (only
    # the text console sets raw mode), so a /dev/null stdin is safe.
    subprocess.Popen(
        cmd, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL, start_new_session=True,
    )
    print(f"==> GUI console launched for {colorize_vm_name(name)} "
          f"(detached - close this terminal anytime).", file=sys.stderr)


def print_table(headers: list[str], rows: list[tuple[str, ...]], *, stream: TextIO = sys.stdout) -> None:
    """Print `rows` as a left-aligned, two-space-gutter table under `headers`, each
    column sized to its widest cell (trailing pad stripped). REUSABLE by any ivm
    listing (`list`, bare `cd`, ...); every row must have one cell per header."""
    column_widths: list[int] = [len(header) for header in headers]
    for row in rows:
        for column_index, cell in enumerate(row):
            column_widths[column_index] = max(column_widths[column_index], len(cell))
    def format_row(cells: tuple[str, ...]) -> str:
        return "  ".join(cell.ljust(column_widths[i]) for i, cell in enumerate(cells)).rstrip()
    print(format_row(tuple(headers)), file=stream)
    for row in rows:
        print(format_row(row), file=stream)


def managed_vm_rows(columns: str) -> list[list[str]]:
    """`incus list` CSV parsed into rows for ivm-MANAGED VMs only - those whose LAST
    column is a non-empty `user.ivm_init_at_dir` (the managed-VM marker). `columns` is
    an incus `--columns` spec that MUST end in `config:user.ivm_init_at_dir`. Parsed via
    io.StringIO (not splitlines) so a multi-address IPv4 cell, which incus CSV-quotes
    across newlines, is not mis-split. REUSABLE by `list` / future name+dir listings."""
    csv_out: str = capture(["incus", "list", "--format", "csv", "--columns", columns])
    managed_rows: list[list[str]] = []
    for row in csv.reader(io.StringIO(csv_out)):
        if row and row[-1]:  # last column is the working dir -> keep only managed VMs
            managed_rows.append(row)
    return managed_rows


def qemu_host_rss(qemu_pid: str) -> str | None:
    """TRUE host RAM of a VM's qemu process: `VmRSS` from `/proc/<pid>/status`, formatted
    like the guest figure (`human_iec_bytes`). This is the real cost the guest-agent number
    (`incus list -c m`) UNDER-reports - incus VMs have no memory-balloon free-page-reporting,
    so freed guest RAM is not returned to the host until stop (see `cmd_top`). `qemu_pid` is
    incus's `state.pid` for the VM (the `p` column; it is the qemu PID, from the driver's
    `/run/incus/<name>/qemu.pid` pidfile). Returns None - so the caller prints a placeholder,
    never a wrong 0 - when the pid is empty/non-numeric, the process is gone, or `/proc` is
    unreadable (e.g. a `hidepid` mount). No sudo: the pid comes from incus, and the `VmRSS`
    line of `/proc/<pid>/status` is world-readable even for a root-owned qemu."""
    if not qemu_pid.strip().isdigit():
        return None
    try:
        proc_status: str = Path(f"/proc/{qemu_pid.strip()}/status").read_text()
    except OSError:
        return None
    rss_match: re.Match[str] | None = re.search(r"^VmRSS:\s+(\d+)\s+kB$", proc_status, re.MULTILINE)
    return human_iec_bytes(int(rss_match.group(1)) * 1024) if rss_match else None


def guest_disk_used(name: str) -> str | None:
    """USED bytes of the VM's root filesystem, read LIVE from inside the guest via
    `incus exec <name> -- df -Pk /` (POSIX `df`, 1-KiB blocks; `-P` keeps each entry on one
    line). This is a DIRECT exec - reliable, unlike incus's periodic guest-agent disk metric
    (`incus list -c D`), which for VMs is famously sporadic (lxc/incus#259). Needs NO host
    root: `incus exec` already runs as root inside the guest (the same path as `ivm sh-root`).
    NOTE: this is the GUEST filesystem's used space, which can sit below the host's real
    `root.img` btrfs footprint until the guest `fstrim`s freed blocks back. A 5s timeout keeps
    one wedged VM from hanging the whole listing. Returns a `human_iec_bytes` string, or None
    (caller prints a placeholder) when the VM is unreachable or `df` output is unparseable."""
    try:
        result: subprocess.CompletedProcess[str] = subprocess.run(
            ["incus", "exec", name, "--", "df", "-Pk", "/"],
            capture_output=True, text=True, timeout=5,
        )
    except (subprocess.TimeoutExpired, OSError):
        return None
    if result.returncode != 0:
        return None
    df_lines: list[str] = result.stdout.splitlines()
    if len(df_lines) < 2:  # header + one data line expected
        return None
    df_fields: list[str] = df_lines[-1].split()  # Filesystem 1K-blocks Used Avail Cap Mount
    if len(df_fields) < 3 or not df_fields[2].isdigit():
        return None
    return human_iec_bytes(int(df_fields[2]) * 1024)


class InstanceTimestamps(NamedTuple):
    """The three timestamps incus keeps per instance (upstream `shared/api/instance.go`
    + `instance_state.go`), as aware datetimes; None = never / unavailable. incus
    records STARTS only - there is no stop/shutdown timestamp anywhere."""

    created_at: datetime | None    # instance creation
    last_used_at: datetime | None  # last START ("Last start timestamp" upstream)
    started_at: datetime | None    # THIS boot's start (`state.started_at`); None when stopped


def parse_incus_rfc3339(timestamp_rfc3339: str) -> datetime | None:
    """An incus API timestamp (Go RFC3339Nano, e.g. `2026-07-12T09:15:03.123456789+08:00`)
    -> aware datetime. None for empty / unparseable / the Go zero time
    (`0001-01-01T00:00:00Z`, incus's "never"). Go emits up to 9 fractional-second
    digits while fromisoformat caps at 6 - trim first; the `Z` -> `+00:00` rewrite
    covers pre-3.11 Pythons that reject the `Z` suffix."""
    if not timestamp_rfc3339:
        return None
    iso_compatible: str = re.sub(r"\.(\d{6})\d+", r".\1", timestamp_rfc3339).replace("Z", "+00:00")
    try:
        parsed_timestamp: datetime = datetime.fromisoformat(iso_compatible)
    except ValueError:
        return None
    return None if parsed_timestamp.year <= 1 else parsed_timestamp


def brief_duration(elapsed: timedelta) -> str:
    """A duration as its two leading units, table-cell brief: `3d 4h` / `5h 12m` /
    `34m` / `<1m`. Clock skew (negative) clamps to `<1m`."""
    total_minutes: int = max(0, int(elapsed.total_seconds() // 60))
    days, day_remainder_minutes = divmod(total_minutes, 24 * 60)
    hours, minutes = divmod(day_remainder_minutes, 60)
    if days:
        return f"{days}d {hours}h"
    if hours:
        return f"{hours}h {minutes}m"
    return f"{minutes}m" if minutes else "<1m"


def brief_ago(past_moment: datetime) -> str:
    """Elapsed-since as ONE leading unit (`19d` / `5h` / `34m` / `<1m`), for
    `(19d ago)`-style suffixes."""
    elapsed_minutes: int = max(
        0, int((datetime.now(timezone.utc) - past_moment).total_seconds() // 60))
    if elapsed_minutes >= 24 * 60:
        return f"{elapsed_minutes // (24 * 60)}d"
    if elapsed_minutes >= 60:
        return f"{elapsed_minutes // 60}h"
    return f"{elapsed_minutes}m" if elapsed_minutes else "<1m"


def incus_instance_timestamps(vm_name: str | None = None) -> dict[str, InstanceTimestamps]:
    """`created_at` / `last_used_at` / `state.started_at` for every instance (or just
    `vm_name`), keyed by instance name - ONE `incus list --format json` call (its
    InstanceFull objects embed the state). JSON, not the CSV date columns: those are
    pre-formatted localized strings (upstream `cmd/incus/list.go` formats via
    `.Local().Format(dateLayout)`), useless for computing an age/uptime.
    `state.started_at` needs the `instance_state_started_at` API extension (incus
    6.1, backported to the 6.0 LTS branch); absent -> None, and RUNNING-uptime
    callers fall back to `last_used_at` - for a running instance the same fact
    (upstream doc comment: "Last start timestamp"). Empty dict when incus fails -
    callers then print placeholders, never crash."""
    incus_list_json_cmd: list[str] = (
        ["incus", "list"] + ([vm_name] if vm_name else []) + ["--format", "json"])
    try:
        instances: Any = json.loads(capture(incus_list_json_cmd) or "[]")
    except json.JSONDecodeError:
        return {}
    timestamps_by_vm_name: dict[str, InstanceTimestamps] = {}
    for instance in instances if isinstance(instances, list) else []:
        instance_state: dict[str, Any] = instance.get("state") or {}
        timestamps_by_vm_name[instance.get("name", "")] = InstanceTimestamps(
            created_at=parse_incus_rfc3339(instance.get("created_at") or ""),
            last_used_at=parse_incus_rfc3339(instance.get("last_used_at") or ""),
            started_at=parse_incus_rfc3339(instance_state.get("started_at") or ""),
        )
    return timestamps_by_vm_name


def created_at_cell(vm_timestamps: InstanceTimestamps) -> str:
    """CREATED cell: `2026-07-12 (19d)` - local date + age. `?` when unknown (incus
    JSON unavailable); the full time-of-day lives in `ivm info`, not here."""
    if vm_timestamps.created_at is None:
        return "?"
    return (f"{vm_timestamps.created_at.astimezone():%Y-%m-%d}"
            f" ({brief_ago(vm_timestamps.created_at)})")


def uptime_or_last_on_cell(vm_state: str, vm_timestamps: InstanceTimestamps) -> str:
    """UP/LAST-ON cell. RUNNING/FROZEN -> `up 3d 4h` since this boot's start (a FROZEN
    VM's qemu lives on; the STATE column right beside it already says frozen).
    Otherwise `last on 19d ago` - the last START, because incus records no stop time
    (see InstanceTimestamps) - or `(never started)`. `up ?` = running but incus
    returned no timestamps (JSON call failed)."""
    if vm_state.upper() in ("RUNNING", "FROZEN"):
        this_boot_started_at: datetime | None = (
            vm_timestamps.started_at or vm_timestamps.last_used_at)
        if this_boot_started_at is None:
            return "up ?"
        return "up " + brief_duration(datetime.now(timezone.utc) - this_boot_started_at)
    if vm_timestamps.last_used_at is None:
        return "(never started)"
    return f"last on {brief_ago(vm_timestamps.last_used_at)} ago"


def cmd_list(list_args: list[str], *, dry_run: bool) -> None:
    """List ivm-managed VMs (those tagged with `user.ivm_init_at_dir`) as a table:
    State, Name, MEM(guest), MEM(host), DISK, Created (local date + age, from incus
    `created_at`), Up/Last-On (running -> `up 3d 4h` since this boot's start; stopped ->
    `last on 19d ago` = the last START, incus records no stop time; `(never started)`
    labelled), Host-Bound Dir (`user.ivm_host_bound_dir`, the dir cwd resolution
    matches + `ivm cd` jumps to; labelled placeholder when unbound/legacy), IPv4. MEM(guest) is incus's guest-agent memory figure;
    MEM(host) is the qemu process's real host RSS (`qemu_host_rss`), which the guest figure
    under-reports. DISK is the guest root filesystem's USED space, read live per running VM
    via `incus exec ... df` (`guest_disk_used`) - reliable, unlike incus's sporadic guest-agent
    disk metric (`-c D`, lxc/incus#259). A non-running VM shows `(<state>)` (e.g. `(stopped)`);
    a value that can't be read shows `-`; a FROZEN VM still has a qemu process, so its MEM(host)
    stays populated. ANY extra arg switches to a RAW `incus list` passthrough instead (e.g.
    `ivm list --format csv`), which then shows ALL incus instances, ivm-managed or not."""
    if list_args:  # explicit passthrough: honor the caller's incus format/filter verbatim
        run(["incus", "list", *list_args], dry_run=dry_run)
        return
    # `p` (qemu pid) rides along so MEM(host) needs no extra per-VM `incus info` call.
    # `host_bound_dir` is the DISPLAY column; `init_at_dir` stays LAST as the
    # managed-VM marker `managed_vm_rows` filters on.
    list_columns: str = "s,n,4,m,p,config:user.ivm_host_bound_dir,config:user.ivm_init_at_dir"
    if dry_run:
        print(f"+ incus list --format csv --columns {list_columns}", file=sys.stderr)
        print("+ incus list --format json  # created_at + last_used_at + state.started_at "
              "-> CREATED, UP/LAST-ON", file=sys.stderr)
        print("  + per running VM: read /proc/<qemu-pid>/status VmRSS (MEM host) + "
              "`incus exec <vm> -- df -Pk /` (DISK)", file=sys.stderr)
        return
    # One extra incus call for the raw timestamps (see incus_instance_timestamps on
    # why the CSV date columns can't serve here).
    instance_timestamps_by_vm_name: dict[str, InstanceTimestamps] = incus_instance_timestamps()
    table_rows: list[tuple[str, ...]] = []
    for state, name, ipv4, guest_mem, qemu_pid, host_bound_dir, _init_at_dir in managed_vm_rows(list_columns):
        # Non-running VMs show `(<state>)`; a running VM whose figure can't be read shows `-`.
        # MEM(host) reads the host qemu process (qemu_host_rss), so it stays populated even when
        # the agent is silent and even for a FROZEN VM whose process lives on. DISK execs `df`
        # inside each running guest - the reliable path, since incus's agent disk metric (`-c D`)
        # is sporadic for VMs (lxc/incus#259); skipped when not running (nothing to exec into).
        is_running: bool = state.upper() == "RUNNING"
        running_gap: str = "-" if is_running else f"({state.lower()})"
        mem_host: str = qemu_host_rss(qemu_pid) or running_gap
        disk: str = (guest_disk_used(name) or running_gap) if is_running else running_gap
        vm_timestamps: InstanceTimestamps = instance_timestamps_by_vm_name.get(
            name, InstanceTimestamps(None, None, None))
        table_rows.append((
            state, name,
            guest_mem or running_gap,
            mem_host,
            disk,
            created_at_cell(vm_timestamps),
            uptime_or_last_on_cell(state, vm_timestamps),
            display_host_bound_dir(host_bound_dir),
            ipv4.replace("\n", ", "),
        ))
    if not table_rows:
        print("No ivm-managed VMs (none carry `user.ivm_init_at_dir`); "
              "create one with `ivm init <template>`.", file=sys.stderr)
        return
    print_table(["STATE", "NAME", "MEM(guest)", "MEM(host)", "DISK", "CREATED",
                 "UP/LAST-ON", "HOST-BOUND DIR", "IPV4"], table_rows)


def cmd_cd(name: str | None) -> None:
    """Print the HOST dir a VM is bound to (`user.ivm_host_bound_dir`) - one line to
    STDOUT, for the `ivm()` shell wrapper to `cd` into (a child process cannot change
    its parent shell's cwd). Refuses a cwd-unbound (sentinel) or legacy (tag absent)
    VM: non-zero exit, empty stdout. No name -> list every ivm-managed VM + its
    bound dir on STDERR, so the wrapper (which cd's to stdout) does nothing.
    Completes VM names -> their dirs (see `_ivm_managed_vms` in the completions)."""
    bindings: list[VmBinding] = list_vm_bindings()
    if not name:
        if not bindings:
            print("No ivm-managed VMs yet; create one with `ivm init <template>`.", file=sys.stderr)
            return
        print_table(["NAME", "HOST-BOUND DIR"],
                    [(binding.name, display_host_bound_dir(binding.host_bound_dir)) for binding in bindings],
                    stream=sys.stderr)
        return
    for binding in bindings:
        if binding.name == name:
            if not binding.host_bound_dir:
                # Exit non-zero with NOTHING on stdout, so the ivm() shell wrapper's
                # `|| return` stops it from cd'ing into a bogus path.
                die(f"'{name}' has no host-bound dir - nothing to cd into "
                    f"(bind one with: ivm --name {name} set host-bound-dir <dir>)")
            print(binding.host_bound_dir)
            return
    die(f"no ivm-managed VM named '{name}' (run `ivm cd` or `ivm list` to see them)")


def cmd_top(top_args: list[str], *, dry_run: bool) -> None:
    """`incus top` passthrough: a live per-instance CPU / memory / disk view (needs a
    recent incus). NOTE: a VM's memory column is the GUEST-reported usage (via the incus
    agent), which UNDER-reports the host RAM the QEMU process actually holds - incus VMs
    have no balloon free-page-reporting, so freed guest memory is not returned to the
    host until the VM stops. For the true per-VM host cost:
    `ps -eo pid,rss,comm --sort=-rss | grep qemu`."""
    exec_into(["incus", "top", *top_args], dry_run=dry_run)


