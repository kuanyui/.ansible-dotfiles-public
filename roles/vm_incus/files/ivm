# Short aliases for the most-typed subcommands. argparse stores the alias VERBATIM
# in `args.subcommand` (e.g. `sh`, not `shell`), so main() folds it back to the
# canonical name via SUBCOMMAND_ALIAS_TO_CANONICAL before dispatch - one dict drives
# BOTH the parser's `aliases=` and that fold-back. Keys MUST be in CWD_RESOLVED.
CWD_RESOLVED_ALIASES: dict[str, tuple[str, ...]] = {
    "shell": ("sh",),
    "shell-user": ("sh-user",),
    "shell-root": ("sh-root",),
}
SUBCOMMAND_ALIAS_TO_CANONICAL: dict[str, str] = {
    alias: canonical
    for canonical, aliases in CWD_RESOLVED_ALIASES.items()
    for alias in aliases
}
# Subcommands taking a positional `<username>` (set/unset a login password).
PASSWORD_SUBCOMMANDS: tuple[str, ...] = ("set-password", "unset-password")
# Subcommands taking a positional `<username>` + optional `--pubkey` (grant/revoke
# key-based SSH for that guest account). Modelled on the password pair above.
SSH_SERVER_SUBCOMMANDS: tuple[str, ...] = ("set-ssh-server", "unset-ssh-server")

# Installed on EVERY guest at first provision (the ivm-guest floor: zsh + login
# shell, sudo, ssh, basics). Defined as a bundle in the distro_packages registry
# (`distro_packages_incus_guest_baseline`) so all package names - including
# per-family differences - live in one place; resolved from distro-package-groups.json.
BASELINE_GROUP: str = "incus_guest_baseline"

# incus instance name: start alphanumeric, then [a-zA-Z0-9-], max 63 chars.
INCUS_NAME_RE: re.Pattern[str] = re.compile(r"^[a-zA-Z0-9][a-zA-Z0-9-]{0,62}$")
MAX_NAME_LEN: int = 63

# A valid (<=63 char) instance name is NOT sufficient: each VM mount gets a
# virtiofs socket at /var/lib/incus/devices/<project_>?<instance>/virtio-fs.<device>.sock
# and that whole path must fit AF_UNIX's sun_path (108 bytes incl. NUL -> 107
# usable chars). On overflow `incus start` dies with a cryptic "connect: invalid
# argument", so `socket_path_error` rejects over-long names at pick time. The
# project prefix (`user-1000_` for the unprivileged `incus` group's restricted
# project, empty for `default`) and the longest device-name suffix both count.
SUN_PATH_MAX: int = 108
INCUS_DEVICES_DIR: str = "/var/lib/incus/devices"

# incus daemon state root (FHS default). When a pool/loop file has an empty
# `source`, incus used a built-in default location UNDER this dir, so the storage
# preview reconstructs it from here: `dir` -> storage-pools/<pool>, loop-file
# backends -> disks/<pool>.img (incus's `loopFilePath()`). If the whole tree was
# relocated it is symlinked back to this path, so the string still resolves.
INCUS_VAR_DIR: str = "/var/lib/incus"

# Map a template's `os.distro` to the ansible fact `ansible_os_family` (values:
# Debian/Suse/RedHat - NOT the distro name like `opensuse`). It keys both the
# feature-first dotfiles staging (shared dotfiles/<feature>/<Debian|Suse|RedHat>/) and the
# package-group overlays (__common__ + per-family) in distro-package-groups.json. debian/ubuntu share the
# Debian family today; if ubuntu package names ever diverge from debian, that
# needs a finer distro-level key, not just ansible_os_family.
DISTRO_TO_ANSIBLE_OS_FAMILY: dict[str, str] = {
    "debian": "Debian",
    "ubuntu": "Debian",
    "opensuse": "Suse",
    "fedora": "RedHat",
}

# VM instance names get lost in ivm's output (the `+ incus ...` echoes, previews,
# `==>` status lines). Color them bold-cyan so they stand out, but ONLY when the
# target stream is a TTY and NO_COLOR is unset - redirected/piped output (and a
# `--dry-run` captured to a file) must stay plain. Gating is per-stream because
# ivm prints names to BOTH stderr (status/previews) and stdout (`info`).
VM_NAME_COLOR: str = "\033[1;36m"  # bold cyan
COLOR_RESET: str = "\033[0m"


def colorize_vm_name(name: str, *, stream: TextIO = sys.stderr) -> str:
    """Wrap a VM name in color for human-facing output on `stream` (default
    stderr; pass `sys.stdout` for names printed there). No-op when `stream` is not
    a TTY or `NO_COLOR` is set, so the escape codes never reach a file/pipe."""
    if os.environ.get("NO_COLOR") or not stream.isatty():
        return name
    return f"{VM_NAME_COLOR}{name}{COLOR_RESET}"


def ansible_os_family_of(doc: Template) -> str:
    distro: str = doc["os"].get("distro", "")
    try:
        return DISTRO_TO_ANSIBLE_OS_FAMILY[distro]
    except KeyError:
        die(f"no dotfiles ansible_os_family mapping for distro '{distro}'")


def die(msg: str) -> NoReturn:
    print(f"ivm: error: {msg}", file=sys.stderr)
    raise SystemExit(1)


# ---------- template loading / validation ----------

def load_yaml(path: Path) -> Template:
    try:
        import yaml  # PyYAML (ships with ansible-core; role ensures python3-yaml)
    except ImportError:
        die("PyYAML not found; install python3-yaml")
    if not path.is_file():
        die(f"template not found: {path}")
    loaded: Any = yaml.safe_load(path.read_text())
    if not isinstance(loaded, dict):
        die(f"template is not a mapping: {path}")
    return loaded


def validate_template(doc: Template, root: Path) -> None:
    """Validate a template dict against template.schema.json (draft 2020-12)."""
    try:
        import jsonschema
    except ImportError:
        die("jsonschema not found; install python3-jsonschema")
    schema_path: Path = root / "template.schema.json"
    if not schema_path.is_file():
        die(f"schema not found: {schema_path}")
    schema: dict[str, Any] = json.loads(schema_path.read_text())
    errors: list[ValidationError] = sorted(
        jsonschema.Draft202012Validator(schema).iter_errors(doc),
        key=lambda e: list(e.path),
    )
    if errors:
        loc: str = "/".join(str(p) for p in errors[0].path) or "(root)"
        die(f"template invalid at {loc}: {errors[0].message}")


def load_and_validate(template_name: str, root: Path) -> Template:
    doc: Template = load_yaml(root / "templates" / f"{template_name}.yaml")
    validate_template(doc, root)
    return doc


# ---------- distro_packages bundle registry ----------

def load_package_groups(shared_prebuilt_provision_assets_root: Path) -> dict[str, Any]:
    """Load distro-package-groups.json (rendered at apply time from the
    provision_distro_packages registry; see roles/_shared_prebuilt_provision_assets)."""
    path: Path = shared_prebuilt_provision_assets_root / "distro-package-groups.json"
    if not path.is_file():
        die(f"distro-package-groups.json not found: {path}; re-run `make vm-incus-install`")
    loaded: Any = json.loads(path.read_text())
    if not isinstance(loaded, dict):
        die(f"distro-package-groups.json is not a mapping: {path}")
    return loaded


def load_thirdparty_software(shared_prebuilt_provision_assets_root: Path) -> dict[str, Any]:
    """Load thirdparty-software.json (rendered at apply time from the
    provision_thirdparty_software registry; see roles/_shared_prebuilt_provision_assets)."""
    path: Path = shared_prebuilt_provision_assets_root / "thirdparty-software.json"
    if not path.is_file():
        die(f"thirdparty-software.json not found: {path}; re-run `make vm-incus-install`")
    loaded: Any = json.loads(path.read_text())
    if not isinstance(loaded, dict):
        die(f"thirdparty-software.json is not a mapping: {path}")
    return loaded


def overlay_install_packages(overlay: Any) -> list[str]:
    """A family overlay (the `common` / `debian` / `suse` / `redhat` value of a
    distro_packages bundle) is EITHER a bare package list, OR - when that family also
    carries setup - a dict `{install: [...], post_install: <shell>}`. Return its package
    list either way."""
    if isinstance(overlay, dict):
        return list(overlay.get("install", []))
    return list(overlay or [])


def overlay_post_install(overlay: Any) -> str:
    """The optional `post_install` shell snippet of a family overlay (only its dict form
    has one). Returns "" for the bare-list form or when absent."""
    if isinstance(overlay, dict):
        return str(overlay.get("post_install", "") or "")
    return ""


def resolve_group(registry: dict[str, Any], group: str, ansible_os_family: str) -> list[str]:
    """A bundle resolves to `__common__ + <ansible_os_family overlay>` packages (same rule as
    roles/provision_distro_packages/tasks/main.yml, but for one family at a time). Each overlay is a
    bare list or a `{install, post_install}` dict - see overlay_install_packages."""
    entry: Any = registry.get(group)
    if entry is None:
        die(f"unknown distro_package_group '{group}' "
            f"(not in distro-package-groups.json; defined ones: {', '.join(sorted(registry))})")
    return overlay_install_packages(entry.get("__common__")) + overlay_install_packages(entry.get(ansible_os_family))


def resolve_packages(doc: Template, registry: dict[str, Any], ansible_os_family: str) -> list[str]:
    """Flatten the always-on baseline + the template's groups + its flat
    `distro_packages` into one install list, deduped (groups overlap the
    baseline, e.g. git/tmux), order preserved."""
    packages: list[str] = resolve_group(registry, BASELINE_GROUP, ansible_os_family)
    for group in doc.get("distro_package_groups", []):
        packages += resolve_group(registry, group, ansible_os_family)
    packages += doc.get("distro_packages", [])
    return list(dict.fromkeys(packages))


def group_post_install_snippet(group_entry: dict[str, Any], ansible_os_family: str) -> str:
    """Resolve a bundle's `post_install` for one family: the `__common__` overlay's snippet +
    this family overlay's snippet, ADDITIVE (__common__ runs first, the family-specific extra
    appends - so a distro needing one extra step adds it without repeating the shared part).
    `post_install` lives INSIDE each family overlay's dict form (sibling to its `install`),
    so the bundle's top level stays purely families. Returns "" when none define one."""
    parts: list[str] = [overlay_post_install(group_entry.get("__common__")),
                        overlay_post_install(group_entry.get(ansible_os_family))]
    return "\n".join(part for part in parts if part.strip())


def groups_post_install_script(groups: list[str], registry: dict[str, Any], ansible_os_family: str) -> str:
    """A distro_packages bundle MAY carry an optional `post_install` shell snippet
    (sibling to its per-family package overlays) - setup that belongs WITH its packages,
    e.g. enabling a display manager after installing it. Concatenate the resolved
    snippets of the given bundles, in order, each prefixed with an echo marker; skip
    bundles without one. Run as ROOT in the guest AFTER the packages install (the caller
    places it post-user-creation so a snippet's `su - user -c` works). Idempotent - it
    re-runs on every `provision`. (Per-distro PACKAGE differences belong in the family
    overlays; `post_install` is for per-distro SCRIPT steps - see group_post_install_snippet.)"""
    script: str = ""
    for group in groups:
        snippet: str = group_post_install_snippet(registry.get(group) or {}, ansible_os_family)
        if snippet.strip():
            script += f"echo '==> {group}: post_install' >&2\n"
            script += snippet if snippet.endswith("\n") else snippet + "\n"
    return script


# ---------- command execution (dry-run aware) ----------

def run(cmd: list[str], *, dry_run: bool) -> None:
    """Run a mutating command, or just print it under --dry-run."""
    print("+ " + shlex.join(cmd), file=sys.stderr)
    if not dry_run:
        subprocess.run(cmd, check=True)


def exec_into(cmd: list[str], *, dry_run: bool) -> None:
    """Hand the terminal to an interactive command (a guest shell / console) by
    REPLACING the ivm process with it (os.execvp). The command's exit status
    becomes ivm's, so a normal `exit` (or `exit 1`) in the guest shell does NOT
    surface as a Python CalledProcessError traceback. No `check`: the child IS
    the foreground program, not a step to verify. Always the last thing ivm does."""
    print("+ " + shlex.join(cmd), file=sys.stderr)
    if dry_run:
        return
    os.execvp(cmd[0], cmd)


def capture(cmd: list[str]) -> str:
    """Run a read-only command and return stdout (empty on failure)."""
    result = subprocess.run(cmd, capture_output=True, text=True)
    return result.stdout if result.returncode == 0 else ""


def sh_expand(value: str, cwd: Path) -> str:
    """Expand a mount `host` value on the HOST, relative to cwd: handles
    `$(pwd)`, `$(xdg-user-dir ...)`, `$HOME`, `~`, and relative paths. The user
    authors these in their own template, so shell evaluation is intentional."""
    out: str = capture(["bash", "-c", f'cd {shlex.quote(str(cwd))} && printf %s {value}'])
    return out or value


# ---------- instance name ----------

def sanitize_incus_name(raw: str) -> str:
    name: str = re.sub(r"[^a-zA-Z0-9-]+", "-", raw).strip("-")
    name = re.sub(r"-{2,}", "-", name)
    if name and not name[0].isalnum():
        name = name.lstrip("-")
    return name[:MAX_NAME_LEN]


def default_instance_name(template_name: str, cwd: Path) -> str:
    # `ivm-` prefix so ivm-managed VMs are obvious at a glance in `incus list`.
    # Only the auto-generated default carries it; an explicit `--name` is left
    # untouched (the canonical "is this ours" check is the user.ivm_init_at_dir tag).
    rel: str = str(cwd)
    home: str = str(Path.home())
    if rel.startswith(home):
        rel = rel[len(home):]
    return sanitize_incus_name(f"ivm-{template_name}-{rel}")


def mount_device_name(mount_index: int) -> str:
    return f"ivm_mount_{mount_index}"


def shadow_device_name(mount_index: int, shadow_index: int) -> str:
    return f"{mount_device_name(mount_index)}_shadow_{shadow_index}"


def standalone_shadow_device_name(shadow_index: int) -> str:
    """A shadow mask added on its own via `ivm mount shadow <guest_path>`, NOT tied
    to a parent `ivm_mount_<N>` (which uses `shadow_device_name`). Still carries the
    `_shadow_` marker so `detach`/`ls` classify it as a mask, not a base mount."""
    return f"ivm_shadow_{shadow_index}"


def mount_device_names(doc: Template) -> list[str]:
    """Every incus disk-device name `init` will create for this template's
    mounts, in `mount_commands` order: one `ivm_mount_{i}` per mount plus one
    `ivm_mount_{i}_shadow_{j}` per shadow subpath. Single source of truth shared
    with `mount_commands`, so the socket-length check sees the exact names."""
    names: list[str] = []
    for mount_index, mount in enumerate(doc.get("mounts", [])):
        names.append(mount_device_name(mount_index))
        for shadow_index, _subpath in enumerate(mount.get("shadow", [])):
            names.append(shadow_device_name(mount_index, shadow_index))
    return names


def current_incus_project_prefix() -> str:
    """The `<project>_` incus prepends to a VM's on-disk device dir under
    `/var/lib/incus/devices/`. Empty for the `default` project; `user-1000_` etc.
    for the per-user restricted project the unprivileged `incus` group assigns.
    `incus project get-current` is empty until you switch at least once
    (lxc/incus#1474), and unprivileged users are auto-assigned their project
    WITHOUT switching - so on empty, probe `user-<uid>` and use it only if that
    project is actually visible (over-counting is the safe direction here)."""
    incus_project: str = subprocess.run(
        ["incus", "project", "get-current"], capture_output=True, text=True
    ).stdout.strip()
    if not incus_project:
        uid_project: str = f"user-{os.getuid()}"
        incus_project = uid_project if project_is_visible(uid_project) else "default"
    return "" if incus_project == "default" else f"{incus_project}_"


def project_is_visible(incus_project: str) -> bool:
    return subprocess.run(
        ["incus", "project", "show", incus_project], capture_output=True, text=True
    ).returncode == 0


def virtiofs_socket_path(incus_project_prefix: str, instance_name: str, device_name: str) -> str:
    """Mirror incus's per-device virtiofs socket layout so its length can be
    checked against `SUN_PATH_MAX` before the VM is created."""
    return f"{INCUS_DEVICES_DIR}/{incus_project_prefix}{instance_name}/virtio-fs.{device_name}.sock"


def socket_path_error(instance_name: str, doc: Template, incus_project_prefix: str) -> str | None:
    """Error if any mount's virtiofs socket path would overflow AF_UNIX sun_path,
    else None. Reports the overflow so the user knows how many chars to drop."""
    longest_socket_path: str = ""
    for device_name in mount_device_names(doc):
        socket_path: str = virtiofs_socket_path(incus_project_prefix, instance_name, device_name)
        if len(socket_path) > len(longest_socket_path):
            longest_socket_path = socket_path
    overflow_chars: int = len(longest_socket_path) - (SUN_PATH_MAX - 1)
    if overflow_chars > 0:
        return (
            f"'{instance_name}' is a valid incus name but too long for the virtiofs "
            f"socket path it produces ({len(longest_socket_path)} chars > {SUN_PATH_MAX - 1} "
            f"AF_UNIX limit); shorten the name by >={overflow_chars} char(s). "
            f"Longest path: {longest_socket_path}"
        )
    return None


def name_error(name: str, doc: Template, *, dry_run: bool) -> str | None:
    """Return an error message if `name` is unusable, else None."""
    if not INCUS_NAME_RE.match(name):
        return f"'{name}' is not a valid incus name ([a-zA-Z0-9-], starts alnum, <=63)"
    # The remaining checks query incus (current project, instance existence);
    # `--dry-run` stays hermetic and skips them, same as before.
    if dry_run:
        return None
    if (socket_err := socket_path_error(name, doc, current_incus_project_prefix())) is not None:
        return socket_err
    if instance_exists(name):
        return f"a VM named '{name}' already exists"
    return None


def instance_exists(name: str) -> bool:
    return subprocess.run(
        ["incus", "info", name], capture_output=True, text=True
    ).returncode == 0


def prompt_with_prefill(prompt: str, prefill: str) -> str:
    """Like input(), but pre-fills the editable line with `prefill` so the user
    can edit it in place (readline) instead of retyping. Falls back to a
    `[default]` suffix if readline is unavailable."""
    try:
        import readline
    except ImportError:
        return input(f"{prompt}[{prefill}] ") or prefill
    readline.set_startup_hook(lambda: readline.insert_text(prefill))
    try:
        return input(prompt)
    finally:
        readline.set_startup_hook()


def choose_instance_name(
    template_name: str, cwd: Path, given: str | None, doc: Template,
    *, dry_run: bool, assume_yes: bool
) -> str:
    """Pick the VM name: explicit arg, or prompt (default = long path-based),
    re-prompting on invalid/duplicate/socket-path-too-long. `--yes`/`--dry-run`
    take the default. `doc` is needed to size each mount's virtiofs socket."""
    default: str = default_instance_name(template_name, cwd)
    if given is not None:
        err: str | None = name_error(given, doc, dry_run=dry_run)
        if err:
            die(err)
        return given
    if assume_yes or dry_run or not sys.stdin.isatty():
        if (err := name_error(default, doc, dry_run=dry_run)) and not dry_run:
            die(f"default name unusable ({err}); pass an explicit name")
        return default
    # Pre-fill the editable line with the default so the user can tweak a few
    # chars instead of retyping; a re-prompt pre-fills the last rejected value.
    current: str = default
    while True:
        reply: str = prompt_with_prefill(
            "incus VM name (the instance name, visible to all of incus e.g. `incus list`): ",
            current,
        ).strip() or default
        err = name_error(reply, doc, dry_run=dry_run)
        if err is None:
            return reply
        print(f"  {err}", file=sys.stderr)
        current = reply


# ---------- incus command builders ----------

def g_to_gib(value: str) -> str:
    """`8G` -> `8GiB` (the template uses G; incus wants GiB)."""
    return value[:-1] + "GiB" if value.endswith("G") else value


def image_ref(os_block: dict[str, Any]) -> str:
    image: dict[str, Any] = os_block.get("image", {})
    source: str = image.get("source", "")
    uri: str = image.get("uri", "")
    if source == "incus":
        return f"images:{uri}"
    die(f"image source '{source}' not supported yet (phase: iso/virt-builder/windows)")


def warn_if_host_nesting_disabled(doc: Template) -> None:
    """`hw.nested_virt`: incus VMs expose the host CPU (vmx/svm), so nested KVM
    needs NO per-VM incus config - only the HOST kernel's nesting enabled. We
    can't change a host modprobe setting, so just warn if it looks off."""
    if not doc.get("hw", {}).get("nested_virt"):
        return
    for kvm_module in ("kvm_intel", "kvm_amd"):
        nesting_param: Path = Path(f"/sys/module/{kvm_module}/parameters/nested")
        if nesting_param.is_file() and nesting_param.read_text().strip() in ("Y", "1"):
            return
    print("ivm: warning: hw.nested_virt requested but the host kernel's KVM "
          "nesting looks disabled; enable it on the HOST (e.g. "
          "`options kvm_intel nested=1` in /etc/modprobe.d). incus itself needs "
          "no per-VM setting.", file=sys.stderr)


def create_command(doc: Template, name: str, cwd: Path) -> list[str]:
    """`incus create` (stopped). We create-then-start (not `incus launch`) so
    non-hotpluggable devices - tpm, and to be safe the nic - can be attached
    before first boot (the TPM device has no VM hotplug; see extra_device_commands)."""
    hw: dict[str, Any] = doc.get("hw", {})
    cmd: list[str] = ["incus", "create", image_ref(doc["os"]), name, "--vm"]
    if "cpu" in hw:
        cmd += ["--config", f"limits.cpu={hw['cpu']}"]
    if "memory" in hw:
        cmd += ["--config", f"limits.memory={g_to_gib(hw['memory'])}"]
    if hw.get("secureboot") is False:  # incus VM default is on, so only emit to disable
        cmd += ["--config", "security.secureboot=false"]
    cmd += [
        "--config", "user.ansible_managed=true",
        "--config", "user.ivm_guest_os=linux",
        "--config", f"user.ivm_template={doc['template_name']}",
        "--config", f"user.ivm_init_at_dir={cwd}",
        # Record the dotfiles ansible_os_family so `overwrite-dotfiles` can pick the
        # right per-family dotfiles bucket (dotfiles/<feature>/<family>/) without re-reading the template.
        "--config", f"user.ivm_ansible_os_family={ansible_os_family_of(doc)}",
    ]
    # Optional: the template's preferred initial cwd for `ivm shell`, stored as a
    # user.* tag and read at runtime (passed as `incus exec --cwd`). It ONLY sets
    # where the shell starts - `$HOME` and a bare `cd` are unaffected. Omitted when
    # unset -> incus's default cwd.
    template_shell_login_dir: str = doc.get("shell_default_dir_after_login", "")
    if template_shell_login_dir:
        cmd += ["--config", f"user.ivm_shell_default_dir_after_login={template_shell_login_dir}"]
    if "disk" in hw:
        cmd += ["--device", f"root,size={g_to_gib(hw['disk'])}"]
    return cmd


def extra_device_commands(doc: Template, name: str) -> list[list[str]]:
    """Non-mount devices added (to the stopped VM) before first start: a virtual
    TPM, and a macvlan/bridged NIC overriding the default NAT eth0."""
    cmds: list[list[str]] = []
    if doc.get("hw", {}).get("tpm"):
        cmds.append(["incus", "config", "device", "add", name, "vtpm", "tpm"])
    net: dict[str, Any] = doc.get("net", {})
    net_mode: str = net.get("mode", "nat")
    if net_mode in ("macvlan", "bridge"):
        parent: str = net.get("parent", "")
        if not parent:
            host_thing: str = "NIC" if net_mode == "macvlan" else "bridge"
            die(f"net.mode={net_mode} requires net.parent (the host {host_thing})")
        nictype: str = "macvlan" if net_mode == "macvlan" else "bridged"
        cmds.append(["incus", "config", "device", "add", name, "eth0", "nic",
                     f"nictype={nictype}", f"parent={parent}"])
    return cmds


def shadow_mask_dir(root: Path) -> Path:
    """A single empty, read-only host dir mounted over each `shadow` subpath to
    mask it. Shared across all VMs (it is always empty); lives under the install
    root. Its absolute path is baked into each VM's shadow device at create time, so
    if the dir is later deleted or moved (e.g. the install root was renamed), a VM
    referencing it fails `incus start` validation. `ensure_shadow_mask_sources`
    recreates whatever each VM references before start (see ensure_up), so a vanished
    mask never bricks a VM."""
    return root / "shadow-mask"


def ensure_shadow_mask(root: Path, *, dry_run: bool) -> None:
    """Create the empty mask dir (idempotent) before mounting it over subpaths."""
    mask: Path = shadow_mask_dir(root)
    if dry_run:
        print(f"+ (mkdir -p {mask})", file=sys.stderr)
        return
    mask.mkdir(parents=True, exist_ok=True)


def ensure_shadow_mask_sources(name: str) -> None:
    """Self-heal before `incus start`: recreate any missing `_shadow_` mask source
    dirs of THIS VM. The mask source is an always-empty read-only dir whose ABSOLUTE
    host path is baked into the device config at create time; if it is later deleted
    or moved (e.g. the install root was renamed, or the user removed it), `incus
    start` fails with `Missing source path ...`. The mask is always empty, so
    recreating exactly what the VM references is safe and idempotent - and it heals
    masks baked under an OLD path too, not just the current one. Only `_shadow_`
    devices are touched; a real mount's missing source (e.g. a removed cwd) is left
    alone so it surfaces instead of being papered over with an empty dir."""
    for device_name, device in _vm_disk_devices(name).items():
        if "_shadow_" not in device_name:
            continue
        source: str = device.get("source", "")
        if source and not Path(source).is_dir():
            print(f"+ mkdir -p {shlex.quote(source)}  "
                  f"# restore missing shadow mask for {device_name}", file=sys.stderr)
            Path(source).mkdir(parents=True, exist_ok=True)


def mount_commands(doc: Template, name: str, cwd: Path, root: Path) -> list[list[str]]:
    cmds: list[list[str]] = []
    mask: Path = shadow_mask_dir(root)
    for mount_index, mount in enumerate(doc.get("mounts", [])):
        host: str = sh_expand(mount["host"], cwd)
        guest: str = sh_expand(mount["guest"], cwd)
        device: str = mount_device_name(mount_index)
        # NOTE: no `shift=true` here. `shift` is a container-only disk property
        # (idmap overlay); for VMs it is a no-op, and a restricted per-user
        # project (unprivileged `incus` group) rejects it with "The shift
        # property cannot be used with a restricted source path". ivm only ever
        # creates VMs (`incus create ... --vm`), so it must never be set.
        args: list[str] = [
            "incus", "config", "device", "add", name, device, "disk",
            f"source={host}", f"path={guest}",
        ]
        if mount.get("ro"):
            args.append("readonly=true")
        cmds.append(args)
        # `shadow`: overlay the empty mask dir (read-only) on each subpath so the
        # guest cannot see the host's real `.git` / `.vscode` / `.env` etc.
        for shadow_index, subpath in enumerate(mount.get("shadow", [])):
            masked_guest_path: str = f"{guest.rstrip('/')}/{subpath}"
            cmds.append([
                "incus", "config", "device", "add", name,
                shadow_device_name(mount_index, shadow_index), "disk",
                f"source={mask}", f"path={masked_guest_path}", "readonly=true",
            ])
    return cmds


# zypper is the most failure-prone of the three (mirror/metadata hiccups), so run
# it at max verbosity (-vvv) by default - any failure is diagnosable from the init
# log without a manual re-run.
ZYPPER: str = "zypper -vvv --non-interactive"


def install_packages_script(ansible_os_family: str, packages: list[str]) -> str:
    """Per-family install with weak-deps/recommends OFF (the apt-min/zypper-min/
    dnf-min policy, applied to provisioning)."""
    pkgs: str = " ".join(packages)
    if ansible_os_family == "Debian":
        return ("export DEBIAN_FRONTEND=noninteractive\n"
                "apt-get update -qq\n"
                f"apt-get install --yes --no-install-recommends {pkgs}\n")
    if ansible_os_family == "Suse":
        return (f"{ZYPPER} refresh\n"
                f"{ZYPPER} install --no-recommends {pkgs}\n")
    if ansible_os_family == "RedHat":
        return f"dnf install --assumeyes --setopt=install_weak_deps=False {pkgs}\n"
    die(f"no package-manager mapping for ansible_os_family '{ansible_os_family}'")


def update_packages_script(ansible_os_family: str) -> str:
    """Per-family 'refresh metadata + upgrade all installed packages'."""
    if ansible_os_family == "Debian":
        return ("export DEBIAN_FRONTEND=noninteractive\n"
                "apt-get update -qq\n"
                "apt-get upgrade --yes\n")
    if ansible_os_family == "Suse":
        return (f"{ZYPPER} refresh\n"
                f"{ZYPPER} update\n")
    if ansible_os_family == "RedHat":
        return "dnf upgrade --assumeyes\n"
    die(f"no package-manager mapping for ansible_os_family '{ansible_os_family}'")


def host_timezone() -> str:
    """The host's IANA timezone (e.g. `Asia/Taipei`), for `sys.timezone: host`."""
    return capture(["timedatectl", "show", "--property=Timezone", "--value"]).strip()


def timezone_provision(doc: Template) -> str:
    """`sys.timezone`: `host` (default) copies the host's tz; else the literal."""
    requested_timezone: str = doc.get("sys", {}).get("timezone", "host")
    effective_timezone: str = host_timezone() if requested_timezone == "host" else requested_timezone
    if not effective_timezone:
        return ""
    return f"timedatectl set-timezone {shlex.quote(effective_timezone)}\n"


def tmpfs_provision(doc: Template) -> str:
    """`sys.tmpfs`: back each path with tmpfs now + persist it in /etc/fstab.
    DISCOURAGED in a VM (see the schema's sys.tmpfs note): incus VMs have no balloon
    free-page-reporting, so the RAM is held by the host QEMU process until the VM
    STOPS, and it only shrinks to swap if the guest has swap. The shipped templates
    no longer set it; prefer leaving /tmp on the VM disk."""
    tmpfs_paths: list[str] = doc.get("sys", {}).get("tmpfs", [])
    if not tmpfs_paths:
        return ""
    joined_paths: str = " ".join(tmpfs_paths)
    script: str = (f"echo 'ivm: NOTE sys.tmpfs ({joined_paths}) uses RAM the host does NOT "
                   f"reclaim until this VM stops; prefer disk-backed /tmp.' >&2\n")
    for guest_tmpfs_path in tmpfs_paths:
        quoted: str = shlex.quote(guest_tmpfs_path)
        fstab_line: str = f"tmpfs {guest_tmpfs_path} tmpfs defaults,nosuid,nodev 0 0"
        script += (
            f"mkdir -p {quoted}\n"
            f"mountpoint --quiet {quoted} || mount --types tmpfs tmpfs {quoted}\n"
            f"grep -qsF {shlex.quote(fstab_line)} /etc/fstab || echo {shlex.quote(fstab_line)} >> /etc/fstab\n"
        )
    return script


# The fcitx5 user-config setup script: the SAME idempotent script you run on the
# host (enables keyboard-us + mozc + chewing, sets the chewing prefs). Shipped in
# the install root by tasks/ivm_install.yml; embedded into provisioning so there's
# one source of truth across host and guest.
FCITX5_SETUP_SCRIPT: str = "setup-fcitx5-input.sh"


def input_method_provision(doc: Template, root: Path) -> str:
    """`sys.input_method: fcitx5` -> the IM env vars in /etc/environment (pam_env,
    so any display-manager-started session picks them up; applies on BOTH X11 and
    Wayland), then run the shared `setup-fcitx5-input.sh` as `user` to seed the
    fcitx5 config (enabled IMs + chewing prefs). The fcitx5 packages come via
    `distro_package_groups: [cjk_input]`; autostart is the template's job (per-WM)."""
    if doc.get("sys", {}).get("input_method") != "fcitx5":
        return ""
    script: str = ""
    for env_line in ("GTK_IM_MODULE=fcitx", "QT_IM_MODULE=fcitx", "XMODIFIERS=@im=fcitx"):
        key: str = env_line.split("=", 1)[0]
        script += (f"grep -q '^{key}=' /etc/environment 2>/dev/null "
                   f"|| echo {shlex.quote(env_line)} >> /etc/environment\n")
    setup_path: Path = root / FCITX5_SETUP_SCRIPT
    if not setup_path.is_file():
        die(f"{FCITX5_SETUP_SCRIPT} not found in {root}; re-run `make vm-incus-install`")
    setup_body: str = setup_path.read_text()
    if not setup_body.endswith("\n"):
        setup_body += "\n"
    # Drop the script in /tmp (root), then run it as `user` so it writes the
    # config under /home/user; clean up after.
    script += (
        f"cat > /tmp/{FCITX5_SETUP_SCRIPT} <<'IVM_FCITX5_SETUP'\n"
        + setup_body +
        "IVM_FCITX5_SETUP\n"
        f"su - user -c 'sh /tmp/{FCITX5_SETUP_SCRIPT}'\n"
        f"rm -f /tmp/{FCITX5_SETUP_SCRIPT}\n"
    )
    return script


def read_authorized_keys(key_file_paths: list[str], cwd: Path) -> list[str]:
    """Read each host public-key file (paths shell-expanded like mounts) and
    return the non-empty key lines."""
    keys: list[str] = []
    for raw_path in key_file_paths:
        key_file: Path = Path(sh_expand(raw_path, cwd))
        if not key_file.is_file():
            die(f"sys.ssh_server.authorized_keys: file not found: {key_file}")
        keys += [line for line in key_file.read_text().splitlines() if line.strip()]
    return keys


def _authorized_keys_install(home: str, owner: str, keys: list[str]) -> str:
    return (
        f"install --directory --mode=700 --owner={owner} --group={owner} {home}/.ssh\n"
        f"cat > {home}/.ssh/authorized_keys <<'IVM_EOF'\n" + "".join(k + "\n" for k in keys) + "IVM_EOF\n"
        f"chmod 600 {home}/.ssh/authorized_keys\n"
        f"chown {owner}:{owner} {home}/.ssh/authorized_keys\n"
    )


# Default host public key authorized by `ivm set-ssh-server` when `--pubkey` is
# omitted. Matches the `sys.ssh_server.authorized_keys` default in the templates.
DEFAULT_SSH_PUBKEY: str = "~/.ssh/id_ed25519.pub"


def _guest_home_for(username: str) -> str:
    """Guest home directory for a login account: `/root` for root, `/home/<user>`
    otherwise. ivm's standard accounts are `user` (-> /home/user) and `root`."""
    return "/root" if username == "root" else f"/home/{username}"


def _authorized_keys_append(home: str, owner: str, keys: list[str]) -> str:
    """Append each of `keys` to `<home>/.ssh/authorized_keys`, but only if not already
    present (idempotent). Unlike `_authorized_keys_install`, this never clobbers keys
    the user added by hand. Creates `.ssh` with the right owner/mode if absent. The
    per-key `if` keeps it safe under `bash -e` (an absent key is the normal path)."""
    block: str = "".join(k + "\n" for k in keys)
    ak: str = f"{home}/.ssh/authorized_keys"
    return (
        f"install --directory --mode=700 --owner={owner} --group={owner} {home}/.ssh\n"
        f"touch {ak}\n"
        f"chmod 600 {ak}\n"
        f"chown {owner}:{owner} {ak}\n"
        f"while IFS= read -r _ivm_key; do\n"
        f'  if [ -n "$_ivm_key" ] && ! grep -qxF "$_ivm_key" {ak}; then\n'
        f"    printf '%s\\n' \"$_ivm_key\" >> {ak}\n"
        f"  fi\n"
        f"done <<'IVM_EOF'\n{block}IVM_EOF\n"
    )


def _authorized_keys_remove(home: str, owner: str, keys: list[str]) -> str:
    """Remove exactly `keys` from `<home>/.ssh/authorized_keys` if present (the reverse
    of `_authorized_keys_append`); any other keys are left untouched. No-op if the file
    is absent. `|| true` guards the `grep -v` exit-1 when every line was removed."""
    block: str = "".join(k + "\n" for k in keys)
    ak: str = f"{home}/.ssh/authorized_keys"
    return (
        f"if [ -f {ak} ]; then\n"
        f"  grep -vxF -f - {ak} > {ak}.ivm_tmp <<'IVM_EOF' || true\n{block}IVM_EOF\n"
        f"  mv {ak}.ivm_tmp {ak}\n"
        f"  chmod 600 {ak}\n"
        f"  chown {owner}:{owner} {ak}\n"
        f"fi\n"
    )


def ssh_provision(doc: Template, cwd: Path) -> str:
    """`sys.ssh_server`: in-guest sshd drop-in + authorized_keys. sshd itself is
    in the baseline (openssh-server / openssh)."""
    ssh: dict[str, Any] = doc.get("sys", {}).get("ssh_server", {})
    if not ssh.get("enabled"):
        return ""
    permit_root_login: str = "yes" if ssh.get("root_login") else "no"
    password_authentication: str = "yes" if ssh.get("password_login") else "no"
    keys: list[str] = read_authorized_keys(ssh.get("authorized_keys", []), cwd)
    # Drop-in (modern sshd on Debian/openSUSE/Fedora reads sshd_config.d/*.conf).
    script: str = (
        "mkdir -p /etc/ssh/sshd_config.d\n"
        "cat > /etc/ssh/sshd_config.d/ivm.conf <<'IVM_EOF'\n"
        f"Port {ssh.get('port', 22)}\n"
        f"PermitRootLogin {permit_root_login}\n"
        f"PasswordAuthentication {password_authentication}\n"
        "IVM_EOF\n"
    )
    script += _authorized_keys_install("/home/user", "user", keys)
    if ssh.get("root_login"):
        script += _authorized_keys_install("/root", "root", keys)
    # service is `ssh` on Debian, `sshd` on openSUSE/Fedora.
    script += "systemctl enable --now sshd 2>/dev/null || systemctl enable --now ssh\n"
    return script


def resolve_thirdparty_software(
    names: list[str], registry: dict[str, Any], ansible_os_family: str
) -> list[dict[str, Any]]:
    """Resolve `thirdparty_software` recipe names against the registry into
    `{name, already_installed?, install_script}` recipes for THIS VM's family.
    OVERRIDE (not additive like distro groups): the family's entry if defined, else
    `__common__`. Shared by `init` (the template's list) and `provision` (CLI args)."""
    recipes: list[dict[str, Any]] = []
    for name in names:
        entry: Any = registry.get(name)
        if entry is None:
            die(f"unknown thirdparty_software '{name}' (not in thirdparty-software.json; "
                f"defined: {', '.join(sorted(registry))})")
        family_recipe: Any = entry.get(ansible_os_family) or entry.get("__common__")
        if family_recipe is None:
            die(f"thirdparty_software '{name}' has no recipe for {ansible_os_family} "
                f"(needs a '{ansible_os_family}' or '__common__' entry)")
        install_script: str = family_recipe.get("install_script", "")
        if not install_script:
            die(f"thirdparty_software '{name}' ({ansible_os_family}) has no install_script")
        recipes.append({
            "name": name,
            "already_installed": family_recipe.get("already_installed"),
            "install_script": install_script,
        })
    return recipes


def thirdparty_install_script(recipes: list[dict[str, Any]]) -> str:
    """Shell (run as root in the guest) that installs each resolved recipe, guarded
    by its `already_installed` probe when present (rc 0 -> skip), so a re-run is
    idempotent. Each recipe's `install_script` is the author's verbatim shell."""
    script: str = ""
    for recipe in recipes:
        name: str = recipe["name"]
        install: str = recipe["install_script"]
        if not install.endswith("\n"):
            install += "\n"
        probe: str | None = recipe.get("already_installed")
        script += f"echo '==> thirdparty_software: {name}' >&2\n"
        if probe:
            script += (
                f"if {{ {probe}; }} >/dev/null 2>&1; then\n"
                f"  echo '    already present, skipping' >&2\n"
                "else\n"
                f"{install}"
                "fi\n"
            )
        else:
            script += install
    return script


# Marker every launcher (ivm/qvm/pvm) drops into its guest so the shared shell dotfiles
# can badge the prompt. Its CONTENTS are this launcher's id; the shared PS1 snippet
# (`roles/_shared_j2_snippets/templates/{zsh,bash}_ps1_*.j2`) reads it and prefixes the
# prompt with one box glyph per isolation level (full VM = 3, container = 1). The host
# runs the SAME dotfiles but has no marker, so its prompt is unchanged.
MANAGED_GUEST_TYPE_MARKER_PATH: str = "/etc/ansible-managed-guest-type"
GUEST_TYPE: str = "ivm"


def guest_type_marker_script() -> str:
    """Shell (run as root in the guest) writing this launcher's id (the `GUEST_TYPE`
    constant) to `MANAGED_GUEST_TYPE_MARKER_PATH`, the marker the shared PS1 snippet keys
    its box-glyph prompt prefix off. Idempotent (truncating write)."""
    return (
        f"echo '==> managed-guest marker: {MANAGED_GUEST_TYPE_MARKER_PATH} ({GUEST_TYPE})' >&2\n"
        f"printf '%s\\n' {GUEST_TYPE} > {MANAGED_GUEST_TYPE_MARKER_PATH}\n"
    )


def provision_script(doc: Template, registry: dict[str, Any], cwd: Path, root: Path,
                     shared_prebuilt_provision_assets_root: Path) -> str:
    """First-provision shell, run as root via `incus exec`: install packages
    (baseline + groups + flat), set timezone + tmpfs, create `user`, set both
    shells to zsh, configure sshd, then run the template's `post_install_script`
    (also as root - it drops to `user` with `su - user -c '...'` for user bits)."""
    ansible_os_family: str = ansible_os_family_of(doc)
    is_gui: bool = bool(doc.get("sys", {}).get("gui"))
    packages: list[str] = resolve_packages(doc, registry, ansible_os_family)
    if is_gui:
        # GUI VMs: the incus-SPICE glue. `spice-vdagent` = clipboard + dynamic
        # resolution with `ivm gui`'s SPICE console. `xdg-user-dirs` = the GTK file
        # picker + apps' XDG lookups (`g_get_user_special_dir`) resolve ~/Downloads
        # etc. Both same package name on Debian/openSUSE/Fedora; headless VMs skip.
        packages = list(dict.fromkeys(packages + ["spice-vdagent", "xdg-user-dirs"]))
    script: str = install_packages_script(ansible_os_family, packages)
    script += timezone_provision(doc)
    script += tmpfs_provision(doc)
    # `command -v zsh` not a hardcoded /bin/zsh: zsh lands in /usr/bin on
    # openSUSE/Fedora (usrmerge makes /bin/zsh work too, but don't rely on it).
    script += (
        'id user >/dev/null 2>&1 || useradd --create-home --shell "$(command -v zsh)" --uid 1000 user\n'
        'usermod --shell "$(command -v zsh)" user\n'
        'usermod --shell "$(command -v zsh)" root\n'
        # A mount targeting /home/user/* (e.g. an XDG dir) is attached before the
        # VM starts, so it pre-creates /home/user root-owned and useradd then
        # skips chowning it. Fix the home dir's ownership (NON-recursive: leave
        # the idmapped mount contents alone).
        'chown user:user /home/user\n'
    )
    # Drop the managed-guest marker right after the core guest identity exists (user +
    # zsh shells set up); the shared PS1 snippet keys its box-glyph prompt prefix off it.
    script += guest_type_marker_script()
    if is_gui:
        # Seed ~/.config/user-dirs.dirs + ~/{Downloads,Desktop,...} now, as `user`
        # (a minimal icewm/lightdm session may not run this at login). It never
        # clobbers an existing dir, so a mounted ~/Downloads is kept as-is.
        script += "su - user -c 'xdg-user-dirs-update'\n"
    script += input_method_provision(doc, root)
    script += ssh_provision(doc, cwd)
    # A bundle's optional `post_install` (e.g. desktop_icewm wiring lightdm autologin):
    # run after its packages + after `user` exists (snippets may `su - user -c`), before
    # the author's `post_install_script` so that can build on it.
    script += groups_post_install_script(doc.get("distro_package_groups", []), registry, ansible_os_family)
    # Non-distro installs (3rd-party repos / curl|bash / npm-pip) declared in the
    # template's `thirdparty_software`, run as root before the author's custom
    # `post_install_script` so that can rely on them. Registry loaded only when used.
    thirdparty_names: list[str] = doc.get("thirdparty_software", [])
    if thirdparty_names:
        script += thirdparty_install_script(
            resolve_thirdparty_software(thirdparty_names, load_thirdparty_software(shared_prebuilt_provision_assets_root), ansible_os_family)
        )
    post_install_script: str = doc.get("post_install_script", "")
    if post_install_script:
        script += post_install_script if post_install_script.endswith("\n") else post_install_script + "\n"
    return script


# Baseline dotfile features pushed at `init` (and re-pushed by `overwrite-dotfiles`):
# the shell configs EVERY ivm guest gets. Other features (e.g. emacs) are pushed on
# demand by `provision <feature>`. Each is a top dir under the shared dotfiles/ tree
# (roles/_shared_prebuilt_provision_assets).
BASELINE_DOTFILE_FEATURES: tuple[str, ...] = ("bash", "tmux", "zsh")


def push_feature_dotfiles_commands(feature: str, ansible_os_family: str, name: str,
                                   shared_prebuilt_provision_assets_root: Path) -> list[list[str]]:
    """Push one feature's staged dotfiles into the guest: the `__common__` bucket then
    the VM's `<ansible_os_family>` bucket (distro overlays common), each with its
    `home/user` (uid 1000) + `root` (uid 0) side. Buckets/sides a feature does not
    populate are skipped - emacs has only `__common__/home/user`; `.zshrc` is per-family
    with no `__common__`. Source: `<shared_prebuilt_provision_assets_root>/dotfiles/<feature>/<bucket>/<who>/`.
    A `home/user` dir is pushed INTO `{name}/home/` (so it lands as /home/user/...);
    a `root` dir INTO `{name}/` (lands as /root/...)."""
    feature_dir: Path = shared_prebuilt_provision_assets_root / "dotfiles" / feature
    cmds: list[list[str]] = []
    for bucket in ("__common__", ansible_os_family):
        user_side: Path = feature_dir / bucket / "home" / "user"
        root_side: Path = feature_dir / bucket / "root"
        if user_side.is_dir():
            cmds.append(["incus", "file", "push", "--recursive", "--create-dirs",
                         "--uid", "1000", "--gid", "1000", str(user_side), f"{name}/home/"])
        if root_side.is_dir():
            cmds.append(["incus", "file", "push", "--recursive", "--create-dirs",
                         "--uid", "0", "--gid", "0", str(root_side), f"{name}/"])
    return cmds


def push_baseline_dotfiles_commands(ansible_os_family: str, name: str,
                                    shared_prebuilt_provision_assets_root: Path) -> list[list[str]]:
    """All baseline shell dotfiles (bash/tmux/zsh) for `init` / `overwrite-dotfiles`,
    keyed by this VM's ansible_os_family (init: from the template; overwrite-dotfiles:
    from the `user.ivm_ansible_os_family` tag)."""
    cmds: list[list[str]] = []
    for feature in BASELINE_DOTFILE_FEATURES:
        cmds += push_feature_dotfiles_commands(feature, ansible_os_family, name, shared_prebuilt_provision_assets_root)
    return cmds


def wait_until(name: str, probe: str, timeout: int) -> bool:
    """Poll `bash -c <probe>` inside the guest until it exits 0 or `timeout`s
    elapse. Returns True on success, False on timeout."""
    deadline: float = time.monotonic() + timeout
    while time.monotonic() < deadline:
        if subprocess.run(["incus", "exec", name, "--", "bash", "-c", probe],
                          capture_output=True).returncode == 0:
            return True
        time.sleep(1)
    return False


def wait_ready(name: str, *, dry_run: bool) -> None:
    """Block until the guest is ready to PROVISION: (1) the incus agent answers
    `exec`, then (2) the network is actually online. Without step 2 the very
    first `zypper/apt refresh` races a not-yet-configured network and dies with a
    connection error (curl 7) - the guest gets its DHCP lease a beat after the
    agent comes up."""
    if dry_run:
        print(f"+ (wait until `incus exec {name}` works, then until the guest network is online)",
              file=sys.stderr)
        return
    if not wait_until(name, "true", 90):
        die(f"VM '{name}' agent did not answer `incus exec` within 90s")
    # Network online = a default route exists AND DNS resolves. `example.com` is
    # an IANA-reserved name (no vendor dependency), used purely as a liveness probe.
    if not wait_until(name, "ip route show default | grep -q . && getent hosts example.com >/dev/null", 60):
        die(f"VM '{name}' has no network connectivity after 60s (no default route or DNS); "
            f"check the host's incus bridge (`incus network show incusbr0`: NAT + DNS).")


class VmBinding(NamedTuple):
    """One ivm VM as the cwd resolver sees it: its name plus the fields needed to
    tell several apart when they share an init dir (status + source template)."""
    name: str
    status: str
    template: str
    init_at_dir: str


def list_vm_bindings() -> list[VmBinding]:
    """Every VM carrying a `user.ivm_init_at_dir` tag, with the columns the
    resolver needs. A LIST (not a dict keyed by init dir) so multiple VMs sharing
    one cwd are all kept, not silently collapsed to the last one incus lists."""
    out: str = capture(["incus", "list", "--format", "csv", "--columns",
                        "n,s,config:user.ivm_template,config:user.ivm_init_at_dir"])
    # csv.reader (not str.partition): an init-dir path can contain a comma, which
    # incus CSV-quotes - splitting on commas by hand would mis-parse it.
    bindings: list[VmBinding] = []
    for row in csv.reader(out.splitlines()):
        if len(row) >= 4 and row[3]:
            bindings.append(VmBinding(name=row[0], status=row[1], template=row[2], init_at_dir=row[3]))
    return bindings


def describe_candidate(binding: VmBinding) -> str:
    """A candidate line for the picker / ambiguity error: the colored name plus
    the template and status that tell otherwise-cryptic names apart."""
    return (f"{colorize_vm_name(binding.name)} "
            f"[template={binding.template or '?'}, {binding.status or '?'}]")


def choose_vm_from_candidates(candidates: list[VmBinding], *, intro: str) -> str:
    """TTY numbered picker over >1 candidate VMs (caller guarantees a TTY; the
    non-TTY path dies with the list instead, so scripted use stays predictable)."""
    print(intro, file=sys.stderr)
    for index, binding in enumerate(candidates, start=1):
        print(f"  {index}) {describe_candidate(binding)}", file=sys.stderr)
    while True:
        reply: str = input(f"Pick a VM [1-{len(candidates)}]: ").strip()
        if reply.isdigit() and 1 <= int(reply) <= len(candidates):
            return candidates[int(reply) - 1].name
        print(f"  enter a number 1-{len(candidates)}", file=sys.stderr)


def die_ambiguous(candidates: list[VmBinding], bound_dir: Path) -> NoReturn:
    """No TTY to pick interactively: list the candidates and require `--name`."""
    listing: str = "\n".join(f"  - {describe_candidate(candidate)}" for candidate in candidates)
    die(f"{len(candidates)} VMs are bound to {bound_dir}; pass `--name <vm>` to pick one "
        f"(no TTY to choose interactively):\n{listing}")


def resolve_vm_by_cwd(cwd: Path, *, dry_run: bool) -> str:
    """Resolve the VM bound to `cwd` via `user.ivm_init_at_dir`. Exactly one match
    -> use it. Several at the same cwd (made via explicit `ivm init <tpl> <name>`
    or different templates) -> TTY: numbered picker; non-TTY: die listing them +
    require `--name` (keeps scripted use predictable). No match at cwd -> walk
    ancestors and offer the nearest dir that has any (REDESIGN 8.9), with the same
    >1 handling there."""
    if dry_run:
        return "<vm-resolved-from-cwd>"
    bindings: list[VmBinding] = list_vm_bindings()
    here: list[VmBinding] = [b for b in bindings if b.init_at_dir == str(cwd)]
    if len(here) == 1:
        return here[0].name
    if len(here) > 1:
        if not sys.stdin.isatty():
            die_ambiguous(here, cwd)
        return choose_vm_from_candidates(here, intro=f"Multiple VMs are bound to {cwd}:")
    # No exact match: `cwd.parents` is ordered nearest-ancestor first - offer the
    # nearest ancestor dir that has any binding(s).
    for ancestor in cwd.parents:
        at_ancestor: list[VmBinding] = [b for b in bindings if b.init_at_dir == str(ancestor)]
        if not at_ancestor:
            continue
        if not sys.stdin.isatty():
            if len(at_ancestor) == 1:
                die(f"no VM bound to {cwd}; nearest is '{at_ancestor[0].name}' at {ancestor} "
                    f"- cd there, or run from a TTY to confirm")
            die_ambiguous(at_ancestor, ancestor)
        if len(at_ancestor) == 1:
            reply: str = input(f"No VM bound to {cwd}. Open "
                               f"'{colorize_vm_name(at_ancestor[0].name, stream=sys.stdout)}' "
                               f"init'd at {ancestor}? [Y/n] ")
            if reply.strip().lower() in ("", "y", "yes"):
                return at_ancestor[0].name
            die("aborted")
        return choose_vm_from_candidates(
            at_ancestor, intro=f"No VM bound to {cwd}; VMs init'd at ancestor {ancestor}:")
    die(f"no VM is bound to {cwd} or any parent; run `ivm init <template>` here first")


def vm_is_running(name: str) -> bool:
    return capture(
        ["incus", "list", name, "--format", "csv", "--columns", "s"]
    ).strip().lower().startswith("running")


def ensure_up(name: str, *, dry_run: bool) -> None:
    """Start the VM if stopped, then block until it accepts `incus exec`."""
    if dry_run:
        print(f"+ (ensure {name} is running)", file=sys.stderr)
        return
    if not instance_exists(name):
        die(f"VM '{name}' does not exist; run `ivm init <template>` here first")
    if not vm_is_running(name):
        ensure_shadow_mask_sources(name)
        run(["incus", "start", name], dry_run=dry_run)
    wait_ready(name, dry_run=dry_run)


def vm_ansible_os_family(name: str, *, dry_run: bool) -> str:
    """Read the `user.ivm_ansible_os_family` tag set at init (picks the dotfiles subtree)."""
    if dry_run:
        return "<os-family-from-tag>"
    family: str = capture(["incus", "config", "get", name, "user.ivm_ansible_os_family"]).strip()
    if not family:
        die(f"{name} has no `user.ivm_ansible_os_family` tag; re-create it with `ivm init`")
    return family


# ---------- subcommands ----------

# ---------- confirm-prompt preview fragments ----------
# Each `preview_*` returns the ready-to-print, label-aligned stderr lines for one
# aspect of a VM (network / mounts / storage pool); the confirm prompts just print
# them. Same name prefix, same `list[str]` return, same call shape - on purpose.

def preview_network(doc: Template) -> list[str]:
    """The `network:` line: NAT vs macvlan/bridge + the host<->VM consequence."""
    net: dict[str, Any] = doc.get("net", {})
    mode: str = net.get("mode", "nat")
    if mode == "nat":
        desc: str = "nat (incus managed bridge; host<->VM ok, LAN cannot reach the VM)"
    else:
        parent: str = net.get("parent", "(MISSING net.parent!)")
        desc = (f"macvlan via {parent} (VM gets a LAN IP; host<->VM blocked)" if mode == "macvlan"
                else f"bridge via {parent} (VM on the LAN through your host bridge)")
    return [f"  network:       {desc}"]


def preview_mounts(doc: Template, cwd: Path) -> list[str]:
    """The `mounts:` block: one `host -> guest` line per mount (host-side
    expansion, no incus), with ro/shadow flags; `(none)` if there are no mounts."""
    mount_lines: list[str] = []
    for mount in doc.get("mounts", []):
        host: str = sh_expand(mount["host"], cwd)
        guest: str = sh_expand(mount["guest"], cwd)
        flags: list[str] = []
        if mount.get("ro"):
            flags.append("ro")
        if mount.get("shadow"):
            flags.append("shadow: " + ", ".join(mount["shadow"]))
        mount_lines.append(f"    {host} -> {guest}" + (f"  ({'; '.join(flags)})" if flags else ""))
    return ["  mounts:", *mount_lines] if mount_lines else ["  mounts:        (none)"]


def human_iec_bytes(num_bytes: int) -> str:
    """A raw byte count -> IEC string with 2 decimals (e.g. 5368709120 -> `5.00GiB`),
    the same style `incus storage info` prints, so the loop-file line below reads
    like the `used / total` figures next to it."""
    size_in_current_unit: float = float(num_bytes)
    for unit in ("B", "KiB", "MiB", "GiB", "TiB", "PiB"):
        if size_in_current_unit < 1024.0 or unit == "PiB":
            return f"{int(size_in_current_unit)}{unit}" if unit == "B" else f"{size_in_current_unit:.2f}{unit}"
        size_in_current_unit /= 1024.0
    return f"{num_bytes}B"  # unreachable (the loop always returns); satisfies the type checker


def read_storage_info(root: Path) -> dict[str, Any] | None:
    """The role records the storage pool layout (driver, the loop `.img` it built,
    mount point, size) to `<root>/storage-info.json` at install. ivm reads it as the
    AUTHORITATIVE location: the unprivileged `incus`-group user can't see incus's own
    pool config (it's admin-only -> `config: {}`), so without this the path is
    unknowable to them. None if absent/unreadable -> fall back to probing incus."""
    try:
        parsed: Any = json.loads((root / "storage-info.json").read_text())
    except (OSError, ValueError):
        return None
    return parsed if isinstance(parsed, dict) else None


def storage_location_lines(root: Path, storage_pool_name: str, storage_pool_driver: str) -> list[str]:
    """The indented location line under `storage pool:`. Prefer the role-recorded
    `storage-info.json` (works for the unprivileged user); else probe incus + the
    host filesystem (`preview_storage_pool_location`)."""
    recorded: dict[str, Any] | None = read_storage_info(root)
    if recorded is None:
        return preview_storage_pool_location(storage_pool_name, storage_pool_driver)
    value_column_indent: str = " " * 17
    # `storage-info.json` records what the role was ASKED to build; `storage_pool_driver`
    # is what incus ACTUALLY has live. They disagree when `incus admin init` was skipped
    # because a `default` pool already existed (so the recorded btrfs/loop config never
    # applied). Printing the recorded loop line under a live `(dir)` driver would be a
    # flat contradiction - surface the mismatch instead of pretending they agree.
    recorded_driver: str = str(recorded.get("driver") or "")
    if recorded_driver and storage_pool_driver not in ("", "?") and recorded_driver != storage_pool_driver:
        recorded_loop_or_source: str = recorded.get("loop_file") or recorded.get("source") or "(see storage-info.json)"
        return [
            f"{value_column_indent}⚠ MISMATCH: live pool is `{storage_pool_driver}`, but the recorded "
            f"config wanted `{recorded_driver}` ({recorded_loop_or_source})",
            f"{value_column_indent}  `incus admin init` was skipped (a `default` pool already existed) - the "
            f"storage override never applied.",
            f"{value_column_indent}  to apply it (DESTROYS VMs): `make incus-teardown-host` then "
            f"`make incus-install INCUS_STORAGE_POOL_*=...`",
        ]
    if recorded.get("build_loop") and recorded.get("loop_file"):
        # The role built a btrfs loop file (e.g. on `/home`) and mounted it: show the
        # real `.img` + its sparse on-disk footprint (`stat` needs no root - metadata
        # via parent-dir traversal) + where it's mounted.
        loop_file: str = recorded["loop_file"]
        mountpoint: str = recorded.get("mountpoint") or ""
        try:
            loop_stat: os.stat_result = os.stat(loop_file)
            usage: str = (f"  (sparse: {human_iec_bytes(loop_stat.st_blocks * 512)} on disk now / "
                          f"{human_iec_bytes(loop_stat.st_size)} max)")
        except OSError:
            usage = ""
        mount_note: str = f"  -> mounted at {mountpoint}" if mountpoint else ""
        return [f"{value_column_indent}loop file at {loop_file}{usage}{mount_note}"]
    recorded_source: str = recorded.get("source") or ""
    if recorded_source:
        if storage_pool_driver == "dir":
            return [f"{value_column_indent}dir tree at {recorded_source}  (used/total above = its whole host filesystem)"]
        return [f"{value_column_indent}{storage_pool_driver} at {recorded_source}"]
    # Empty source: incus made the pool at its OWN default location (on `/`).
    if storage_pool_driver == "dir":
        return [f"{value_column_indent}dir tree at {INCUS_VAR_DIR}/storage-pools/{storage_pool_name}  (used/total above = its whole host filesystem)"]
    return [f"{value_column_indent}incus-managed loop at {INCUS_VAR_DIR}/disks/{storage_pool_name}.img  (on /)"]


def preview_storage_pool(root: Path, *, dry_run: bool) -> list[str]:
    """The `storage pool:` block: which pool a VM lands in (the `default` profile's
    root device pool), how full incus reports it, and - on the indented line below -
    WHERE on the host its blocks actually live. Best-effort: `(skipped)` under
    --dry-run, `(unknown)` if incus can't report it; purely informational."""
    if dry_run:
        return ["  storage pool:  (skipped under --dry-run)"]
    import yaml  # lazy, same as load_yaml (ships with ansible-core / python3-yaml)
    storage_pool_name: str = capture(["incus", "profile", "device", "get", "default", "root", "pool"]).strip()
    if not storage_pool_name:
        return ["  storage pool:  (unknown - incus did not report)"]
    # `incus storage info` is yaml; older versions nest the fields under `info:`.
    # Its `space used`/`total space` come from a statvfs of the pool's MOUNT path
    # (incus `genericVFSGetResources`), so they mean different things per backend -
    # spelled out in `preview_storage_pool_location` below.
    parsed: Any = yaml.safe_load(capture(["incus", "storage", "info", storage_pool_name]) or "")
    info: dict[str, Any] = (parsed.get("info", parsed) if isinstance(parsed, dict) else {}) or {}
    storage_pool_driver: str = str(info.get("driver", "")) or "?"
    space_used: Any = info.get("space used")
    space_total: Any = info.get("total space")
    space: str = f"  -  {space_used} used / {space_total} total" if space_used and space_total else ""
    return [
        f"  storage pool:  {storage_pool_name} ({storage_pool_driver}){space}",
        *storage_location_lines(root, storage_pool_name, storage_pool_driver),
    ]


def preview_storage_pool_location(storage_pool_name: str, storage_pool_driver: str) -> list[str]:
    """The indented line under `storage pool:` - where the pool's blocks live on
    the host, and for a loop file its REAL footprint. `incus storage get <pool>
    source` is the configured source; empty means incus used a built-in default
    location, reconstructed per driver. Always one line, aligned under the value."""
    value_column_indent: str = " " * 17  # line up with the `storage pool:` value column above
    storage_pool_source: str = capture(["incus", "storage", "get", storage_pool_name, "source"]).strip()
    if storage_pool_driver == "dir":
        # `dir` backend: `source` IS the storage directory (a plain tree on a real
        # filesystem; no loop file). `used / total` above is therefore that WHOLE
        # filesystem, not just this pool - worth saying, the numbers look huge.
        dir_tree_path: str = storage_pool_source or f"{INCUS_VAR_DIR}/storage-pools/{storage_pool_name}"
        return [f"{value_column_indent}dir tree at {dir_tree_path}  (used/total above = its whole host filesystem)"]
    # btrfs / zfs / lvm: `source` is a loop file, a block device, an existing
    # subvolume, or a zfs dataset / lvm VG name. Empty -> incus auto-created a loop
    # file at its default `loopFilePath()`. stat() classifies what it points at
    # (needs only traverse on the parent dirs, not read on the file, so no root)
    # and, for a loop file, yields the footprint.
    if not storage_pool_source:
        storage_pool_source = f"{INCUS_VAR_DIR}/disks/{storage_pool_name}.img"
    try:
        storage_pool_source_stat: os.stat_result = os.stat(storage_pool_source)
    except FileNotFoundError:
        # Not a host path at all: a zfs dataset (`tank/incus`) or lvm VG (`vg0/incus`) name.
        return [f"{value_column_indent}{storage_pool_driver} dataset/volume: {storage_pool_source}"]
    except OSError:
        # A real path under a root-only dir we can't traverse unprivileged.
        return [f"{value_column_indent}{storage_pool_driver} backing at {storage_pool_source}  (size hidden - needs root)"]
    if stat.S_ISREG(storage_pool_source_stat.st_mode):
        # Loop file: a sparse `.img` whose REAL host-disk use (st_blocks, the same
        # number `du` reports) sits far below its declared size (st_size, the sparse
        # apparent length == the pool's `total` above). That gap is the whole point
        # of a loop file, so show both.
        loop_file_real_bytes_on_disk: int = storage_pool_source_stat.st_blocks * 512  # POSIX: st_blocks is 512-byte units
        loop_file_logical_size_bytes: int = storage_pool_source_stat.st_size
        return [f"{value_column_indent}loop file at {storage_pool_source}  "
                f"(sparse: {human_iec_bytes(loop_file_real_bytes_on_disk)} on host disk now / "
                f"{human_iec_bytes(loop_file_logical_size_bytes)} max)"]
    if stat.S_ISBLK(storage_pool_source_stat.st_mode):
        return [f"{value_column_indent}{storage_pool_driver} on block device {storage_pool_source}"]
    return [f"{value_column_indent}{storage_pool_driver} subvolume at {storage_pool_source}"]


def confirm_create(doc: Template, name: str, cwd: Path, root: Path, *, assume_yes: bool, dry_run: bool) -> None:
    hw: dict[str, Any] = doc.get("hw", {})
    print("", file=sys.stderr)
    print("About to CREATE a new Incus VM:", file=sys.stderr)
    print(f"  incus VM name: {colorize_vm_name(name)}  (visible in `incus list`)", file=sys.stderr)
    print(f"  template:      {doc['template_name']}  (cwd: {cwd})", file=sys.stderr)
    print(f"  image:         {image_ref(doc['os'])}", file=sys.stderr)
    print(f"  hw:            cpu={hw.get('cpu')} memory={hw.get('memory')} disk={hw.get('disk')}", file=sys.stderr)
    # Surface what will run as ROOT in the guest at provision time BEFORE the create
    # is confirmed (esp. `thirdparty_software`, which fetches + runs external
    # installers like claude's `curl|bash`) - transparency before a privileged fetch.
    thirdparty_software: list[str] = doc.get("thirdparty_software", [])
    if thirdparty_software:
        print(f"  3rd-party:     {', '.join(thirdparty_software)}  (install recipes run as ROOT in the guest)", file=sys.stderr)
    if doc.get("post_install_script"):
        print("  post-install:  custom script (runs as ROOT in the guest)", file=sys.stderr)
    for line in (preview_network(doc) + preview_mounts(doc, cwd) + preview_storage_pool(root, dry_run=dry_run)):
        print(line, file=sys.stderr)
    print("", file=sys.stderr)
    if assume_yes or dry_run:
        return
    if not sys.stdin.isatty():
        die(f"refusing to create {name} without a TTY; pass --yes")
    if input("Create this VM? [y/N] ").strip().lower() not in ("y", "yes"):
        die("aborted; no VM created")


def cmd_list_templates(root: Path) -> None:
    """List available templates + their one-line `description` - shown when `ivm init` runs
    with NO template arg (the bash-friendly alternative to <TAB>, since bash completion
    can't show descriptions inline). Prints to stdout (readable / pipeable)."""
    templates_dir: Path = root / "templates"
    rows: list[tuple[str, str]] = []
    for template_file in sorted(templates_dir.glob("*.yaml")):
        try:
            doc: Template = load_yaml(template_file)
            rows.append((doc.get("template_name", template_file.stem), doc.get("description", "")))
        except Exception:
            rows.append((template_file.stem, "(could not parse)"))
    if not rows:
        die(f"no templates found in {templates_dir}; re-run `make vm-incus-install`")
    width: int = max(len(name) for name, _ in rows)
    print("Available templates - run `ivm init <template>`:\n")
    for name, desc in rows:
        print(f"  {name:<{width}}  {desc}" if desc else f"  {name}")


def cmd_init(template_name: str, given_name: str | None, root: Path, shared_prebuilt_provision_assets_root: Path, *,
             assume_yes: bool, dry_run: bool) -> None:
    """Create a VM from `<template>`, bound to the current directory: validate the
    template, prompt for + confirm the instance name, then `incus create` (stopped)
    -> attach devices (mounts, shadow masks, tpm, nic) -> start -> provision (packages,
    `user`, dotfiles); a GUI template also reboots into the desktop. A post-create
    failure leaves the VM in place (blips are often transient) with recovery hints."""
    cwd: Path = Path.cwd()
    doc: Template = load_and_validate(template_name, root)
    if doc["os"]["type"] != "linux":
        die(f"`init` supports linux only for now; '{template_name}' is os.type={doc['os']['type']}")
    registry: dict[str, Any] = load_package_groups(shared_prebuilt_provision_assets_root)
    warn_if_host_nesting_disabled(doc)
    name: str = choose_instance_name(template_name, cwd, given_name, doc,
                                     dry_run=dry_run, assume_yes=assume_yes)
    confirm_create(doc, name, cwd, root, assume_yes=assume_yes, dry_run=dry_run)
    is_gui: bool = bool(doc.get("sys", {}).get("gui"))
    # create stopped, attach all devices, THEN start (so non-hotpluggable
    # devices like the TPM are present at first boot).
    run(create_command(doc, name, cwd), dry_run=dry_run)
    # Past `incus create` anything can fail (flaky mirror mid-install, bad package
    # name, guest not coming up). We deliberately do NOT auto-delete on failure:
    # the cause is often a transient repo/network blip, and destroying the VM
    # would throw away a likely-fine machine plus the chance to inspect/retry.
    # Report cleanly (no Python traceback) with the recovery commands instead.
    try:
        if any(mount.get("shadow") for mount in doc.get("mounts", [])):
            ensure_shadow_mask(root, dry_run=dry_run)
        for device_cmd in mount_commands(doc, name, cwd, root) + extra_device_commands(doc, name):
            run(device_cmd, dry_run=dry_run)
        run(["incus", "start", name], dry_run=dry_run)
        wait_ready(name, dry_run=dry_run)
        run(["incus", "exec", name, "--", "bash", "-ec", provision_script(doc, registry, cwd, root, shared_prebuilt_provision_assets_root)], dry_run=dry_run)
        for push_cmd in push_baseline_dotfiles_commands(ansible_os_family_of(doc), name, shared_prebuilt_provision_assets_root):
            run(push_cmd, dry_run=dry_run)
        if is_gui:
            # Provisioning set graphical.target + enabled the display manager, but
            # the VM was started BEFORE that, so it is still at multi-user (a TTY).
            # Reboot so it comes up in graphical.target (autologin + the IM env vars
            # from /etc/environment apply to the fresh session). Then wait for the
            # agent only - the desktop needs no network to render.
            run(["incus", "restart", name], dry_run=dry_run)
            if dry_run:
                print(f"+ (wait until `incus exec {name}` works again after reboot)", file=sys.stderr)
            elif not wait_until(name, "true", 90):
                die(f"VM '{name}' did not come back up within 90s after the GUI reboot")
    except subprocess.CalledProcessError as exc:
        print("", file=sys.stderr)
        die(f"setup of '{name}' failed at the step above (exit {exc.returncode}). "
            f"The VM was left in place, NOT deleted (often a transient mirror/network "
            f"blip worth retrying).\n"
            f"  inspect: incus exec {name} -- bash\n"
            f"  remove:  ivm delete   (from {cwd})   # or: incus delete --force {name}\n"
            f"Resolve the cause, then `ivm delete` + `ivm init {template_name}` to rebuild.")
    enter_hint: str = "ivm shell" + (", or `ivm gui` for the desktop" if is_gui else "")
    print(f"==> {colorize_vm_name(name)} ready. Enter with: {enter_hint}", file=sys.stderr)


def shell_login_dir(name: str, *, dry_run: bool) -> str:
    """The initial working directory for `ivm shell`, read from the VM's
    `user.ivm_shell_default_dir_after_login` tag (set at init from the template field of
    the same name). Returns "" when the tag is unset -> the caller omits `--cwd` and
    incus uses its default cwd. If the tag is set but the directory is ABSENT in the
    guest (e.g. a mount failed to attach), warn and return "" so `ivm shell` still opens
    in the default cwd instead of failing on `incus exec --cwd <missing>`."""
    if dry_run:
        return ""  # don't probe a possibly-nonexistent VM under --dry-run
    configured_dir: str = capture(
        ["incus", "config", "get", name, "user.ivm_shell_default_dir_after_login"]).strip()
    if not configured_dir:
        return ""
    # `incus exec --cwd <dir>` fails hard if <dir> is missing, which would block the
    # shell entirely; probe with `test -d` first and fall back to the default cwd.
    probe = subprocess.run(
        ["incus", "exec", name, "--", "test", "-d", configured_dir], capture_output=True)
    if probe.returncode != 0:
        print(f"==> warning: shell dir '{configured_dir}' "
              f"(user.ivm_shell_default_dir_after_login) not found in {colorize_vm_name(name)}; "
              f"starting in the default directory instead.", file=sys.stderr)
        return ""
    return configured_dir


def cmd_shell(name: str, root: Path, *, as_root: bool, dry_run: bool) -> None:
    """Open an interactive zsh in the target VM (starting it first if stopped): as
    `root` when `as_root`, else as the unprivileged `user` (uid/gid 1000). Auth is the
    host incus socket - no in-guest password needed.

    Starts in the VM's `user.ivm_shell_default_dir_after_login` directory when that tag
    is set (from the template field) and the directory exists in the guest, via
    `incus exec --cwd`; this ONLY sets the starting directory - `$HOME` and a bare `cd`
    are unchanged. Applies to shell / shell-user / shell-root alike."""
    ensure_up(name, dry_run=dry_run)
    cmd: list[str] = ["incus", "exec"]
    login_dir: str = shell_login_dir(name, dry_run=dry_run)
    if login_dir:
        cmd += ["--cwd", login_dir]
    if as_root:
        cmd += ["--env", "HOME=/root", "--env", "USER=root"]
    else:
        cmd += ["--user", "1000", "--group", "1000",
                "--env", "HOME=/home/user", "--env", "USER=user"]
    cmd += [name, "--", "zsh"]
    exec_into(cmd, dry_run=dry_run)


def cmd_start(name: str, *, dry_run: bool) -> None:
    """Start the target VM and wait until it is ready (no-op if already running)."""
    ensure_up(name, dry_run=dry_run)
    print(f"==> {colorize_vm_name(name)} running.", file=sys.stderr)


def confirm_action(name: str, action: str, *, assume_yes: bool, dry_run: bool) -> None:
    """y/N gate before a disruptive lifecycle action (stop / reboot) that interrupts a
    running VM. `--yes` / `--dry-run` skip it; non-TTY without `--yes` aborts (same
    policy as `delete`)."""
    if assume_yes or dry_run:
        return
    if not sys.stdin.isatty():
        die(f"refusing to {action} {name} without a TTY; pass --yes")
    if input(f"{action.capitalize()} {colorize_vm_name(name)}? [y/N] ").strip().lower() not in ("y", "yes"):
        die("aborted")


def cmd_reboot(name: str, *, assume_yes: bool, dry_run: bool) -> None:
    """`incus restart` the target VM (ivm-friendly alias; incus calls it restart).
    Confirms first (unless `--yes`)."""
    confirm_action(name, "reboot", assume_yes=assume_yes, dry_run=dry_run)
    run(["incus", "restart", name], dry_run=dry_run)
    print(f"==> {colorize_vm_name(name)} rebooted.", file=sys.stderr)


def cmd_stop(name: str, *, assume_yes: bool, dry_run: bool) -> None:
    """Stop the target VM (`incus stop`); disk state is preserved. Confirms first
    (unless `--yes`); no-op if already stopped."""
    if not dry_run and not vm_is_running(name):
        print(f"==> {colorize_vm_name(name)} already stopped.", file=sys.stderr)
        return
    confirm_action(name, "stop", assume_yes=assume_yes, dry_run=dry_run)
    run(["incus", "stop", name], dry_run=dry_run)


def confirm_delete(name: str, root: Path, *, assume_yes: bool, dry_run: bool) -> None:
    print("", file=sys.stderr)
    print("About to PERMANENTLY DELETE this Incus VM (config + disk + snapshots):", file=sys.stderr)
    print(f"  incus VM name: {colorize_vm_name(name)}", file=sys.stderr)
    for line in preview_storage_pool(root, dry_run=dry_run):
        print(line, file=sys.stderr)
    print("This cannot be undone.", file=sys.stderr)
    print("", file=sys.stderr)
    if assume_yes or dry_run:
        return
    if not sys.stdin.isatty():
        die(f"refusing to delete {name} without a TTY; pass --yes")
    if input("Delete this VM? [y/N] ").strip().lower() not in ("y", "yes"):
        die("aborted; VM not deleted")


def cmd_delete(name: str, root: Path, *, assume_yes: bool, dry_run: bool) -> None:
    """Permanently delete the target VM - config, disk, and snapshots (`incus delete
    --force`). Confirms first (showing the storage pool) unless `--yes`; no-op if the
    VM does not exist."""
    if not dry_run and not instance_exists(name):
        print(f"==> {colorize_vm_name(name)} does not exist; nothing to delete.", file=sys.stderr)
        return
    confirm_delete(name, root, assume_yes=assume_yes, dry_run=dry_run)
    run(["incus", "delete", "--force", name], dry_run=dry_run)


def cmd_overwrite_dotfiles(name: str, shared_prebuilt_provision_assets_root: Path, *, dry_run: bool) -> None:
    """Re-push the host-staged baseline dotfiles (bash/tmux/zsh) into an existing VM
    (no re-provision)."""
    ensure_up(name, dry_run=dry_run)
    for push_cmd in push_baseline_dotfiles_commands(vm_ansible_os_family(name, dry_run=dry_run), name, shared_prebuilt_provision_assets_root):
        run(push_cmd, dry_run=dry_run)
    # Ensure the managed-guest marker too, so a VM created before this existed lights up
    # the box-glyph prompt after a plain `overwrite-dotfiles` (no full re-provision).
    run(["incus", "exec", name, "--", "bash", "-ec", guest_type_marker_script()], dry_run=dry_run)
    print(f"==> dotfiles re-pushed into {colorize_vm_name(name)} (/home/user + /root).", file=sys.stderr)


def cmd_set_password(name: str, username: str, *, dry_run: bool) -> None:
    """Set a login password for `<username>` in the guest (e.g. so you can log in
    on the console/TTY). Just the password - sudo is a separate opt-in
    (`enable-user-sudo`). The operator's `shell-root`/`shell` paths are host-socket
    auth and need no password."""
    ensure_up(name, dry_run=dry_run)
    if dry_run:
        print(f"+ (prompt for {username}'s password, then `incus exec {name} -- chpasswd` via stdin)",
              file=sys.stderr)
        return
    password: str = getpass.getpass(f"New password for {username} on {name}: ")
    if not password:
        die("empty password rejected")
    if password != getpass.getpass("Confirm: "):
        die("passwords do not match")
    # Password travels via stdin, never argv - so it is not visible in the
    # guest's process list. `chpasswd` reads `username:password` lines.
    subprocess.run(["incus", "exec", name, "--", "chpasswd"],
                   input=f"{username}:{password}\n", text=True, check=True)
    print(f"==> password set for {username} on {colorize_vm_name(name)}.", file=sys.stderr)


def cmd_unset_password(name: str, username: str, *, dry_run: bool) -> None:
    """Lock `<username>`'s password (reverses `set-password`); the account can no
    longer log in by password."""
    ensure_up(name, dry_run=dry_run)
    run(["incus", "exec", name, "--", "passwd", "--lock", username], dry_run=dry_run)
    print(f"==> {username}'s password locked on {colorize_vm_name(name)}.", file=sys.stderr)


# Opt into IN-GUEST privilege escalation, separate from any login password.
# Default provisioning gives `user` NO sudo; this lets `user` sudo but gated by
# ROOT's password (`Defaults:user rootpw`), so a `user` process that doesn't know
# it still can't escalate. Requires root to HAVE a password (`ivm set-password
# root`) - without it sudo is unusable. The operator's `shell-root` path is
# host-socket auth, unaffected either way.
_SUDOERS_USER: str = "Defaults:user rootpw\nuser ALL=(ALL) ALL\n"


def cmd_enable_user_sudo(name: str, *, dry_run: bool) -> None:
    """Opt `user` into in-guest sudo via an `/etc/sudoers.d/user` drop-in - sudo then
    prompts for ROOT's password (`Defaults:user rootpw`), so set one first with
    `ivm set-password root`. Revert with `disable-user-sudo`."""
    ensure_up(name, dry_run=dry_run)
    run(["incus", "exec", name, "--", "bash", "-ec",
         "cat > /etc/sudoers.d/user <<'EOF'\n" + _SUDOERS_USER + "EOF\n"
         "chmod 0440 /etc/sudoers.d/user\n"
         "visudo --check --file=/etc/sudoers.d/user"], dry_run=dry_run)
    print(f"==> `user` may now sudo on {colorize_vm_name(name)} - it prompts for ROOT's password, so "
          f"set one first with `ivm set-password root` if you haven't.", file=sys.stderr)


def cmd_disable_user_sudo(name: str, *, dry_run: bool) -> None:
    """Remove the `/etc/sudoers.d/user` drop-in, reverting `enable-user-sudo` (back to
    the locked-down default where `user` cannot sudo)."""
    ensure_up(name, dry_run=dry_run)
    run(["incus", "exec", name, "--", "rm", "-f", "/etc/sudoers.d/user"], dry_run=dry_run)
    print(f"==> `user` sudo removed on {colorize_vm_name(name)}; back to the locked-down default.", file=sys.stderr)


def cmd_set_ssh_server(name: str, username: str, *, pubkey_files: list[str] | None, dry_run: bool) -> None:
    """Authorize key-based SSH login for `<username>` in the guest - e.g. so VS Code
    Remote-SSH can attach without going through `incus exec`. Appends the given host
    public key(s) to that account's `~/.ssh/authorized_keys` (idempotent - never
    clobbers keys you added by hand) and makes sure sshd is running; `root` also gets
    `PermitRootLogin prohibit-password`. Key-only, no password auth. Reverse with
    `unset-ssh-server`. Port / password-login tuning lives in the template's
    `sys.ssh_server` block, not here."""
    keys: list[str] = read_authorized_keys(pubkey_files or [DEFAULT_SSH_PUBKEY], Path.cwd())
    ensure_up(name, dry_run=dry_run)
    home: str = _guest_home_for(username)
    # sshd ships in the guest baseline; enable + start it, then authorize the key(s).
    script: str = "systemctl enable --now sshd 2>/dev/null || systemctl enable --now ssh\n"
    script += _authorized_keys_append(home, username, keys)
    if username == "root":
        # Most distros block root key login by default; allow key-only root via a drop-in.
        script += (
            "mkdir -p /etc/ssh/sshd_config.d\n"
            "printf 'PermitRootLogin prohibit-password\\n' > /etc/ssh/sshd_config.d/ivm-set-ssh-server.conf\n"
            "systemctl reload sshd 2>/dev/null || systemctl reload ssh 2>/dev/null || true\n"
        )
    run(["incus", "exec", name, "--", "bash", "-ec", script], dry_run=dry_run)
    print(f"==> SSH authorized for `{username}` on {colorize_vm_name(name)} "
          f"({len(keys)} key(s)). Connect with `ssh {username}@<vm-ip>` (see `ivm info` "
          f"for the address). Reverse with `ivm unset-ssh-server {username}`.", file=sys.stderr)


def cmd_unset_ssh_server(name: str, username: str, *, pubkey_files: list[str] | None, dry_run: bool) -> None:
    """Revoke the access granted by `set-ssh-server` for `<username>`: remove the given
    host public key(s) from that account's `~/.ssh/authorized_keys` (other keys left
    untouched), and for `root` drop the `PermitRootLogin` override. sshd itself is left
    running, since another account may still use it (mirrors `unset-password`, which
    only locks the account)."""
    keys: list[str] = read_authorized_keys(pubkey_files or [DEFAULT_SSH_PUBKEY], Path.cwd())
    ensure_up(name, dry_run=dry_run)
    home: str = _guest_home_for(username)
    script: str = _authorized_keys_remove(home, username, keys)
    if username == "root":
        script += (
            "rm -f /etc/ssh/sshd_config.d/ivm-set-ssh-server.conf\n"
            "systemctl reload sshd 2>/dev/null || systemctl reload ssh 2>/dev/null || true\n"
        )
    run(["incus", "exec", name, "--", "bash", "-ec", script], dry_run=dry_run)
    print(f"==> SSH access revoked for `{username}` on {colorize_vm_name(name)} "
          f"({len(keys)} key(s) removed; sshd left running).", file=sys.stderr)


def cmd_update(name: str, *, dry_run: bool) -> None:
    """Refresh metadata + upgrade all packages in the VM (per-family pkg-mgr)."""
    ensure_up(name, dry_run=dry_run)
    if dry_run:
        print("+ (incus exec <vm> -- upgrade all packages via the VM's ansible_os_family "
              "package manager [apt/zypper/dnf])", file=sys.stderr)
        return
    ansible_os_family: str = vm_ansible_os_family(name, dry_run=dry_run)
    run(["incus", "exec", name, "--", "bash", "-ec", update_packages_script(ansible_os_family)],
        dry_run=dry_run)


def cmd_list_provision_units(shared_prebuilt_provision_assets_root: Path) -> None:
    """List the installable units (name + `description`), grouped by kind - shown when
    `ivm provision` runs with NO unit arg (the bash-friendly alternative to <TAB>). No VM
    needed - this is just the registry. Prints to stdout (readable / pipeable)."""
    distro: dict[str, Any] = load_package_groups(shared_prebuilt_provision_assets_root)
    thirdparty: dict[str, Any] = load_thirdparty_software(shared_prebuilt_provision_assets_root)
    dotfiles_root: Path = shared_prebuilt_provision_assets_root / "dotfiles"
    dotfiles: list[str] = sorted(p.name for p in dotfiles_root.iterdir()) if dotfiles_root.is_dir() else []

    def described_rows(registry: dict[str, Any]) -> list[str]:
        names: list[str] = sorted(registry)
        width: int = max((len(n) for n in names), default=0)
        rows: list[str] = []
        for n in names:
            desc: str = registry[n].get("description", "") if isinstance(registry[n], dict) else ""
            rows.append(f"    {n:<{width}}  {desc}" if desc else f"    {n}")
        return rows

    print("Provisionable units - run `ivm provision <unit>...` (a name may match more than one):\n")
    print("  distro package bundles:")
    print("\n".join(described_rows(distro)))
    print("\n  thirdparty software:")
    print("\n".join(described_rows(thirdparty)))
    print("\n  dotfiles features:")
    print(("    " + ", ".join(dotfiles)) if dotfiles else "    (none)")


def cmd_provision(name: str, unit_names: list[str], shared_prebuilt_provision_assets_root: Path, *, dry_run: bool) -> None:
    """Install named units onto an EXISTING VM - the post-`init` "add more software"
    path. A name can be a `distro_package_groups` bundle, a `thirdparty_software`
    recipe, AND/OR a dotfiles feature - all that match are applied (e.g. `emacs` is
    BOTH the `emacs` package bundle AND the `dotfiles/emacs` config, so both happen).
    Distro bundles install via the VM's package manager, thirdparty recipes run their
    (probe-guarded) script as root, dotfiles features are pushed into /home/user (+ /root).
    Idempotent. Target is the cwd-bound VM or `--name`, like the other VM subcommands."""
    ensure_up(name, dry_run=dry_run)
    distro_registry: dict[str, Any] = load_package_groups(shared_prebuilt_provision_assets_root)
    thirdparty_registry: dict[str, Any] = load_thirdparty_software(shared_prebuilt_provision_assets_root)
    dotfiles_root: Path = shared_prebuilt_provision_assets_root / "dotfiles"
    distro_bundles: list[str] = []
    thirdparty_names: list[str] = []
    dotfiles_features: list[str] = []
    for unit in unit_names:
        matched: bool = False
        if unit in distro_registry:
            distro_bundles.append(unit)
            matched = True
        if unit in thirdparty_registry:
            thirdparty_names.append(unit)
            matched = True
        if (dotfiles_root / unit).is_dir():
            dotfiles_features.append(unit)
            matched = True
        if not matched:
            available_features: list[str] = sorted(p.name for p in dotfiles_root.iterdir()) if dotfiles_root.is_dir() else []
            die(f"unknown unit '{unit}' - not a distro_package_groups bundle, a "
                f"thirdparty_software recipe, nor a dotfiles feature.\n"
                f"  distro bundles:      {', '.join(sorted(distro_registry))}\n"
                f"  thirdparty software: {', '.join(sorted(thirdparty_registry))}\n"
                f"  dotfiles features:   {', '.join(available_features)}")
    if dry_run:
        print(f"+ (incus exec {name} -- install distro bundles {distro_bundles or '[]'} + "
              f"thirdparty {thirdparty_names or '[]'}; push dotfiles {dotfiles_features or '[]'})",
              file=sys.stderr)
        return
    ansible_os_family: str = vm_ansible_os_family(name, dry_run=dry_run)
    script: str = ""
    if distro_bundles:
        packages: list[str] = []
        for bundle in distro_bundles:
            packages += resolve_group(distro_registry, bundle, ansible_os_family)
        packages = list(dict.fromkeys(packages))
        if packages:
            script += install_packages_script(ansible_os_family, packages)
        # `user` already exists on a provisioned VM, so a bundle's post_install can
        # `su - user -c` straight away (unlike init, no ordering concern).
        script += groups_post_install_script(distro_bundles, distro_registry, ansible_os_family)
    if thirdparty_names:
        script += thirdparty_install_script(
            resolve_thirdparty_software(thirdparty_names, thirdparty_registry, ansible_os_family)
        )
    if script:
        run(["incus", "exec", name, "--", "bash", "-ec", script], dry_run=dry_run)
    for feature in dotfiles_features:
        for push_cmd in push_feature_dotfiles_commands(feature, ansible_os_family, name, shared_prebuilt_provision_assets_root):
            run(push_cmd, dry_run=dry_run)
    print(f"==> provisioned {', '.join(unit_names)} into {colorize_vm_name(name)}.", file=sys.stderr)


def cmd_snapshot(name: str, snapshot_args: list[str], *, dry_run: bool) -> None:
    """Thin wrapper over `incus snapshot`, injecting the target VM as the instance
    arg: `ivm snapshot [create|list|restore|delete|...] [snapname]` ->
    `incus snapshot <action> <vm> [snapname]`. No args defaults to `list`."""
    action: str = snapshot_args[0] if snapshot_args else "list"
    rest: list[str] = snapshot_args[1:]
    run(["incus", "snapshot", action, name, *rest], dry_run=dry_run)


def cmd_gui(name: str, *, dry_run: bool) -> None:
    """Open the VM's SPICE graphical console (`incus console --type=vga`) DETACHED
    from the calling shell: spawn it in its own session with stdin/stdout/stderr
    silenced, so ivm returns at once and you can close the terminal without
    killing the GUI. (incus console itself stays alive managing the SPICE socket
    until the viewer closes - cmd/incus/console.go vga() - so it must be detached,
    not merely backgrounded.)"""
    ensure_up(name, dry_run=dry_run)
    cmd: list[str] = ["incus", "console", "--type=vga", name]
    print("+ " + shlex.join(cmd) + "  (detached: own session, output silenced)", file=sys.stderr)
    if dry_run:
        return
    # `incus console --type=vga` auto-launches remote-viewer, else spicy. If
    # NEITHER is installed it does NOT fail - it prints a socket path and hangs
    # waiting for a connection (console.go vga(), "neither could be found").
    # Detached + silenced, that would be an invisible stuck process with no
    # window, so refuse loudly here instead (mirrors incus's own viewer probe).
    if shutil.which("remote-viewer") is None and shutil.which("spicy") is None:
        die("no SPICE viewer found - install remote-viewer (virt-viewer) or spicy "
            "(spice-gtk), then retry `ivm gui`. To debug without one, run yourself: "
            f"incus console --type=vga {name}")
    # Detach: start_new_session=True puts it in its own session (no controlling
    # terminal), so closing this shell does NOT SIGHUP it; stdin/stdout/stderr to
    # /dev/null keeps console noise off the shell. The vga path needs no TTY (only
    # the text console sets raw mode), so a /dev/null stdin is safe.
    subprocess.Popen(
        cmd, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL, start_new_session=True,
    )
    print(f"==> GUI console launched for {colorize_vm_name(name)} "
          f"(detached - close this terminal anytime).", file=sys.stderr)


def cmd_list(list_args: list[str], *, dry_run: bool) -> None:
    """`incus list` passthrough (ivm-friendly alias). Extra args go to incus, e.g.
    `ivm list --format csv`. Shows all instances; ivm VMs are `ivm-`prefixed."""
    run(["incus", "list", *list_args], dry_run=dry_run)


def cmd_top(top_args: list[str], *, dry_run: bool) -> None:
    """`incus top` passthrough: a live per-instance CPU / memory / disk view (needs a
    recent incus). NOTE: a VM's memory column is the GUEST-reported usage (via the incus
    agent), which UNDER-reports the host RAM the QEMU process actually holds - incus VMs
    have no balloon free-page-reporting, so freed guest memory is not returned to the
    host until the VM stops. For the true per-VM host cost:
    `ps -eo pid,rss,comm --sort=-rss | grep qemu`."""
    exec_into(["incus", "top", *top_args], dry_run=dry_run)


