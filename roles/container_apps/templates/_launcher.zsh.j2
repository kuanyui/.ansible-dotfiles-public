#compdef {{ launcher_name }}
# {{ ansible_managed }}
#
# zsh completion for `{{ launcher_name }}`. Subcommands are parsed from the
# dispatch case statement in host-cli.sh (any new subcommand picks up
# automatically on next shell start); flags are hardcoded to mirror
# `host-cli.sh`'s flag parser.

local script="{{ container_apps_install_root }}/{{ app.template }}/host-cli.sh"
local -a subs
subs=(${(s.|.)"$(perl -ne 'if (/^\s*([a-zA-Z_][\w-]*(\|[a-zA-Z_][\w-]*)+)\)/) { print $1; exit }' "$script" 2>/dev/null)"})

# Mutually-exclusive groups via the (a b)'flag'... form so e.g. proposing
# `--project-name` removes `-n` from the next round of suggestions.
_arguments -C \
    '(-n --project-name)'{-n,--project-name}'[project name (default: basename of cwd)]:name:' \
    '(-p --project-path)'{-p,--project-path}'[single-mount alias for --mount]:path:_files -/' \
    '*--mount[bind-mount <host>\[:<name>\] into /workspaces/<name>; repeatable]:mount:_files -/' \
    '--hide-git-dir[mask host .git/ inside container (default: true)]:mode:(true false readonly)' \
    '--hide-vscode-dir[mask host .vscode/ inside container (default: true)]:mode:(true false readonly)' \
    '1:subcommand:->subcmd' \
    '*::arg:->args'

case "$state" in
    subcmd) _describe 'subcommand' subs ;;
esac
