#!/usr/bin/env bash
# {{ ansible_managed }}
#
# Launcher for container app `{{ app.template }}` under OCI runtime `{{ runtime }}`.
# Sets RUNTIME / PROJECT_NAME / PROJECT_PATH and forwards to the rendered
# `host-cli.sh`.
#
# ===========================================================================
# Two-role layout (the key to not getting lost between container_apps and
# container_templates):
#
#   roles/container_apps/       thin launchers at `~/.local/bin/c-<tpl>-<rt>`
#                               + zsh/bash completions. Each launcher sets
#                               RUNTIME / PROJECT_NAME / PROJECT_PATH env
#                               vars then `exec`s into the script below.
#                               (This is the name the user types.) <-- YOU ARE HERE
#                                                |
#                                                v
#   roles/container_templates/  per-template assets under
#                               `~/.local/share/ansible-managed/container-apps/container-templates/<tpl>/`,
#                               including Dockerfile{,.krun,.systemd}, the
#                               rendered dotfiles, and host-cli.sh.
#                               (Per-template means: one host-cli.sh per
#                               template name; one launcher per
#                               (template, runtime) pair.)
#
# Concrete example for `c-claude-crun init`:
#   1. shell runs `~/.local/bin/c-claude-crun`                                          (launcher; container_apps)
#   2. launcher `exec`s `~/.local/share/ansible-managed/container-apps/container-templates/claude/host-cli.sh init`   (host-cli.sh; container_templates)
# ===========================================================================
#
# Examples:
#   c-{{ app.template }}-{{ runtime }} init                       # from your project dir
#   c-{{ app.template }}-{{ runtime }} zsh-user
#   PROJECT_NAME=foo c-{{ app.template }}-{{ runtime }} init      # override one var

export RUNTIME="{{ runtime }}"
# Default PROJECT_NAME = $PWD with $HOME prefix stripped (or leading `/` if
# PWD is outside $HOME), then `/` replaced by `_`. So:
#   ~/projects/foo/bar  -> `projects_foo_bar`
#   ~/foo               -> `foo`
#   /tmp/work           -> `tmp_work`
# This way different projects sharing a basename (e.g. `~/work/foo` and
# `~/sandbox/foo`) don't collide on the container name.
_proj="${PWD#"$HOME"/}"
_proj="${_proj#/}"
# Sanitize `.` at the start of any path segment to `_`, BEFORE the `/`->`_`
# pass. Docker image references reject `_.` and leading `.` in path components
# (regex `[a-z0-9]+(?:(?:[._]|__|[-]*)[a-z0-9]+)*`), so without this, any
# dotdir on the path (`~/.foo`, `~/projects/.bar`) explodes at build time
# with `invalid reference format`. We preserve the dot's position with `_`
# instead of stripping it, so `~/foo` and `~/.foo` map to distinct names.
_proj="${_proj//\/./\/_}"
_proj="${_proj/#./_}"
export PROJECT_NAME="${PROJECT_NAME:-${_proj//\//_}}"
unset _proj
export PROJECT_PATH="${PROJECT_PATH:-$PWD}"

exec "{{ container_apps_install_root }}/{{ app.template }}/host-cli.sh" "$@"
