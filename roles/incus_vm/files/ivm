#!/usr/bin/env python3
"""ivm - incus VM launcher engine.

Reads VM templates (`<root>/vm-templates/<name>.yaml`) validated against
`<root>/vm.schema.json`, and drives incus from the HOST (no ansible/python in
the guest). Design: roles/incus_vm/REDESIGN.md (esp. section 8) +
roles/incus_vm/IMPLEMENTATION_PLAN.md.

Implemented: `init` (name prompt -> launch -> mounts -> provision: install
baseline+groups+packages, create user, run post_install_script -> push
dotfiles); `shell`/`shell-user`/`shell-root`; lifecycle `start`/`stop`/`delete`/
`update`/`overwrite-dotfiles`/`set-root-password`/`unset-root-password`; `env`.
Linux on Debian/Suse/RedHat families (apt/zypper/dnf). `--dry-run` prints every
mutating command instead of running it. shadow mounts / tmpfs / ssh / gpu / net
/ snapshot / gui / windows are later phases (guarded where reached).
"""

from __future__ import annotations

import argparse
import getpass
import json
import os
import re
import shlex
import subprocess
import sys
import time
from pathlib import Path
from typing import TYPE_CHECKING, Any, NoReturn

if TYPE_CHECKING:
    # Type-only: keep the runtime imports of yaml/jsonschema lazy (inside the
    # functions) so a missing dep yields a clean message, not an ImportError.
    from jsonschema.exceptions import ValidationError

# A parsed VM template. Structure is enforced at runtime by jsonschema against
# `vm.schema.json`, so the values stay `Any` rather than a duplicated TypedDict.
Template = dict[str, Any]

DEFAULT_ROOT: Path = Path(
    os.environ.get("IVM_ROOT", str(Path.home() / ".local/share/ansible-managed/incus-vm"))
)

CWD_RESOLVED: tuple[str, ...] = (
    "shell", "shell-user", "shell-root", "start", "stop", "delete", "env",
    "overwrite-dotfiles", "update", "set-root-password", "unset-root-password",
    "snapshot", "gui",
)

# Installed on EVERY guest at first provision (the ivm-guest floor: zsh + login
# shell, sudo, ssh, basics). Defined as a bundle in the distro_packages registry
# (`distro_packages_incus_guest_baseline`) so all package names - including
# per-family differences - live in one place; resolved from package-groups.json.
BASELINE_GROUP: str = "incus_guest_baseline"

# incus instance name: start alphanumeric, then [a-zA-Z0-9-], max 63 chars.
INCUS_NAME_RE: re.Pattern[str] = re.compile(r"^[a-zA-Z0-9][a-zA-Z0-9-]{0,62}$")
MAX_NAME_LEN: int = 63

# Map a template's `os.distro` to the ansible fact `ansible_os_family` (values:
# Debian/Suse/RedHat - NOT the distro name like `opensuse`). It keys both the
# dotfiles staging (vm-rootfs/<Debian|Suse|RedHat>/) and the package-group
# overlays (common + per-family) in package-groups.json. debian/ubuntu share the
# Debian family today; if ubuntu package names ever diverge from debian, that
# needs a finer distro-level key, not just ansible_os_family.
DISTRO_TO_ANSIBLE_OS_FAMILY: dict[str, str] = {
    "debian": "Debian",
    "ubuntu": "Debian",
    "opensuse": "Suse",
    "fedora": "RedHat",
}

# ansible_os_family -> the lowercase overlay key used inside each bundle in
# package-groups.json (mirrors roles/distro_packages/defaults/main.yml).
ANSIBLE_OS_FAMILY_TO_OVERLAY_KEY: dict[str, str] = {
    "Debian": "debian", "Suse": "suse", "RedHat": "redhat",
}


def ansible_os_family_of(doc: Template) -> str:
    distro: str = doc["os"].get("distro", "")
    try:
        return DISTRO_TO_ANSIBLE_OS_FAMILY[distro]
    except KeyError:
        die(f"no dotfiles ansible_os_family mapping for distro '{distro}'")


def die(msg: str) -> NoReturn:
    print(f"ivm: error: {msg}", file=sys.stderr)
    raise SystemExit(1)


# ---------- template loading / validation ----------

def load_yaml(path: Path) -> Template:
    try:
        import yaml  # PyYAML (ships with ansible-core; role ensures python3-yaml)
    except ImportError:
        die("PyYAML not found; install python3-yaml")
    if not path.is_file():
        die(f"template not found: {path}")
    loaded: Any = yaml.safe_load(path.read_text())
    if not isinstance(loaded, dict):
        die(f"template is not a mapping: {path}")
    return loaded


def validate_template(doc: Template, root: Path) -> None:
    """Validate a template dict against vm.schema.json (draft 2020-12)."""
    try:
        import jsonschema
    except ImportError:
        die("jsonschema not found; install python3-jsonschema")
    schema_path: Path = root / "vm.schema.json"
    if not schema_path.is_file():
        die(f"schema not found: {schema_path}")
    schema: dict[str, Any] = json.loads(schema_path.read_text())
    errors: list[ValidationError] = sorted(
        jsonschema.Draft202012Validator(schema).iter_errors(doc),
        key=lambda e: list(e.path),
    )
    if errors:
        loc: str = "/".join(str(p) for p in errors[0].path) or "(root)"
        die(f"template invalid at {loc}: {errors[0].message}")


def load_and_validate(template_name: str, root: Path) -> Template:
    doc: Template = load_yaml(root / "vm-templates" / f"{template_name}.yaml")
    validate_template(doc, root)
    return doc


# ---------- distro_packages bundle registry ----------

def load_package_groups(root: Path) -> dict[str, Any]:
    """Load package-groups.json (rendered at apply time from the distro_packages
    registry; see roles/incus_vm/tasks/install.yml)."""
    path: Path = root / "package-groups.json"
    if not path.is_file():
        die(f"package-groups.json not found: {path}; re-run `make apply-incus-vm`")
    loaded: Any = json.loads(path.read_text())
    if not isinstance(loaded, dict):
        die(f"package-groups.json is not a mapping: {path}")
    return loaded


def resolve_group(registry: dict[str, Any], group: str, ansible_os_family: str) -> list[str]:
    """A bundle resolves to `common + <ansible_os_family overlay>` (same rule as
    roles/distro_packages/tasks/main.yml, but for one family at a time)."""
    entry: Any = registry.get(group)
    if entry is None:
        die(f"unknown distro_package_group '{group}' "
            f"(not in package-groups.json; defined ones: {', '.join(sorted(registry))})")
    overlay_key: str = ANSIBLE_OS_FAMILY_TO_OVERLAY_KEY[ansible_os_family]
    common: list[str] = list(entry.get("common", []))
    overlay: list[str] = list(entry.get(overlay_key, []))
    return common + overlay


def resolve_packages(doc: Template, registry: dict[str, Any], ansible_os_family: str) -> list[str]:
    """Flatten the always-on baseline + the template's groups + its flat
    `distro_packages` into one install list, deduped (groups overlap the
    baseline, e.g. git/tmux), order preserved."""
    packages: list[str] = resolve_group(registry, BASELINE_GROUP, ansible_os_family)
    for group in doc.get("distro_package_groups", []):
        packages += resolve_group(registry, group, ansible_os_family)
    packages += doc.get("distro_packages", [])
    return list(dict.fromkeys(packages))


# ---------- command execution (dry-run aware) ----------

def run(cmd: list[str], *, dry_run: bool) -> None:
    """Run a mutating command, or just print it under --dry-run."""
    print("+ " + shlex.join(cmd), file=sys.stderr)
    if not dry_run:
        subprocess.run(cmd, check=True)


def capture(cmd: list[str]) -> str:
    """Run a read-only command and return stdout (empty on failure)."""
    result = subprocess.run(cmd, capture_output=True, text=True)
    return result.stdout if result.returncode == 0 else ""


def sh_expand(value: str, cwd: Path) -> str:
    """Expand a mount `host` value on the HOST, relative to cwd: handles
    `$(pwd)`, `$(xdg-user-dir ...)`, `$HOME`, `~`, and relative paths. The user
    authors these in their own template, so shell evaluation is intentional."""
    out: str = capture(["bash", "-c", f'cd {shlex.quote(str(cwd))} && printf %s {value}'])
    return out or value


# ---------- instance name ----------

def sanitize_incus_name(raw: str) -> str:
    name: str = re.sub(r"[^a-zA-Z0-9-]+", "-", raw).strip("-")
    name = re.sub(r"-{2,}", "-", name)
    if name and not name[0].isalnum():
        name = name.lstrip("-")
    return name[:MAX_NAME_LEN]


def default_instance_name(template_name: str, cwd: Path) -> str:
    # `ivm-` prefix so ivm-managed VMs are obvious at a glance in `incus list`.
    # Only the auto-generated default carries it; an explicit `--name` is left
    # untouched (the canonical "is this ours" check is the user.ivm_init_at_dir tag).
    rel: str = str(cwd)
    home: str = str(Path.home())
    if rel.startswith(home):
        rel = rel[len(home):]
    return sanitize_incus_name(f"ivm-{template_name}-{rel}")


def name_error(name: str, *, dry_run: bool) -> str | None:
    """Return an error message if `name` is unusable, else None."""
    if not INCUS_NAME_RE.match(name):
        return f"'{name}' is not a valid incus name ([a-zA-Z0-9-], starts alnum, <=63)"
    if not dry_run and instance_exists(name):
        return f"a VM named '{name}' already exists"
    return None


def instance_exists(name: str) -> bool:
    return subprocess.run(
        ["incus", "info", name], capture_output=True, text=True
    ).returncode == 0


def choose_instance_name(
    template_name: str, cwd: Path, given: str | None, *, dry_run: bool, assume_yes: bool
) -> str:
    """Pick the VM name: explicit arg, or prompt (default = long path-based),
    re-prompting on invalid/duplicate. `--yes`/`--dry-run` take the default."""
    default: str = default_instance_name(template_name, cwd)
    if given is not None:
        err: str | None = name_error(given, dry_run=dry_run)
        if err:
            die(err)
        return given
    if assume_yes or dry_run or not sys.stdin.isatty():
        if (err := name_error(default, dry_run=dry_run)) and not dry_run:
            die(f"default name unusable ({err}); pass an explicit name")
        return default
    while True:
        reply: str = input(f"VM name [{default}]: ").strip() or default
        err = name_error(reply, dry_run=dry_run)
        if err is None:
            return reply
        print(f"  {err}", file=sys.stderr)


# ---------- incus command builders ----------

def mem_to_gib(value: str) -> str:
    """`8G` -> `8GiB` (the template uses G; incus wants GiB)."""
    return value[:-1] + "GiB" if value.endswith("G") else value


def image_ref(os_block: dict[str, Any]) -> str:
    image: dict[str, Any] = os_block.get("image", {})
    source: str = image.get("source", "")
    uri: str = image.get("uri", "")
    if source == "incus":
        return f"images:{uri}"
    die(f"image source '{source}' not supported yet (phase: iso/virt-builder/windows)")


def launch_command(doc: Template, name: str, cwd: Path) -> list[str]:
    hw: dict[str, Any] = doc.get("hw", {})
    cmd: list[str] = ["incus", "launch", image_ref(doc["os"]), name, "--vm"]
    if "cpu" in hw:
        cmd += ["--config", f"limits.cpu={hw['cpu']}"]
    if "memory" in hw:
        cmd += ["--config", f"limits.memory={mem_to_gib(hw['memory'])}"]
    cmd += [
        "--config", "user.ansible-managed=true",
        "--config", "user.ansible-guest-os=linux",
        "--config", f"user.ivm_template={doc['template_name']}",
        "--config", f"user.ivm_init_at_dir={cwd}",
        # Record the dotfiles ansible_os_family so `overwrite-dotfiles` can pick the
        # right vm-rootfs/<family>/ subtree without re-reading the template.
        "--config", f"user.ivm_ansible_os_family={ansible_os_family_of(doc)}",
    ]
    if "disk" in hw:
        cmd += ["--device", f"root,size={mem_to_gib(hw['disk'])}"]
    return cmd


def mount_commands(doc: Template, name: str, cwd: Path) -> list[list[str]]:
    cmds: list[list[str]] = []
    for index, mount in enumerate(doc.get("mounts", [])):
        host: str = sh_expand(mount["host"], cwd)
        guest: str = sh_expand(mount["guest"], cwd)
        device: str = f"ivm_mount_{index}"
        args: list[str] = [
            "incus", "config", "device", "add", name, device, "disk",
            f"source={host}", f"path={guest}", "shift=true",
        ]
        if mount.get("ro"):
            args.append("readonly=true")
        cmds.append(args)
        # NOTE: `shadow` (mask subpaths) is phase 3.
    return cmds


def install_packages_script(ansible_os_family: str, packages: list[str]) -> str:
    """Per-family install with weak-deps/recommends OFF (the apt-min/zypper-min/
    dnf-min policy, applied to provisioning)."""
    pkgs: str = " ".join(packages)
    if ansible_os_family == "Debian":
        return ("export DEBIAN_FRONTEND=noninteractive\n"
                "apt-get update -qq\n"
                f"apt-get install --yes --no-install-recommends {pkgs}\n")
    if ansible_os_family == "Suse":
        return ("zypper --non-interactive refresh\n"
                f"zypper --non-interactive install --no-recommends {pkgs}\n")
    if ansible_os_family == "RedHat":
        return f"dnf install --assumeyes --setopt=install_weak_deps=False {pkgs}\n"
    die(f"no package-manager mapping for ansible_os_family '{ansible_os_family}'")


def update_packages_script(ansible_os_family: str) -> str:
    """Per-family 'refresh metadata + upgrade all installed packages'."""
    if ansible_os_family == "Debian":
        return ("export DEBIAN_FRONTEND=noninteractive\n"
                "apt-get update -qq\n"
                "apt-get upgrade --yes\n")
    if ansible_os_family == "Suse":
        return ("zypper --non-interactive refresh\n"
                "zypper --non-interactive update\n")
    if ansible_os_family == "RedHat":
        return "dnf upgrade --assumeyes\n"
    die(f"no package-manager mapping for ansible_os_family '{ansible_os_family}'")


def provision_script(doc: Template, registry: dict[str, Any]) -> str:
    """First-provision shell, run as root via `incus exec`: install packages
    (baseline + groups + flat), create `user`, set both shells to zsh, then run
    the template's `post_install_script` (also as root - it drops to `user` with
    `su - user -c '...'` for user-scoped bits)."""
    ansible_os_family: str = ansible_os_family_of(doc)
    packages: list[str] = resolve_packages(doc, registry, ansible_os_family)
    script: str = install_packages_script(ansible_os_family, packages)
    # `command -v zsh` not a hardcoded /bin/zsh: zsh lands in /usr/bin on
    # openSUSE/Fedora (usrmerge makes /bin/zsh work too, but don't rely on it).
    script += (
        'id user >/dev/null 2>&1 || useradd --create-home --shell "$(command -v zsh)" --uid 1000 user\n'
        'usermod --shell "$(command -v zsh)" user\n'
        'usermod --shell "$(command -v zsh)" root\n'
    )
    post_install_script: str = doc.get("post_install_script", "")
    if post_install_script:
        script += post_install_script if post_install_script.endswith("\n") else post_install_script + "\n"
    return script


def push_dotfiles_commands(ansible_os_family: str, name: str, root: Path) -> list[list[str]]:
    """Push the host-staged user/root dotfile trees (rendered at apply time by
    roles/_incus_guest_setup_dotfiles) into the guest. The staging is keyed by
    ansible_os_family (apt-min vs zypper-min vs dnf-min differ), so pick the subtree
    matching this VM's distro (init: from the template; overwrite-dotfiles: from
    the `user.ivm_ansible_os_family` tag)."""
    staging: Path = root / "vm-rootfs" / ansible_os_family
    return [
        ["incus", "file", "push", "--recursive", "--create-dirs",
         "--uid", "1000", "--gid", "1000", str(staging / "home/user"), f"{name}/home/"],
        ["incus", "file", "push", "--recursive", "--create-dirs",
         "--uid", "0", "--gid", "0", str(staging / "root"), f"{name}/"],
    ]


def wait_ready(name: str, *, dry_run: bool) -> None:
    if dry_run:
        print(f"+ (wait until `incus exec {name} -- true` succeeds)", file=sys.stderr)
        return
    deadline: float = time.monotonic() + 90
    while time.monotonic() < deadline:
        if subprocess.run(["incus", "exec", name, "--", "true"],
                          capture_output=True).returncode == 0:
            return
        time.sleep(1)
    die(f"VM '{name}' did not become ready within 90s")


def resolve_vm_by_cwd(cwd: Path, *, dry_run: bool) -> str:
    """Find the VM whose user.ivm_init_at_dir == cwd."""
    if dry_run:
        return "<vm-resolved-from-cwd>"
    out: str = capture(["incus", "list", "--format", "csv", "--columns", "n,config:user.ivm_init_at_dir"])
    for line in out.splitlines():
        vm_name, _, init_dir = line.partition(",")
        if init_dir == str(cwd):
            return vm_name
    die(f"no VM is bound to {cwd}; run `ivm init <template>` here first")


def vm_is_running(name: str) -> bool:
    return capture(
        ["incus", "list", name, "--format", "csv", "--columns", "s"]
    ).strip().lower().startswith("running")


def ensure_up(name: str, *, dry_run: bool) -> None:
    """Start the VM if stopped, then block until it accepts `incus exec`."""
    if dry_run:
        print(f"+ (ensure {name} is running)", file=sys.stderr)
        return
    if not instance_exists(name):
        die(f"VM '{name}' does not exist; run `ivm init <template>` here first")
    if not vm_is_running(name):
        run(["incus", "start", name], dry_run=dry_run)
    wait_ready(name, dry_run=dry_run)


def vm_ansible_os_family(name: str, *, dry_run: bool) -> str:
    """Read the `user.ivm_ansible_os_family` tag set at init (picks the dotfiles subtree)."""
    if dry_run:
        return "<os-family-from-tag>"
    family: str = capture(["incus", "config", "get", name, "user.ivm_ansible_os_family"]).strip()
    if not family:
        die(f"{name} has no `user.ivm_ansible_os_family` tag; re-create it with `ivm init`")
    return family


# ---------- subcommands ----------

def confirm_create(doc: Template, name: str, cwd: Path, *, assume_yes: bool, dry_run: bool) -> None:
    hw: dict[str, Any] = doc.get("hw", {})
    print("", file=sys.stderr)
    print("About to CREATE a new Incus VM:", file=sys.stderr)
    print(f"  name:     {name}", file=sys.stderr)
    print(f"  template: {doc['template_name']}  (cwd: {cwd})", file=sys.stderr)
    print(f"  image:    {image_ref(doc['os'])}", file=sys.stderr)
    print(f"  hw:       cpu={hw.get('cpu')} memory={hw.get('memory')} disk={hw.get('disk')}", file=sys.stderr)
    print("", file=sys.stderr)
    if assume_yes or dry_run:
        return
    if not sys.stdin.isatty():
        die(f"refusing to create {name} without a TTY; pass --yes")
    if input("Create this VM? [y/N] ").strip().lower() not in ("y", "yes"):
        die("aborted; no VM created")


def cmd_init(template_name: str, given_name: str | None, root: Path, *,
             assume_yes: bool, dry_run: bool) -> None:
    cwd: Path = Path.cwd()
    doc: Template = load_and_validate(template_name, root)
    if doc["os"]["type"] != "linux":
        die(f"`init` supports linux only for now; '{template_name}' is os.type={doc['os']['type']}")
    registry: dict[str, Any] = load_package_groups(root)
    name: str = choose_instance_name(template_name, cwd, given_name,
                                     dry_run=dry_run, assume_yes=assume_yes)
    confirm_create(doc, name, cwd, assume_yes=assume_yes, dry_run=dry_run)
    run(launch_command(doc, name, cwd), dry_run=dry_run)
    wait_ready(name, dry_run=dry_run)
    for mount_cmd in mount_commands(doc, name, cwd):
        run(mount_cmd, dry_run=dry_run)
    run(["incus", "exec", name, "--", "bash", "-ec", provision_script(doc, registry)], dry_run=dry_run)
    for push_cmd in push_dotfiles_commands(ansible_os_family_of(doc), name, root):
        run(push_cmd, dry_run=dry_run)
    print(f"==> {name} ready. Enter with: ivm shell", file=sys.stderr)


def cmd_shell(root: Path, *, as_root: bool, dry_run: bool) -> None:
    name: str = resolve_vm_by_cwd(Path.cwd(), dry_run=dry_run)
    ensure_up(name, dry_run=dry_run)
    if as_root:
        cmd: list[str] = ["incus", "exec", "--env", "HOME=/root", "--env", "USER=root",
                          name, "--", "zsh"]
    else:
        cmd = ["incus", "exec", "--user", "1000", "--group", "1000",
               "--env", "HOME=/home/user", "--env", "USER=user", name, "--", "zsh"]
    run(cmd, dry_run=dry_run)


def cmd_start(*, dry_run: bool) -> None:
    name: str = resolve_vm_by_cwd(Path.cwd(), dry_run=dry_run)
    ensure_up(name, dry_run=dry_run)
    print(f"==> {name} running.", file=sys.stderr)


def cmd_stop(*, dry_run: bool) -> None:
    name: str = resolve_vm_by_cwd(Path.cwd(), dry_run=dry_run)
    if dry_run or vm_is_running(name):
        run(["incus", "stop", name], dry_run=dry_run)
    else:
        print(f"==> {name} already stopped.", file=sys.stderr)


def confirm_delete(name: str, *, assume_yes: bool, dry_run: bool) -> None:
    print("", file=sys.stderr)
    print("About to PERMANENTLY DELETE this Incus VM (config + disk + snapshots):", file=sys.stderr)
    print(f"  name:     {name}", file=sys.stderr)
    print("This cannot be undone.", file=sys.stderr)
    print("", file=sys.stderr)
    if assume_yes or dry_run:
        return
    if not sys.stdin.isatty():
        die(f"refusing to delete {name} without a TTY; pass --yes")
    if input("Delete this VM? [y/N] ").strip().lower() not in ("y", "yes"):
        die("aborted; VM not deleted")


def cmd_delete(*, assume_yes: bool, dry_run: bool) -> None:
    name: str = resolve_vm_by_cwd(Path.cwd(), dry_run=dry_run)
    if not dry_run and not instance_exists(name):
        print(f"==> {name} does not exist; nothing to delete.", file=sys.stderr)
        return
    confirm_delete(name, assume_yes=assume_yes, dry_run=dry_run)
    run(["incus", "delete", "--force", name], dry_run=dry_run)


def cmd_overwrite_dotfiles(root: Path, *, dry_run: bool) -> None:
    """Re-push the host-staged dotfiles into an existing VM (no re-provision)."""
    name: str = resolve_vm_by_cwd(Path.cwd(), dry_run=dry_run)
    ensure_up(name, dry_run=dry_run)
    for push_cmd in push_dotfiles_commands(vm_ansible_os_family(name, dry_run=dry_run), name, root):
        run(push_cmd, dry_run=dry_run)
    print(f"==> dotfiles re-pushed into {name} (/home/user + /root).", file=sys.stderr)


# Opt into IN-GUEST privilege escalation. Default provisioning gives `user` NO
# sudo; this sets root's password and enables `user` sudo gated by THAT password
# (`Defaults:user rootpw`), so a `user` process that doesn't know it still can't
# escalate. The operator's `shell-root` path is host-socket auth, unaffected.
_SUDOERS_USER: str = "Defaults:user rootpw\nuser ALL=(ALL) ALL\n"


def cmd_set_root_password(*, dry_run: bool) -> None:
    name: str = resolve_vm_by_cwd(Path.cwd(), dry_run=dry_run)
    ensure_up(name, dry_run=dry_run)
    if dry_run:
        print("+ (prompt for root password, then `incus exec <vm> -- chpasswd` via "
              "stdin + write /etc/sudoers.d/user)", file=sys.stderr)
        return
    root_password: str = getpass.getpass(f"New root password for {name}: ")
    if not root_password:
        die("empty password rejected")
    if root_password != getpass.getpass("Confirm: "):
        die("passwords do not match")
    # Password travels via stdin, never argv - so it is not visible in the
    # guest's process list. `chpasswd` reads `user:password` lines.
    subprocess.run(["incus", "exec", name, "--", "chpasswd"],
                   input=f"root:{root_password}\n", text=True, check=True)
    subprocess.run(
        ["incus", "exec", name, "--", "bash", "-ec",
         "cat > /etc/sudoers.d/user <<'EOF'\n" + _SUDOERS_USER + "EOF\n"
         "chmod 0440 /etc/sudoers.d/user\n"
         "visudo --check --file=/etc/sudoers.d/user"],
        check=True)
    print(f"==> root password set; `user` may now sudo (prompts for the root password).",
          file=sys.stderr)


def cmd_unset_root_password(*, dry_run: bool) -> None:
    name: str = resolve_vm_by_cwd(Path.cwd(), dry_run=dry_run)
    ensure_up(name, dry_run=dry_run)
    run(["incus", "exec", name, "--", "bash", "-ec",
         "rm -f /etc/sudoers.d/user\npasswd --lock root >/dev/null"], dry_run=dry_run)
    print("==> sudoers removed and root password re-locked; back to locked-down default.",
          file=sys.stderr)


def cmd_update(*, dry_run: bool) -> None:
    """Refresh metadata + upgrade all packages in the VM (per-family pkg-mgr)."""
    name: str = resolve_vm_by_cwd(Path.cwd(), dry_run=dry_run)
    ensure_up(name, dry_run=dry_run)
    if dry_run:
        print("+ (incus exec <vm> -- upgrade all packages via the VM's ansible_os_family "
              "package manager [apt/zypper/dnf])", file=sys.stderr)
        return
    ansible_os_family: str = vm_ansible_os_family(name, dry_run=dry_run)
    run(["incus", "exec", name, "--", "bash", "-ec", update_packages_script(ansible_os_family)],
        dry_run=dry_run)


def cmd_env(template_name: str, root: Path) -> None:
    """Load + validate a template and print its resolved configuration."""
    doc: Template = load_and_validate(template_name, root)
    os_block: dict[str, Any] = doc.get("os", {})
    image: dict[str, Any] = os_block.get("image", {})
    hw: dict[str, Any] = doc.get("hw", {})
    mounts: list[dict[str, Any]] = doc.get("mounts", [])
    print(f"template_name : {doc['template_name']}")
    print(f"os.type       : {os_block.get('type')}")
    if os_block.get("type") == "linux":
        print(f"os.distro     : {os_block.get('distro')}")
    print(f"os.image      : {image.get('source')}:{image.get('uri')}")
    print(f"hw            : cpu={hw.get('cpu')} memory={hw.get('memory')} disk={hw.get('disk')}")
    for m in mounts:
        ro: str = " (ro)" if m.get("ro") else ""
        shadow: str = f"  shadow={m['shadow']}" if m.get("shadow") else ""
        print(f"mount         : {m['host']} -> {m['guest']}{ro}{shadow}")
    groups: list[str] = doc.get("distro_package_groups", [])
    packages: list[str] = doc.get("distro_packages", [])
    if groups:
        print(f"pkg groups    : {', '.join(groups)}")
    if packages:
        print(f"packages      : {', '.join(packages)}")
    if os_block.get("type") == "linux":
        ansible_os_family: str = ansible_os_family_of(doc)
        resolved: list[str] = resolve_packages(doc, load_package_groups(root), ansible_os_family)
        print(f"-> resolved   : ({ansible_os_family}) {' '.join(resolved)}")


def cmd_stub(subcommand: str) -> NoReturn:
    die(f"`{subcommand}` is not implemented yet (see IMPLEMENTATION_PLAN.md phases).")


# ---------- CLI ----------

def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog="ivm", description="incus VM launcher engine")
    parser.add_argument("--root", type=Path, default=DEFAULT_ROOT,
                        help=f"install root (schema + vm-templates + vm-rootfs). Default: {DEFAULT_ROOT}")
    parser.add_argument("--dry-run", action="store_true",
                        help="print the incus commands that would run, without executing")
    parser.add_argument("-y", "--yes", action="store_true",
                        help="skip confirmation prompts / name prompt (use the default name)")
    sub = parser.add_subparsers(dest="subcommand", required=True)

    p_init: argparse.ArgumentParser = sub.add_parser("init", help="create a VM from a template")
    p_init.add_argument("template", help="template id (file in vm-templates/)")
    p_init.add_argument("name", nargs="?", help="VM instance name (skips the prompt)")

    for name in CWD_RESOLVED:
        sp: argparse.ArgumentParser = sub.add_parser(name, help="(cwd-resolved)")
        if name == "env":
            sp.add_argument("template", help="template id")
        if name == "snapshot":
            sp.add_argument("snapshot_args", nargs=argparse.REMAINDER)
    return parser


def main() -> None:
    args: argparse.Namespace = build_parser().parse_args()
    root: Path = args.root
    if args.subcommand == "init":
        cmd_init(args.template, args.name, root, assume_yes=args.yes, dry_run=args.dry_run)
    elif args.subcommand == "env":
        cmd_env(args.template, root)
    elif args.subcommand in ("shell", "shell-user"):
        cmd_shell(root, as_root=False, dry_run=args.dry_run)
    elif args.subcommand == "shell-root":
        cmd_shell(root, as_root=True, dry_run=args.dry_run)
    elif args.subcommand == "start":
        cmd_start(dry_run=args.dry_run)
    elif args.subcommand == "stop":
        cmd_stop(dry_run=args.dry_run)
    elif args.subcommand == "delete":
        cmd_delete(assume_yes=args.yes, dry_run=args.dry_run)
    elif args.subcommand == "overwrite-dotfiles":
        cmd_overwrite_dotfiles(root, dry_run=args.dry_run)
    elif args.subcommand == "set-root-password":
        cmd_set_root_password(dry_run=args.dry_run)
    elif args.subcommand == "unset-root-password":
        cmd_unset_root_password(dry_run=args.dry_run)
    elif args.subcommand == "update":
        cmd_update(dry_run=args.dry_run)
    else:
        cmd_stub(args.subcommand)


if __name__ == "__main__":
    main()
