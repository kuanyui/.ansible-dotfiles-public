# {{ ansible_managed }}
#
# bash completion for `{{ launcher_name }}` (incus_vm launcher).
# Eager-sourced from ~/.bashrc.

_{{ launcher_name | replace('-', '_') }}() {
    local cur="${COMP_WORDS[COMP_CWORD]}"
    local prev="${COMP_WORDS[COMP_CWORD-1]}"
    local script="{{ incus_vm_bin_dir }}/{{ launcher_name }}"

    # Subcommand of `snapshot` (e.g. `v-foo snapshot c<TAB>` -> `create`).
    if [[ "${COMP_WORDS[1]:-}" == "snapshot" ]] && [[ "$COMP_CWORD" == 2 ]]; then
        mapfile -t COMPREPLY < <(compgen -W "create list restore delete help" -- "$cur")
        return
    fi

    # Top-level subcommand: parse the launcher's dispatch case.
    local subs
    subs="$(perl -ne 'if (/^\s*([a-zA-Z_][\w-]*(\|[a-zA-Z_][\w-]*)+)\)/) { print $1; exit }' "$script" 2>/dev/null | tr '|' ' ')"
    mapfile -t COMPREPLY < <(compgen -W "$subs" -- "$cur")
}
complete -F _{{ launcher_name | replace('-', '_') }} {{ launcher_name }}
