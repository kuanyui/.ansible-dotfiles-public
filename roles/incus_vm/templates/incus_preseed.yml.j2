# {{ ansible_managed }}
#
# Preseed for `incus admin init`. Minimal but functional:
#   - `default` storage pool, backend = `{{ incus_storage_pool_driver }}`
#   - `incusbr0` bridge with auto IPv4/IPv6 so VMs get network out of the box
#   - default profile attaches `eth0` -> incusbr0 + root disk -> default pool
#
# Storage pool: see `roles/incus_vm/defaults/main/incus_host_install.yml` for the three
# `incus_storage_pool_{driver,source,size}` vars. `host_vars/<hostname>.yml`
# is the typical place to override per-machine.
config: {}
networks:
  - name: incusbr0
    type: bridge
    config:
      ipv4.address: auto
      ipv6.address: auto
storage_pools:
  - name: default
    driver: {{ incus_storage_pool_driver }}
{# `_incus_effective_pool_*` are computed in tasks/incus_host_install.yml: for a #}
{# role-built btrfs loop file they become the loop MOUNT POINT + no size (incus #}
{# gets an existing btrfs FS); otherwise they pass the raw config through. #}
{% if _incus_effective_pool_source or _incus_effective_pool_size %}
    config:
{% if _incus_effective_pool_source %}
      source: {{ _incus_effective_pool_source }}
{% endif %}
{% if _incus_effective_pool_size %}
      size: {{ _incus_effective_pool_size }}
{% endif %}
{% endif %}
profiles:
  - name: default
    devices:
      eth0:
        name: eth0
        network: incusbr0
        type: nic
      root:
        path: /
        pool: default
        type: disk
projects: []
cluster: null
