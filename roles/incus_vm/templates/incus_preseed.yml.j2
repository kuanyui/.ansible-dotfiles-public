# {{ ansible_managed }}
#
# Preseed for `incus admin init`. Minimal but functional:
#   - `default` storage pool, backend = `{{ incus_storage_pool_driver }}`
#   - `incusbr0` bridge with auto IPv4/IPv6 so VMs get network out of the box
#   - default profile attaches `eth0` -> incusbr0 + root disk -> default pool
#
# Storage pool: see `roles/incus_vm/defaults/main/host_setup.yml` for the three
# `incus_storage_pool_{driver,source,size}` vars. `host_vars/<hostname>.yml`
# is the typical place to override per-machine.
config: {}
networks:
  - name: incusbr0
    type: bridge
    config:
      ipv4.address: auto
      ipv6.address: auto
storage_pools:
  - name: default
    driver: {{ incus_storage_pool_driver }}
{% if incus_storage_pool_source or incus_storage_pool_size %}
    config:
{% if incus_storage_pool_source %}
      source: {{ incus_storage_pool_source }}
{% endif %}
{% if incus_storage_pool_size %}
      size: {{ incus_storage_pool_size }}
{% endif %}
{% endif %}
profiles:
  - name: default
    devices:
      eth0:
        name: eth0
        network: incusbr0
        type: nic
      root:
        path: /
        pool: default
        type: disk
projects: []
cluster: null
