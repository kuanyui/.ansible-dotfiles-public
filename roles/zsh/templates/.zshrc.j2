alias set-lang-to-en='export LC_ALL=en_US.utf8; export LC_CTYPE=en_US.utf8; export LC_MESSAGES=en_US.utf8; export LANG=en_US.utf8; export LANGUAGE=en_US.utf8;'
alias set-lang-to-ja='export LC_ALL=ja_JP.utf8 LC_CTYPE=ja_JP.utf8 LC_MESSAGES=ja_JP.utf8 LANG=ja_JP.utf8 LANGUAGE=ja_JP.utf8;'

alias cccp='su -'  # Because `su -` is so fucking difficult to type. I'm extremely lazy.

function emacsx() {
    ('emacs' $@ > /dev/null 2>&1 &)
}

function dotfiles-public-update () {
    cd ~/.dotfiles-public/{{ 'root' if is_root else 'user' }}/ &&
    git fetch --all &&
    git reset --hard origin/master &&
}

{# `override_os_family` is an OPTIONAL caller-provided override of the
   gather-time `ansible_facts['os_family']`. Host-side callers
   (`playbooks/user.yml` etc.) don't set it, so the default kicks in -
   behavior unchanged. `roles/incus_agents` sets it to `Debian` when
   staging `.zshrc` for VM consumption, because the VM is always
   Debian 13 even when the HOST running ansible is openSUSE / Fedora /
   etc. (without this override, the host's `os_family` would leak into
   the VM's .zshrc and the Debian-only `apt-install-without-recommends`
   helper below would silently disappear for non-Debian hosts).
#}
{% if (override_os_family | default(ansible_facts['os_family'])) == 'Debian' %}
function apt-install-without-recommends () {
    {% if not is_root %}sudo {% endif %}apt install --no-install-recommends $@
}

function apt-install-without-recommends-diff-dry-run () {
    if [ $UID -eq 0 ]; then
        echo "Please run as non-root for GUI (meld)"
        diff --width=$COLUMNS --suppress-common-lines --side-by-side --color <(apt-get install --dry-run $@) <(apt-get install --dry-run --no-install-recommends $@)
    else
        meld <(apt-get install --dry-run $@) <(apt-get install --dry-run --no-install-recommends $@)
    fi
}
{% endif %}
