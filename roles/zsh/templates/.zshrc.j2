### ============================================
### Prompts
### ============================================
# If not running interactively, don't do anything
[ -z "$PS1" ] && return

### ============================================
### Env vars for ~/.centralized-lang-pkgs/ (npm / pip / pipx / cargo / go)
### ============================================
# Deployed by `roles/centralize_lang_pkgs_dir/` (opt-in). Harmless no-op when the
# file is absent.
[ -f "${HOME}/.centralized-lang-pkgs/centralized-lang-pkgs.env.sh" ] && . "${HOME}/.centralized-lang-pkgs/centralized-lang-pkgs.env.sh"

### ============================================
### Version managers: nvm / gvm (opt-in via `ivm provision dev_nvm` / `dev_gvm`)
### ============================================
# Sourced HERE (interactive rc), not ~/.zshenv, so they load only for interactive shells -
# and survive `ivm`'s dotfiles push because this template IS the pushed file. Each line is a
# harmless no-op when the tool is absent (the `[ -s ... ]` guard).
export NVM_DIR="${HOME}/.nvm"
[ -s "${NVM_DIR}/nvm.sh" ] && . "${NVM_DIR}/nvm.sh"
[ -s "${HOME}/.gvm/scripts/gvm" ] && . "${HOME}/.gvm/scripts/gvm"

