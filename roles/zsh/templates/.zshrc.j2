### ============================================
### Completions
### ============================================
# Pick up ansible-managed completion functions. Each managed role drops `_<cmd>`
# files under its own `~/.local/share/ansible-managed/<role>/zsh-completions/`
# subdir (e.g. `vm-podman/zsh-completions/_pvm`,
# `vm-incus/zsh-completions/_ivm`); the glob auto-discovers across all
# roles, so adding a new role doesn't require editing this file. Must run
# BEFORE `compinit` for new fpath entries to be scanned. `(N)` is null-glob
# (no error if zero matches). Project-private path (not the distro-standard
# `~/.local/share/zsh/site-functions/`) so cross-distro behavior is identical.
fpath=(${HOME}/.local/share/ansible-managed/*/zsh-completions(N) $fpath)

{{ shared_zsh_compinit_and_zstyles }}
### ============================================
### Shell-init snippets (ansible-managed)
### ============================================
# Each managed role may drop shell function / wrapper snippets under its own
# `~/.local/share/ansible-managed/<role>/shell-init/` subdir (e.g.
# `vm-incus/shell-init/ivm.sh` defines the `ivm()` wrapper so `ivm cd <vm>` can change
# THIS interactive shell's directory - a child process cannot). Sourced here so the
# functions exist in the shell. Same per-role-subdir + glob auto-discovery as the
# completions above, so a new role needs no edit here. `(N)` is null-glob (no error if none).
for _ansible_managed_shell_init in ${HOME}/.local/share/ansible-managed/*/shell-init/*(N); do
  source "$_ansible_managed_shell_init"
done
unset _ansible_managed_shell_init
