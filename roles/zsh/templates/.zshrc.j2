function dotfiles-public-update () {
    cd ~/.dotfiles-public/{{ 'root' if is_root else 'user' }}/ &&
    git fetch --all &&
    git reset --hard origin/master &&
}

{# `override_os_family` is an OPTIONAL caller-provided override of the
   gather-time `ansible_facts['os_family']`. Host-side callers
   (`playbooks/user.yml` etc.) don't set it, so the default kicks in -
   behavior unchanged. `roles/vm_incus`'s dotfiles staging
   (`tasks/_stage_family.yml`) sets it per TARGET family (Debian / Suse /
   RedHat) when staging `.zshrc` for VM consumption, because the guest's
   distro may differ from the HOST running ansible (e.g. openSUSE host,
   Debian guest) - without this override the host's `os_family` would leak
   into the VM's .zshrc and pick the wrong min-install helper
   (`apt-min` / `zypper-min` / `dnf-min`).
#}
{% set _effective_os_family = override_os_family | default(ansible_facts['os_family']) %}
{% if _effective_os_family == 'Debian' %}
# `apt-min`: install without recommended packages (the no-recommends shortcut).
alias apt-min='{% if not is_root %}sudo {% endif %}apt install --no-install-recommends'

# `apt-min-diff-dry-run`: preview what the recommends would add, by diffing a
# normal dry-run against a `--no-install-recommends` dry-run.
function apt-min-diff-dry-run () {
    if [ $UID -eq 0 ]; then
        echo "Please run as non-root for GUI (meld)"
        diff --width=$COLUMNS --suppress-common-lines --side-by-side --color <(apt-get install --dry-run $@) <(apt-get install --dry-run --no-install-recommends $@)
    else
        meld <(apt-get install --dry-run $@) <(apt-get install --dry-run --no-install-recommends $@)
    fi
}
{% elif _effective_os_family == 'Suse' %}
# `zypper-min`: install without recommended packages (the no-recommends shortcut).
alias zypper-min='{% if not is_root %}sudo {% endif %}zypper install --no-recommends'
{% elif _effective_os_family == 'RedHat' %}
# `dnf-min`: install without weak deps (dnf's equivalent of no-recommends).
alias dnf-min='{% if not is_root %}sudo {% endif %}dnf install --setopt=install_weak_deps=False'
{% endif %}
### ============================================
### Plugins - prefer the distro package under `/usr/share`, else the pinned
### vendored copy under `~/.local/share/ansible-managed/zsh/` (deployed by
### `roles/zsh` from `files/`; provenance table in that role's README).
### openSUSE packages none of these, so there it is always the vendored copy.
### ============================================
_ansible_managed_zsh_dir="${HOME}/.local/share/ansible-managed/zsh"

# autosuggestions: as you type, suggests the rest of the line in gray from
# history; press right-arrow / End to accept.
if [ -f /usr/share/zsh-autosuggestions/zsh-autosuggestions.zsh ]; then
        source /usr/share/zsh-autosuggestions/zsh-autosuggestions.zsh
elif [ -f "${_ansible_managed_zsh_dir}/zsh-autosuggestions/zsh-autosuggestions.zsh" ]; then
        source "${_ansible_managed_zsh_dir}/zsh-autosuggestions/zsh-autosuggestions.zsh"
fi

# history-substring-search: type a fragment, then Up / Down cycles only the
# history lines that CONTAIN it (substring, not prefix). No distro packages it,
# so it is always the vendored copy. bindkey must run AFTER sourcing (the plugin
# defines the up/down ZLE widgets); bind both the normal (`^[[A`) and the
# application-mode (`^[OA`) cursor-key codes so it works across terminals.
if [ -f "${_ansible_managed_zsh_dir}/zsh-history-substring-search/zsh-history-substring-search.zsh" ]; then
        source "${_ansible_managed_zsh_dir}/zsh-history-substring-search/zsh-history-substring-search.zsh"
        bindkey '^[[A' history-substring-search-up
        bindkey '^[OA' history-substring-search-up
        bindkey '^[[B' history-substring-search-down
        bindkey '^[OB' history-substring-search-down
fi

### ============================================
### Syntax Highlighting - colors the command line as you type (valid command
### green, unknown red, quotes / paths highlighted).
### [IMPORTANT] keep this LAST (it wraps the ZLE widgets set up above).
### ============================================
if [ -f /usr/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh ]; then
        source /usr/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh
elif [ -f "${_ansible_managed_zsh_dir}/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh" ]; then
        source "${_ansible_managed_zsh_dir}/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"
fi
{% if not is_root %}

# PATH for pipx
PATH="${PATH}:${HOME}/.local/bin"
{% endif %}
