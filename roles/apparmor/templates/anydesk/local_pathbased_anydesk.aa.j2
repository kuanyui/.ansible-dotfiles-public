abi <abi/5.0>,
#include <tunables/global>

# THIS_FILE_IS_MANAGED_BY_ANSIBLE__DO_NOT_EDIT_MANUALLY
# AnyDesk AppArmor profile - /etc/apparmor.d/local_pathbased_anydesk
# Source template mtime: {{ (lookup('pipe', 'stat -c %y ' ~ template_fullpath))[:19] }}
#
# Attaches to any binary named "anydesk" at any path - covers portable (non-installed) usage.
#
# Draft - put in complain mode first to capture missing paths:
#   sudo aa-complain /etc/apparmor.d/local_pathbased_anydesk

profile local_pathbased_anydesk /**/anydesk {
    #include <abstractions/base>
    #include <abstractions/nameservice>
    #include <abstractions/fonts>

    #include <abstractions/local_mixin_audio_probe>
    #include <abstractions/local_mixin_gpu>
    #include <abstractions/local_mixin_gtk>
    #include <abstractions/local_mixin_sysinfo>
    #include <abstractions/local_mixin_tmpdir>
    #include <abstractions/local_mixin_deny_keyrings>
    #include <abstractions/local_mixin_deny_probably_credentials>
    #include <abstractions/local_mixin_deny_persistent_attack>
    #include <abstractions/local_mixin_network_app>
    #include <abstractions/local_mixin_kernel_surface_general_app>
    #include <abstractions/local_mixin_deny_mounted_external_media>
    #include <abstractions/local_mixin_gui_wayland>
    # X11 included UNCONDITIONALLY (not behind apparmor_allow_x11): AnyDesk needs libxtest
    # (input injection) + libxdamage (screen capture) even in Wayland sessions; XWayland
    # typically provides /tmp/.X11-unix/X0.
    #include <abstractions/local_mixin_gui_x11>

    # MIT-SHM extension (fast pixmap transfer over shared memory). AnyDesk-specific, kept
    # inline; gated behind apparmor_allow_x11.
{% if apparmor_allow_x11 %}
    owner /tmp/.X11-unix-lock rw,
{% endif %}

    # D-Bus (desktop notifications)
    owner /run/user/*/bus rw,

    # Input devices - needed to inject keyboard/mouse when being remotely controlled
    /dev/input/ r,
    /dev/input/event* rw,
    /dev/uinput rw,

    # Shared memory
    owner /dev/shm/** rwk,

    # Process self-inspection
    owner @{PROC}/@{pid}/ r,
    owner @{PROC}/@{pid}/** r,

    # SSL certificate verification
    /etc/ssl/{,**} r,

    # AnyDesk config and runtime data (portable run: stored in ~/.anydesk/)
    owner @{HOME}/.anydesk/ rw,
    owner @{HOME}/.anydesk/** rwkl,

    # Polkit action file (read-only; needed even without the system service)
    /usr/share/polkit-1/actions/com.anydesk.anydesk.policy r,

}
