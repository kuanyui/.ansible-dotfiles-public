# Managed by Ansible - do not edit manually
# Firefox common AppArmor rules (abstraction included by attachmentless profiles) - /etc/apparmor.d/abstractions/local_base_firefox
# Source template mtime: {{ (lookup('pipe', 'stat -c %y ' ~ template_fullpath))[:19] }}

    #include <abstractions/base>
    #include <abstractions/nameservice>
    #include <abstractions/fonts>
    #include <abstractions/dbus-session-strict>

    #include <abstractions/local_mixin_kernel_surface_browser>
    #include <abstractions/local_mixin_sysinfo>
    #include <abstractions/local_mixin_gpu>
    #include <abstractions/local_mixin_audio>
    #include <abstractions/local_mixin_gtk>
    #include <abstractions/local_mixin_tmpdir>
    #include <abstractions/local_mixin_xdg_dir_pictures_screenshots>
    #include <abstractions/local_mixin_xdg_dir_downloads>
    #include <abstractions/local_mixin_deny_keyrings>
    #include <abstractions/local_mixin_deny_probably_credentials>
    #include <abstractions/local_mixin_deny_persistent_attack>
    #include <abstractions/local_mixin_personal_dirs__for__web_browser>
    #include <abstractions/local_mixin_deny_mounted_external_media>

    # Allow Firefox to execute itself, crash reporter, and shell utilities used during startup
    # ix (inherit execute) - child processes inherit this profile instead of transitioning to a new one
    # Px (profile execute, scrub env) - transition to a named profile with environment scrubbed
    /usr/lib*/firefox/* ix,
    /usr/bin/basename ix,
    /usr/bin/expr ix,
    /dev/tty rw,

    # Glycin image loading - gly-hdl-loader runs under this profile (ix), then execs bwrap
    # which transitions to local_attachmentless_glycin (Px, non-stacked). Security boundary
    # is bwrap's mount namespace: only what bwrap bind-mounts into the sandbox is visible to
    # the decoder, regardless of what local_attachmentless_glycin permits.
    #include <abstractions/local_mixin_glycin>
    /usr/bin/bwrap Px -> local_attachmentless_glycin,

    # User/group namespace ID mapping - needed by bwrap for user namespace setup
    /proc/sys/kernel/overflowuid r,
    /proc/sys/kernel/overflowgid r,

    # Process self-inspection (also used by crashreporter)
    # owner restricts reads to processes owned by the same user
    owner @{PROC}/@{pid}/ r,
    owner @{PROC}/@{pid}/** r,
    owner @{PROC}/@{pid}/oom_score_adj w,
    owner @{PROC}/@{pid}/uid_map w,      # Firefox content process sandbox: write UID mapping for user namespace
    owner @{PROC}/@{pid}/gid_map w,      # Firefox content process sandbox: write GID mapping for user namespace
    owner @{PROC}/@{pid}/setgroups w,    # Firefox content process sandbox: must be written before gid_map
    deny @{PROC}/@{pid}/mem rwklx,       # direct process memory access
    deny @{PROC}/@{pid}/environ r,       # process environment variables (may contain secrets)
    deny @{PROC}/@{pid}/pagemap r,       # virtual-to-physical memory mapping (exploit aid)

    # Content-process sandbox privileges (capability sys_admin / sys_chroot / sys_ptrace +
    # userns create) are centralised in <abstractions/local_mixin_kernel_surface_browser>,
    # included at the top of this abstraction.

    /etc/sysconfig/proxy r,                  # openSUSE system-wide proxy settings
    /usr/share/mozilla/extensions/{,**} r,   # system-wide Firefox extensions
    /usr/share/myspell/{,**} r,              # spell check dictionaries

    # Wayland proxy socket
    owner /run/user/*/wayland-proxy-* rw,

    # ICE (Inter-Client Exchange) auth for X11 - Firefox probes for this even under Wayland
    owner /run/user/*/iceauth_* r,

{% if apparmor_allow_x11 %}
    # X11 auth
    owner /run/user/*/xauth_* r,
{% endif %}

    # Allow read-only access to shared Firefox files
    owner @{HOME}/.mozilla/firefox/profiles.ini r,
    owner @{HOME}/.mozilla/firefox/installs.ini r,
    owner "@{HOME}/.mozilla/firefox/Pending Pings{/,/**}" rw,

    # Deny Firefox's cross-profile group database (introduced in Firefox 138) - intentional,
    # as it is a shared store across profiles and undermines per-profile isolation
    deny "@{HOME}/.mozilla/firefox/Profile Groups/" mrwklx,
    deny "@{HOME}/.mozilla/firefox/Profile Groups/**" mrwklx,

    # Crash reports - shared path across all profiles
    owner "@{HOME}/.mozilla/firefox/Crash Reports/" rw,
    owner "@{HOME}/.mozilla/firefox/Crash Reports/**" rwk,

    # MPRIS media control integration - shared directory across all profiles
    owner @{HOME}/.mozilla/firefox/firefox-mpris/ rw,
    owner @{HOME}/.mozilla/firefox/firefox-mpris/** rwk,

    # XDG cross-app recents - GTK file dialog reads recently-used.xbel on
    # every open/save to populate its "Recently Used" tab. The file is a
    # SHARED log of every recent-file event across every GTK / xdg-utils
    # app on the system (filenames + paths + which app opened them) -
    # exactly what an isolated browser must not see. `deny` (NOT `audit
    # deny`) silences the spam from GTK probing it on each dialog open.
    deny owner @{HOME}/.local/share/recently-used.xbel r,

