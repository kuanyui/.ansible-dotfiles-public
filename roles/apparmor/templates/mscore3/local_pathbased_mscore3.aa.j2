abi <abi/5.0>,
#include <tunables/global>

# THIS_FILE_IS_MANAGED_BY_ANSIBLE__DO_NOT_EDIT_MANUALLY
# MuseScore 3 AppArmor profile - /etc/apparmor.d/local_pathbased_mscore3
# Source template mtime: {{ (lookup('pipe', 'stat -c %y ' ~ template_fullpath))[:19] }}
#
# Draft - put in complain mode first to capture missing paths:
#   sudo aa-complain /etc/apparmor.d/local_pathbased_mscore3

# flags: attach_disconnected reattaches the disconnected systemd journal socket
# (see the journal section) so its deny matches; mediate_deleted lets QSaveFile
# atomic-save links resolve when the temp target is an unlinked `#<inode>`.
profile local_pathbased_mscore3 /usr/{,local/}bin/mscore3 flags=(attach_disconnected, mediate_deleted) {
    #include <abstractions/base>
    #include <abstractions/fonts>

    #include <abstractions/local_mixin_audio>
    #include <abstractions/local_mixin_kde>
    #include <abstractions/local_mixin_kde_native_apps>
    #include <abstractions/local_mixin_bookmarked_places>
    #include <abstractions/local_mixin_recent_file_list>
    #include <abstractions/local_mixin_xdg_dir_downloads>
    #include <abstractions/local_mixin_deny_keyrings>
    #include <abstractions/local_mixin_deny_probably_credentials>
    #include <abstractions/local_mixin_deny_persistent_attack>
    #include <abstractions/local_mixin_network_deny>
    #include <abstractions/local_mixin_kernel_surface_general_app>
    #include <abstractions/local_mixin_customized_extra_dirs__for__music_score_editor>
    #include <abstractions/local_mixin_deny_mounted_external_media>
    #include <abstractions/local_mixin_sysinfo>
    #include <abstractions/local_mixin_deny_gpu>
    #include <abstractions/local_mixin_gpu_probe>
    #include <abstractions/local_mixin_gui_wayland>
{% if apparmor_allow_x11 %}
    #include <abstractions/local_mixin_gui_x11>
{% else %}
    #include <abstractions/local_mixin_gui_x11_deny>
{% endif %}

    # D-Bus (desktop notifications)
    owner /run/user/*/bus rw,

    # MuseScore re-opens its own binary at runtime (argv[0] re-read)
    /usr/{,local/}bin/mscore3 r,

    # MuseScore 3 system data (soundfonts, templates, instruments) - self-installed under /usr/local
    /usr/local/share/mscore3*/{,**} r,

    # User config, cache, and scores. `l` on the ** rules covers MuseScore's
    # QSaveFile atomic saves (hard-link a temp to a `#<inode>`, then rename) -
    # the .ini in .config/, the Qt shader cache in .cache/, etc.; mediate_deleted
    # (profile flag) lets those links resolve when the temp is already unlinked.
    owner @{HOME}/.config/MuseScore/ rw,
    owner @{HOME}/.config/MuseScore/** rwkl,
    owner @{HOME}/.local/share/MuseScore/ rw,
    owner @{HOME}/.local/share/MuseScore/** rwkl,
    owner @{HOME}/.cache/MuseScore/ rw,
    owner @{HOME}/.cache/MuseScore/** rwkl,

    # MuseScore 3 KConfig-style rc directly under ~/.config (distinct from the
    # QSettings ~/.config/MuseScore/MuseScore3.ini above). Only read audited.
    owner @{HOME}/.config/MuseScore3rc r,

    # Session / machine identity. Read by libsystemd-style code and KDE
    # frameworks for D-Bus session identification. World-readable, not secrets
    # (boot_id changes per boot; machine-id is a well-known per-host id), and
    # mscore3 has no network egress (local_mixin_network_deny) to leak them.
    # gwenview keeps the same two rules inline; promote to a shared mixin only
    # once a 3rd Qt/KDE caller needs them.
    @{PROC}/sys/kernel/random/boot_id r,
    /etc/machine-id r,

    # Anonymous (`#<inode>`) temp files in XDG_RUNTIME_DIR - O_TMPFILE or
    # unlinked-while-open files Qt/KIO use for atomic state writes. Only rw
    # audited (no flock). gwenview keeps the same rule inline (2nd caller now).
    owner /run/user/*/#[0-9]* rw,

    # Self-introspection, own pid only: Qt/Mesa read their own name + argv
    owner @{PROC}/@{pid}/comm r,
    owner @{PROC}/@{pid}/cmdline r,

    # KIO worker sockets: KIO binds a per-worker socket via O_TMPFILE + linkat
    # (the `#<inode>` target is covered by the runtime-temp rule above + the
    # mediate_deleted flag). `rwl` = socket traffic + the link step.
    owner /run/user/*/MuseScore*.kioworker.socket rwl,

    # systemd journal: denied, not granted. Qt/libsystemd try to log to the
    # journal socket; a local score editor needs no host-journal access. The
    # socket is an AF_UNIX dgram whose dentry is disconnected from the policy
    # namespace root, so the audit reports it as `systemd/journal/socket` (no
    # /run prefix) with a "disconnected path" error. flags=(attach_disconnected)
    # on the profile header reattaches it so these denies match; deny both forms
    # to silence the sendmsg spam. Same pattern as the telegram profile.
    deny /run/systemd/journal/socket w,
    deny /systemd/journal/socket w,

    # MuseScore's own data tree under XDG_DOCUMENTS_DIR (Scores, Templates,
    # Styles, SoundFonts, Plugins, Extensions, ...). rw so it reads its
    # resources and saves scores. Subdir resolved from user-dirs.dirs at render
    # time (apparmor_xdg_documents_subdir), not hardcoded "Documents".
    owner @{HOME}/{{ apparmor_xdg_documents_subdir }}/MuseScore3/ rw,
    owner @{HOME}/{{ apparmor_xdg_documents_subdir }}/MuseScore3/** rwk,

    # Qt terminal detection
    /dev/tty r,

    # GPU: software render (llvmpipe). deny_gpu (above) blocks the device nodes;
    # gpu_probe gives the EGL-vendor scan; these are the Mesa/Vulkan metadata
    # reads the llvmpipe path makes (nvidia / EGL-external probes denied).
    /dev/dri/ r,
    /dev/udmabuf rw,
    /usr/share/vulkan/icd.d/{,**} r,
    /usr/share/vulkan/implicit_layer.d/{,**} r,
    /usr/share/drirc.d/{,**} r,
    owner @{HOME}/.cache/mesa_shader_cache/{,**} rwk,
    owner @{HOME}/.cache/qtshadercache-*/{,**} rwl,   # Qt Quick compiled-shader cache
    deny /sys/devices/**/boot_vga r,
    deny /usr/share/egl/egl_external_platform.d/{,**} r,
    deny /usr/share/nvidia/nvidia-application-profiles-* r,

    # HEIF/HEIC image import
    /usr/libexec/libheif/ r,
    /usr/libexec/libheif/libheif-*.so rm,

    # QtSingleApplication single-instance lock (flock) + socket
    owner /tmp/qtsingleapp-mscore-* rwk,

    # Printing: local socket to cupsd (local IPC, NOT network egress - inet
    # stays denied via local_mixin_network_deny).
    /etc/cups/client.conf r,
    /run/cups/cups.sock rw,

    # NSS user/group resolution (libcups getpwuid/getgrgid for the print-job
    # owner). World-readable, no secrets - allowed so printing works fully.
    /etc/nsswitch.conf r,
    /usr/etc/nsswitch.conf r,
    /etc/passwd r,
    /etc/group r,

    # System D-Bus not needed (Qt probes it for power/network status); the app
    # falls back gracefully. Deny + silence.
    deny /run/dbus/system_bus_socket rw,

    # JACK is necessary
    /dev/shm/jack* rw,
    /usr/bin/jackd ix,

}
