#include <tunables/global>

# Managed by Ansible - do not edit manually
# Microsoft Edge AppArmor profile - /etc/apparmor.d/local_pathbased_msedge
# Source template mtime: {{ (lookup('pipe', 'stat -c %y ' ~ template_fullpath))[:19] }}
#
# Draft - put in complain mode first to capture missing paths:
#   sudo aa-complain /etc/apparmor.d/local_pathbased_msedge

profile local_pathbased_msedge /opt/microsoft/msedge/msedge {
    # Attachment covers only the msedge binary, not the microsoft-edge bash launcher script.
    # microsoft-edge is a short-lived wrapper that resolves paths, creates ~/.local/share/applications/,
    # then does exec -a to replace itself with msedge. Confinement starts at that exec point.
    #include <abstractions/base>
    #include <abstractions/nameservice>
    #include <abstractions/fonts>
    #include <abstractions/dbus-session-strict>

    #include <abstractions/local_mixin_sysinfo>
    #include <abstractions/local_mixin_gpu>
    #include <abstractions/local_mixin_gpu_chromium_based>
    #include <abstractions/local_mixin_audio>
    #include <abstractions/local_mixin_gtk>
    #include <abstractions/local_mixin_kde>
    #include <abstractions/local_mixin_tmpdir>
    #include <abstractions/local_mixin_xdg_dir_pictures_screenshots>
    #include <abstractions/local_mixin_xdg_dir_downloads>
    #include <abstractions/local_mixin_deny_keyrings>
    #include <abstractions/local_mixin_deny_persistent_attack>
    #include <abstractions/local_mixin_personal_dirs__for__web_browser>
    #include <abstractions/local_mixin_deny_mounted_external_media>

    # Edge executable and resources
    # TODO: verify remaining paths via complain mode log
    /opt/microsoft/msedge/ r,
    /opt/microsoft/msedge/** rm,                 # m: .so files (Widevine CDM, Qt shims, etc.) require executable mmap
    /opt/microsoft/msedge/msedge ix,
    /opt/microsoft/msedge/msedge-sandbox ix,         # sandbox helper
    /opt/microsoft/msedge/msedge_crashpad_handler ix, # out-of-process crash reporter

    /usr/bin/xdg-settings ix,                        # query/set default browser

    # System Edge policies (Microsoft managed policy path)
    /etc/opt/microsoft/msedge/{,**} r,
    deny /opt/microsoft/msedge/Extensions/ w,  # Edge probes this; install path is root-owned so mkdir would fail anyway

    # Capabilities - same Chromium sandbox model
    capability sys_admin,    # user namespace setup for sandboxed child processes
    capability sys_chroot,   # chroot-based content process sandbox
    capability sys_ptrace,   # inspect sandboxed child processes

    # User/group namespace ID mapping - needed for user namespace setup
    /proc/sys/kernel/overflowuid r,
    /proc/sys/kernel/overflowgid r,

    # Process self-inspection
    /proc/ r,                                        # sandbox setup: enumerate /proc entries
    /proc/*/stat r,                                  # monitor child process status (sandboxed children may run as root)
    /proc/*/task/*/status r,                         # sandbox monitor: read thread status of child processes
    /proc/sys/kernel/yama/ptrace_scope r,            # crashpad: check yama ptrace restrictions
    /proc/sys/kernel/core_pattern r,                 # crashpad: locate core dump handler
    /proc/sys/fs/inotify/max_user_watches r,         # inotify limit check for file watching
    owner @{PROC}/@{pid}/ r,
    owner @{PROC}/@{pid}/** r,
    owner @{PROC}/@{pid}/oom_score_adj w,
    owner @{PROC}/@{pid}/clear_refs w,               # MemoryInfra: reset page reference bits for working set measurement
    owner @{PROC}/@{pid}/uid_map w,      # renderer sandbox: write UID mapping for user namespace
    owner @{PROC}/@{pid}/gid_map w,      # renderer sandbox: write GID mapping for user namespace
    owner @{PROC}/@{pid}/setgroups w,    # renderer sandbox: must be written before gid_map
    deny @{PROC}/@{pid}/mem rwklx,       # direct process memory access
    deny @{PROC}/@{pid}/environ r,       # process environment variables (may contain secrets)
    deny @{PROC}/@{pid}/pagemap r,       # virtual-to-physical memory mapping (exploit aid)

    # Chromium multi-process: main/renderer/GPU/utility processes all run under this profile
    ptrace (trace) peer=local_pathbased_msedge,

    /dev/tty rw,                                     # terminal access (startup and crash reporter)

    # Wayland display socket
    owner /run/user/*/wayland-[0-9]* rw,

    # X11 and ICE auth - Edge probes for both even under Wayland
    owner /run/user/*/xauth_* r,
    owner /run/user/*/iceauth_* r,

    # Shared memory - Edge uses both its own and Chromium's shm namespace prefixes
    owner /dev/shm/org.chromium.* rwk,
    owner /dev/shm/.org.chromium.* rwk,
    owner /dev/shm/.com.microsoft.Edge.* rwk,    # Edge-specific shm prefix

    # File picker: list top-level home directories
    /home/ r,

    # sysfs device enumeration
    /sys/bus/ r,
    /sys/bus/usb/{,**} r,                            # USB device enumeration (WebUSB, gamepad, HID APIs)
    /sys/class/ r,

    # Camera access (WebRTC)
    /dev/video* rw,

    # User data
    owner @{HOME}/.config/ r,                        # top-level .config listing (config discovery)
    owner @{HOME}/.config/microsoft-edge/ rw,
    owner @{HOME}/.config/microsoft-edge/** rwkm,    # m: Widevine CDM (.so) requires executable mmap
    owner @{HOME}/.cache/microsoft-edge/ rw,
    owner @{HOME}/.cache/microsoft-edge/** rwk,
    owner @{HOME}/.cache/Microsoft/ rw,
    owner @{HOME}/.cache/Microsoft/Edge/ rw,
    owner @{HOME}/.cache/Microsoft/Edge/** rwk,  # Microsoft-specific features: identity cache, account sync

    # NSS/PKCS11 certificate database (TLS client certificates)
    owner @{HOME}/.pki/ r,
    owner @{HOME}/.pki/nssdb/ r,
    owner @{HOME}/.pki/nssdb/** rwk,

}
