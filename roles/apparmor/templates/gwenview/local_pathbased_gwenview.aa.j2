abi <abi/5.0>,
#include <tunables/global>

# Managed by Ansible - do not edit manually
# Gwenview AppArmor profile - /etc/apparmor.d/local_pathbased_gwenview
# Source template mtime: {{ (lookup('pipe', 'stat -c %y ' ~ template_fullpath))[:19] }}
#
# Draft - put in complain mode first to capture missing paths:
#   sudo aa-complain /etc/apparmor.d/local_pathbased_gwenview

profile local_pathbased_gwenview /usr/bin/gwenview {
    #include <abstractions/base>
    #include <abstractions/fonts>

    #include <abstractions/local_mixin_kde>
    #include <abstractions/local_mixin_kde_native_apps>
    #include <abstractions/local_mixin_bookmarked_places>
    #include <abstractions/local_mixin_xdg_thumbnailer>
    #include <abstractions/local_mixin_sysinfo>
    #include <abstractions/local_mixin_audio_probe>
    #include <abstractions/local_mixin_deny_audio>
    #include <abstractions/local_mixin_xdg_dir_pictures_screenshots>
    #include <abstractions/local_mixin_xdg_dir_downloads>
    #include <abstractions/local_mixin_deny_keyrings>
    #include <abstractions/local_mixin_deny_probably_credentials>
    #include <abstractions/local_mixin_deny_persistent_attack>
    #include <abstractions/local_mixin_network_deny>
    #include <abstractions/local_mixin_kernel_surface_general_app>
    #include <abstractions/local_mixin_customized_extra_dirs__for__image_viewer>
    #include <abstractions/local_mixin_deny_mounted_external_media>
    #include <abstractions/local_mixin_deny_gpu>
    #include <abstractions/local_mixin_gpu_probe>
    #include <abstractions/local_mixin_gui_wayland>
{% if apparmor_allow_x11 %}
    #include <abstractions/local_mixin_gui_x11>
{% else %}
    #include <abstractions/local_mixin_gui_x11_deny>
{% endif %}

    # D-Bus (desktop notifications, portal access)
    owner /run/user/*/bus rw,

    # Anonymous-file (`#<inode>`) reads/writes directly under XDG_RUNTIME_DIR.
    # `#<digits>` is how the kernel represents unnamed files (typically opened
    # via `O_TMPFILE`, or unlinked while an fd is still open) in audit logs.
    # Gwenview hits this; not yet seen with other Qt/KDE apps, so keep it
    # scoped here instead of promoting to local_mixin_qt or local_mixin_kde.
    owner /run/user/*/#[0-9]* rwk,

    # Session / machine identity. Read by libsystemd-style code and KDE
    # frameworks for D-Bus session identification. Both files are world-
    # readable; the values themselves are not secrets (boot_id changes on
    # every boot, machine-id is a stable but well-known per-host identifier).
    @{PROC}/sys/kernel/random/boot_id r,
    /etc/machine-id r,

    # KIO worker sockets. KIO spawns kioworker processes for each protocol
    # (file://, sftp://, etc.) and bonds to them via unix sockets in
    # XDG_RUNTIME_DIR. The atomic-create pattern is: open O_TMPFILE, bind,
    # then linkat() the anon fd to the final socket path. `rwl` covers the
    # socket file's read/write traffic and the final hard-link step.
    owner /run/user/*/gwenview*.kioworker.socket rwl,

    # udmabuf - kernel module that lets userspace assemble dma-buf objects
    # from regular memfd-backed pages, without needing GPU device access.
    # Used by gwenview's image render pipeline for zero-copy delivery of
    # decoded image frames to the compositor (Wayland dmabuf protocol).
    # Distinct from the GPU device nodes (/dev/dri/renderD*) which stay
    # denied - udmabuf only deals with the host RAM side of the handover.
    /dev/udmabuf rw,

    # 3D / DRI / Vulkan / mesa-shader-cache inert metadata. Kept inline (NOT
    # promoted to local_mixin_gpu_probe) because telegram - the third caller
    # of gpu_probe - runs with `LIBGL_ALWAYS_SOFTWARE=1` and explicitly does
    # NOT want the vulkan / drirc / shader-cache reads (over-grant would
    # let a compromised telegram pollute the system-wide mesa shader cache).
    # mpv has the same set inline. Promote here only when a non-telegram /
    # non-mpv / non-gwenview app hits the same denials.
    /dev/dri/ r,                                  # DRM card directory listing (NOT the device nodes)
    /usr/share/vulkan/icd.d/{,**} r,              # Vulkan installable client driver manifests
    /usr/share/vulkan/implicit_layer.d/{,**} r,   # Vulkan implicit layer manifests
    /usr/share/drirc.d/{,**} r,                   # DRI driver workaround configs
    owner @{HOME}/.cache/mesa_shader_cache/{,**} rwk,  # llvmpipe software rasterizer also writes here

    # GPU metadata probes silenced. deny_gpu forces llvmpipe, so the nvidia
    # blob / EGL-external probes below find nothing useful - they are pure
    # startup noise. Plain `deny` (NOT `audit deny`) silences the audit spam
    # while local_mixin_deny_gpu keeps the hardware device-node denials as
    # the real tripwire. Distinct from the vulkan/drirc reads above, which
    # Qt's core EGL loader path uses and are therefore allowed, not denied.
    deny /sys/devices/**/boot_vga r,                          # PCI: is-this-the-boot-GPU flag
    deny /usr/share/egl/egl_external_platform.d/{,**} r,      # EGL external platform configs (nvidia/wayland)
    deny /usr/share/nvidia/nvidia-application-profiles-* r,   # nvidia per-app driver tunables (version in name)

    # Process self-introspection (only /proc/<own pid>/{fd/,comm,cmdline},
    # narrowly scoped to what gwenview actually audits - KIO/Qt walking own
    # open fds during kioworker fork, plus reading its own name/argv). NOT
    # promoted to local_mixin_qt: most Qt apps do not need this and granting
    # it widens the attack surface (ASLR addresses, mmap'd library
    # inspection, env var leaks via /proc/<pid>/environ). comm/cmdline are
    # far less sensitive than fd//environ - own process name and argv only.
    owner @{PROC}/@{pid}/fd/ r,
    owner @{PROC}/@{pid}/comm r,
    owner @{PROC}/@{pid}/cmdline r,

    # Gwenview's own application data
    /usr/share/gwenview/{,**} r,                 # color schemes, images, cursors, etc.
    /usr/libexec/libheif/ r,                     # libheif plugin directory listing
    /usr/libexec/libheif/libheif-*.so rm,        # libheif plugins (HEIC / HEIF format support); `m` = mmap-exec for dlopen
    /usr/share/kImageAnnotator/{,**} r,          # kImageAnnotator library data + Qt .qm translations

    # KIO worker - spawned per-protocol (file://, sftp://, etc.). Inherit-
    # exec keeps the worker under gwenview's own confinement instead of
    # going unconfined.
    /usr/libexec/kf6/kioworker ix,

    # User config and cache.
    # `.local/share/gwenview/** rwkl` includes `l` so gwenview can hard-link
    # files in `recentfolders/` (KSaveFile backup step on history rewrites).
    # `gwenviewrc.lock` is a KConfig lock file (created via mknod, then
    # flock'd; `w` covers create, `k` covers flock).
    owner @{HOME}/.config/gwenviewrc rw,
    owner @{HOME}/.config/gwenviewrc.lock rwk,
    owner @{HOME}/.config/gwenview/ rw,
    owner @{HOME}/.config/gwenview/** rwk,
    owner @{HOME}/.cache/gwenview/ rw,
    owner @{HOME}/.cache/gwenview/** rwk,
    owner @{HOME}/.local/share/gwenview/ rw,
    owner @{HOME}/.local/share/gwenview/** rwkl,
    owner @{HOME}/.local/state/gwenviewstaterc rwk,
    owner @{HOME}/.local/state/gwenviewstaterc.lock rwk,
    owner @{HOME}/.local/state/#[0-9]* rw,                  # QSaveFile temp for atomic save of gwenviewstaterc
    owner @{HOME}/.local/state/gwenviewstaterc.?????? rwl,  # KSaveFile mkstemp link target (linkat + later rename/unlink)
    owner @{HOME}/.config/#[0-9]* rw,                       # QSaveFile temp for atomic save of files under .config/
    owner @{HOME}/.config/gwenviewrc.?????? rwl,           # KSaveFile mkstemp link target (linkat + rename; `r` = rename_src reads the temp before swapping it into place)

    # KIO - NSS uid/gid name resolution silently denied. kioworker calls
    # getpwuid / getgrgid via libc NSS to render file Owner/Group columns
    # only; actual open/read/write uses kernel uid checks, not NSS, so
    # denying only breaks that cosmetic display. /usr/etc/ is openSUSE's
    # NSS fallback path. If KIO rules later get factored into a dedicated
    # mixin (local_mixin_kio), this block moves there too.
    deny /etc/nsswitch.conf r,
    deny /usr/etc/nsswitch.conf r,
    deny /etc/passwd r,
    deny /etc/group r,

    # Baloo file index intentionally blocked. Baloo's Xapian database under
    # ~/.local/share/baloo/ contains the user's full-text index (every
    # filename, EXIF, document body, mail header that baloo has crawled).
    # An image viewer has no business reading that. Cost: KIO file dialogs
    # lose baloo-backed search-as-you-type integration; basic file
    # listing still works. Use plain `deny` (NOT `audit deny`) to silence
    # the spam from kioworker probing the index.
    deny owner @{HOME}/.local/share/baloo/{,**} r,


}
