abi <abi/5.0>,
#include <tunables/global>

# THIS_FILE_IS_MANAGED_BY_ANSIBLE__DO_NOT_EDIT_MANUALLY
# DBeaver CE AppArmor profile - /etc/apparmor.d/local_pathbased_dbeaver
# Source template mtime: {{ (lookup('pipe', 'stat -c %y ' ~ template_fullpath))[:19] }}
#
# Attaches to any executable named "dbeaver" at any path - covers the official portable
# binary tarball, which unpacks to a dbeaver/ directory (Eclipse launcher `dbeaver`,
# bundled JRE under jre/, OSGi bundles under plugins/) and runs in place, no installation.
# Same name-based attachment pattern as local_pathbased_anydesk.
#
# Threat model: network-egress database client (SQL over TCP to arbitrary hosts, renders
# untrusted server responses). It gets its own unpack tree and its default workspace;
# browser data, SSH/GPG keys, and clipboard/notes stores are hard-denied via mixins.
#
# customized_extra_dirs: includes the DENY_ALL variant, NOT a __for__<category> allow
# list - a database client has no business in ANY customized extra dir, so every listed
# dir is audit-denied regardless of its allow list.
#
# GPU: GRANTED via local_mixin_gpu, and this is a KNOWN over-grant - see TODO.md. The
# workbench itself does not need it (Eclipse/SWT renders fine on llvmpipe); what needs it is
# the SWT `Browser` DBeaver builds at startup for the Welcome page, i.e. WebKitGTK, whose
# accelerated compositing misbehaves under software OpenGL and whose DMA-BUF renderer fails
# on DRM/GBM buffer creation when /dev/dri is unreachable - surfacing as the well-known
# `SWTError: No more handles` unhandled event-loop exception, which takes the UI down.
# GPU-denied was tried first (deny_gpu + metadata denies, telegram's calibration) and the UI
# did not come up. Cost, stated: render node + nvidiactl + PCI enumeration are reachable from
# a network-egress database client. The narrower fix is WEBKIT_DISABLE_COMPOSITING_MODE=1 in
# DBeaver's environment, which AppArmor cannot set - tracked in TODO.md.
#
# Draft - put in complain mode first to capture missing paths:
#   sudo aa-complain /etc/apparmor.d/local_pathbased_dbeaver

# flags: attach_disconnected reattaches the disconnected systemd journal socket (see the
# journal section) so its deny matches.
profile local_pathbased_dbeaver /**/dbeaver flags=(attach_disconnected) {
    #include <abstractions/base>
    #include <abstractions/nameservice>
    #include <abstractions/fonts>

    #include <abstractions/local_mixin_gtk>
    #include <abstractions/local_mixin_glycin>
    #include <abstractions/local_mixin_sysinfo>
    #include <abstractions/local_mixin_tmpdir>
    #include <abstractions/local_mixin_deny_browser_config>
    #include <abstractions/local_mixin_deny_keyrings>
    #include <abstractions/local_mixin_deny_probably_credentials>
    #include <abstractions/local_mixin_deny_persistent_attack>
    #include <abstractions/local_mixin_deny_mounted_external_media>
    #include <abstractions/local_mixin_deny_machine_id>
    #include <abstractions/local_mixin_deny_audio>
    #include <abstractions/local_mixin_customized_extra_dirs__DENY_ALL>
    #include <abstractions/local_mixin_kernel_surface_general_app>
    #include <abstractions/local_mixin_network_app>
    #include <abstractions/local_mixin_gpu>
    #include <abstractions/local_mixin_gui_wayland>
{% if apparmor_allow_x11 %}
    #include <abstractions/local_mixin_gui_x11>
{% else %}
    #include <abstractions/local_mixin_gui_x11_deny>
{% endif %}
    # X11 NOTE - this app needs a companion setting in its own `dbeaver.ini`:
    #     -Djava.awt.headless=true      (under -vmargs)
    # SWT renders the UI through GTK, but SWT's SVG rasterizer (JSVGRasterizer) draws
    # through AWT, and AWT speaks ONLY X11. With apparmor_allow_x11 false the xauth cookie
    # is denied above, so AWT reaches the X server on the abstract socket but cannot
    # authenticate ("Authorization required, but no authorization protocol specified"),
    # X11GraphicsEnvironment fails to initialise, and every later AWT use dies with
    # `NoClassDefFoundError: Could not initialize class java.awt.GraphicsEnvironment$LocalGE`
    # - which is why the ER Diagram renders BLACK while the rest of the UI is fine.
    # Headless AWT fixes it without opening X11: printing/fonts/imaging are fully supported
    # headless, so BufferedImage.createGraphics() rasterises the SVGs offscreen. Trade-off:
    # Desktop.isDesktopSupported() then returns false (DBeaver calls it at startup), so
    # "open in external browser / file manager" goes through SWT's Program.launch instead
    # of AWT Desktop - reported as a side effect of headless mode, not verified here.
    # Do NOT "fix" this by flipping apparmor_allow_x11 - that hands a network-egress
    # database client the cookie to keylog and screenshot the entire desktop.

    # The portable unpack tree, matched by directory name like the attachment.
    # Whole-tree access is the design: the Eclipse launcher rewrites configuration/ and
    # p2/ in place, OSGi extracts native .so bundles next to the plugins (m: libjvm.so
    # and extracted SWT/JNA natives mmap PROT_EXEC), and Eclipse .lock files need flock
    # (k). owner: a portable unpack is user-owned by definition.
    owner /**/dbeaver/ r,
    owner /**/dbeaver/** rwkm,
    # Self re-exec (restart after driver/plugin install, -clean relaunch); the glob also
    # matches the dbeaver/dbeaver launcher path itself. ix keeps confinement.
    owner /**/dbeaver rix,
    # Bundled JRE - DBeaver spawns jre/bin/java for helper processes; ix keeps them confined
    owner /**/dbeaver/jre/bin/* rix,

    # Default workspace (upstream-documented location, used even by a portable run unless
    # dbeaver.ini overrides -data): connection definitions, SQL scripts,
    # credentials-config.json, Eclipse .metadata; k: workspace .lock flock
    owner @{HOME}/.local/share/DBeaverData/ rw,
    owner @{HOME}/.local/share/DBeaverData/** rwk,

    # Second XDG data dir, created alongside the workspace by the Eclipse runtime's
    # directory resolution at startup (audit: operation=mkdir, comm=olveDirectories i.e. the
    # truncated ResolveDirectories thread). Distinct path from DBeaverData above - product
    # state rather than the workspace - and created even when the workspace already exists.
    owner @{HOME}/.local/share/DBeaver/ rw,
    owner @{HOME}/.local/share/DBeaver/** rwk,

    # THIRD DBeaver dir - the XDG cache one. Written by DBeaver's own `persistent` thread
    # (audit comm=persistent) as well as by the WebKit helper. Denying it silently loses
    # whatever DBeaver persists there between runs, which is the leading suspect for UI
    # preferences (e.g. an interface-language change) not surviving a restart.
    owner @{HOME}/.cache/DBeaver/ rw,
    owner @{HOME}/.cache/DBeaver/** rwk,

    # SWT native-library extraction fallback. SWT looks for libswt-*.so in swt.library.path,
    # then java.library.path, and only if both miss does it mkdir ~/.swt/lib/<platform>/<arch>/,
    # extract the .so from the plugin jar, chmod 755 it and dlopen it (m). Denying the mkdir
    # does not prevent the write - SWT then falls back to extracting the same .so into $HOME
    # itself (Library.loadLibrary, eclipse.platform.swt).
    owner @{HOME}/.swt/ rw,
    owner @{HOME}/.swt/** rwm,

    # D-Bus session bus (desktop notifications for long-running query completion)
    owner /run/user/*/bus rw,

    # SSL certificate verification (TLS to database hosts)
    /etc/ssl/{,**} r,

    # Process self-inspection (JVM reads its own maps/stat/cgroup at startup)
    owner @{PROC}/@{pid}/ r,
    owner @{PROC}/@{pid}/** r,

    # JVM startup probes, each read once while HotSpot sizes itself
    /sys/kernel/mm/hugepages/ r,                          # large-page pool availability
    /sys/kernel/mm/transparent_hugepage/shmem_enabled r,  # THP policy for shared memory
    @{PROC}/sys/vm/mmap_min_addr r,                       # lowest mmap-able address
    # /proc/<pid>/net/* is root-owned even for a user-owned process, so the `owner` rules
    # above cannot match it - granted separately, for this pid's file only.
    @{PROC}/@{pid}/net/if_inet6 r,                        # java.net: is the IPv6 stack up?
    # HotSpot sets which mappings land in its own core dump. Self-scoped: no other process
    # is affected, and the heap is dumped either way, so this grants no credential exposure.
    owner @{PROC}/@{pid}/coredump_filter w,
    # Thread naming: the WebKit helper writes its own threads' comm. Self-scoped (own pid).
    owner @{PROC}/@{pid}/task/*/comm w,

    # Glycin image loader - bwrap exec transitions to local_attachmentless_glycin.
    # Px (discrete, non-stacked): the decoder runs under the glycin profile, so this profile's
    # `audit deny userns` (local_mixin_kernel_surface_general_app) does not follow it into
    # bwrap's namespace setup. The security boundary is bwrap's mount namespace - only what
    # bwrap bind-mounts is visible to the decoder, whatever the glycin profile permits.
    /usr/bin/bwrap Px -> local_attachmentless_glycin,
    signal (send) set=(kill) peer=local_attachmentless_glycin,

    # udmabuf zero-copy buffer assembly. local_mixin_gpu deliberately leaves this to the
    # profile (see local_mixin_deny_gpu's header); granted here for the same reason as the
    # rest of the GPU stack - it was in the same failing-startup audit burst. gwenview and
    # mscore3 grant it the same way.
    /dev/udmabuf rw,

    # ACPI power profile, read by the graphics stack in the same startup audit burst as the
    # /dev/dri enumeration. This one CANNOT be granted from here: `audit deny
    # /sys/firmware/{,**}` in local_mixin_deny_persistent_attack already covers it and deny
    # always beats allow, so the rule below only silences the logging (the quiet mask is
    # OR'd across matching rules; the rest of /sys/firmware stays audited). Left denied
    # deliberately - it is a power-profile hint, and nothing observed depends on it. If a
    # future launch proves the workbench needs it, the fix is to narrow that mixin's glob,
    # not to add an allow here.
    deny /sys/firmware/acpi/pm_profile r,

    # ---- WebKit helper fallout ----
    # Everything in this block appeared only after the `ix` below let the WebKit helpers
    # run at all. Each is decided on its own merits rather than granted as a bundle.

    # Library / hardware enumeration the helper does at startup: directory LISTINGS only,
    # no contents. Same grant chromium, msedge and vscode already make.
    /sys/bus/ r,
    /sys/class/ r,
    /usr/lib/ r,
    /usr/lib64/ r,
    # ICU data the WebKit text stack mmaps. Identical rule to local_mixin_qt's (whose
    # comment names this exact file), inlined because DBeaver is a GTK/SWT app and must
    # not pull in the Qt mixin.
    /usr/share/icu/{,**} r,

    # D-Bus SYSTEM bus: denied. The session bus is granted above for notifications; the
    # system bus is host-level services and a database client has no business there.
    # Matches telegram / mscore3 / firefox / vscode, which all deny exactly this.
    deny /run/dbus/system_bus_socket rw,

    # GStreamer, pulled in by WebKit for HTML5 media: denied, and the plugin scanner's exec
    # with it. WebKit runs fine without the scanner - only media DECODE degrades (WebKit's
    # own bug 140069 covers running with it disabled under seccomp), and the Welcome / Help
    # views are static HTML. This also keeps ORC out: `orcexec.*` are JIT-compiled code
    # files ORC writes into $HOME / $TMPDIR / $XDG_RUNTIME_DIR and then mmaps PROT_EXEC -
    # writable-and-executable files in the user's home is exactly what
    # local_mixin_deny_persistent_attack exists to prevent.
    deny /usr/libexec/gstreamer-*/gst-plugin-scanner* x,
    deny owner @{HOME}/.cache/gstreamer-*/{,**} rwk,
    deny owner @{HOME}/orcexec.* rwmk,
    deny owner /tmp/orcexec.* rwmk,
    deny owner /run/user/*/orcexec.* rwmk,
    # gvm's LD_LIBRARY_PATH leak. Sourcing ~/.gvm/scripts/gvm in an interactive shell exports
    # LD_LIBRARY_PATH="$GVM_OVERLAY_PREFIX/lib:..." (the Go pkgset's cgo overlay), and a GUI
    # app launched FROM that shell inherits it - so the dynamic loader searches the overlay
    # dir on every dlopen, which the WebKit helper does constantly. Harmless: the loader just
    # skips a dir it cannot list. Denied rather than granted - a database client has no
    # business in a Go toolchain tree - and silenced, since it recurs for the whole session.
    # Launching from a .desktop entry instead of a terminal avoids it entirely.
    deny owner @{HOME}/.gvm/{,**} r,

    # GStreamer's DEVICE MONITOR, which runs even with the plugin scanner denied: it
    # enumerates capture and display devices so a page could open a camera. A SQL client's
    # Welcome page has no such need, and this is the surface WebKit keeps reaching for a
    # new corner of on every launch. Denied as a set.
    deny /sys/class/video4linux/{,**} r,
    deny /sys/bus/media/devices/{,**} r,
    deny /sys/class/drm/{,**} r,
    deny @{PROC}/devices r,

    # NVIDIA hardware paths: denied. local_mixin_gpu grants the render node and nvidiactl,
    # which is what rendering needs; these are the driver-params probe and the per-GPU
    # node, plus an `unlink` of /dev/char/195:* - the helper trying to REMOVE and recreate
    # device nodes, which an unprivileged app must never do. Denied, not audited: the
    # NVIDIA userspace probes these on every start.
    deny /proc/driver/nvidia/{,**} r,
    deny /dev/nvidia[0-9]* rw,
    deny /dev/nvidia-uvm* rw,          # NVIDIA unified-memory device (not matched by the numeric glob above)
    # setuid-root helper that loads the NVIDIA kernel module and CREATES its device nodes.
    # local_mixin_deny_gpu words it well: never for an app that has no business doing this.
    # GPU rendering here goes through the render node local_mixin_gpu already grants.
    deny /usr/bin/nvidia-modprobe x,
    deny /dev/char/195:* rw,   # `unlink` is mediated by `w` on the target; there is no `d` file perm
    # DRM PRIMARY nodes (KMS modesetting). local_mixin_gpu deliberately grants renderD* and
    # excludes card* - rendering works through the render node. Same deny mpv makes.
    deny /dev/dri/card[0-9]* rw,

    # WebKitGTK helper processes for the SWT Browser widget behind DBeaver's Welcome / Help
    # views. `ix`, not denied: the Browser is constructed during WORKBENCH STARTUP, and an
    # SWT Browser that cannot start its helper throws rather than degrading, which takes the
    # whole UI down with it - denying this was tried and the workbench did not come up.
    # `ix` (inherit) keeps the helper inside THIS profile: no new profile, and it gets
    # exactly the DB client's confinement - notably still under
    # local_mixin_deny_browser_config, so it cannot reach browser profiles or cookie stores.
    # Version-globbed: the directory name carries the WebKitGTK API version. The `WebKit*`
    # glob also covers the sibling Web/GPU helper processes spawned from the same dir.
    # NO `owner`: these binaries are root-owned (audit ouid=root) while the process runs as
    # the user, so an owner-qualified rule would never match - same reason the
    # /proc/<pid>/net rule above is unqualified.
    /usr/libexec/libwebkit2gtk-*/WebKit*Process rix,

    # XDG cross-app recents (GtkRecentManager): network-facing app -> denied, same
    # calibration as the browsers; local_mixin_recent_file_list is for no-network local
    # viewers only. Plain deny (not audit): GTK file dialogs touch this on every
    # open/save dialog - noise, not signal.
    deny owner @{HOME}/.local/share/recently-used.xbel{,.*} rw,

    # AT-SPI accessibility bus: denied, not granted. GTK's atk-bridge dials this socket on
    # every launch, and a client on that bus can read the accessible text of OTHER
    # applications' windows and generate synthetic input - the same whole-desktop reach that
    # makes local_mixin_gui_x11 expensive, which a network-egress database client must not
    # have. Plain deny (not audit): per-launch toolkit noise, not a tripwire. Trade-off: a
    # screen reader (Orca) cannot read the DBeaver UI.
    deny owner /run/user/*/at-spi/bus{,_*} rw,

    # systemd journal: denied, not granted. libsystemd in the GTK/JVM stack logs to the
    # journal socket; a database client needs no host-journal access. The socket is an
    # AF_UNIX dgram whose dentry is disconnected from the policy namespace root, so the audit
    # reports it as `systemd/journal/socket` (no /run prefix) with a "disconnected path"
    # error; flags=(attach_disconnected) on the profile header reattaches it so these denies
    # match. Deny both forms to silence the sendmsg spam. Same pattern as mscore3.
    deny /run/systemd/journal/socket w,
    deny /systemd/journal/socket w,

}
