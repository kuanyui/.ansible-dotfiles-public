# Managed by Ansible - do not edit manually
# mpv shared profile base - /etc/apparmor.d/abstractions/local_base_mpv
#
# Included by local_pathbased_mpv and local_attachmentless_mpv_gpu.
# Contains all common rules. GPU access is intentionally excluded;
# only local_attachmentless_mpv_gpu adds local_mixin_gpu on top.

    #include <abstractions/base>
    #include <abstractions/nameservice>
    #include <abstractions/fonts>
    #include <abstractions/dbus-session-strict>

    #include <abstractions/local_mixin_sysinfo>
    #include <abstractions/local_mixin_audio>
    #include <abstractions/local_mixin_kde>
    #include <abstractions/local_mixin_tmpdir>
    #include <abstractions/local_mixin_xdg_dir_pictures_screenshots>
    #include <abstractions/local_mixin_deny_browser_config>
    #include <abstractions/local_mixin_deny_keyrings>
    #include <abstractions/local_mixin_deny_persistent_attack>
    #include <abstractions/local_mixin_deny_personal_dirs>
    #include <abstractions/local_mixin_deny_mounted_external_media>

    # mpv system resources
    /usr/share/mpv/{,**} r,
    /etc/mpv/{,**} r,

    # mpv writes terminal status line / OSD CLI output
    /dev/tty rw,

    # GPU/render API probe metadata, even without hardware access. These are inert
    # config files / sysfs IDs / directory listings; the actual GPU hardware boundary
    # stays at `/dev/dri/renderD*` and `/dev/nvidiactl`, which are only granted via
    # `local_mixin_gpu` (used by `local_attachmentless_mpv_gpu`).
    # Allow the reads so the no-GPU profile (`local_pathbased_mpv`) does not spam
    # the audit log every time mesa/vulkan/egl scan their config dirs and PCI bus.
    /dev/dri/ r,
    /usr/share/vulkan/icd.d/{,**} r,
    /usr/share/vulkan/implicit_layer.d/{,**} r,
    /usr/share/glvnd/egl_vendor.d/{,**} r,
    /usr/share/drirc.d/{,**} r,
    /sys/bus/pci/devices/{,**} r,
    /sys/devices/pci*/{,**} r,
    /proc/sys/dev/i915/perf_stream_paranoid r,

    # Mesa shader cache - used by llvmpipe (software rasterizer) too, not only by
    # hardware GPU drivers. Without this write rule, llvmpipe falls back to no-cache
    # mode and re-compiles shaders on every startup. Per-user cache, no security
    # boundary.
    owner @{HOME}/.cache/mesa_shader_cache/{,**} rwk,

    # mpv's lua subsystem calls `pthread_setname_np` on worker threads, which
    # writes the thread name via `/proc/self/task/<tid>/comm`. The base profile
    # already permits read on `@{PROC}/@{pid}/**`; this rule adds the matching
    # write capability scoped to thread comm files.
    owner @{PROC}/@{pid}/task/*/comm rw,

    # Audio gaps not yet covered by `local_mixin_audio` (which currently only
    # handles PulseAudio + ALSA config, not native PipeWire client or ALSA
    # device nodes). Kept inline here rather than extended into the shared mixin
    # because telegram intentionally comments out the equivalent PipeWire lines;
    # if a second audio-playing profile hits the same denials, promote to the
    # mixin.
    /usr/share/pipewire/client.conf r,
    /usr/share/pipewire/client.conf.d/{,**} r,
    /etc/pulse/client.conf.d/{,**} r,
    /dev/snd/controlC[0-9]* rw,

    # Wayland display socket
    owner /run/user/*/wayland-[0-9]* rw,

    # X11 auth
    owner /run/user/*/xauth_* r,
    owner /run/user/*/iceauth_* r,

    # Process self-inspection
    owner @{PROC}/@{pid}/ r,
    owner @{PROC}/@{pid}/** r,

    # Media file access - read anywhere in home; write for watch-later, config, cache
    owner @{HOME}/ r,
    owner @{HOME}/** r,
    owner @{HOME}/.config/mpv/{,**} rw,
    owner @{HOME}/.cache/mpv/{,**} rw,

    # Removable media
    /media/ r,
    /media/** r,
    /mnt/ r,
    /mnt/** r,
