#include <tunables/global>

# Managed by Ansible - do not edit manually
# MComix AppArmor profile - /etc/apparmor.d/local_pathbased_mcomix
# Source template mtime: {{ (lookup('pipe', 'stat -c %y ' ~ template_fullpath))[:19] }}
#
# Draft - put in complain mode first to capture missing paths:
#   sudo aa-complain /etc/apparmor.d/local_pathbased_mcomix

profile local_pathbased_mcomix /usr/bin/mcomix {
    #include <abstractions/base>
    #include <abstractions/fonts>

    #include <abstractions/local_mixin_gtk>
    #include <abstractions/local_mixin_xdg_dir_downloads>
    #include <abstractions/local_mixin_deny_keyrings>
    #include <abstractions/local_mixin_deny_persistent_attack>
    #include <abstractions/local_mixin_personal_dirs__for__image_viewer>
    #include <abstractions/local_mixin_deny_mounted_external_media>
    #include <abstractions/local_mixin_glycin>

    # Python launcher re-opened by the interpreter at runtime (argv[0])
    /usr/bin/mcomix r,

    # /usr/bin directory listing (names only); triggered during image loading
    /usr/bin/ r,

    # Root directory listing (names only); occurs during glycin image-load startup
    / r,

    # network access intentionally denied

    # Wayland display socket
    owner /run/user/*/wayland-[0-9]* rw,

{% if apparmor_allow_x11 %}
    /tmp/.X11-unix/ r,
    /tmp/.X11-unix/X* rw,
    owner /run/user/*/xauth_* r,
{% endif %}

    # D-Bus (desktop notifications)
    owner /run/user/*/bus rw,

    # External archive extractors for reading comic archives; ix keeps them confined under this profile
    /usr/bin/7z ix,
    /usr/bin/unrar ix,

    # Glycin image loader - bwrap exec transitions to local_attachmentless_glycin
    /usr/bin/bwrap Px -> local_attachmentless_glycin,
    signal (send) set=(kill) peer=local_attachmentless_glycin,

    # User config and cache
    owner @{HOME}/.config/mcomix/ rw,
    owner @{HOME}/.config/mcomix/** rwk,
    owner @{HOME}/.cache/mcomix/ rw,
    owner @{HOME}/.cache/mcomix/** rwk,

    # Reading own cgroup for thread-pool sizing; harmless self-introspection
    owner @{PROC}/@{pid}/cgroup r,


}
