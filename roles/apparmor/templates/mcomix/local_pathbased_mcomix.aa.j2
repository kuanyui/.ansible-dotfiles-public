abi <abi/5.0>,
#include <tunables/global>

# Managed by Ansible - do not edit manually
# MComix AppArmor profile - /etc/apparmor.d/local_pathbased_mcomix
# Source template mtime: {{ (lookup('pipe', 'stat -c %y ' ~ template_fullpath))[:19] }}
#
# Draft - put in complain mode first to capture missing paths:
#   sudo aa-complain /etc/apparmor.d/local_pathbased_mcomix

profile local_pathbased_mcomix /usr/bin/mcomix {
    #include <abstractions/base>
    #include <abstractions/fonts>

    #include <abstractions/local_mixin_gtk>
    #include <abstractions/local_mixin_recent_file_list>
    #include <abstractions/local_mixin_xdg_dir_downloads>
    #include <abstractions/local_mixin_deny_keyrings>
    #include <abstractions/local_mixin_deny_probably_credentials>
    #include <abstractions/local_mixin_deny_persistent_attack>
    #include <abstractions/local_mixin_network_deny>
    #include <abstractions/local_mixin_kernel_surface_general_app>
    #include <abstractions/local_mixin_customized_extra_dirs__for__image_viewer>
    #include <abstractions/local_mixin_deny_mounted_external_media>
    #include <abstractions/local_mixin_glycin>
    #include <abstractions/local_mixin_tmpdir>
    #include <abstractions/local_mixin_gui_wayland>
{% if apparmor_allow_x11 %}
    #include <abstractions/local_mixin_gui_x11>
{% else %}
    #include <abstractions/local_mixin_gui_x11_deny>
{% endif %}

    # Python launcher re-opened by the interpreter at runtime (argv[0])
    /usr/bin/mcomix r,

    # /usr/bin directory listing (names only); triggered during image loading
    /usr/bin/ r,

    # Root directory listing (names only); occurs during glycin image-load startup
    / r,

    # D-Bus (desktop notifications)
    owner /run/user/*/bus rw,

    # External archive extractors for reading comic archives; ix keeps them confined under this profile
    /usr/bin/7z ix,
    /usr/bin/unrar ix,

    # Glycin image loader - bwrap exec transitions to local_attachmentless_glycin
    /usr/bin/bwrap Px -> local_attachmentless_glycin,
    signal (send) set=(kill) peer=local_attachmentless_glycin,

    # User config, cache, and data (bookmarks.pickle + library.db SQLite store).
    # Data dir mirrors the config/cache pattern: k covers SQLite file locking, and ** absorbs
    # the db sidecar files (library.db-journal / -wal / -shm) without per-file iteration.
    owner @{HOME}/.config/mcomix/ rw,
    owner @{HOME}/.config/mcomix/** rwk,
    owner @{HOME}/.cache/mcomix/ rw,
    owner @{HOME}/.cache/mcomix/** rwk,
    owner @{HOME}/.local/share/mcomix/ rw,
    owner @{HOME}/.local/share/mcomix/** rwk,

    # Reading own cgroup for thread-pool sizing; harmless self-introspection
    owner @{PROC}/@{pid}/cgroup r,
    # CPU quota for the same thread-pool sizing (GLib reads the cgroup v2 limit)
    /sys/fs/cgroup/user.slice/cpu.max r,
    # Own mount table; harmless self-introspection
    owner @{PROC}/@{pid}/mounts r,                # own pid only

    # Plain `deny` (NOT `audit deny`): these attempts are routine/benign (a library probes
    # them every launch), so a denied hit is log noise, not a security signal - silence it.
    # NSS user/group lookup (getpwuid): non-sensitive, world-readable, viewer does not need.
    deny /etc/nsswitch.conf r,
    deny /usr/etc/nsswitch.conf r,
    deny /etc/passwd r,
    deny /etc/group r,
    # ldconfig = Python ctypes find_library() locating a .so to dlopen in-process, notably the
    # non-free libunrar.so for CBR/RAR. Denying it steers mcomix to the already-allowed,
    # separately-confined /usr/bin/unrar binary, keeping the RAR parser out of its address space.
    deny /usr/sbin/ldconfig x,
    # Same find_library() probe falling back to its next strategy when ldconfig is unavailable:
    # invoke the C compiler (cc -> gcc-15 via the openSUSE `alts` alternatives helper) to resolve
    # the .so through a linker trace. An image viewer has no business exec'ing a compiler; deny
    # and silence like ldconfig. (gcc-15 is version-specific; a toolchain bump may resurface it.)
    deny /usr/bin/gcc-15 x,
    deny /usr/bin/alts x,

}
