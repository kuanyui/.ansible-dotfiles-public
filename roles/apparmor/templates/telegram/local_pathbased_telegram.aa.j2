abi <abi/5.0>,
#include <tunables/global>

# THIS_FILE_IS_MANAGED_BY_ANSIBLE__DO_NOT_EDIT_MANUALLY
# Telegram Desktop AppArmor profile - /etc/apparmor.d/local_pathbased_telegram
# Source template mtime: {{ (lookup('pipe', 'stat -c %y ' ~ template_fullpath))[:19] }}
#
# Auto-attaches to /usr/bin/Telegram at execve - no aa-exec needed; the profile
# kicks in whenever that exact path is executed (the .desktop runs it directly).
#
# NOTE - bwrap removed 2026-06-21: this profile was authored to run together with a
# bwrap wrapper (mount namespace; --tmpfs / and --tmpfs /run/user/<uid>; GPU + audio
# left unbound). The wrapper is gone - Telegram now relies on AppArmor alone. Some
# rules below were only safe BECAUSE of bwrap and are now stale or over-broad; they
# need a complain-mode re-tightening pass on a real machine (cannot audit headless).
# See roles/apparmor/TODO.md "Telegram: bwrap wrapper dropped". Most important:
#   - `owner /run/user/*/* rwk` (below) hit only bwrap's throwaway tmpfs before; with
#     no bwrap it now reaches the REAL runtime dir (pipewire / keyring / other sockets).
#   - `flags=(attach_disconnected)` may no longer be needed (no bwrap namespace).
#
# flags=(attach_disconnected): originally required because Telegram ran inside bwrap's
# mount namespace - /proc and /dev there were fresh mounts that appeared disconnected
# from the host root. Revisit during the re-tightening pass (see NOTE above).
#
# flags=(mediate_deleted): Telegram is a Qt app and writes tdata/ atomically with the
# O_TMPFILE + linkat() pattern - open an unnamed temp inode, write, then link it to its final
# name. The source inode never had a name, so without this flag AppArmor fails the link's name
# lookup ("Failed name lookup - deleted entry", error=-2) and denies it. mediate_deleted makes
# AppArmor mediate the deleted-but-open inode against the existing tdata rules below; it grants
# no new paths.
#
# Draft - put in complain mode first to capture missing paths:
#   sudo aa-complain /etc/apparmor.d/local_pathbased_telegram

profile local_pathbased_telegram /usr/bin/Telegram flags=(attach_disconnected, mediate_deleted) {
    #include <abstractions/base>
    #include <abstractions/nameservice>
    #include <abstractions/fonts>

    #include <abstractions/local_mixin_audio_probe>
    #include <abstractions/local_mixin_deny_audio>
    #include <abstractions/local_mixin_kde>
    #include <abstractions/local_mixin_sysinfo>
    #include <abstractions/local_mixin_tmpdir>
    #include <abstractions/local_mixin_xdg_dir_pictures_screenshots>
    #include <abstractions/local_mixin_xdg_dir_downloads>
    #include <abstractions/local_mixin_deny_browser_config>
    #include <abstractions/local_mixin_deny_keyrings>
    #include <abstractions/local_mixin_deny_probably_credentials>
    #include <abstractions/local_mixin_deny_persistent_attack>
    #include <abstractions/local_mixin_kernel_surface_general_app>
    #include <abstractions/local_mixin_customized_extra_dirs__for__others>
    #include <abstractions/local_mixin_deny_mounted_external_media>
    #include <abstractions/local_mixin_gpu_probe>
    #include <abstractions/local_mixin_deny_gpu>
    #include <abstractions/local_mixin_deny_gpu_metadata>
    #include <abstractions/local_mixin_deny_machine_id>
    #include <abstractions/local_mixin_network_app>
    #include <abstractions/local_mixin_gui_wayland>
{% if apparmor_allow_x11 %}
    #include <abstractions/local_mixin_gui_x11>
{% else %}
    #include <abstractions/local_mixin_gui_x11_deny>
{% endif %}

    # Open clicked links/files in the default application; ix keeps xdg-open confined
    /usr/bin/xdg-open rix,

    # Telegram may re-exec itself (crash recovery, updater)
    /usr/bin/Telegram ix,

    # Used to detect VM/container environment at startup
    /usr/bin/systemd-detect-virt ix,

    # SSL certificate verification (bind-mounted read-only by launcher)
    /etc/ssl/{,**} r,

    # openSUSE system proxy config. Telegram's MTProto networking reads this to
    # honor the host HTTP/SOCKS proxy settings. A network-facing app legitimately
    # consults it; read-only single file, no secrets.
    /etc/sysconfig/proxy r,

    # Network families whitelisted via <abstractions/local_mixin_network_app> (included at top):
    # TCP/UDP/QUIC = inet/inet6 stream+dgram. Obscure families (rds/rxrpc/alg) stay denied.

    # D-Bus socket (bind-mounted by launcher; used for desktop notifications and portal access)
    owner /run/user/*/bus rw,

    # Telegram webview creates socket/lock files with unpredictable names in XDG_RUNTIME_DIR.
    # bwrap mounts --tmpfs /run/user/<uid> so this only affects the isolated tmpfs,
    # not the host's real runtime directory.
    owner /run/user/*/* rwk,

    # Shared memory
    owner /dev/shm/** rwk,

    # Camera (video calls)
    /dev/video* rw,

    # GPU (/dev/dri) intentionally excluded - launcher does not bind /dev/dri and forces
    # LIBGL_ALWAYS_SOFTWARE=1. The actual attack surface is the device node, not config files.
    # Qt EGL loader scans /usr/share/glvnd/egl_vendor.d/ unconditionally at startup regardless
    # of LIBGL_ALWAYS_SOFTWARE, so the directory must be readable even though GPU is unused.
    # That read is now factored into the shared `local_mixin_gpu_probe` abstraction
    # included above.
    #
    # The remaining GPU userspace discovery (Vulkan / DRI / EGL external platform / NVIDIA app
    # profiles / the /dev/dri dir listing / mesa shader cache) is inert metadata Telegram does
    # not need under LIBGL_ALWAYS_SOFTWARE=1. Explicit `deny` (silence): this is the counterpart
    # to gwenview, which inlines these as ALLOW precisely so Telegram can keep them denied - a
    # compromised Telegram must not pollute the shared mesa shader cache. local_mixin_deny_gpu
    # above already blocks the device nodes; these lines silence the leftover discovery reads.
    # These eight denies (incl. the udmabuf one below) now live in the shared
    # local_mixin_deny_gpu_metadata abstraction, included at the top of this profile -
    # DBeaver reached the identical set, and a second inline copy would fragment the
    # maintenance. udmabuf rides along in that mixin: the minimal GPU-less posture uses plain
    # memory copies for frame delivery, and gwenview grants it inline instead.

    # Audio: Telegram plays no sound by design - the bwrap launcher binds no audio
    # socket (its "Audio" section binds only D-Bus) and `--dev /dev` exposes no
    # /dev/snd. The live sockets + ALSA device nodes are hard-denied via
    # <abstractions/local_mixin_deny_audio> (included at top); local_mixin_audio
    # provides only the config reads Qt does at startup.

    # System D-Bus intentionally denied - only the session bus is bound by the
    # launcher and allowed above; Telegram has no business on the system bus.
    # Plain `deny` silences the connect-attempt spam while keeping it denied.
    deny /run/dbus/system_bus_socket rw,

    # systemd journal: Telegram (libsystemd) tries to log to the journal socket;
    # the profile intentionally does not grant it - Telegram needs no host-journal
    # access. The audit reports the target as /systemd/journal/socket without the
    # real /run prefix (apparmor disconnected-path reporting under
    # flags=(attach_disconnected)), so deny both the canonical and the reported
    # form to silence the sendmsg spam regardless of how the path resolves.
    deny /run/systemd/journal/socket w,
    deny /systemd/journal/socket w,

    # Qt reads /dev/tty to detect whether stdout is a terminal
    /dev/tty r,

    # Battery / power status (directory listing); Telegram polls power state
    /sys/class/power_supply/ r,

    # Process self-inspection
    owner @{PROC}/@{pid}/ r,
    owner @{PROC}/@{pid}/** r,
    # Thread naming: Telegram names its worker threads via prctl(PR_SET_NAME),
    # which the kernel reflects as a write to /proc/<pid>/task/<tid>/comm. Own
    # process only; purely cosmetic (htop/debugger thread labels). The `r` rule
    # above already covers reading these - this adds just the `w` for the set.
    owner @{PROC}/@{pid}/task/*/comm w,
    @{PROC}/sys/kernel/core_pattern r,
    # systemd-detect-virt (allowed above) reads osrelease for VM/container detection
    @{PROC}/sys/kernel/osrelease r,

    # libheif plugins for HEIF/HEIC image support; m required to mmap the .so files
    /usr/libexec/libheif/{,*} rm,

    # Keyboard layout rules (Qt input handling); openSUSE installs to xkeyboard-config-2/
    /usr/share/xkeyboard-config{,-2}/{,**} r,

    # bwrap uses --tmpfs / so ~/.config and ~/.cache do not exist in the namespace.
    # Telegram needs to mkdir them on startup; w here allows only the directory entry
    # itself (mkdir), not any files inside. Contents are controlled by explicit sub-path rules.
    owner @{HOME}/.config/ rw,
    owner @{HOME}/.cache/ rw,

    # Telegram user data and cache (bind-mounted by launcher)
    owner @{HOME}/.local/share/TelegramDesktop/ rw,
    owner @{HOME}/.local/share/TelegramDesktop/** rwkl,
    owner @{HOME}/.cache/TelegramDesktop/ rw,
    # `l`: Qt's qtshadercache writes with the same O_TMPFILE + linkat() pattern as tdata (see
    # the mediate_deleted note in the header), so the link's name lookup needs `l` here too.
    owner @{HOME}/.cache/TelegramDesktop/** rwkl,

}
