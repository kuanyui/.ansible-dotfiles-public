abi <abi/5.0>,
#include <tunables/global>

# THIS_FILE_IS_MANAGED_BY_ANSIBLE__DO_NOT_EDIT_MANUALLY
# Visual Studio Code AppArmor profile - /etc/apparmor.d/local_pathbased_vscode
# Source template mtime: {{ (lookup('pipe', 'stat -c %y ' ~ template_fullpath))[:19] }}
#
# Attaches to the Electron binary. /usr/bin/code and /usr/share/code/bin/code are shell
# scripts (CLI wrappers) that eventually exec this binary - confinement begins at that point.
#
# Draft - put in complain mode first to capture missing paths:
#   sudo aa-complain /etc/apparmor.d/local_pathbased_vscode

profile local_pathbased_vscode /usr/share/code/code {
    #include <abstractions/base>
    #include <abstractions/nameservice>
    #include <abstractions/fonts>
    #include <abstractions/dbus-session-strict>

    #include <abstractions/local_mixin_kernel_surface_browser>
    #include <abstractions/local_mixin_network_local_ipc>
    #include <abstractions/local_mixin_sysinfo>
    #include <abstractions/local_mixin_gpu>
    #include <abstractions/local_mixin_gpu_chromium_based>
    #include <abstractions/local_mixin_gtk>
    #include <abstractions/local_mixin_kde>
    #include <abstractions/local_mixin_tmpdir>
    #include <abstractions/local_mixin_deny_browser_config>
    #include <abstractions/local_mixin_deny_keyrings>
    #include <abstractions/local_mixin_deny_probably_credentials>
    #include <abstractions/local_mixin_deny_persistent_attack>
    #include <abstractions/local_mixin_customized_extra_dirs__for__ide>
    #include <abstractions/local_mixin_deny_mounted_external_media>
    #include <abstractions/local_mixin_gui_wayland>
    #include <abstractions/local_mixin_gui_session_manager>
{% if apparmor_allow_x11 %}
    #include <abstractions/local_mixin_gui_x11>
{% else %}
    #include <abstractions/local_mixin_gui_x11_deny>
{% endif %}

    # VS Code executable and resources
    /usr/share/code/ r,
    /usr/share/code/** rm,                          # m: Electron/V8 snapshot blobs and bundled .so files require executable mmap
    /usr/share/code/code ix,
    /usr/share/code/code-sandbox ix,                # setuid sandbox helper
    /usr/share/code/chrome_crashpad_handler ix,     # out-of-process crash reporter
    # Bundled npm helpers (ripgrep for workspace search, vsce-sign for VSIX signature checks, ...).
    # One tree rule, not a per-helper list: the tree is root-owned so the confined app cannot add a
    # binary to it, `ix` keeps each helper under THIS profile, and `/usr/share/code/** rm` above
    # already allows PROT_EXEC mmap of the same files in-process - so enumeration bought no
    # confinement, only a silently broken feature plus an audit round every time an update moved a
    # helper (ripgrep -> ripgrep-universal -> asar-unpacked, then vsce-sign). `{,.asar.unpacked}`:
    # Electron leaves binaries that must be real files next to the asar archive.
    /usr/share/code/resources/app/node_modules{,.asar.unpacked}/**/bin/** ix,

    deny /usr/share/code/resources/app/extensions/ w,  # VS Code probes this; root-owned so mkdir fails anyway

    # Content-process sandbox capabilities + userns are in
    # <abstractions/local_mixin_kernel_surface_browser>, included at the top.

    # User/group namespace ID mapping - needed for user namespace setup
    /proc/sys/kernel/overflowuid r,
    /proc/sys/kernel/overflowgid r,

    # Process self-inspection
    /proc/ r,
    /proc/*/stat r,                                 # monitor child process status (sandboxed children may run as root)
    /proc/*/task/*/status r,                        # sandbox monitor: read thread status of child processes
    /proc/sys/kernel/yama/ptrace_scope r,           # crashpad: check yama ptrace restrictions
    /proc/sys/kernel/core_pattern r,                # crashpad: locate core dump handler
    /proc/version r,                                # kernel version string (Node.js runtime detection)
    /proc/loadavg r,                                # system load (VS Code performance monitoring)
    /proc/sys/fs/inotify/max_user_watches r,        # file watcher limit (VS Code watches workspace files for hot-reload)
    owner @{PROC}/@{pid}/ r,
    owner @{PROC}/@{pid}/** r,
    owner @{PROC}/@{pid}/oom_score_adj w,
    owner @{PROC}/@{pid}/clear_refs w,              # MemoryInfra: reset page reference bits for working set measurement
    owner @{PROC}/@{pid}/uid_map w,                 # renderer sandbox: write UID mapping for user namespace
    owner @{PROC}/@{pid}/gid_map w,                 # renderer sandbox: write GID mapping for user namespace
    owner @{PROC}/@{pid}/setgroups w,               # renderer sandbox: must be written before gid_map
    owner @{PROC}/@{pid}/task/*/comm w,             # vsce-sign (Node): set worker thread names on own threads
    deny @{PROC}/@{pid}/mem rwklx,                  # direct process memory access
    deny @{PROC}/@{pid}/environ r,                  # process environment variables (may contain secrets)
    deny @{PROC}/@{pid}/pagemap r,                  # virtual-to-physical memory mapping (exploit aid)

    # Electron multi-process: main/renderer/GPU/extension-host processes all run under this profile
    ptrace (trace) peer=local_pathbased_vscode,

    /dev/tty rw,
    /dev/ptmx rw,                                   # pty master - required to open integrated terminal sessions
    owner /dev/pts/[0-9]* rw,                       # pty slave - the shell side of each terminal session

    # Shared memory - Electron renderer/GPU process IPC
    owner /dev/shm/org.chromium.* rwk,
    owner /dev/shm/.org.chromium.* rwk,

    # File picker: list top-level home directories
    /home/ r,

    # sysfs device enumeration
    /sys/bus/ r,
    /sys/class/ r,
    /sys/kernel/mm/transparent_hugepage/enabled r,  # jemalloc (ripgrep): THP availability probe at allocator init

    # fontconfig tries to refresh and chmod the root-owned shared cache on launch; DAC blocks
    # it regardless of policy, so this is pure noise. Plain deny keeps the audit log clean.
    deny /var/cache/fontconfig/ w,

    # VS Code IPC sockets (main process <-> extension host and language server communication)
    owner /run/user/*/vscode-* rwk,
    owner /run/user/*/vscd-*.sock rwk,              # VS Code daemon sockets (session/installedLk lockfile)
    owner /run/user/*/ssh-askpass-*.sock rw,        # SSH askpass socket created by VS Code for credential prompts

    # Deny podman runtime directory - chmod here would let a malicious extension make the
    # podman API socket world-writable, granting arbitrary container control to other processes.
    # VSCode is not a container management tool; use a dedicated terminal for podman.
    deny /run/user/*/libpod/{,**} w,

    # System D-Bus intentionally denied - only the session bus (dbus-session-strict above) is
    # granted. Electron probes the system bus for power/battery (UPower) and link state
    # (NetworkManager) and degrades gracefully; a marketplace extension has no business there.
    # Plain `deny` silences the connect spam. Same calibration as firefox / telegram / mscore3.
    deny /run/dbus/system_bus_socket rw,

    # System-wide git configuration - read by git child processes inheriting this profile
    /etc/gitconfig r,
    /etc/shells r,                                  # libuv: enumerate available shells for integrated terminal
    /etc/profile r,                                 # system shell init: sourced by integrated terminal's zsh in login/sh-compat mode
    /etc/zshenv r,                                  # system zsh init: read by integrated terminal's zsh on startup
    /etc/zprofile r,                                # same
    /etc/zshrc r,                                   # same
    /etc/ r,                                         # integrated terminal: compaudit/compinit lists /etc to locate completion dirs
    /etc/zsh_completion.d/ r,                       # integrated terminal: compinit enumerates the system zsh completion dir
    /usr/share/libalternatives/{,**} r,             # openSUSE libalternatives: npm child resolves binary alternatives at startup

    # Workspace file access - VS Code is a code editor; arbitrary read/write
    # across home is expected. `k` (flock) is included because SQLite-backed
    # state DBs (VSCode workspace storage, extension state, etc.) live under
    # various user-chosen paths in home and refuse to open without locking.
    # No extra attack surface since rw is already broad.
    owner @{HOME}/ r,
    owner @{HOME}/** rwk,
    deny @{HOME}/.nvm/** x,                           # nvm-managed node binaries must not run under this profile

    # VS Code user data - explicit k and m on top of the broad rw above
    owner @{HOME}/.config/Code/ rw,
    owner @{HOME}/.config/Code/** rwkm,             # m: V8 bytecode cache files require executable mmap
    owner @{HOME}/.vscode/ rw,
    owner @{HOME}/.vscode/** rwkm,                  # m: native extension modules (.node files) require executable mmap

    # NSS certificate database - Electron uses this for TLS; SQLite requires file locking
    owner @{HOME}/.pki/ rw,
    owner @{HOME}/.pki/** rwk,

    # Integrated terminal - zsh runtime support
    /usr/share/zsh/{,**} r,
    /usr/share/terminfo/{,**} r,
    /usr/share/zoneinfo/** k,                       # vsce-sign (Node): flock on tz database files (read already granted by abstractions/base)

    # zsh probes selinuxenabled at startup; this system uses AppArmor, not SELinux - deny silently
    deny /usr/sbin/selinuxenabled x,

    # ix: child processes inherit this profile so deny_keyrings and deny_persistent_attack
    # remain effective even when extensions spawn external tools via child_process APIs.
    /bin/{,*} rix,
    /usr/bin/{,*} rix,
    deny /usr/bin/ps x,                               # VSCode auto-spawns ps to enumerate all processes; deny full process list visibility
    /usr/libexec/** rix,
    /usr/local/bin/{,*} rix,
}
