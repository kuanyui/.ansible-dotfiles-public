abi <abi/5.0>,
#include <tunables/global>

# THIS_FILE_IS_MANAGED_BY_ANSIBLE__DO_NOT_EDIT_MANUALLY
# mpv media player GPU-enabled profile - /etc/apparmor.d/local_attachmentless_mpv_gpu
#
# Attachmentless: no executable attachment, must be invoked explicitly:
#   aa-exec -p local_attachmentless_mpv_gpu -- mpv [args]
# or via the ansible-mpv-gpu.desktop launcher.

profile local_attachmentless_mpv_gpu {
    #include <abstractions/local_mixin_gpu>
    #include <abstractions/local_mixin_gpu_chromium_based>
    #include <abstractions/local_base_mpv>
}
