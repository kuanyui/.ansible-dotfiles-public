# THIS_FILE_IS_MANAGED_BY_ANSIBLE__DO_NOT_EDIT_MANUALLY
# Network family whitelist for networked apps - /etc/apparmor.d/abstractions/local_mixin_network_app
#
# Include in confined apps that need network egress (IM, remote desktop) INSTEAD of a bare
# `network,` (which allows every address family). Whitelists only the families a desktop app
# uses, so obscure protocol families that are recurring kernel-LPE surface stay default-denied:
# rds (CVE-2026-43494 PinTheft), rxrpc (CVE-2026-43284 Dirty Frag), alg / AF_ALG (CVE-2026-31431
# Copy Fail), ax25, can, ...
#
# Only effective at an abi that mediates network families (abi/4.0+); profiles pin `abi <abi/5.0>`.
# Apps that need NO network egress use local_mixin_network_deny instead (it includes the same
# local_mixin_network_local_ipc, minus the inet egress lines below).
#
# AF_UNIX local IPC (Wayland / D-Bus / audio / journald) comes from the shared mixin; the inet
# egress + netlink lines here are what makes this the "networked app" variant.
#include <abstractions/local_mixin_network_local_ipc>
network inet  stream,
network inet6 stream,
network inet  dgram,
network inet6 dgram,
network netlink raw,
