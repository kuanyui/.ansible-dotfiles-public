# THIS_FILE_IS_MANAGED_BY_ANSIBLE__DO_NOT_EDIT_MANUALLY
# Live audio output capability (full sound: config + connection sockets) -
# /etc/apparmor.d/abstractions/local_mixin_audio
#
# Include ONLY in profiles that actually play sound (mpv, vlc, mscore...). This is
# the audio equivalent of local_mixin_gpu: it pulls in the config reads via
# local_mixin_audio_probe and adds the live PipeWire / PulseAudio connection
# sockets - connecting to them IS audio output.
#
# Apps that play no sound include local_mixin_audio_probe (config only) +
# local_mixin_deny_audio (hard-deny the sockets). Do NOT include local_mixin_audio
# and local_mixin_deny_audio together.
#
# Why a file rule for a socket: at abi/5.0 AppArmor mediates a pathname AF_UNIX
# socket via BOTH a `unix` rule (local_mixin_network_local_ipc) AND a file rule on
# the socket path. The `unix` grant alone is not enough - without the file rule the
# connect is denied with class="file", silently killing audio (the abi/5.0 regression).
#include <abstractions/local_mixin_audio_probe>
owner /run/user/*/pipewire-0 rw,           # PipeWire native client socket
owner /run/user/*/pulse/native rw,         # PulseAudio client socket (also the pipewire-pulse shim)
