# THIS_FILE_IS_MANAGED_BY_ANSIBLE__DO_NOT_EDIT_MANUALLY
# Deny GPU userspace DISCOVERY (metadata, not hardware) -
# /etc/apparmor.d/abstractions/local_mixin_deny_gpu_metadata
#
# Companion to local_mixin_deny_gpu, which blocks the device NODES. The
# Mesa / EGL / Vulkan loaders still enumerate their config dirs at startup
# before falling back to llvmpipe, and those reads are not covered there -
# so a GPU-denied app keeps logging them on every launch. This mixin
# silences that leftover discovery.
#
# OPT-IN, and deliberately NOT folded into local_mixin_deny_gpu: the same
# paths are a SPLIT-POLICY set. gwenview / mscore3 include deny_gpu and
# then ALLOW these reads inline (llvmpipe still consults drirc, and the
# software rasterizer writes the shader cache); telegram and dbeaver want
# them denied, because a compromised network-facing app must not write
# into the SHARED mesa shader cache. Moving these lines into deny_gpu
# would silently override gwenview's and mscore3's allows - deny beats
# allow in AppArmor. See CLAUDE.md "Mixin promotion" (split-policy paths
# get a dedicated opt-in mixin).
#
# Do NOT include this together with local_mixin_gpu, or in a profile that
# grants /dev/udmabuf - the deny wins and the grant becomes dead policy.
#
# `deny` (NOT `audit deny`) throughout: this is per-launch loader noise,
# not a tripwire. The hardware boundary is local_mixin_deny_gpu's job.
#
# Current callers: Telegram (local_pathbased_telegram),
# DBeaver (local_pathbased_dbeaver).

deny /dev/dri/ r,                                  # DRM device directory LISTING (nodes: local_mixin_deny_gpu)
deny /usr/share/vulkan/icd.d/{,**} r,              # Vulkan installable client driver manifests
deny /usr/share/vulkan/implicit_layer.d/{,**} r,   # Vulkan implicit layer manifests
deny /usr/share/drirc.d/{,**} r,                   # Mesa DRI per-app workaround configs
deny /usr/share/egl/egl_external_platform.d/{,**} r,  # EGL external platform configs (nvidia/wayland)
deny /usr/share/nvidia/nvidia-application-profiles-* r,  # nvidia per-app driver tunables (version in the name)
deny @{HOME}/.cache/mesa_shader_cache/{,**} rwk,   # shared Mesa shader cache - never written by a network-facing app
# udmabuf zero-copy buffer assembly: a GPU-less posture hands frames over by plain memory
# copy instead. local_mixin_deny_gpu leaves this to the profile on purpose; deniers get it here.
deny /dev/udmabuf rw,
