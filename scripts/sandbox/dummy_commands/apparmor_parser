#!/bin/bash
# Sandbox wrapper for apparmor_parser.
# Pure-userspace flags pass through to the real binary so deployed profiles are
# syntactically validated. Kernel-touching flags (-r load, -R unload, etc.) are
# stubbed because the sandbox shares the host kernel and rootless podman lacks
# CAP_MAC_ADMIN; a real call would either error or pollute the host's loaded
# AppArmor state.
case "$1" in
    --parse|-p|--preprocess|-Q|--skip-kernel-load|-K)
        exec /usr/sbin/apparmor_parser "$@" ;;
    *)
        echo "[sandbox stub] apparmor_parser $*"
        exit 0 ;;
esac
