#!/bin/bash
# Sandbox stub for `incus`. `roles/incus_vm` host setup is skipped in the sandbox
# (incus_vm_skip_host_setup=true), so the real binary isn't needed and we don't
# spin up VMs here (nested KVM via libkrun/crun isn't worth the complexity for
# what this sandbox verifies - the file-install path). Any incidental `incus`
# invocation is stubbed to no-op success.
case "$1" in
    --version)
        echo "Incus 6.0.0 (sandbox stub)"
        ;;
    *)
        echo "[sandbox stub] incus $*"
        exit 0
        ;;
esac
