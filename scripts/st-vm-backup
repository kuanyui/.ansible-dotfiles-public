#!/usr/bin/env python3
"""Host-side backup/restore of a SillyTavern ivm/incus VM's app data.

Streams ST's data dir (+ config.yaml) in/out of the guest via `incus exec`, so it works on
ANY SillyTavern VM - including older ones provisioned before the in-guest `st-backup` helper
existed (that is the whole point: no in-guest dependency). App DATA only (characters, chats,
settings, secrets.json): NOT the whole VM (use `incus export` for that), and NOT a fast
in-place rollback (use `ivm snapshot`).

  st-vm-backup list                    running VMs that have a SillyTavern data dir
  st-vm-backup backup <vm> [outfile]   tar ST data out of <vm> into a host file
  st-vm-backup restore <vm> <file>     push a backup into <vm>, then restart it to reload

The backup .tar holds secrets.json (API keys) in PLAINTEXT - treat the file as a secret.
"""
from __future__ import annotations

import argparse
import shlex
import subprocess
import sys
from datetime import datetime
from pathlib import Path
from typing import IO


def announce_and_run(incus_command: list[str], *, stdin: IO[bytes] | None = None,
                     stdout: IO[bytes] | None = None) -> int:
    """Print the incus command (host-side transparency), run it, return its exit code."""
    print(f"+ {shlex.join(incus_command)}", file=sys.stderr)
    return subprocess.run(incus_command, stdin=stdin, stdout=stdout).returncode


def die(message: str) -> None:
    print(f"st-vm-backup: {message}", file=sys.stderr)
    raise SystemExit(1)


def vm_is_running(vm_name: str) -> bool:
    probe = subprocess.run(["incus", "list", vm_name, "--format", "csv", "--columns", "s"],
                           capture_output=True, text=True)
    return probe.returncode == 0 and probe.stdout.strip().upper().startswith("RUNNING")


def guest_has_sillytavern(vm_name: str, sillytavern_dir: str) -> bool:
    return subprocess.run(["incus", "exec", vm_name, "--", "test", "-d", f"{sillytavern_dir}/data"],
                          capture_output=True).returncode == 0


def cmd_list(sillytavern_dir: str) -> None:
    listing = subprocess.run(["incus", "list", "--format", "csv", "--columns", "ns"],
                             capture_output=True, text=True)
    if listing.returncode != 0:
        die("`incus list` failed - is incus set up and are you in the `incus` group?")
    sillytavern_vms: list[str] = []
    for vm_row in listing.stdout.splitlines():
        if not vm_row:
            continue
        vm_name, _, vm_state = vm_row.partition(",")
        if vm_state.upper() == "RUNNING" and guest_has_sillytavern(vm_name, sillytavern_dir):
            sillytavern_vms.append(vm_name)
    if not sillytavern_vms:
        die(f"no running VM has {sillytavern_dir}/data "
            "(start the VM first, or pass --st-dir if ST lives elsewhere)")
    print("SillyTavern VMs (running):")
    for vm_name in sillytavern_vms:
        print(f"  {vm_name}")


def cmd_backup(vm_name: str, out_arg: str | None, sillytavern_dir: str) -> None:
    if not vm_is_running(vm_name):
        die(f"VM '{vm_name}' is not running - start it first: incus start {vm_name}")
    if not guest_has_sillytavern(vm_name, sillytavern_dir):
        die(f"VM '{vm_name}' has no {sillytavern_dir}/data - not a SillyTavern VM? (see --st-dir)")
    out_path = (Path(out_arg) if out_arg
                else Path.cwd() / f"STBackup_{vm_name}_{datetime.now():%Y%m%d_%H%M}.tar")
    # Hot backup: tar data (+ config.yaml if present) to stdout, captured into the host file.
    quoted_dir = shlex.quote(sillytavern_dir)
    guest_tar = f"cd {quoted_dir} && tar -cf - data $([ -f config.yaml ] && printf config.yaml)"
    print(f"st-vm-backup: {vm_name}:{sillytavern_dir}/data -> {out_path}", file=sys.stderr)
    with open(out_path, "wb") as out_fh:
        rc = announce_and_run(["incus", "exec", vm_name, "--", "sh", "-c", guest_tar], stdout=out_fh)
    if rc != 0:
        out_path.unlink(missing_ok=True)
        die(f"backup failed (incus exec rc={rc}); removed partial {out_path}")
    mib = out_path.stat().st_size / 1_048_576
    print(f"st-vm-backup: wrote {out_path} ({mib:.1f} MiB) - "
          "contains secrets.json (API keys) in PLAINTEXT.")


def cmd_restore(vm_name: str, backup_arg: str, sillytavern_dir: str) -> None:
    backup_path = Path(backup_arg)
    if not backup_path.is_file():
        die(f"not found: {backup_path}")
    if not vm_is_running(vm_name):
        die(f"VM '{vm_name}' is not running - start it first: incus start {vm_name}")
    print(f"st-vm-backup: this OVERWRITES {vm_name}:{sillytavern_dir}/data from {backup_path}")
    if input("Continue? [y/N] ").strip().lower() not in ("y", "yes"):
        die("aborted")
    # Extract as `user` (so ST keeps owning its files), then restart the VM to reload ST
    # cleanly - works whether ST runs as a system or a per-user service (older vs newer VMs).
    quoted_dir = shlex.quote(sillytavern_dir)
    guest_extract = f"mkdir -p {quoted_dir} && tar -C {quoted_dir} -xf -"
    with open(backup_path, "rb") as backup_fh:
        rc = announce_and_run(["incus", "exec", vm_name, "--", "su", "-", "user", "-c", guest_extract],
                              stdin=backup_fh)
    if rc != 0:
        die(f"restore failed (incus exec rc={rc}); VM left running, not restarted")
    announce_and_run(["incus", "restart", vm_name])
    print(f"st-vm-backup: restored into {vm_name} and restarted it (ST reloads on boot).")


def main() -> None:
    parser = argparse.ArgumentParser(prog="st-vm-backup", description=__doc__,
                                     formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--st-dir", default="/home/user/SillyTavern",
                        help="ST install dir inside the guest (default: /home/user/SillyTavern)")
    subparsers = parser.add_subparsers(dest="command", required=True)
    subparsers.add_parser("list", help="list running SillyTavern VMs")
    backup_parser = subparsers.add_parser("backup", help="back up a VM's ST data to a host file")
    backup_parser.add_argument("vm")
    backup_parser.add_argument("outfile", nargs="?")
    restore_parser = subparsers.add_parser("restore",
                                           help="restore a backup into a VM (destructive; restarts it)")
    restore_parser.add_argument("vm")
    restore_parser.add_argument("infile")
    args = parser.parse_args()
    if args.command == "list":
        cmd_list(args.st_dir)
    elif args.command == "backup":
        cmd_backup(args.vm, args.outfile, args.st_dir)
    elif args.command == "restore":
        cmd_restore(args.vm, args.infile, args.st_dir)


if __name__ == "__main__":
    main()
